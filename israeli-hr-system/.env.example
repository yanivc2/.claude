# מסד נתונים (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hr_il?schema=public"

# מפתח ל-Anthropic API (עבור צ'אטבוט ההתייעצות מבוסס RAG)
ANTHROPIC_API_KEY="sk-ant-..."

# סוד לאימות קריאות ה-Cron (Vercel Cron / מתזמן חיצוני)
CRON_SECRET="change-me-to-a-long-random-string"

# ── שליחת מייל (Resend) — נדרש לשליחת מסמכים במייל למטפלי פנסיה/אנשי קשר ──
# ללא מפתח זה, שליחת המייל מושבתת (וואטסאפ/הדפסה עדיין עובדים).
RESEND_API_KEY=""
EMAIL_FROM="מערכת משאבי אנוש <onboarding@resend.dev>"

# כתובת בסיס לאפליקציה (עבור זימוני יומן וקישורים)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── התראות Web Push (VAPID) ──
# יש לייצר זוג מפתחות: npx web-push generate-vapid-keys
# המפתח הציבורי נחשף ללקוח (NEXT_PUBLIC_), הפרטי נשאר בשרת בלבד.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# נושא ה-VAPID (כתובת מייל ליצירת קשר). אופציונלי.
VAPID_SUBJECT="mailto:hr@example.com"
