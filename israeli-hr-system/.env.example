# מסד נתונים (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hr_il?schema=public"

# ── סוד הסשן (חתימת עוגיית הכניסה) — חובה בפרודקשן ──
# ללא ערך זה משתמשים בברירת מחדל לא בטוחה. יש להגדיר מחרוזת אקראית ארוכה.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── פרטי הכניסה של הבעלים (רשות; קיימות ברירות מחדל) ──
# מומלץ להגדיר בפרודקשן במקום להסתמך על ברירת המחדל admin.
AUTH_USERNAME="yanivc2"
AUTH_NAME="יניב כהן"
AUTH_EMAIL="yanivc2@gmail.com"
AUTH_PASSWORD="change-me"

# מפתח ל-Anthropic API (עבור צ'אטבוט ההתייעצות מבוסס RAG)
ANTHROPIC_API_KEY="sk-ant-..."

# סוד לאימות קריאות ה-Cron (Vercel Cron / מתזמן חיצוני)
CRON_SECRET="change-me-to-a-long-random-string"

# סוד לאיפוס-חירום של סיסמת הבעלים כשננעל בחוץ ושליחת מייל אינה זמינה.
# פעיל רק אם מוגדר. במסך הכניסה: "שכחתי סיסמה" → איפוס חירום → הזנת ערך זה.
# מומלץ למחוק לאחר השימוש.
OWNER_RESET_SECRET=""

# ── שליחת מייל (Resend) — נדרש לשליחת מסמכים במייל למטפלי פנסיה/אנשי קשר ──
# ללא מפתח זה, שליחת המייל מושבתת (וואטסאפ/הדפסה עדיין עובדים).
RESEND_API_KEY=""
EMAIL_FROM="מערכת משאבי אנוש <onboarding@resend.dev>"

# כתובת בסיס לאפליקציה (עבור זימוני יומן וקישורים)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── התראות Web Push (VAPID) ──
# יש לייצר זוג מפתחות: npx web-push generate-vapid-keys
# המפתח הציבורי נחשף ללקוח (חובה קידומת NEXT_PUBLIC_), הפרטי נשאר בשרת בלבד.
# שניהם זוג תואם — אין לערבב עם זוג ישן. בפרודקשן: להגדיר ב-Vercel ואז Redeploy
# (הערך NEXT_PUBLIC_ נצרב בזמן build). ללא המפתחות ההתראות עדיין נשמרות
# ומוצגות בפעמון בתוך האפליקציה, רק הדחיפה למכשיר מושבתת.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# נושא ה-VAPID (כתובת מייל ליצירת קשר). אופציונלי.
VAPID_SUBJECT="mailto:yanivc2@gmail.com"
