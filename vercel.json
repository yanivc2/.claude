{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/ingest/bank-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/ingest/voided-checks",
      "schedule": "30 5 * * *"
    }
  ]
}
