{
  "permissions": {
    "allow": [
      "PowerShell(gh auth status 2>&1)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(*node generate.mjs*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(gh auth status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "PowerShell(Get-ChildItem \"$env:USERPROFILE\\\\.claude\" -ErrorAction SilentlyContinue | Select-Object Name, PSIsContainer)",
      "PowerShell(Get-ChildItem \"$env:USERPROFILE\\\\.claude\\\\skills\" -ErrorAction SilentlyContinue | Select-Object Name, PSIsContainer)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:medium.com)",
      "Bash(gws gmail *)",
      "Bash(npm show *)",
      "Bash(npx skills *)",
      "Skill(code-review)",
      "Skill(code-review:*)",
      "Skill(schedule)",
      "Skill(schedule:*)",
      "mcp__playwright__browser_snapshot",
      "mcp__claude_ai_Microsoft_Learn__microsoft_docs_search",
      "Write(C:\\Users\\yaniv\\.claude\\*)"
    ],
    "additionalDirectories": [
      "C:\\Users\\yaniv"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/client_secret*.json)",
      "Read(**/credentials.json)",
      "Read(**/session.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/Vault/_organize/*.json)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/*.pyc)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)",
      "Read(**/poetry.lock)",
      "Read(**/.git/objects/**)",
      "Read(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Read(~/.local/**)",
      "Read(~/.agents/skills-archive/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/backups/**)",
      "Read(~/.claude/cache/**)",
      "Read(~/.claude/deletions/**)",
      "Read(~/Documents/Codex/**)",
      "Read(**/*.db)",
      "Read(**/*.db3)",
      "Read(**/*.bak)",
      "Read(**/*.sqlite)",
      "Read(**/*.zip)",
      "Read(**/*.7z)",
      "Read(**/*.iso)",
      "Read(**/*.mp4)",
      "Read(~/AppData/Local/Google/Chrome/User Data/**)",
      "Read(~/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(~/AppData/Roaming/Mozilla/Firefox/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/Firefox/**)"
    ],
    "ask": [
      "Read(//c/micha-agent/**/*.vtt)",
      "Read(~/Projects/**/*.vtt)",
      "Read(**/*.srt)",
      "Read(//c/Users/yaniv/OneDrive/**)",
      "Read(~/OneDrive/**)",
      "Read(~/Library/CloudStorage/OneDrive-*/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/seed-project.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/env-nudges.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-summary.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/precompact-notice.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-onedrive.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/backup-before-write.mjs\"",
            "statusMessage": "Backing up before overwrite or delete..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/typecheck.mjs\"",
            "statusMessage": "בודק TypeScript..."
          }
        ]
      }
    ]
  },
  "fileCheckpointingEnabled": true,
  "model": "opus",
  "effortLevel": "xhigh"
}
