{
  "language": "hebrew",
  "permissions": {
    "allow": [
      "PowerShell(gh auth status 2>&1)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(*node generate.mjs*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "PowerShell(Get-ChildItem \"$env:USERPROFILE\\\\.claude\" -ErrorAction SilentlyContinue | Select-Object Name, PSIsContainer)",
      "PowerShell(Get-ChildItem \"$env:USERPROFILE\\\\.claude\\\\skills\" -ErrorAction SilentlyContinue | Select-Object Name, PSIsContainer)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:medium.com)",
      "Bash(gws gmail *)",
      "Bash(npm show *)",
      "Bash(npx skills *)",
      "Skill(code-review)",
      "Skill(code-review:*)",
      "Skill(schedule)",
      "Skill(schedule:*)",
      "mcp__playwright__browser_snapshot",
      "mcp__claude_ai_Microsoft_Learn__microsoft_docs_search",
      "Edit(~/.claude/**)",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_triggers",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__update_trigger",
      "Bash(gh auth status*)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/client_secret*.json)",
      "Read(**/credentials.json)",
      "Read(**/session.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(//c/Users/yaniv/Vault/_organize/*.json)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/*.pyc)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)",
      "Read(**/poetry.lock)",
      "Read(**/.git/objects/**)",
      "Read(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Read(~/.local/**)",
      "Read(~/.agents/skills-archive/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/backups/**)",
      "Read(~/.claude/cache/**)",
      "Read(~/.claude/deletions/**)",
      "Read(//c/Users/yaniv/Documents/Codex/**)",
      "Read(**/*.db)",
      "Read(**/*.db3)",
      "Read(**/*.bak)",
      "Read(**/*.sqlite)",
      "Read(**/*.zip)",
      "Read(**/*.7z)",
      "Read(**/*.iso)",
      "Read(**/*.mp4)",
      "Read(~/AppData/Local/Google/Chrome/User Data/**)",
      "Read(~/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(~/AppData/Roaming/Mozilla/Firefox/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/Firefox/**)"
    ],
    "ask": [
      "Read(//c/micha-agent/**/*.vtt)",
      "Read(**/*.srt)",
      "Read(//c/Users/yaniv/OneDrive/**)"
    ],
    "additionalDirectories": [
      "C:\\Users\\yaniv"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/skills-drift.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/project-template-bootstrap.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/project-health.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"C:/Users/yaniv/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/stop-sound.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/stop-git-stat.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/hebrew-reply-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/onedrive-write-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-secrets.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/tsc-check.mjs\"",
            "statusMessage": "בודק TypeScript..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/tsc-check.mjs\"",
            "statusMessage": "בודק TypeScript..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "design@knowledge-work-plugins": true,
    "firecrawl@firecrawl": true,
    "context-mode@context-mode": true,
    "commit-commands@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "firecrawl": {
      "source": {
        "source": "github",
        "repo": "firecrawl/firecrawl-claude-plugin"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "effortLevel": "xhigh",
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skillListingMaxDescChars": 200,
