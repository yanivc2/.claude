# AP Control — local configuration (stage 1)
# Copy to .env and adjust. Never commit .env.

# HTTP port for the local web app (secretary connects from a browser on the office LAN)
PORT=3000

# SQLite database file path (relative to project root). Kept out of git; back it up daily (§12).
DB_PATH=./data/ap-control.sqlite

# Stage 1b — invoice images. Directory is gitignored; back it up together with the DB (§12).
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Stage 2 — bank reconciliation (R7).
# Match window: a bank debit matches an open check within this many days of payment_date.
RECONCILE_WINDOW_DAYS=60

# Bank scraper (israeli-bank-scrapers, optional dependency — install when ready for stage 2).
# Never hard-code bank credentials in source. Use OS keychain or an encrypted, gitignored file.
# Run:  npm install israeli-bank-scrapers  &&  npm run scrape
# BANK_HAPOALIM_USER_CODE=
# BANK_HAPOALIM_PASSWORD=

# Stage 3 — OCR (local, optional). Install:  npm install tesseract.js
# Languages for tesseract; OCR_LANG_PATH points to a local traineddata folder for offline use.
OCR_LANGS=heb+eng
# OCR_LANG_PATH=./tessdata

# Stage 4 — check printing (Standard 501 / MICR). GATED: leave false until the bank has
# approved self-printing AND an approved E-13B MICR font is installed (🔴 §11.5, §10.3).
# While false, the check prints as a watermarked DRAFT with a MICR placeholder only.
CHECK_PRINTING_APPROVED=false

# Stage 2d — Z-close alerts via a DEDICATED Telegram bot (separate from any other bot you run).
# Create the bot with @BotFather (/newbot) and paste its token below. With no token the app
# runs normally and simply sends no alerts. Never commit the real token — keep it in .env only.
# TELEGRAM_BOT_TOKEN=123456789:AA...token
# Chat id to send alerts to (default is the owner's id; override here if needed).
# TELEGRAM_CHAT_ID=5717967564
