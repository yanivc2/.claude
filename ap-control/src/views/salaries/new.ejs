<%- include('../partials/header') %>
<h1>רישום שכר</h1>
<div class="card">
  <p class="muted">תשלום שכר לעובד. אינו נכנס לזרימת החשבוניות/בקרת הצ׳קים.</p>
  <% if (error) { %><div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div><% } %>

  <form class="stack" method="post" action="/salaries">
    <div class="row">
      <div>
        <label>שם עובד *</label>
        <input name="employee_name" required value="<%= values.employee_name || '' %>" />
      </div>
      <div>
        <label>סכום (₪) *</label>
        <input name="amount" inputmode="decimal" required value="<%= values.amount || '' %>" />
      </div>
    </div>

    <div class="row">
      <div>
        <label>תאריך תשלום *</label>
        <input type="date" name="pay_date" required value="<%= values.pay_date || '' %>" />
      </div>
      <div>
        <label>עבור חודש</label>
        <input name="period" value="<%= values.period || '' %>" placeholder="למשל 2026-07" />
      </div>
      <div>
        <label>אמצעי</label>
        <select name="method">
          <option value="transfer" <%= values.method !== 'check' && values.method !== 'cash' ? 'selected' : '' %>>העברה</option>
          <option value="check" <%= values.method === 'check' ? 'selected' : '' %>>צ׳ק</option>
          <option value="cash" <%= values.method === 'cash' ? 'selected' : '' %>>מזומן</option>
        </select>
      </div>
    </div>

    <div class="row">
      <div>
        <label>חשבון בנק (לצ׳ק / העברה)</label>
        <select name="bank_account_id">
          <option value="">— ללא / מזומן —</option>
          <% accounts.forEach(function(a){ %>
            <option value="<%= a.id %>" <%= String(values.bank_account_id) === String(a.id) ? 'selected' : '' %>><%= a.display_name %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label>אסמכתא (מס׳ צ׳ק / העברה)</label>
        <input name="reference" value="<%= values.reference || '' %>" />
      </div>
    </div>

    <label>הערות</label>
    <textarea name="notes" rows="2"><%= values.notes || '' %></textarea>

    <div style="margin-top:1.1rem" class="actions">
      <button type="submit">שמור רישום</button>
      <a href="/salaries" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
