<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · AP Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/nocturne.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#161826" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
</head>
<body>
  <!-- ambient background -->
  <div class="amb amb-glow"></div>
  <div class="amb amb-grid"></div>
  <div class="amb amb-vignette"></div>

  <header class="nav">
    <a href="/" class="nav-brand"><span class="mark">AP</span>Control</a>
    <span class="spacer"></span>
    <details class="menu navmenu">
      <summary class="btn btn-secondary btn-sm">☰ ניווט דפים <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">לוח בקרה</a>
        <a href="/invoices" class="<%= path.startsWith('/invoices') ? 'active' : '' %>">חשבוניות</a>
        <a href="/payments" class="<%= path.startsWith('/payments') ? 'active' : '' %>">מרקורים</a>
        <a href="/suppliers" class="<%= path.startsWith('/suppliers') ? 'active' : '' %>">ספקים</a>
        <a href="/reports/outstanding" class="<%= path === '/reports/outstanding' ? 'active' : '' %>">צ׳קים בחוץ</a>
        <a href="/reconciliation" class="<%= path.startsWith('/reconciliation') ? 'active' : '' %>">התאמת בנק</a>
        <a href="/reports/profitability" class="<%= path === '/reports/profitability' ? 'active' : '' %>">רווחיות</a>
        <a href="/reports/zreports" class="<%= path.startsWith('/reports/zreports') ? 'active' : '' %>">דוחות Z</a>
        <a href="/audit" class="<%= path === '/audit' ? 'active' : '' %>">יומן</a>
        <% if (currentUser.role === 'owner') { %>
          <a href="/approvals" class="<%= path.startsWith('/approvals') ? 'active' : '' %>">אישורים<% if (typeof pendingApprovals !== 'undefined' && pendingApprovals > 0) { %> <span class="tag tag-accent"><%= pendingApprovals %></span><% } %></a>
        <% } %>
        <% if (typeof can === 'function' && can('settings')) { %>
          <div class="menu-sep"></div>
          <a href="/settings" class="<%= path.startsWith('/settings') ? 'active' : '' %>">הגדרות</a>
        <% } %>
        <div class="menu-sep"></div>
        <form method="post" action="/logout" style="margin:0">
          <button type="submit">התנתק</button>
        </form>
      </div>
    </details>
  </header>

  <main class="page fade-up">
    <% if (typeof scopeCompanies !== 'undefined' && scopeCompanies) { %>
      <div class="scope-strip">
        <span class="tag tag-outline">חברות מורשות</span>
        <% if (scopeCompanies.length === 0) { %>
          <span>אין גישה לאף חברה — פנה לבעלים</span>
        <% } else { %>
          <span><%= scopeCompanies.map(function(c){return c.name;}).join(' · ') %></span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div>
    <% } %>
