<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · AP Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/nocturne.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#161826" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
</head>
<body>
  <!-- ambient background -->
  <div class="amb amb-glow"></div>
  <div class="amb amb-grid"></div>
  <div class="amb amb-vignette"></div>

  <header class="nav">
    <a href="/" class="nav-brand"><span class="mark">AP</span>Control</a>
    <nav class="mainnav">
      <a href="/" class="navlink <%= path === '/' ? 'active' : '' %>">לוח בקרה</a>
      <a href="/invoices" class="navlink <%= path.startsWith('/invoices') ? 'active' : '' %>">חשבוניות</a>
      <a href="/payments" class="navlink <%= path.startsWith('/payments') ? 'active' : '' %>">תשלומים</a>
      <a href="/suppliers" class="navlink <%= path.startsWith('/suppliers') ? 'active' : '' %>">ספקים</a>
      <a href="/reports/outstanding" class="navlink <%= path === '/reports/outstanding' ? 'active' : '' %>">צ׳קים בחוץ</a>
      <a href="/reconciliation" class="navlink <%= path.startsWith('/reconciliation') ? 'active' : '' %>">התאמת בנק</a>
      <a href="/reports/profitability" class="navlink <%= path === '/reports/profitability' ? 'active' : '' %>">רווחיות</a>
      <a href="/audit" class="navlink <%= path === '/audit' ? 'active' : '' %>">יומן</a>
      <% if (currentUser.role === 'owner') { %>
        <a href="/approvals" class="navlink <%= path.startsWith('/approvals') ? 'active' : '' %>">אישורים<% if (typeof pendingApprovals !== 'undefined' && pendingApprovals > 0) { %> <span class="tag tag-accent" style="margin-inline-start:4px"><%= pendingApprovals %></span><% } %></a>
      <% } %>
      <% if (typeof can === 'function' && can('settings')) { %><a href="/settings" class="navlink <%= path.startsWith('/settings') ? 'active' : '' %>">הגדרות</a><% } %>
    </nav>
    <span class="spacer"></span>
    <span class="tag tag-neutral" title="משתמש מחובר"><%= currentUser.label || currentUser.name || currentUser.username %></span>
    <form method="post" action="/logout" style="display:inline">
      <button type="submit" class="btn btn-secondary btn-sm">התנתק</button>
    </form>
  </header>

  <main class="page fade-up">
    <% if (typeof scopeCompanies !== 'undefined' && scopeCompanies) { %>
      <div class="scope-strip">
        <span class="tag tag-outline">חברות מורשות</span>
        <% if (scopeCompanies.length === 0) { %>
          <span>אין גישה לאף חברה — פנה לבעלים</span>
        <% } else { %>
          <span><%= scopeCompanies.map(function(c){return c.name;}).join(' · ') %></span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div>
    <% } %>
