<%- include('../partials/header') %>
<%
// Reusable inline icons (fill = currentColor).
var phoneSvg = '<svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>';
var mailSvg = '<svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>';
function telHref(p){ var c = String(p||'').replace(/[^\d+]/g,''); return c ? ('tel:' + c) : null; }
%>
<div class="toolbar">
  <h1>אנשי קשר ספקים</h1>
  <a href="/suppliers" class="btn secondary">כל הספקים</a>
</div>

<div class="card no-print">
  <form method="get" action="/suppliers/contacts" class="row" style="align-items:flex-end">
    <div style="flex:1">
      <label>חיפוש ספק (שם / ח.פ. / טלפון / איש קשר)</label>
      <input name="q" value="<%= q %>" placeholder="הקלד לחיפוש..." autofocus />
    </div>
    <div><button type="submit">חפש</button></div>
    <% if (q) { %><div><a href="/suppliers/contacts" class="btn secondary">נקה</a></div><% } %>
  </form>
  <p class="muted" style="margin:.4rem 0 0">לחיצה על כותרת "ספק" ממיינת א׳–ת׳. לחיצה על אייקון טלפון מחייגת (בנייד) / פותחת חיוג (במחשב); אייקון מייל פותח שליחת מייל.</p>
</div>

<% if (suppliers.length === 0) { %>
  <div class="card muted"><%= q ? 'לא נמצאו ספקים תואמים.' : 'אין ספקים.' %></div>
<% } else { %>
  <div class="card">
    <table class="sortable">
      <thead>
        <tr><th>ספק</th><th>סטטוס</th><th>טלפון</th><th>מייל</th><th>איש קשר הנה"ח</th><th data-nosort class="no-print">פעולות</th></tr>
      </thead>
      <tbody>
        <% suppliers.forEach(function(s){ %>
          <tr>
            <td><strong><%= s.name %></strong><% if (s.tax_id) { %> <span class="muted mono">· <%= s.tax_id %></span><% } %></td>
            <td>
              <span class="badge <%= s.status === 'approved' ? 'b-approved' : s.status === 'blocked' ? 'b-blocked' : 'b-on_hold' %>">
                <%= s.status === 'approved' ? 'מאושר' : s.status === 'blocked' ? 'חסום' : 'ממתין' %>
              </span>
            </td>
            <td>
              <% if (telHref(s.phone)) { %>
                <a class="icon-btn" href="<%= telHref(s.phone) %>" title="חייג <%= s.phone %>" aria-label="חייג"><%- phoneSvg %></a>
                <span class="mono muted" style="font-size:.8rem"><%= s.phone %></span>
              <% } else { %>—<% } %>
            </td>
            <td>
              <% if (s.email) { %>
                <a class="icon-btn" href="mailto:<%= s.email %>" title="שלח מייל ל-<%= s.email %>" aria-label="מייל"><%- mailSvg %></a>
                <span class="muted" style="font-size:.8rem"><%= s.email %></span>
              <% } else { %>—<% } %>
            </td>
            <td>
              <%= s.contact_name || '—' %>
              <% if (telHref(s.contact_phone)) { %>
                <a class="icon-btn" href="<%= telHref(s.contact_phone) %>" title="חייג <%= s.contact_phone %>" aria-label="חייג הנה״ח"><%- phoneSvg %></a>
              <% } %>
            </td>
            <td class="no-print" onclick="event.stopPropagation()">
              <a class="btn secondary small" href="/suppliers/<%= s.id %>/edit">ערוך</a>
              <form method="post" action="/suppliers/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את הספק <%= s.name %>?')">
                <button class="danger small" type="submit">מחק</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>
