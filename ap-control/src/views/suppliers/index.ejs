<%- include('../partials/header') %>
<% var supLabel = filter === 'pending' ? 'ממתינים' : filter === 'approved' ? 'מאושרים' : filter === 'blocked' ? 'חסומים' : 'הכל'; %>
<div class="toolbar">
  <h1>ספקים</h1>
  <div class="actions no-print">
    <details class="menu">
      <summary class="btn btn-primary">+ ספק חדש <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/suppliers/new">+ ספק חדש</a>
        <a href="/suppliers/contacts">אנשי קשר ספקים</a>
      </div>
    </details>
    <details class="menu">
      <summary class="btn btn-secondary">סינון · <%= supLabel %> <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/suppliers" class="<%= !filter ? 'active' : '' %>">הכל</a>
        <a href="/suppliers?status=pending" class="<%= filter === 'pending' ? 'active' : '' %>">ממתינים</a>
        <a href="/suppliers?status=approved" class="<%= filter === 'approved' ? 'active' : '' %>">מאושרים</a>
        <a href="/suppliers?status=blocked" class="<%= filter === 'blocked' ? 'active' : '' %>">חסומים</a>
      </div>
    </details>
  </div>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>

<form method="post" action="/suppliers/bulk">
  <div class="card no-print" style="display:flex; gap:.6rem; align-items:center; flex-wrap:wrap">
    <strong>פעולה על הנבחרים:</strong>
    <select name="bulk_action">
      <option value="approve">אשר</option>
      <option value="block">חסום</option>
      <option value="delete">מחק</option>
    </select>
    <button type="submit" onclick="return confirm('לבצע את הפעולה על הספקים הנבחרים?')">בצע</button>
    <span class="muted">סמן שורות עם התיבות. אישור/חסימה/מחיקה — פעולות בעלים. מחיקה רק לספק ללא חשבוניות.</span>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width:2rem"><input type="checkbox" onclick="document.querySelectorAll('input.rowchk').forEach(c=>c.checked=this.checked)" title="בחר הכל" /></th>
        <th data-nosort></th>
        <th>שם</th><th class="hide-sm">ח.פ.</th><th>סטטוס</th><th>טלפון</th><th class="hide-sm">הערות</th>
      </tr>
    </thead>
    <tbody>
      <% if (suppliers.length === 0) { %>
        <tr><td colspan="7" class="muted">אין ספקים להצגה.</td></tr>
      <% } %>
      <% suppliers.forEach(function(s){ %>
        <tr>
          <td><input type="checkbox" class="rowchk" name="ids" value="<%= s.id %>" /></td>
          <td><a class="btn btn-secondary btn-sm" href="/suppliers/<%= s.id %>/edit">ערוך</a></td>
          <td><%= s.name %></td>
          <td class="mono hide-sm"><%= s.tax_id || '—' %></td>
          <td><span class="badge b-<%= s.status %>"><%= s.status === 'pending' ? 'ממתין' : s.status === 'approved' ? 'מאושר' : 'חסום' %></span></td>
          <td onclick="event.stopPropagation()">
            <% if (s.phone) { %>
              <details class="menu">
                <summary class="btn btn-secondary btn-sm mono" style="white-space:nowrap"><%= s.phone %> <span class="caret">▾</span></summary>
                <div class="menu-panel" style="min-width:160px">
                  <a href="<%= telLink(s.phone) %>">📞 התקשר</a>
                  <a href="<%= waLink(s.phone) %>" target="_blank" rel="noopener">💬 וואטסאפ</a>
                </div>
              </details>
            <% } else { %>—<% } %>
          </td>
          <td class="muted hide-sm"><%= s.notes || '' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</form>
<%- include('../partials/footer') %>
