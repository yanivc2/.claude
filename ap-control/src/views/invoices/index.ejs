<%- include('../partials/header') %>
<div class="toolbar">
  <h1>חשבוניות</h1>
  <a class="btn" href="/invoices/new">+ חשבונית חדשה</a>
</div>

<div class="card no-print">
  <strong>קיצורי תשלום:</strong>
  <div class="actions" style="flex-wrap:wrap; margin-top:.4rem">
    <a class="btn" href="/payments/new?method=transfer">+ תשלום בהעברה</a>
    <a class="btn" href="/payments/new?method=cash">+ תשלום במזומן</a>
    <a class="btn" href="/payments/new?method=check">+ צ׳ק</a>
  </div>
</div>

<div class="filterms card">
  סינון:
  <a href="/invoices">הכל</a>
  <a href="/invoices?status=recorded">נרשמו</a>
  <a href="/invoices?status=on_hold">מוחזקות</a>
  <a href="/invoices?status=approved_for_payment">מאושרות לתשלום</a>
  <a href="/invoices?status=paid">שולמו</a>
</div>
<p class="muted no-print" style="margin:.2rem 0">לחיצה על כותרת עמודה ממיינת (א׳–ת׳ / גבוה–נמוך).</p>

<table class="sortable">
  <thead>
    <tr>
      <th>#</th><th>ספק</th><th>חנות</th><th>מס' חשבונית</th><th>הקצאה</th>
      <th>תאריך</th><th>סוג</th><th class="right">סכום</th><th>סטטוס</th>
    </tr>
  </thead>
  <tbody>
    <% if (invoices.length === 0) { %>
      <tr><td colspan="9" class="muted">אין חשבוניות להצגה.</td></tr>
    <% } %>
    <% invoices.forEach(function(i){ %>
      <tr onclick="location='/invoices/<%= i.id %>'" style="cursor:pointer">
        <td><%= i.id %></td>
        <td><%= i.supplier_name %>
          <% if (i.supplier_status !== 'approved') { %>
            <span class="badge b-<%= i.supplier_status %>">ספק <%= i.supplier_status === 'pending' ? 'ממתין' : 'חסום' %></span>
          <% } %>
        </td>
        <td><%= i.store_name %></td>
        <td class="mono"><%= i.invoice_number %></td>
        <td class="mono"><%= i.allocation_number || '—' %></td>
        <td><%= i.invoice_date %></td>
        <td><%= i.doc_type === 'credit_note' ? 'זיכוי' : i.doc_type === 'tax_invoice_receipt' ? 'חש/קבלה' : 'חש. מס' %></td>
        <td class="right <%= i.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(i.total_amount) %></td>
        <td><span class="badge b-<%= i.status %>"><%= statusLabel(i.status) %></span></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%
function statusLabel(s){
  return s === 'recorded' ? 'נרשם'
    : s === 'on_hold' ? 'מוחזק'
    : s === 'approved_for_payment' ? 'מאושר לתשלום'
    : s === 'paid' ? 'שולם' : s;
}
%>
<%- include('../partials/footer') %>
