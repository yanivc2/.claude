<%- include('../partials/header') %>
<% function payStatusLabel(s){ return s === 'issued' ? 'הונפק' : s === 'cleared' ? 'נפרע' : 'מבוטל'; } %>
<!-- כותרת: רק מזהה הצ׳ק (מספר הצ׳ק שהוזן); תגית הסטטוס משמאל, נלחצת לשינוי -->
<div class="toolbar" style="align-items:center">
  <h1 style="margin:0"><span class="mono"><%= paymentIdent(payment) %></span></h1>
  <% if (payment.status === 'voided') { %>
    <span class="status-pill b-voided">מבוטל</span>
  <% } else { %>
    <details class="menu open-in statusmenu no-print">
      <summary class="status-pill b-<%= payment.status %>"><%= payStatusLabel(payment.status) %> <span class="caret">▾</span></summary>
      <div class="menu-panel" style="min-width:240px">
        <div class="menu-cap">שינוי סטטוס הצ׳ק</div>
        <% if (payment.status === 'issued') { %>
          <form method="post" action="/payments/<%= payment.id %>/clear" style="padding:8px 12px">
            <label class="lbl">תאריך פירעון (ריק = היום)</label>
            <input type="date" name="cleared_date" />
            <button class="btn btn-secondary btn-sm btn-block" type="submit" style="margin-top:6px">סמן כנפרע</button>
          </form>
        <% } else if (payment.status === 'cleared') { %>
          <form method="post" action="/payments/<%= payment.id %>/unclear"><button class="mi" type="submit">החזר ל״הונפק״</button></form>
        <% } %>
        <% if (currentUser.role === 'owner') { %>
          <div class="menu-sep"></div>
          <form method="post" action="/payments/<%= payment.id %>/void" style="padding:8px 12px" onsubmit="return confirm('לבטל את הצ׳ק? החשבוניות יחזרו לסטטוס מאושר לתשלום.')">
            <label class="lbl" style="color:var(--color-bad)">ביטול צ׳ק (בעלים)</label>
            <input name="reason" placeholder="סיבת ביטול" />
            <button class="btn btn-secondary btn-sm btn-block" type="submit" style="margin-top:6px;color:var(--color-bad)">בטל צ׳ק</button>
          </form>
        <% } %>
      </div>
    </details>
  <% } %>
</div>

<div class="card">
  <div class="row">
    <div><span class="muted">חשבון בנק</span><br><%= payment.bank_account_name %></div>
    <div><span class="muted">תאריך תשלום</span><br><%= formatDate(payment.payment_date) %></div>
    <div><span class="muted">סכום</span><br><strong><%= formatIls(payment.amount) %></strong></div>
    <div><span class="muted">נפרע בתאריך</span><br><%= payment.cleared_date ? formatDate(payment.cleared_date) : '—' %></div>
  </div>
</div>

<div class="card">
  <h2>שורות (חשבוניות / זיכויים)</h2>
  <table>
    <thead><tr><th>חשבונית</th><th>ספק</th><th>סוג</th><th>תאריך</th><th class="right">סכום מיושם</th></tr></thead>
    <tbody>
      <% payment.lines.forEach(function(l){ %>
        <tr>
          <td><a href="/invoices/<%= l.invoice_id %>" class="mono"><%= l.invoice_number %></a></td>
          <td><%= l.supplier_name %></td>
          <td><%= l.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %></td>
          <td><%= formatDate(l.invoice_date) %></td>
          <td class="right <%= l.amount_applied < 0 ? 'neg' : '' %>"><%= formatIls(l.amount_applied) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- שורת פעולות: הדפסה + חזרה לרשימה -->
<div class="card no-print" style="display:flex; justify-content:flex-start; gap:var(--space-3)">
  <% if (payment.method === 'check') { %>
    <a href="/payments/<%= payment.id %>/print" class="btn btn-secondary" target="_blank">הדפס צ׳ק (טיוטה)</a>
  <% } %>
  <a href="/payments" class="btn btn-secondary">חזרה לרשימה</a>
</div>
<%- include('../partials/footer') %>
