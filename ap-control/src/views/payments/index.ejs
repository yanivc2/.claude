<%- include('../partials/header') %>
<div class="toolbar">
  <h1>תשלומים (צ׳קים)</h1>
  <a class="btn" href="/payments/new">+ צ׳ק חדש</a>
</div>

<div class="filterms card">
  סינון:
  <a href="/payments">הכל</a>
  <a href="/payments?status=issued">בחוץ (הונפקו)</a>
  <a href="/payments?status=cleared">נפרעו</a>
  <a href="/payments?status=voided">מבוטלים</a>
</div>

<table>
  <thead>
    <tr><th>#</th><th>מס' צ׳ק</th><th>חשבון בנק</th><th>תאריך</th><th class="right">סכום</th><th>סטטוס</th></tr>
  </thead>
  <tbody>
    <% if (payments.length === 0) { %>
      <tr><td colspan="6" class="muted">אין צ׳קים להצגה.</td></tr>
    <% } %>
    <% payments.forEach(function(p){ %>
      <tr onclick="location='/payments/<%= p.id %>'" style="cursor:pointer">
        <td><%= p.id %></td>
        <td class="mono"><%= p.check_number %></td>
        <td><%= p.bank_account_name %></td>
        <td><%= p.payment_date %></td>
        <td class="right"><%= formatIls(p.amount) %></td>
        <td><span class="badge b-<%= p.status %>"><%= p.status === 'issued' ? 'הונפק' : p.status === 'cleared' ? 'נפרע' : 'מבוטל' %></span></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<%- include('../partials/footer') %>
