<%- include('../partials/header') %>
<div class="toolbar">
  <h1>צ׳קים בחוץ</h1>
</div>
<p class="muted">סכום הצ׳קים שהונפקו וטרם נפרעו, פר חשבון בנק = ההתחייבות החיה (§7). לחץ על שורה לפירוט.</p>

<div class="card">
  <table>
    <thead>
      <tr><th>חברה</th><th>חנות / חשבון</th><th class="right">צ׳קים פתוחים</th><th class="right">סכום בחוץ</th><th class="no-print">ייצוא</th></tr>
    </thead>
    <tbody>
      <% accounts.forEach(function(a){ %>
        <tr onclick="location='/reports/outstanding?account=<%= a.id %>'" style="cursor:pointer"
            class="<%= detailAccountId === a.id ? 'b-approved' : '' %>">
          <td><%= a.company_name %></td>
          <td><%= a.display_name %></td>
          <td class="right"><%= a.outstanding_count %></td>
          <td class="right"><strong><%= formatIls(a.outstanding) %></strong></td>
          <td class="no-print" onclick="event.stopPropagation()">
            <details class="menu open-in">
              <summary class="btn btn-secondary btn-sm">ייצוא <span class="caret">▾</span></summary>
              <div class="menu-panel" style="min-width:150px">
                <a href="/reports/outstanding-detail.csv?account=<%= a.id %>">📄 ייצוא CSV</a>
                <a href="/reports/outstanding?account=<%= a.id %>&print=1">🖨️ הדפסה</a>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">סה"כ כל החשבונות</th>
        <th class="right"><%= a_total_count(accounts) %></th>
        <th class="right"><%= formatIls(totalOutstanding) %></th>
        <th class="no-print"></th>
      </tr>
    </tfoot>
  </table>
</div>

<% if (detailAccountId) { %>
  <div class="card">
    <div class="toolbar">
      <h2 style="margin:0">פירוט צ׳קים שלא נפרעו — החשבון הנבחר</h2>
      <a class="btn secondary no-print" href="/reports/outstanding-detail.csv?account=<%= detailAccountId %>">ייצוא CSV מפורט</a>
    </div>
    <table class="sortable">
      <thead>
        <tr>
          <th>ספק</th><th>מס' חשבונית</th><th>תאריך חשבונית</th><th class="right">סכום חשבונית</th>
          <th>מס' זיכוי</th><th class="right">סכום זיכוי</th><th>תאריך פירעון</th><th class="right">סכום</th>
          <th class="no-print" data-nosort>פעולות</th>
        </tr>
      </thead>
      <tbody>
        <% if (detail.length === 0) { %><tr><td colspan="9" class="muted">אין צ׳קים פתוחים.</td></tr><% } %>
        <% detail.forEach(function(r){ %>
          <tr>
            <td><%= r.supplierName %></td>
            <td class="mono"><a href="/payments/<%= r.paymentId %>"><%= r.invoiceNumbers || r.ident %></a></td>
            <td><%= r.invoiceDate %></td>
            <td class="right"><%= formatIls(r.invoiceAmount) %></td>
            <td class="mono"><%= r.creditNumbers || '—' %></td>
            <td class="right"><%= r.creditAmount ? '−' + formatIls(r.creditAmount) : '—' %></td>
            <td><%= r.dueDate %></td>
            <td class="right"><strong><%= formatIls(r.amount) %></strong></td>
            <td class="no-print">
              <form method="post" action="/payments/<%= r.paymentId %>/clear" style="display:inline">
                <button class="ok small" type="submit">סמן כנפרע</button>
              </form>
              <% if (currentUser.role === 'owner') { %>
                <% r.invoiceIds.forEach(function(iid){ %>
                  <a class="btn secondary small" href="/invoices/<%= iid %>/edit">ערוך חשבונית</a>
                <% }); %>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% if (currentUser.role !== 'owner') { %><p class="muted no-print">עריכת חשבוניות זמינה לבעלים בלבד.</p><% } %>
  </div>
<% } %>
<!-- פעולות ייצוא/הדפסה — למטה -->
<div class="card no-print" style="display:flex; justify-content:flex-start; gap:var(--space-3)">
  <a class="btn btn-secondary" href="/reports/outstanding.csv">📄 ייצוא CSV</a>
  <button type="button" class="btn btn-secondary" onclick="window.print()">🖨️ הדפסה / PDF</button>
</div>

<script>
  // "הדפסה" מהתפריט בשורה פותח את פירוט החשבון ומריץ הדפסה אוטומטית.
  if (new URLSearchParams(location.search).get('print') === '1') {
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 350); });
  }
</script>
<%
function a_total_count(list){ return list.reduce(function(s,a){ return s + a.outstanding_count; }, 0); }
%>
<%- include('../partials/footer') %>
