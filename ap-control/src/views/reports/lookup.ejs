<%- include('../partials/header') %>
<h1>בדיקת חשבונית</h1>
<p class="muted">חיפוש לפי מספר חשבונית, מספר הקצאה, או שם ספק (§7).</p>

<div class="card">
  <form method="get" action="/reports/lookup" class="actions">
    <input name="q" value="<%= query %>" placeholder="מספר חשבונית / הקצאה / שם ספק" style="max-width:340px" autofocus />
    <button type="submit">חפש</button>
  </form>
</div>

<% if (query) { %>
  <div class="card">
    <div class="toolbar">
      <h2 style="margin:0">תוצאות (<%= results.length %>)</h2>
      <div class="actions no-print">
        <a class="btn secondary" href="/reports/lookup.csv?q=<%= encodeURIComponent(query) %>">ייצוא CSV</a>
        <button class="secondary" onclick="window.print()">הדפסה / PDF</button>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>#</th><th>ספק</th><th>מס' חשבונית</th><th>הקצאה</th><th>תאריך</th>
          <th class="right">סכום</th><th>סטטוס</th><th>מס' צ׳ק</th><th>פירעון</th>
        </tr>
      </thead>
      <tbody>
        <% if (results.length === 0) { %><tr><td colspan="9" class="muted">לא נמצאו תוצאות.</td></tr><% } %>
        <% results.forEach(function(r){ %>
          <tr>
            <td><a href="/invoices/<%= r.id %>"><%= r.id %></a></td>
            <td><%= r.supplier_name %></td>
            <td class="mono"><%= r.invoice_number %></td>
            <td class="mono"><%= r.allocation_number || '—' %></td>
            <td><%= formatDate(r.invoice_date) %></td>
            <td class="right <%= r.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(r.total_amount) %></td>
            <td><span class="badge b-<%= r.invoice_status %>"><%= r.invoice_status %></span></td>
            <td class="mono"><%= r.check_number || '—' %></td>
            <td>
              <% if (r.payment_status) { %>
                <span class="badge b-<%= r.payment_status %>"><%= r.payment_status === 'issued' ? 'בחוץ' : r.payment_status === 'cleared' ? 'נפרע' : 'מבוטל' %></span>
                <% if (r.cleared_date) { %><br><span class="muted"><%= formatDate(r.cleared_date) %></span><% } %>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>
