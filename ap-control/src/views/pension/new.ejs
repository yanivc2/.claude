<%- include('../partials/header') %>
<h1>עובד חדש</h1>
<div class="card">
  <p class="muted">רישום עובד למעקב פנסיה. המערכת תחשב את מועד פתיחת התיק החוקי ותתריע לפני חריגה.</p>
  <% if (error) { %><div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div><% } %>

  <form class="stack" method="post" action="/pension">
    <div class="row">
      <div>
        <label>שם עובד *</label>
        <input name="name" required value="<%= values.name || '' %>" />
      </div>
      <div>
        <label>תחילת עבודה *</label>
        <input type="date" name="start_date" required value="<%= values.start_date || '' %>" />
      </div>
    </div>

    <div class="row">
      <div>
        <label>חברה</label>
        <select name="company_id">
          <option value="">— ללא —</option>
          <% companies.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= String(values.company_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label>חנות</label>
        <select name="store_id">
          <option value="">— ללא —</option>
          <% stores.forEach(function(st){ %>
            <option value="<%= st.id %>" <%= String(values.store_id) === String(st.id) ? 'selected' : '' %>><%= st.name %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <label class="radio" style="display:flex;align-items:center;gap:.5rem;margin-top:.6rem">
      <input type="checkbox" name="prior_pension" value="1" style="width:auto" <%= values.prior_pension === '1' ? 'checked' : '' %> />
      לעובד היה תיק פנסיה פעיל לפני הקליטה (מקצר את מועד הפתיחה לחוק)
    </label>

    <label>הערות</label>
    <textarea name="notes" rows="2"><%= values.notes || '' %></textarea>

    <div style="margin-top:1.1rem" class="actions">
      <button type="submit">שמור עובד</button>
      <a href="/pension" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
