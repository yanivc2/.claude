<%- include('partials/header') %>
<h1>אישורים</h1>
<p class="muted">ספקים חדשים שהוזנו וממתינים לאישור, ובקשות עריכה שהגישו משתמשים (מזכירה / מנהל). אשר לביצוע או דחה.</p>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-info"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<% var _pendingSuppliers = (typeof pendingSuppliers !== 'undefined' && pendingSuppliers) ? pendingSuppliers : []; %>
<div class="card">
  <h2 style="margin-top:0">ספקים ממתינים לאישור (<%= _pendingSuppliers.length %>)</h2>
  <p class="muted" style="margin:0 0 .6rem">ספק חדש נשמר כ<strong>ממתין</strong> עד לאישור — אפשר לרשום עליו חשבוניות, אך <strong>תשלום חסום</strong> עד שתאשר.</p>
  <% if (_pendingSuppliers.length === 0) { %>
    <p class="muted">אין ספקים ממתינים.</p>
  <% } else { %>
    <div class="table-scroll">
      <table>
        <thead><tr><th>ספק</th><th>ח.פ / ע.מ</th><th>טלפון</th><th>איש קשר</th><th class="no-print" data-nosort></th></tr></thead>
        <tbody>
          <% _pendingSuppliers.forEach(function(s){ %>
            <tr>
              <td><a href="/suppliers/<%= s.id %>"><%= s.name %></a></td>
              <td class="mono"><%= s.tax_id || '—' %></td>
              <td class="mono"><% if (s.phone) { %><a href="<%= telLink(s.phone) %>"><%= s.phone %></a><% } else { %>—<% } %></td>
              <td><%= s.contact_name || '—' %></td>
              <td class="no-print">
                <div class="actions" style="gap:.3rem;justify-content:flex-end">
                  <form method="post" action="/suppliers/<%= s.id %>/approve" style="display:inline">
                    <input type="hidden" name="return_to" value="/approvals" />
                    <button class="ok small" type="submit">אשר ספק</button>
                  </form>
                  <form method="post" action="/suppliers/<%= s.id %>/block" style="display:inline" onsubmit="return confirm('לחסום את הספק <%= s.name %>?')">
                    <input type="hidden" name="return_to" value="/approvals" />
                    <button class="danger small" type="submit">חסום</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0">ממתינות לאישור (<%= pending.length %>)</h2>
  <% if (pending.length === 0) { %>
    <p class="muted">אין בקשות ממתינות.</p>
  <% } %>
  <% pending.forEach(function(r){ %>
    <div style="border:1px solid var(--line);border-radius:8px;padding:.8rem;margin-bottom:.8rem">
      <div class="toolbar" style="margin-bottom:.4rem">
        <div>
          <strong><%= actionLabel(r.action) %></strong>
          <span class="muted">· מבקש: <%= r.requested_by_name || '—' %> · <%= formatDate(r.created_at) %></span>
        </div>
        <div class="actions no-print">
          <form method="post" action="/approvals/<%= r.id %>/approve" style="display:inline" onsubmit="return confirm('לאשר ולבצע את השינוי?')">
            <button class="ok small" type="submit">אשר ובצע</button>
          </form>
          <form method="post" action="/approvals/<%= r.id %>/reject" class="actions" style="display:inline-flex;gap:.3rem" onsubmit="return confirm('לדחות את הבקשה?')">
            <input name="note" placeholder="סיבת דחייה (לא חובה)" style="width:180px" />
            <button class="danger small" type="submit">דחה</button>
          </form>
        </div>
      </div>
      <div style="white-space:pre-line;background:var(--th-bg);border-radius:6px;padding:.6rem"><%= r.summary || '' %></div>
    </div>
  <% }); %>
</div>

<details class="section">
  <summary>היסטוריית בקשות</summary>
  <div class="section-body">
    <table class="sortable">
      <thead><tr><th>#</th><th>פעולה</th><th>מבקש</th><th>סטטוס</th><th>הוחלט</th><th>פרטים</th></tr></thead>
      <tbody>
        <% history.filter(function(r){return r.status!=='pending';}).forEach(function(r){ %>
          <tr>
            <td><%= r.id %></td>
            <td><%= actionLabel(r.action) %></td>
            <td><%= r.requested_by_name || '—' %></td>
            <td>
              <span class="badge <%= r.status === 'approved' ? 'b-approved' : 'b-blocked' %>"><%= r.status === 'approved' ? 'אושר' : 'נדחה' %></span>
            </td>
            <td class="muted"><%= r.decided_at || '' %></td>
            <td class="muted" style="white-space:pre-line"><%= r.result_summary || r.decision_note || r.summary || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</details>
<%- include('partials/footer') %>
