<%- include('../partials/header') %>
<div class="toolbar">
  <h1 style="margin:0">עריכת אמצעי תשלום #<%= payment.id %></h1>
  <a href="/payments/<%= payment.id %>" class="btn btn-secondary no-print">חזרה</a>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" style="background:var(--color-surface-2)">
  <div class="row">
    <div><span class="text-muted">חשבון בנק</span><br><%= payment.bank_account_name %></div>
    <div><span class="text-muted">סכום</span><br><strong><%= formatIls(payment.amount) %></strong></div>
    <div><span class="text-muted">סטטוס</span><br><%= payment.status === 'issued' ? 'הונפק' : payment.status === 'cleared' ? 'נפרע' : 'מבוטל' %></div>
  </div>
  <p class="muted" style="margin:.6rem 0 0">שיוך לחשבוניות:
    <% payment.lines.forEach(function(l, i){ %><%= i ? ' · ' : ' ' %><a href="/invoices/<%= l.invoice_id %>"><%= l.invoice_number %></a> (<%= l.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %>)<% }); %>
  </p>
  <% if (!(typeof canRetarget !== 'undefined' && canRetarget)) { %>
    <p class="muted" style="margin:.3rem 0 0">הסכום נגזר מהחשבוניות המשויכות. לשינוי החשבוניות/סכום — התשלום צריך להיות "הונפק" וללא התאמת בנק (בטל התאמה/פירעון קודם, או בטל וצור מחדש).</p>
  <% } %>
</div>

<div class="card">
  <form method="post" action="/payments/<%= payment.id %>/edit" class="stack" id="payedit">
    <div class="row">
      <div>
        <label>אמצעי תשלום</label>
        <select name="method" id="pe_method">
          <% var methods = [['check','צ׳ק'],['transfer','העברה'],['cash','מזומן'],['credit','אשראי'],['standing_order','הו"ק'],['batch','מקבץ']]; %>
          <% methods.forEach(function(m){ %><option value="<%= m[0] %>" <%= payment.method === m[0] ? 'selected' : '' %>><%= m[1] %></option><% }); %>
        </select>
      </div>
      <div><label>תאריך תשלום</label><input type="date" name="payment_date" value="<%= payment.payment_date || '' %>" required /></div>
    </div>

    <div class="pe-row" data-m="check"><label>מספר צ׳ק</label><input name="check_number" value="<%= payment.check_number || '' %>" /></div>
    <div class="pe-row" data-m="transfer"><label>מספר אסמכתה</label><input name="reference" value="<%= payment.method === 'transfer' || payment.method === 'standing_order' || payment.method === 'batch' ? (payment.reference || '') : '' %>" data-ref /></div>
    <div class="pe-row" data-m="standing_order"><label>מספר הרשאה / אסמכתא</label><input name="reference" data-ref /></div>
    <div class="pe-row" data-m="cash"><label>שולם ע"י</label><input name="payer_name" value="<%= payment.payer_name || '' %>" /></div>
    <div class="pe-row" data-m="credit"><label>4 ספרות אחרונות (לא חובה)</label><input name="card_last4" inputmode="numeric" maxlength="4" pattern="\d{4}" value="<%= payment.card_last4 || '' %>" /></div>
    <div class="pe-row" data-m="batch">
      <div class="row">
        <div><label>מספר מקבץ</label><input name="batch_number" value="<%= payment.batch_number || '' %>" /></div>
        <div><label>מספר אסמכתא</label><input name="reference" data-ref /></div>
      </div>
    </div>

    <% if (typeof canRetarget !== 'undefined' && canRetarget && candidates && candidates.length) { %>
      <h3 style="margin:1rem 0 .2rem">חשבוניות משויכות לתשלום</h3>
      <p class="muted" style="margin:0 0 .4rem">סמן את החשבוניות והזיכויים שהתשלום מכסה. <strong>סכום הצ׳ק יחושב אוטומטית</strong> כנטו של המסומנות (זיכוי מקזז). כך מצרפים זיכוי לצ׳ק קיים והסכום מתעדכן לסכום האמיתי.</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th data-nosort></th><th>מס'</th><th>תאריך</th><th>סוג</th><th class="right">סכום</th></tr></thead>
          <tbody>
            <% candidates.forEach(function(c){ %>
              <tr>
                <td><input type="checkbox" class="rt-check" name="invoice_ids" value="<%= c.id %>" data-amt="<%= c.total_amount %>" <%= c.applied ? 'checked' : '' %> style="width:auto;min-height:0" /></td>
                <td class="mono"><a href="/invoices/<%= c.id %>"><%= c.invoice_number %></a></td>
                <td><%= formatDate(c.invoice_date) %></td>
                <td><%= c.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %></td>
                <td class="right <%= c.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(c.total_amount) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot><tr><td colspan="4" class="right"><strong>נטו לצ׳ק (מסומנות)</strong></td><td class="right"><strong id="rtNet">₪0.00</strong></td></tr></tfoot>
        </table>
      </div>
    <% } %>

    <div style="margin-top:.6rem"><button type="submit">💾 שמור שינויים</button></div>
  </form>
</div>

<script>
  (function(){
    var sel = document.getElementById('pe_method');
    var refVal = <%- JSON.stringify(payment.reference || '') %>;
    function upd(){
      document.querySelectorAll('.pe-row').forEach(function(r){
        var on = r.dataset.m === sel.value;
        r.style.display = on ? 'block' : 'none';
        // only the visible method's reference input carries a name so exactly one is posted
        r.querySelectorAll('[data-ref]').forEach(function(inp){
          if (on) { inp.setAttribute('name', 'reference'); if (!inp.value) inp.value = (['transfer','standing_order','batch'].indexOf(sel.value) !== -1) ? refVal : ''; }
          else inp.removeAttribute('name');
        });
      });
    }
    sel.addEventListener('change', upd);
    upd();
  })();
  (function(){
    var checks = Array.prototype.slice.call(document.querySelectorAll('.rt-check'));
    var net = document.getElementById('rtNet'); if (!checks.length || !net) return;
    function fmt(ag){ var s = ag<0?'-':''; ag=Math.abs(ag); return '₪'+s+(Math.floor(ag/100)).toLocaleString('en-US')+'.'+String(ag%100).padStart(2,'0'); }
    function recalc(){ var sum=0; checks.forEach(function(c){ if(c.checked) sum+=parseInt(c.dataset.amt,10)||0; }); net.textContent = fmt(sum); }
    checks.forEach(function(c){ c.addEventListener('change', recalc); });
    recalc();
  })();
</script>
<%- include('../partials/footer') %>
