<%- include('../partials/header') %>
<% var statusLabel = filter === 'issued' ? 'בחוץ' : filter === 'cleared' ? 'נפרעו' : filter === 'voided' ? 'מבוטלים' : 'הכל'; %>
<% var cq = companyId || ''; var sq = storeId || ''; %>
<div class="toolbar">
  <h1>מרקורים</h1>
</div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-ok no-print"><%= notice %>
    <% if (/[1-9]/.test(String(notice).split('·')[1] || '')) { %>
      <a href="/reconciliation">הכרעה ידנית ›</a>
    <% } %>
  </div>
<% } %>

<details class="card collapse" open style="margin-top:1rem">
  <summary><span class="caret">▸</span> הצהרות הפקדה <span class="muted">(<%= (deposits || []).length %>)</span></summary>
  <p class="muted no-print" style="margin:.6rem 0 .2rem">הפקדות שהוצהרו בדוחות Z. "יתרה / חוסר" מתמלא בהתאמה אוטומטית לבנק לפי מספר שקית = מספר אסמכתה.</p>
  <div class="table-scroll">
  <table class="sortable">
    <thead><tr><th>מספר שקית</th><th class="right">סכום הפקדה</th><th>תאריך</th><th>שיוך ל-Z</th><th class="right">יתרה / חוסר</th><th>סטטוס</th><th class="no-print" data-nosort>פעולות</th></tr></thead>
    <tbody>
      <% if (!deposits || deposits.length === 0) { %><tr><td colspan="7" class="muted">אין הצהרות הפקדה.</td></tr><% } %>
      <% (deposits || []).forEach(function(d){ %>
        <tr>
          <td class="mono"><%= d.bag_number || '—' %></td>
          <td class="right"><%= formatIls(d.amount) %></td>
          <td><%= formatDate(d.deposit_date) %></td>
          <td>
            <% if (d.z_report_id) { %><a href="/reports/zreports/<%= d.z_report_id %>">Z <%= d.z_number || d.z_report_id %></a><% } else { %>—<% } %>
          </td>
          <td class="right">
            <% if (d.recon_diff == null) { %><span class="muted">—</span>
            <% } else if (d.recon_diff === 0) { %><span class="badge b-approved">מאוזן</span>
            <% } else if (d.recon_diff > 0) { %><span class="badge b-cleared">יתרה <%= formatIls(d.recon_diff) %></span>
            <% } else { %><span class="badge b-blocked">חוסר <%= formatIls(-d.recon_diff) %></span><% } %>
          </td>
          <td>
            <% if (d.deposited) { %><span class="badge b-approved">הופקד</span><% } else { %><span class="badge b-on_hold">לא הופקד</span><% } %>
          </td>
          <td class="no-print">
            <% if (typeof can === 'function' && can('manage_deposits')) { %>
              <% if (!d.deposited) { %>
                <form method="post" action="/reports/deposits/<%= d.id %>/deposited" style="display:inline"><input type="hidden" name="value" value="1" /><button class="ok small" type="submit">סמן כהופקד</button></form>
              <% } else if (currentUser.role === 'owner') { %>
                <form method="post" action="/reports/deposits/<%= d.id %>/deposited" style="display:inline" onsubmit="return confirm('לבטל את סימון ההפקדה?')"><input type="hidden" name="value" value="0" /><button class="danger small" type="submit">בטל</button></form>
              <% } else { %>
                <span class="muted" style="font-size:12px">ביטול — בעלים בלבד</span>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</details>

<details class="card collapse" style="margin-top:1rem">
  <summary><span class="caret">▸</span> צ׳קים <span class="muted">(<%= payments.length %>)</span></summary>
<p class="muted no-print" style="margin:.6rem 0 .2rem">לחיצה על כותרת עמודה ממיינת · שורת הסינון מתחת לכותרות מסננת לפי עמודה.</p>
<div class="table-scroll">
<table class="sortable" id="paymentsTable">
  <thead>
    <tr><th>אמצעי / מזהה</th><th>חנות</th><th>תאריך</th><th class="right">סכום</th><th data-nosort>סטטוס/פעולות</th></tr>
    <tr class="filter-row no-print">
      <th><input type="text" data-fcol="0" placeholder="סינון מזהה" aria-label="סינון מזהה" /></th>
      <th><input type="text" data-fcol="1" placeholder="סינון חנות" aria-label="סינון חנות" /></th>
      <th><input type="text" data-fcol="2" placeholder="סינון תאריך" aria-label="סינון תאריך" /></th>
      <th class="right"><input type="text" data-fcol="3" inputmode="decimal" placeholder="סינון סכום" aria-label="סינון סכום" /></th>
      <th data-nosort>
        <select id="fStatus" aria-label="סינון סטטוס">
          <option value="">הכל</option>
          <option value="paid">נפרע</option>
          <option value="unpaid">לא נפרע</option>
        </select>
      </th>
    </tr>
  </thead>
  <tbody>
    <% if (payments.length === 0) { %>
      <tr><td colspan="5" class="muted">אין צ׳קים להצגה.</td></tr>
    <% } %>
    <% payments.forEach(function(p){ %>
      <tr onclick="location='/payments/<%= p.id %>'" style="cursor:pointer">
        <td><%= paymentIdent(p) %></td>
        <td><%= p.store_name %></td>
        <td><%= formatDate(p.payment_date) %></td>
        <td class="right"><%= formatIls(p.amount) %></td>
        <td onclick="event.stopPropagation()">
          <% var autoCleared = p.status === 'cleared' && p.auto_cleared; %>
          <span class="badge <%= autoCleared ? 'b-cleared-auto' : ('b-' + p.status) %>"
                title="<%= autoCleared ? 'נפרע אוטומטית ע״י שיוך בהתאמת בנק' : (p.status === 'cleared' ? 'נפרע — סימון ידני' : '') %>"><%= p.status === 'issued' ? 'הונפק' : p.status === 'cleared' ? 'נפרע' : 'מבוטל' %></span>
          <% if (p.status === 'cleared' && p.cleared_date) { %> <span class="muted" style="font-size:12px"><%= formatDate(p.cleared_date) %></span><% } %>
          <% if (p.status === 'issued') { %>
            <div class="actions no-print" style="margin-top:5px">
              <form method="post" action="/payments/<%= p.id %>/clear" style="display:inline">
                <button class="ok small" type="submit">סמן כנפרע</button>
              </form>
              <% if (currentUser.role === 'owner') { %>
                <form method="post" action="/payments/<%= p.id %>/void" style="display:inline" onsubmit="return confirm('לבטל את הצ׳ק?')">
                  <button class="danger small" type="submit">בטל</button>
                </form>
              <% } %>
            </div>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <tr id="pmNoMatch" style="display:none"><td colspan="5" class="muted">אין תוצאות התואמות לסינון.</td></tr>
  </tbody>
</table>
</div>
<p class="muted no-print" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center">
  <span>"סמן כנפרע" מסמן בתאריך היום. ביטול צ׳ק — בעלים בלבד.</span>
  <span style="display:inline-flex;gap:6px;align-items:center"><span class="badge b-cleared">נפרע</span> = סימון ידני</span>
  <span style="display:inline-flex;gap:6px;align-items:center"><span class="badge b-cleared-auto">נפרע</span> = אוטומטי (שיוך בהתאמת בנק)</span>
</p>
</details>

<div class="no-print" style="display:flex;justify-content:center;gap:1.8rem;margin:1.6rem 0 .5rem;flex-wrap:wrap">
  <form method="post" action="/payments/auto-reconcile" style="margin:0;display:flex;flex-direction:column;align-items:center;gap:5px"
        title="התאמת צ׳קים פתוחים לתנועות בנק שיובאו (R7)">
    <input type="hidden" name="status" value="<%= filter %>" />
    <input type="hidden" name="company" value="<%= cq %>" />
    <input type="hidden" name="store" value="<%= sq %>" />
    <button class="round-btn" type="submit" aria-label="התאמה אוטומטית">⟳</button>
    <span class="muted" style="font-size:12px">התאמה אוטומטית</span>
  </form>
  <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
    <details class="menu up">
      <summary class="round-btn" style="list-style:none" aria-label="סינון">🔎</summary>
      <div class="menu-panel" style="min-width:250px; padding:12px">
        <form method="get" action="/payments">
          <label class="lbl">חברה</label>
          <select name="company" onchange="this.form.submit()">
            <option value="">כל החברות</option>
            <% companies.forEach(function(c){ %>
              <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
          <label class="lbl" style="margin-top:10px">חנות / חשבון בנק</label>
          <select name="store" onchange="this.form.submit()">
            <option value="">כל החנויות (הכל יחד)</option>
            <% stores.forEach(function(s){ %>
              <option value="<%= s.id %>" <%= storeId === s.id ? 'selected' : '' %>><%= s.name %><%= s.bank_account_name ? ' · ' + s.bank_account_name : '' %></option>
            <% }); %>
          </select>
          <input type="hidden" name="status" value="<%= filter %>" />
        </form>
        <div class="menu-sep"></div>
        <a href="/payments?status=&company=<%= cq %>&store=<%= sq %>" class="<%= !filter ? 'active' : '' %>">הכל</a>
        <a href="/payments?status=issued&company=<%= cq %>&store=<%= sq %>" class="<%= filter === 'issued' ? 'active' : '' %>">בחוץ</a>
        <a href="/payments?status=cleared&company=<%= cq %>&store=<%= sq %>" class="<%= filter === 'cleared' ? 'active' : '' %>">נפרעו</a>
        <a href="/payments?status=voided&company=<%= cq %>&store=<%= sq %>" class="<%= filter === 'voided' ? 'active' : '' %>">מבוטלים</a>
      </div>
    </details>
    <span class="muted" style="font-size:12px">סינון · <%= statusLabel %></span>
  </div>
</div>

<script>
  // סינון פר-עמודה בטבלת המרקורים: שדות טקסט לכל עמודה + בורר סטטוס נפרע/לא נפרע.
  // סינון בצד לקוח בלבד — מסתיר שורות שאינן תואמות, בלי לפנות לשרת.
  (function () {
    var table = document.getElementById('paymentsTable');
    if (!table || !table.tBodies[0]) return;
    var tbody = table.tBodies[0];
    var inputs = table.querySelectorAll('.filter-row input[data-fcol]');
    var statusSel = document.getElementById('fStatus');
    function norm(s) { return (s || '').toLowerCase().replace(/[₪,\s]/g, '').trim(); }
    function apply() {
      var terms = [];
      inputs.forEach(function (inp) {
        var v = norm(inp.value);
        if (v) terms.push({ col: +inp.getAttribute('data-fcol'), v: v });
      });
      var st = statusSel ? statusSel.value : '';
      var shown = 0;
      Array.prototype.forEach.call(tbody.rows, function (r) {
        if (r.querySelector('td[colspan]')) return; // שורת "אין תוצאות"
        var ok = true;
        for (var i = 0; i < terms.length && ok; i++) {
          var cell = r.cells[terms[i].col];
          if (!cell || norm(cell.textContent).indexOf(terms[i].v) === -1) ok = false;
        }
        if (ok && st) {
          // סטטוס נקבע לפי התגית עצמה (לא לפי טקסט הכפתור "סמן כנפרע").
          var paid = !!(r.cells[4] && r.cells[4].querySelector('.b-cleared, .b-cleared-auto'));
          if (st === 'paid' && !paid) ok = false;
          if (st === 'unpaid' && paid) ok = false;
        }
        r.style.display = ok ? '' : 'none';
        if (ok) shown += 1;
      });
      var empty = document.getElementById('pmNoMatch');
      if (empty) empty.style.display = shown === 0 ? '' : 'none';
    }
    inputs.forEach(function (inp) { inp.addEventListener('input', apply); });
    if (statusSel) statusSel.addEventListener('change', apply);
  })();
</script>
<%- include('../partials/footer') %>
