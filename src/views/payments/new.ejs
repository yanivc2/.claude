<%- include('../partials/header') %>
<h1>תשלום חדש</h1>
<p class="muted">
  בחר חשבוניות לתשלום (כולל זיכויים) מאותו חשבון בנק, בחר אמצעי תשלום, הזן את המזהה שלו ותאריך.
  המערכת מחשבת נטו ואוכפת: אין תשלום ללא חשבונית + מזהה (R1), סכום = סכום השורות (R5),
  ותקרת מזומן לפי חוק (<%= formatIls(cashCeilingAgorot) %>).
</p>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>
<% if (typeof addedNotice !== 'undefined' && addedNotice) { %>
  <div class="alert alert-info"><%= addedNotice %></div>
<% } %>
<% if (typeof activeStore !== 'undefined' && activeStore) { %>
  <p class="muted" style="font-size:13px">מוצגות חשבוניות של החנות הפעילה בלבד: <b><%= activeStore.name %></b>.</p>
<% } %>
<% const preId = (typeof preselectId !== 'undefined') ? preselectId : null; %>

<%
// group payable invoices by their (store's 1:1) bank account
const groups = {};
payable.forEach(function(i){
  const k = i.derived_bank_account_id;
  (groups[k] = groups[k] || { name: i.bank_account_name, id: k, rows: [] }).rows.push(i);
});
const groupList = Object.values(groups);
%>

<% if (groupList.length === 0) { %>
  <div class="card muted">אין חשבוניות מאושרות לתשלום. אשר חשבוניות תחילה במסך החשבוניות.</div>
<% } %>

<%# With no active store every account is listed, so the groups start COLLAPSED — otherwise the
    screen opens as one long wall of invoices. With an active store there is one group: open it. %>
<% var openByDefault = (typeof activeStore !== 'undefined' && activeStore) || groupList.length === 1; %>
<% groupList.forEach(function(g){ %>
  <div class="card no-collapse">
   <details data-accordion="paygrp" <%= openByDefault ? 'open' : '' %>>
    <summary style="cursor:pointer; font-weight:600; font-size:1.05rem">
      <%= g.name %> <span class="muted" style="font-weight:400">(<%= g.rows.length %> חשבוניות)</span>
    </summary>
    <form method="post" action="/payments" onsubmit="return validateCheck(this)">
      <input type="hidden" name="bank_account_id" value="<%= g.id %>" />
      <table>
        <thead>
          <tr><th></th><th>ספק</th><th>מס' חשבונית</th><th>תאריך</th><th>סוג</th><th class="right">סכום</th></tr>
        </thead>
        <tbody>
          <% g.rows.forEach(function(i){ %>
            <tr>
              <td><input type="checkbox" class="inv-check" name="invoice_ids" value="<%= i.id %>"
                         data-amount="<%= i.total_amount %>"
                         data-fam="<%= i.supplier_parent_id || i.supplier_id %>"
                         data-supplier="<%= i.supplier_name %>"
                         <%= preId === i.id ? 'checked' : '' %> onchange="recalc(this.form)" style="width:auto"></td>
              <td><%= i.supplier_name %></td>
              <td class="mono"><%= i.invoice_number %></td>
              <td><%= formatDate(i.invoice_date) %></td>
              <td><%= i.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %></td>
              <td class="right <%= i.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(i.total_amount) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="row" style="margin-top:.8rem">
        <div>
          <label>אמצעי תשלום *</label>
          <select name="method" onchange="onMethod(this.form)">
            <option value="check" <%= values.method === 'check' ? 'selected' : '' %>>צ׳ק</option>
            <option value="cash" <%= values.method === 'cash' ? 'selected' : '' %>>מזומן</option>
            <option value="credit" <%= values.method === 'credit' ? 'selected' : '' %>>אשראי</option>
            <option value="transfer" <%= values.method === 'transfer' ? 'selected' : '' %>>העברה</option>
            <option value="batch" <%= values.method === 'batch' ? 'selected' : '' %>>מקבץ</option>
          </select>
        </div>
        <div>
          <label>תאריך תשלום *</label>
          <input type="date" name="payment_date" required />
        </div>
        <div>
          <label>נטו לתשלום</label>
          <input class="net-display" readonly value="₪0.00" />
        </div>
        <div>
          <label>ספק</label>
          <input class="fam-hint" readonly value="" placeholder="— בחר חשבונית —" />
        </div>
      </div>

      <div class="row m-check">
        <div><label>מספר צ׳ק *</label><input name="check_number" /></div>
      </div>
      <div class="row m-cash" style="display:none">
        <div><label>שם המשלם *</label><input name="payer_name" /></div>
      </div>
      <div class="row m-credit" style="display:none">
        <div><label>4 ספרות אחרונות של האשראי *</label><input name="card_last4" maxlength="4" pattern="\d{4}" /></div>
      </div>
      <div class="row m-transfer" style="display:none">
        <div><label>מספר אסמכתא *</label><input name="reference" /></div>
      </div>
      <div class="row m-batch" style="display:none">
        <div><label>מספר מקבץ *</label><input name="batch_number" /></div>
        <div><label>מספר אסמכתא *</label><input name="reference" /></div>
      </div>

      <div style="margin-top:1rem" class="actions">
        <button type="submit">הנפק תשלום</button>
      </div>
    </form>
   </details>
  </div>
<% }); %>

<div class="card no-collapse">
  <details data-accordion="advpay">
    <summary style="cursor:pointer; font-weight:600">💰 תשלום על החשבון (ללא חשבונית עדיין)</summary>
    <p class="muted" style="font-size:13px; margin-top:.6rem">
      לכסף ששולם <b>לפני</b> שהתקבלה חשבונית — למשל 12 צ׳קים לשכירות שנמסרו מראש. הסכום נרשם
      כ"יתרה על החשבון" אצל הספק, וכשתגיע החשבונית (למשל עבור 3 חודשים) משייכים אותה לצ׳קים
      האלה מדף החשבונית. כל עוד לא שויכה — הכסף מופיע כיתרה פתוחה.
    </p>
    <form method="post" action="/payments" onsubmit="return validateAdvance(this)">
      <div class="row">
        <div>
          <label>חשבון בנק *</label>
          <select name="bank_account_id" required class="js-combo">
            <% accounts.forEach(function(a){ %><option value="<%= a.id %>"><%= a.display_name %></option><% }); %>
          </select>
        </div>
        <div>
          <label>ספק *</label>
          <select name="advance_supplier_id" required class="js-combo">
            <option value="">— בחר ספק —</option>
            <% suppliers.forEach(function(sp){ %><option value="<%= sp.id %>"><%= sp.name %></option><% }); %>
          </select>
        </div>
        <div>
          <label>סכום ששולם (₪) *</label>
          <input name="advance_amount" inputmode="decimal" required placeholder="5000" />
        </div>
      </div>
      <div class="row">
        <div>
          <label>אמצעי תשלום</label>
          <select name="method" onchange="onMethod(this.form)">
            <option value="check">צ׳ק</option>
            <option value="cash">מזומן</option>
            <option value="credit">אשראי</option>
            <option value="transfer">העברה</option>
            <option value="batch">מקבץ</option>
          </select>
        </div>
        <div>
          <label>תאריך תשלום *</label>
          <input type="date" name="payment_date" required />
        </div>
      </div>
      <div class="row m-check"><div><label>מספר צ׳ק *</label><input name="check_number" /></div></div>
      <div class="row m-cash" style="display:none"><div><label>שם המשלם *</label><input name="payer_name" /></div></div>
      <div class="row m-credit" style="display:none"><div><label>4 ספרות אחרונות *</label><input name="card_last4" maxlength="4" pattern="\d{4}" /></div></div>
      <div class="row m-transfer" style="display:none"><div><label>מספר אסמכתא *</label><input name="reference" /></div></div>
      <div class="row m-batch" style="display:none">
        <div><label>מספר מקבץ *</label><input name="batch_number" /></div>
        <div><label>מספר אסמכתא *</label><input name="reference" /></div>
      </div>
      <div style="margin-top:1rem" class="actions">
        <button type="submit">רשום תשלום על החשבון</button>
        <button type="submit" name="add_another" value="1" class="secondary">שמור והוסף עוד תשלום</button>
      </div>
    </form>
  </details>
</div>

<a href="/payments" class="btn secondary">חזרה לרשימת הצ׳קים</a>

<script>
var METHODS = ['check','cash','credit','transfer','batch'];
var CASH_CEILING = <%= cashCeilingAgorot %>;
function netOf(form){
  let net = 0;
  form.querySelectorAll('input[name="invoice_ids"]:checked').forEach(function(c){ net += Number(c.dataset.amount); });
  return net;
}
// One payment settles ONE supplier (or a supplier family — a subsidiary billed separately but
// paid with its parent). Once something is ticked, every other family is locked so the mistake
// can't be made at all; createPayment refuses it server-side regardless.
function lockFamily(form){
  const boxes = form.querySelectorAll('.inv-check');
  let fam = null, name = null;
  boxes.forEach(function(b){ if (b.checked && fam === null){ fam = b.dataset.fam; name = b.dataset.supplier; } });
  boxes.forEach(function(b){
    const other = fam !== null && b.dataset.fam !== fam;
    b.disabled = other && !b.checked;
    b.closest('tr').style.opacity = b.disabled ? '.45' : '';
    b.title = b.disabled ? 'תשלום אחד = ספק אחד. כבר נבחרה חשבונית של ' + name : '';
  });
  const hint = form.querySelector('.fam-hint');
  if (hint) hint.value = fam === null ? '' : name;
}
function recalc(form){
  lockFamily(form);
  const net = netOf(form);
  const disp = form.querySelector('.net-display');
  disp.value = '₪' + (net/100).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  disp.style.color = net <= 0 ? '#b3261e' : '';
  // Disable the cash option when over the legal ceiling.
  const sel = form.querySelector('select[name="method"]');
  const cashOpt = sel ? sel.querySelector('option[value="cash"]') : null;
  if (cashOpt){
    const over = CASH_CEILING > 0 && net > CASH_CEILING;
    cashOpt.disabled = over;
    if (over && sel.value === 'cash'){ sel.value = 'check'; onMethod(form); }
  }
}
// Show only the selected method's fields; disable inputs in hidden rows so they are not
// submitted (avoids duplicate `reference` names and stray values).
function onMethod(form){
  var method = form.querySelector('select[name="method"]').value;
  METHODS.forEach(function(m){
    var row = form.querySelector('.m-' + m);
    if (!row) return;
    var active = (m === method);
    row.style.display = active ? '' : 'none';
    row.querySelectorAll('input').forEach(function(inp){ inp.disabled = !active; });
  });
}
function validateCheck(form){
  const checked = form.querySelectorAll('input[name="invoice_ids"]:checked').length;
  if (checked === 0){ alert('בחר לפחות חשבונית אחת'); return false; }
  const method = form.querySelector('select[name="method"]').value;
  if (method === 'cash' && CASH_CEILING > 0 && netOf(form) > CASH_CEILING){
    alert('תשלום במזומן מוגבל ל-' + (CASH_CEILING/100).toLocaleString('en-US') + ' ₪ לפי חוק. בחר אמצעי אחר.');
    return false;
  }
  return true;
}
// The advance form has no invoices: it validates its own amount instead of a selection.
function validateAdvance(form){
  const amt = Number(String(form.advance_amount.value).replace(/[^\d.-]/g, ''));
  if (!(amt > 0)){ alert('הזן סכום חיובי'); return false; }
  const method = form.querySelector('select[name="method"]').value;
  if (method === 'cash' && CASH_CEILING > 0 && Math.round(amt*100) > CASH_CEILING){
    alert('תשלום במזומן מוגבל ל-' + (CASH_CEILING/100).toLocaleString('en-US') + ' ₪ לפי חוק. בחר אמצעי אחר.');
    return false;
  }
  return true;
}
// Apply the preselected method (from ?method=) and recalc (for a preselected invoice) on load.
// recalc() only applies to the invoice forms — the advance form has no .net-display.
document.querySelectorAll('form[action="/payments"]').forEach(function(f){
  onMethod(f);
  if (f.querySelector('.net-display')) recalc(f);
});
</script>
<%- include('../partials/footer') %>
