<%- include('../partials/header') %>
<div class="toolbar">
  <h1 style="margin:0">חשבונית חדשה</h1>
  <% if (typeof openInvoices !== 'undefined' && openInvoices && openInvoices.length) { %>
    <button type="button" class="btn btn-secondary no-print" onclick="document.getElementById('openInvDlg').showModal()">📎 צרף חשבונית פתוחה (<%= openInvoices.length %>)</button>
  <% } %>
</div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-ok"><%= notice %></div>
<% } %>

<% if (warnings && warnings.length) { %>
  <div class="alert alert-warn">
    <strong>אזהרות כפילות — ודא לפני המשך:</strong>
    <ul style="margin:0.4rem 0 0">
      <% warnings.forEach(function(w){ %><li>[<%= w.code %>] <%= w.message %></li><% }); %>
    </ul>
  </div>
<% } %>

<div class="card">
  <form class="stack" method="post" action="/invoices" enctype="multipart/form-data">
    <div class="row">
      <div>
        <label>ספק *</label>
        <select name="supplier_id" required class="js-combo" data-combo-ph="הקלד שם ספק לחיפוש…" data-combo-label="ספק">
          <option value="">— בחר ספק —</option>
          <% suppliers.forEach(function(s){ %>
            <option value="<%= s.id %>" <%= String(values.supplier_id) === String(s.id) ? 'selected' : '' %>>
              <%= s.name %><%= s.status !== 'approved' ? ' (' + (s.status === 'pending' ? 'ממתין' : 'חסום') + ')' : '' %>
            </option>
          <% }); %>
        </select>
        <p class="muted" style="margin:.3rem 0 0">ספק לא קיים? <a href="/suppliers/new">פתח ספק חדש</a></p>
      </div>
      <div>
        <label>חנות *</label>
        <select name="store_id" required>
          <option value="">— בחר חנות —</option>
          <% stores.forEach(function(st){ %>
            <option value="<%= st.id %>" <%= String(values.store_id) === String(st.id) ? 'selected' : '' %>>
              <%= st.name %> · <%= st.company_name %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="row">
      <div>
        <label>מספר חשבונית *</label>
        <input name="invoice_number" required value="<%= values.invoice_number || '' %>" />
      </div>
      <div>
        <label>מספר הקצאה (6 ספרות אחרונות, אם קיים)</label>
        <input name="allocation_number" maxlength="9" pattern="\d{6,}" inputmode="numeric" title="לפחות 6 ספרות" value="<%= values.allocation_number || '' %>" />
      </div>
      <div>
        <label>תאריך חשבונית *</label>
        <input type="date" name="invoice_date" required value="<%= values.invoice_date || '' %>" />
      </div>
    </div>

    <div class="row">
      <div>
        <label>סוג מסמך *</label>
        <select name="doc_type" required>
          <option value="tax_invoice" <%= values.doc_type === 'tax_invoice' ? 'selected' : '' %>>חשבונית מס</option>
          <option value="tax_invoice_receipt" <%= values.doc_type === 'tax_invoice_receipt' ? 'selected' : '' %>>חשבונית מס/קבלה</option>
          <option value="credit_note" <%= values.doc_type === 'credit_note' ? 'selected' : '' %>>חשבונית זיכוי</option>
        </select>
      </div>
      <div>
        <label>סכום כולל מע"מ (₪)</label>
        <input id="total_incl" class="input-hl-yellow" inputmode="decimal" value="" placeholder="מלא כאן או למטה" />
      </div>
    </div>
    <div class="row">
      <div>
        <label>סכום לפני מע"מ (₪) *</label>
        <input id="before_vat" name="amount_before_vat" inputmode="decimal" required value="<%= values.amount_before_vat || '' %>" />
      </div>
      <div>
        <label>מע"מ (₪)</label>
        <input id="vat_amount" name="vat_amount" inputmode="decimal" value="<%= values.vat_amount || '' %>" />
      </div>
      <div>
        <label>&nbsp;</label>
        <div class="muted" style="padding:.5rem 0">מע"מ <%= (vatRate*100).toFixed(0) %>% — מחושב אוטומטית</div>
      </div>
    </div>
    <p class="muted">מלא <strong>סכום כולל מע"מ</strong> או <strong>לפני מע"מ</strong> — השאר יחושב לבד. זיכוי יישמר כסכום שלילי. חשבונית זיכוי פטורה ממספר הקצאה.</p>
    <script>
      (function(){
        var RATE = <%= vatRate %>;
        var total = document.getElementById('total_incl');
        var before = document.getElementById('before_vat');
        var vat = document.getElementById('vat_amount');
        var round2 = function(n){ return Math.round(n*100)/100; };
        function fromTotal(){
          var t = parseFloat(total.value); if (isNaN(t)) return;
          var b = round2(t/(1+RATE)); before.value = b.toFixed(2); vat.value = round2(t-b).toFixed(2);
        }
        function fromBefore(){
          var b = parseFloat(before.value); if (isNaN(b)) return;
          var v = round2(b*RATE); vat.value = v.toFixed(2); total.value = round2(b+v).toFixed(2);
        }
        total.addEventListener('input', fromTotal);
        before.addEventListener('input', fromBefore);
        vat.addEventListener('input', function(){
          var b = parseFloat(before.value), v = parseFloat(vat.value);
          if (!isNaN(b) && !isNaN(v)) total.value = round2(b+v).toFixed(2);
        });
      })();
    </script>

    <% const carriedImage = (typeof uploadedImage !== 'undefined' && uploadedImage) ? uploadedImage : ''; %>
    <label>תמונת חשבונית (סריקה/צילום — לא חובה)</label>
    <input type="file" name="image" accept="image/*,application/pdf" />
    <% if (carriedImage) { %>
      <input type="hidden" name="uploaded_image" value="<%= carriedImage %>" />
      <p class="muted">קובץ צורף וישמר עם החשבונית. בחירת קובץ חדש תחליף אותו.</p>
    <% } %>

    <!-- אמצעי תשלום (לא חובה) — אם נבחר, ייווצר תשלום וישויך לחשבונית -->
    <div style="margin-top:1rem;padding-top:.8rem;border-top:1px solid var(--color-line)">
      <h3 style="margin:0 0 .2rem">אמצעי תשלום (לא חובה)</h3>
      <p class="muted" style="margin:0 0 .5rem">אם שילמת עבור החשבונית — בחר אמצעי והזן פרטים; התשלום ייווצר וישויך אוטומטית.</p>
      <label>אמצעי תשלום</label>
      <select name="pay_method" id="pay_method">
        <option value="" <%= !values.pay_method ? 'selected' : '' %>>— ללא —</option>
        <option value="check" <%= values.pay_method === 'check' ? 'selected' : '' %>>צ׳ק</option>
        <option value="transfer" <%= values.pay_method === 'transfer' ? 'selected' : '' %>>העברה</option>
        <option value="cash" <%= values.pay_method === 'cash' ? 'selected' : '' %>>מזומן</option>
        <option value="credit" <%= values.pay_method === 'credit' ? 'selected' : '' %>>אשראי</option>
        <option value="standing_order" <%= values.pay_method === 'standing_order' ? 'selected' : '' %>>הו"ק</option>
      </select>
      <div id="pay_amount_wrap" style="margin-top:.5rem;max-width:280px" hidden>
        <label>סכום התשלום (₪)</label>
        <input id="pay_amount_disp" readonly value="" />
        <small class="muted">מחושב אוטומטית מסכום החשבונית (תשלום = סכום החשבונית).</small>
      </div>
      <div class="pay-row" data-m="check">
        <div class="row">
          <div><label>מספר צ׳ק</label><input name="check_number" value="<%= values.check_number || '' %>" /></div>
          <div><label>תאריך פירעון</label><input type="date" name="check_due_date" value="<%= values.check_due_date || '' %>" /></div>
        </div>
      </div>
      <div class="pay-row" data-m="transfer">
        <div class="row">
          <div><label>מספר אסמכתה</label><input name="transfer_ref" value="<%= values.transfer_ref || '' %>" /></div>
          <div><label>תאריך פירעון</label><input type="date" name="transfer_date" value="<%= values.transfer_date || '' %>" /></div>
        </div>
      </div>
      <div class="pay-row" data-m="cash">
        <div class="row">
          <div><label>שולם ע"י</label><input name="cash_payer" value="<%= values.cash_payer || '' %>" /></div>
          <div><label>תאריך תשלום</label><input type="date" name="cash_date" value="<%= values.cash_date || '' %>" /></div>
          <div><label>סכום ששולם (₪)</label><input name="cash_amount" inputmode="decimal" value="<%= values.cash_amount || '' %>" /><small class="muted">הסכום שיירשם = סכום החשבונית</small></div>
        </div>
      </div>
      <div class="pay-row" data-m="credit">
        <div class="row">
          <div><label>4 ספרות אחרונות (לא חובה)</label><input name="card_last4" inputmode="numeric" maxlength="4" pattern="\d{4}" value="<%= values.card_last4 || '' %>" /></div>
          <div><label>תאריך חיוב</label><input type="date" name="credit_date" value="<%= values.credit_date || '' %>" /></div>
        </div>
      </div>
      <div class="pay-row" data-m="standing_order">
        <div class="row">
          <div><label>מספר הרשאה / אסמכתא</label><input name="so_ref" value="<%= values.so_ref || '' %>" /></div>
          <div><label>תאריך חיוב</label><input type="date" name="so_date" value="<%= values.so_date || '' %>" /></div>
        </div>
      </div>
      <script>
        (function(){
          var sel = document.getElementById('pay_method');
          var amtWrap = document.getElementById('pay_amount_wrap');
          var amtDisp = document.getElementById('pay_amount_disp');
          var before = document.getElementById('before_vat');
          var vat = document.getElementById('vat_amount');
          var total = document.getElementById('total_incl');
          function invoiceTotal(){
            var t = parseFloat(total && total.value);
            if (!isNaN(t)) return t;
            var b = parseFloat(before && before.value) || 0, v = parseFloat(vat && vat.value) || 0;
            return b + v;
          }
          function syncAmount(){ if (amtDisp){ var t = invoiceTotal(); amtDisp.value = t ? t.toFixed(2) : ''; } }
          function upd(){
            document.querySelectorAll('.pay-row').forEach(function(r){ r.style.display = (r.dataset.m === sel.value) ? 'block' : 'none'; });
            if (amtWrap) amtWrap.hidden = !sel.value; // הצג את סכום התשלום רק כשנבחר אמצעי
            syncAmount();
          }
          sel.addEventListener('change', upd);
          [before, vat, total].forEach(function(el){ if (el) el.addEventListener('input', syncAmount); });
          upd();
        })();
      </script>
    </div>

    <% if (warnings && warnings.length) { %>
      <input type="hidden" name="confirm" value="1" />
      <label>סיבת אישור למרות האזהרה *</label>
      <input name="confirm_reason" required placeholder="למשל: חשבונית חוזרת חודשית, לא כפילות" />
    <% } %>

    <div style="margin-top:1rem; flex-wrap:wrap" class="actions">
      <button type="submit" name="action" value="save"><%= warnings && warnings.length ? 'אשר ושמור בכל זאת' : 'שמור חשבונית' %></button>
      <button type="submit" name="action" value="add_another" class="btn secondary"><%= warnings && warnings.length ? 'אשר, שמור והוסף עוד' : 'שמור והוסף עוד לספק' %></button>
      <a href="/invoices" class="btn secondary">ביטול</a>
    </div>
    <p class="muted" style="margin:.4rem 0 0">"שמור והוסף עוד לספק" — שומר ופותח טופס ריק לאותו ספק/חנות, כדי להזין עוד חשבוניות (כולל זיכוי) ואז לשייך את כולן לתשלום למטה.</p>
  </form>
</div>

<% if (typeof batchInvoices !== 'undefined' && batchInvoices && batchInvoices.length) { %>
  <div class="card">
    <h2 style="margin:0 0 .3rem">שיוך לתשלום — <%= batchInvoices[0].supplier_name %> · <%= batchInvoices[0].store_name %></h2>
    <p class="muted" style="margin:0 0 .6rem">בחר את החשבוניות שברצונך לשלם יחד (זיכויים מקזזים) ובחר אמצעי תשלום. ייווצר תשלום אחד וישויך לכולן.</p>
    <form method="post" action="/invoices/pay-batch" class="stack">
      <input type="hidden" name="supplier_id" value="<%= batchInvoices[0].supplier_id %>" />
      <input type="hidden" name="store_id" value="<%= batchInvoices[0].store_id %>" />
      <table>
        <thead><tr><th data-nosort></th><th>מס'</th><th>תאריך</th><th>סוג</th><th class="right">סכום</th></tr></thead>
        <tbody>
          <% batchInvoices.forEach(function(iv){ %>
            <tr>
              <td><input type="checkbox" class="bp-check" name="invoice_ids" value="<%= iv.id %>" <%= (typeof pickIds !== 'undefined' && pickIds.indexOf(iv.id) !== -1) ? 'checked' : '' %> style="width:auto;min-height:0" /></td>
              <td class="mono"><a href="/invoices/<%= iv.id %>"><%= iv.invoice_number %></a></td>
              <td><%= formatDate(iv.invoice_date) %></td>
              <td><%= iv.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %></td>
              <td class="right <%= iv.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(iv.total_amount) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot><tr><td colspan="4" class="right"><strong>נטו לתשלום (מסומנות)</strong></td><td class="right"><strong id="bpNet"><%= formatIls(0) %></strong></td></tr></tfoot>
      </table>

      <label style="margin-top:.6rem">אמצעי תשלום</label>
      <select name="pay_method" id="bp_method">
        <option value="check">צ׳ק</option>
        <option value="transfer">העברה</option>
        <option value="cash">מזומן</option>
        <option value="credit">אשראי</option>
        <option value="standing_order">הו"ק</option>
      </select>
      <div class="bpay-row" data-m="check">
        <div class="row">
          <div><label>מספר צ׳ק</label><input name="check_number" /></div>
          <div><label>תאריך פירעון</label><input type="date" name="check_due_date" /></div>
        </div>
      </div>
      <div class="bpay-row" data-m="transfer">
        <div class="row">
          <div><label>מספר אסמכתה</label><input name="transfer_ref" /></div>
          <div><label>תאריך פירעון</label><input type="date" name="transfer_date" /></div>
        </div>
      </div>
      <div class="bpay-row" data-m="cash">
        <div class="row">
          <div><label>שולם ע"י</label><input name="cash_payer" /></div>
          <div><label>תאריך תשלום</label><input type="date" name="cash_date" /></div>
        </div>
      </div>
      <div class="bpay-row" data-m="credit">
        <div class="row">
          <div><label>4 ספרות אחרונות (לא חובה)</label><input name="card_last4" inputmode="numeric" maxlength="4" pattern="\d{4}" /></div>
          <div><label>תאריך חיוב</label><input type="date" name="credit_date" /></div>
        </div>
      </div>
      <div class="bpay-row" data-m="standing_order">
        <div class="row">
          <div><label>מספר הרשאה / אסמכתא</label><input name="so_ref" /></div>
          <div><label>תאריך חיוב</label><input type="date" name="so_date" /></div>
        </div>
      </div>
      <div style="margin-top:.8rem"><button type="submit">צור תשלום לחשבוניות המסומנות</button></div>
    </form>
  </div>
  <script>
    (function(){
      var sel = document.getElementById('bp_method');
      function upd(){ document.querySelectorAll('.bpay-row').forEach(function(r){ r.style.display = (r.dataset.m === sel.value) ? 'block' : 'none'; }); }
      sel.addEventListener('change', upd); upd();
      // live net of the checked rows
      var amounts = [<%- batchInvoices.map(function(iv){ return iv.total_amount; }).join(',') %>];
      var checks = Array.prototype.slice.call(document.querySelectorAll('.bp-check'));
      var net = document.getElementById('bpNet');
      function fmt(ag){ var s = ag<0?'-':''; ag=Math.abs(ag); return '₪'+s+(Math.floor(ag/100)).toLocaleString('en-US')+'.'+String(ag%100).padStart(2,'0'); }
      function recalc(){ var sum=0; checks.forEach(function(c,i){ if(c.checked) sum+=amounts[i]; }); net.textContent = fmt(sum); }
      checks.forEach(function(c){ c.addEventListener('change', recalc); });
      recalc();
    })();
  </script>
<% } %>

<%# "צרף חשבונית פתוחה" — pick open (payable, no-payment) invoices of ONE supplier to pay together. %>
<% if (typeof openInvoices !== 'undefined' && openInvoices && openInvoices.length) { %>
  <dialog id="openInvDlg" class="ndialog" onclick="event.stopPropagation()" style="max-width:640px">
    <div class="stack">
      <h3 style="margin:0">צרף חשבונית פתוחה לתשלום</h3>
      <p class="muted" style="margin:.2rem 0">כל החשבוניות הפתוחות (ללא אמצעי תשלום). סמן חשבוניות של <strong>אותו ספק</strong> (אפשר גם זיכויים) והמשך לתשלום מרוכז אחד.</p>
      <div class="table-scroll" style="max-height:50vh">
        <table>
          <thead><tr><th data-nosort></th><th>ספק</th><th>מס'</th><th>תאריך</th><th>סוג</th><th class="right">סכום</th></tr></thead>
          <tbody>
            <% openInvoices.forEach(function(iv){ %>
              <tr>
                <td><input type="checkbox" class="oi-check" value="<%= iv.id %>" data-sup="<%= iv.supplier_id %>" data-store="<%= iv.store_id %>" style="width:auto;min-height:0" /></td>
                <td><%= iv.supplier_name %></td>
                <td class="mono"><%= iv.invoice_number %></td>
                <td><%= formatDate(iv.invoice_date) %></td>
                <td><%= iv.doc_type === 'credit_note' ? 'זיכוי' : 'חשבונית' %></td>
                <td class="right <%= iv.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(iv.total_amount) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="muted" id="oiHint" style="margin:.2rem 0;min-height:1.2em"></p>
      <div class="actions" style="justify-content:flex-end">
        <button type="button" class="secondary" onclick="document.getElementById('openInvDlg').close()">ביטול</button>
        <button type="button" class="btn btn-primary" id="oiGo" disabled>המשך לתשלום מרוכז</button>
      </div>
    </div>
  </dialog>
  <script>
    (function(){
      var dlg = document.getElementById('openInvDlg'); if (!dlg) return;
      var boxes = Array.prototype.slice.call(dlg.querySelectorAll('.oi-check'));
      var go = document.getElementById('oiGo'), hint = document.getElementById('oiHint');
      function state(){
        var picked = boxes.filter(function(b){ return b.checked; });
        // enforce a single supplier+store — a payment can't span suppliers/accounts.
        var sup = picked.length ? picked[0].dataset.sup : null, store = picked.length ? picked[0].dataset.store : null;
        var mixed = picked.some(function(b){ return b.dataset.sup !== sup || b.dataset.store !== store; });
        boxes.forEach(function(b){ b.disabled = picked.length > 0 && (b.dataset.sup !== sup || b.dataset.store !== store); });
        if (!picked.length) { hint.textContent = ''; go.disabled = true; }
        else if (mixed) { hint.textContent = 'יש לבחור חשבוניות של אותו ספק בלבד.'; go.disabled = true; }
        else { hint.textContent = picked.length + ' חשבוניות נבחרו.'; go.disabled = false; }
        return { picked: picked, sup: sup, store: store };
      }
      boxes.forEach(function(b){ b.addEventListener('change', state); });
      go.addEventListener('click', function(){
        var s = state(); if (go.disabled) return;
        var ids = s.picked.map(function(b){ return b.value; }).join(',');
        location.href = '/invoices/new?supplier=' + encodeURIComponent(s.sup) + '&store=' + encodeURIComponent(s.store) + '&pick=' + encodeURIComponent(ids);
      });
    })();
  </script>
<% } %>
<%- include('../partials/footer') %>
