<%- include('../partials/header') %>
<h1>עריכת חשבונית #<%= invoice.id %></h1>
<p class="muted">עריכה זמינה עד לתשלום החשבונית. שינוי הסכומים מעדכן את הסכום הכולל אוטומטית.</p>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>

<div class="card">
  <form class="stack" method="post" action="/invoices/<%= invoice.id %>/edit">
    <div class="row">
      <div>
        <label>ספק *</label>
        <select name="supplier_id" required class="js-combo" data-combo-ph="הקלד שם ספק לחיפוש…" data-combo-label="ספק">
          <% suppliers.forEach(function(s){ %>
            <option value="<%= s.id %>" <%= String(values.supplier_id) === String(s.id) ? 'selected' : '' %>>
              <%= s.name %><%= s.status !== 'approved' ? ' (' + (s.status === 'pending' ? 'ממתין' : 'חסום') + ')' : '' %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label>חנות *</label>
        <select name="store_id" required>
          <% stores.forEach(function(st){ %>
            <option value="<%= st.id %>" <%= String(values.store_id) === String(st.id) ? 'selected' : '' %>>
              <%= st.name %> · <%= st.company_name %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="row">
      <div>
        <label>מספר חשבונית *</label>
        <input name="invoice_number" required value="<%= values.invoice_number || '' %>" />
      </div>
      <div>
        <label>מספר הקצאה (6 ספרות אחרונות, אם קיים)</label>
        <input name="allocation_number" maxlength="9" pattern="\d{6,}" inputmode="numeric" title="לפחות 6 ספרות" value="<%= values.allocation_number || '' %>" />
      </div>
      <div>
        <label>תאריך חשבונית *</label>
        <input type="date" name="invoice_date" required value="<%= values.invoice_date || '' %>" />
      </div>
    </div>

    <div class="row">
      <div>
        <label>סוג מסמך *</label>
        <select name="doc_type" required>
          <option value="tax_invoice" <%= values.doc_type === 'tax_invoice' ? 'selected' : '' %>>חשבונית מס</option>
          <option value="tax_invoice_receipt" <%= values.doc_type === 'tax_invoice_receipt' ? 'selected' : '' %>>חשבונית מס/קבלה</option>
          <option value="credit_note" <%= values.doc_type === 'credit_note' ? 'selected' : '' %>>חשבונית זיכוי</option>
        </select>
      </div>
      <div>
        <label>סכום כולל מע"מ (₪)</label>
        <input id="total_incl" inputmode="decimal" value="" placeholder="מלא כאן או למטה" />
      </div>
    </div>
    <div class="row">
      <div>
        <label>סכום לפני מע"מ (₪) *</label>
        <input id="before_vat" name="amount_before_vat" inputmode="decimal" required value="<%= values.amount_before_vat || '' %>" />
      </div>
      <div>
        <label>מע"מ (₪)</label>
        <input id="vat_amount" name="vat_amount" inputmode="decimal" value="<%= values.vat_amount || '' %>" />
      </div>
      <div>
        <label>&nbsp;</label>
        <div class="muted" style="padding:.5rem 0">מע"מ <%= (vatRate*100).toFixed(0) %>% — מחושב אוטומטית</div>
      </div>
    </div>
    <p class="muted">זיכוי יישמר כסכום שלילי. מספר החשבונית והסכומים ניתנים לעדכון.</p>
    <script>
      (function(){
        var RATE = <%= vatRate %>;
        var total = document.getElementById('total_incl');
        var before = document.getElementById('before_vat');
        var vat = document.getElementById('vat_amount');
        var round2 = function(n){ return Math.round(n*100)/100; };
        total.addEventListener('input', function(){
          var t = parseFloat(total.value); if (isNaN(t)) return;
          var b = round2(t/(1+RATE)); before.value = b.toFixed(2); vat.value = round2(t-b).toFixed(2);
        });
        before.addEventListener('input', function(){
          var b = parseFloat(before.value); if (isNaN(b)) return;
          var v = round2(b*RATE); vat.value = v.toFixed(2); total.value = round2(b+v).toFixed(2);
        });
      })();
    </script>

    <div style="margin-top:1rem" class="actions">
      <button type="submit">שמור שינויים</button>
      <a href="/invoices/<%= invoice.id %>" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
