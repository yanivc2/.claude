<%- include('../partials/header') %>
<%
function statusLabel(s){
  return s === 'recorded' ? 'נרשם'
    : s === 'on_hold' ? 'מוחזק'
    : s === 'approved_for_payment' ? 'מאושר לתשלום'
    : s === 'paid' ? 'שולם' : s;
}
var imgIsPdf = invoice.image_path && /\.pdf$/i.test(invoice.image_path);
var ocrData = (typeof ocr !== 'undefined') ? ocr : null;
var cmp = (typeof comparison !== 'undefined') ? comparison : null;
// R3: a tax invoice above the allocation threshold with no allocation number needs one.
var requiresAllocation = invoice.doc_type === 'tax_invoice'
  && Math.abs(invoice.amount_before_vat) > allocationThresholdAgorot
  && !invoice.allocation_number;
var ex = (ocrData && ocrData.extracted) || {};
var canApprove = (typeof can === 'function') && can('approve_payment');
var canHold = (typeof can === 'function') && can('hold_invoice');
var isManager = canApprove || canHold;              // בעלים / מנהל חנות
var payReq = (typeof pendingPayReq !== 'undefined') ? pendingPayReq : null;
var relReq = (typeof pendingReleaseReq !== 'undefined') ? pendingReleaseReq : null;
%>

<!-- כותרת: ללא מספר חשבונית; תגית הסטטוס משמאל, נלחצת לשינוי מצב -->
<div class="toolbar" style="align-items:center">
  <h1 style="margin:0">חשבונית</h1>
  <% if (invoice.status === 'paid') { %>
    <span class="status-pill b-paid">שולם</span>
  <% } else { %>
    <details class="menu open-in statusmenu no-print">
      <summary class="status-pill b-<%= invoice.status %>"><%= statusLabel(invoice.status) %> <span class="caret">▾</span></summary>
      <div class="menu-panel" style="min-width:230px">
        <div class="menu-cap">שינוי מצב החשבונית</div>
        <% if (invoice.status === 'on_hold') { %>
          <% if (isManager) { %>
            <form method="post" action="/invoices/<%= invoice.id %>/release"><button class="mi" type="submit">שחרר החזקה → נרשם</button></form>
          <% } else if (relReq) { %>
            <span class="mi disabled">בקשת שחרור ממתינה לאישור מנהל</span>
          <% } else { %>
            <form method="post" action="/invoices/<%= invoice.id %>/release"><button class="mi" type="submit">בקש שחרור מהמנהל</button></form>
          <% } %>
        <% } else if (isManager) { %>
          <form method="post" action="/invoices/<%= invoice.id %>/hold" class="pay-hold">
            <label class="hold-opt"><input type="radio" name="reason_type" value="credit" required> מחכה לזיכוי</label>
            <label class="hold-opt"><input type="radio" name="reason_type" value="review"> חשבונית בבירור</label>
            <div class="hold-remind">
              <label class="lbl">תזכורת בפוש בתאריך</label>
              <input type="date" name="remind_date" />
            </div>
            <label class="hold-opt"><input type="radio" name="reason_type" value="not_now"> לא לתשלום כרגע</label>
            <button class="btn btn-secondary btn-sm btn-block" type="submit" style="margin-top:6px">החזק חשבונית</button>
          </form>
        <% } else { %>
          <span class="mi disabled">שינוי מצב — נדרשת הרשאת מנהל/בעלים</span>
        <% } %>
      </div>
    </details>
  <% } %>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (invoice.status === 'on_hold' && invoice.hold_reason) { %><div class="alert alert-warn"><strong>מוחזק:</strong> <%= invoice.hold_reason %></div><% } %>
<% if (payReq) { %><div class="alert alert-info">בקשת אישור תשלום ממתינה<% if (isManager) { %> — אפשר לאשר בכפתור למטה<% } else { %> לאישור מנהל/בעלים<% } %>.</div><% } %>
<% if (requiresAllocation) { %><div class="alert alert-error"><strong>נדרש מספר הקצאה</strong> — חשבונית מס מעל <%= formatIls(allocationThresholdAgorot) %> ללא מספר הקצאה. הזן מספר הקצאה בכפתור למטה.</div><% } %>

<% if (typeof cashPayments !== 'undefined' && cashPayments && cashPayments.length) { %>
  <div class="alert alert-ok">
    <strong>שולם במזומן</strong> —
    <% cashPayments.forEach(function(cp, i){ %><%= i ? ' · ' : '' %><%= formatIls(cp.amount) %> בדוח <a href="/reports/zreports/<%= cp.z_report_id %>">Z <%= cp.z_number %></a> (<%= formatDate(cp.z_date) %>)<% }); %>
  </div>
<% } %>

<!-- פרטי החשבונית -->
<div class="card" style="<%= requiresAllocation ? 'border-color:var(--color-bad)' : '' %>">
  <div class="row">
    <div><span class="text-muted">מספר חשבונית</span><br><span class="mono"><%= invoice.invoice_number || '—' %></span></div>
    <div><span class="text-muted">ספק</span><br><%= invoice.supplier_name %>
      <% if (invoice.supplier_status !== 'approved') { %><span class="badge b-<%= invoice.supplier_status %>">ספק <%= invoice.supplier_status === 'pending' ? 'ממתין לאישור' : 'חסום' %></span><% } %>
    </div>
    <div><span class="text-muted">חנות</span><br><%= invoice.store_name %></div>
    <div><span class="text-muted">תאריך</span><br><%= formatDate(invoice.invoice_date) %></div>
  </div>
  <div class="row" style="margin-top:.8rem">
    <div><span class="text-muted">מספר הקצאה</span><br><span class="mono <%= requiresAllocation ? 'neg' : '' %>"><%= invoice.allocation_number || '— חסר' %></span></div>
    <div><span class="text-muted">סוג</span><br><%= invoice.doc_type === 'credit_note' ? 'זיכוי' : invoice.doc_type === 'tax_invoice_receipt' ? 'חשבונית מס/קבלה' : 'חשבונית מס' %></div>
    <div><span class="text-muted">סה"כ</span><br><strong class="<%= invoice.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(invoice.total_amount) %></strong>
      <span class="text-muted" style="font-size:12px">(לפני מע"מ <%= formatIls(invoice.amount_before_vat) %> · מע"מ <%= formatIls(invoice.vat_amount) %>)</span>
    </div>
  </div>
</div>

<!-- כפתורי עיגול: OCR (שמאל) · תמונת חשבונית (ימין) -->
<div class="card no-print" style="display:flex; gap:var(--space-8); align-items:flex-start">
  <div class="icon-tile">
    <button type="button" class="icon-circle" onclick="document.getElementById('imgDlg').showModal()" aria-label="תמונת חשבונית" title="תמונת חשבונית">
      <svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 12h5M9.5 15.5h5M9.5 8.5h2"/></svg>
    </button>
    <span class="cap">תמונת חשבונית</span>
  </div>
  <% if (invoice.image_path && !imgIsPdf) { %>
    <div class="icon-tile">
      <button type="button" class="icon-circle accent" onclick="document.getElementById('ocrDlg').showModal()" aria-label="OCR" title="קריאת OCR">
        <svg viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 011-1h3M20 8V5a1 1 0 00-1-1h-3M4 16v3a1 1 0 001 1h3M20 16v3a1 1 0 01-1 1h-3"/><path d="M7.5 12h9"/></svg>
      </button>
      <span class="cap">OCR</span>
    </div>
  <% } %>
</div>

<% if (invoice.payment) { %>
  <div class="card">
    <h2 style="margin-top:0">תשלום</h2>
    <p>שולם ב<%= methodLabel(invoice.payment.method || 'check') %> <a href="/payments/<%= invoice.payment.id %>"><span class="mono"><%= invoice.payment.check_number || '' %></span></a>
      מתאריך <%= formatDate(invoice.payment.payment_date) %> —
      <span class="badge b-<%= invoice.payment.payment_status %>"><%= invoice.payment.payment_status === 'issued' ? 'הונפק' : invoice.payment.payment_status === 'cleared' ? 'נפרע' : 'מבוטל' %></span>
      <% if (invoice.payment.cleared_date) { %> · נפרע ב-<%= formatDate(invoice.payment.cleared_date) %><% } %>
    </p>
  </div>
<% } %>

<!-- כפתור תשלום / אישור — ללא כותרת, נפתח למעלה-שמאלה. תשלום נפתח רק לאחר אישור מבעלים/מנהל. -->
<% if (invoice.status !== 'paid') { %>
  <% var overCash = cashCeilingAgorot > 0 && Math.abs(invoice.total_amount) > cashCeilingAgorot; %>
  <%
    // בעלים/מנהל משלמים ישירות (הם ממילא מאשרים). מזכירה — רק דרך בקשת אישור.
    var canPayNow = !requiresAllocation && invoice.status !== 'on_hold'
      && (invoice.status === 'approved_for_payment' || isManager);
    var payLabel = (invoice.status === 'approved_for_payment' || isManager) ? 'תשלום' : 'בקשת אישור תשלום';
  %>
  <div class="card no-print" style="display:flex; justify-content:flex-start">
    <details class="menu up">
      <summary class="btn btn-primary"><%= payLabel %> <span class="caret">▾</span></summary>
      <div class="menu-panel" style="min-width:260px">

        <% if (requiresAllocation) { %>
          <form method="post" action="/invoices/<%= invoice.id %>/allocation" style="padding:8px 12px">
            <label class="lbl" style="color:var(--color-bad)">נדרש מספר הקצאה (9 ספרות)</label>
            <input name="allocation_number" maxlength="9" pattern="\d{9}" placeholder="9 ספרות" required />
            <button class="btn btn-secondary btn-sm btn-block" type="submit" style="margin-top:6px">שמור הקצאה</button>
          </form>
          <div class="menu-sep"></div>
        <% } %>

        <% if (invoice.status === 'on_hold') { %>
          <span class="mi disabled">החשבונית מוחזקת — יש לשחרר אותה (בתגית הסטטוס) לפני תשלום.</span>
        <% } else if (requiresAllocation) { %>
          <span class="mi disabled">הזן מספר הקצאה כדי לאפשר תשלום.</span>
        <% } else if (canPayNow) { %>
          <!-- מאושר לתשלום, או בעלים/מנהל שמשלמים ישירות → אמצעי תשלום -->
          <% if (payReq && isManager && invoice.status !== 'approved_for_payment') { %>
            <form method="post" action="/invoices/<%= invoice.id %>/approve"><button class="mi" type="submit">אשר את הבקשה (בלי לשלם עכשיו)</button></form>
            <div class="menu-sep"></div>
          <% } %>
          <a href="/payments/new?invoice=<%= invoice.id %>&method=check">צ׳ק</a>
          <a href="/payments/new?invoice=<%= invoice.id %>&method=credit">אשראי</a>
          <a href="/payments/new?invoice=<%= invoice.id %>&method=transfer">העברה</a>
          <% if (overCash) { %>
            <span class="mi disabled" title="מעל תקרת המזומן">מזומן ✕ (מעל התקרה)</span>
          <% } else { %>
            <a href="/payments/new?invoice=<%= invoice.id %>&method=cash">מזומן</a>
          <% } %>
        <% } else if (payReq) { %>
          <span class="mi disabled">בקשת אישור תשלום נשלחה וממתינה לאישור מנהל/בעלים.</span>
        <% } else if (!invoice.image_path) { %>
          <span class="mi disabled">יש לצרף צילום של החשבונית לפני בקשת אישור תשלום.</span>
        <% } else { %>
          <form method="post" action="/invoices/<%= invoice.id %>/request-payment"><button class="mi" type="submit">בקש אישור תשלום מהמנהל</button></form>
        <% } %>
      </div>
    </details>
  </div>
<% } %>

<!-- פירוט שורות — קיים רק לחשבונית שנקלטה מצילום (קריאה בלבד) -->
<% var invLines = (typeof lines !== 'undefined' && lines) ? lines : []; %>
<% if (invLines.length) { %>
  <div class="card">
    <h2 style="margin:0 0 .6rem">פירוט שורות</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>מוצר</th><th>ברקוד</th><th>מק"ט</th><th class="right">כמות</th><th class="right">כ.בודד</th><th class="right">מחיר לארגז</th><th class="right">מחיר ליחידה</th><th class="right">סה"כ שורה</th></tr>
        </thead>
        <tbody>
          <% var linesTotal = 0; %>
          <% invLines.forEach(function(l){ linesTotal += l.line_total || 0; %>
            <tr>
              <td>
                <% if (l.product_id) { %><a href="/products/<%= l.product_id %>"><%= l.name %></a><% } else { %><%= l.name %><% } %>
              </td>
              <td class="mono"><%= l.barcode || '—' %></td>
              <td class="mono"><%= l.sku || '—' %></td>
              <td class="right"><%= l.quantity === null || l.quantity === undefined ? '—' : l.quantity %></td>
              <td class="right"><%= l.unit_quantity === null || l.unit_quantity === undefined ? '—' : l.unit_quantity %></td>
              <td class="right"><%= l.pack_cost === null || l.pack_cost === undefined ? '—' : formatIls(l.pack_cost) %></td>
              <td class="right"><%= l.unit_cost === null || l.unit_cost === undefined ? '—' : formatIls(l.unit_cost) %><%= l.unit_cost_source === 'computed' ? ' *' : '' %></td>
              <td class="right <%= l.line_total < 0 ? 'neg' : '' %>"><%= formatIls(l.line_total) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr><td colspan="7" class="right"><strong>סה"כ שורות</strong></td><td class="right"><strong><%= formatIls(linesTotal) %></strong></td></tr>
        </tfoot>
      </table>
    </div>
    <p class="text-muted" style="font-size:12px;margin:.5rem 0 0">* מחיר ליחידה שחושב מסה"כ נטו חלקי כ.בודד (או חלקי הכמות כשאין כ.בודד).</p>
  </div>
<% } %>

<!-- עמודי הסריקה שממנה נקלטה החשבונית -->
<% var invScanPages = (typeof scanPages !== 'undefined' && scanPages) ? scanPages : []; %>
<% if (invScanPages.length) { %>
  <div class="card no-print">
    <h2 style="margin:0 0 .6rem">עמודי הסריקה</h2>
    <div class="scan-thumbs">
      <% invScanPages.forEach(function(ref, i){ %>
        <% if (/\.pdf$/i.test(ref)) { %>
          <a class="scan-thumb" href="/invoices/<%= invoice.id %>/scan-image/<%= i %>" target="_blank" rel="noopener">
            <div class="scan-thumb-pdf">📄</div><span class="scan-thumb-no"><%= i+1 %></span>
          </a>
        <% } else { %>
          <button type="button" class="scan-thumb" data-scanimg="/invoices/<%= invoice.id %>/scan-image/<%= i %>">
            <img src="/invoices/<%= invoice.id %>/scan-image/<%= i %>" alt="עמוד <%= i+1 %>" /><span class="scan-thumb-no"><%= i+1 %></span>
          </button>
        <% } %>
      <% }); %>
    </div>
  </div>
  <dialog id="scanDlg" class="dlg wide">
    <div class="dlg-head">
      <strong>עמוד סריקה</strong>
      <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
    </div>
    <img id="scanDlgSrc" src="" alt="עמוד סריקה" style="max-width:100%;max-height:74vh;border:1px solid var(--color-line);border-radius:var(--radius-md)" />
  </dialog>
  <script>
  (function(){
    var dlg = document.getElementById('scanDlg'), img = document.getElementById('scanDlgSrc');
    document.querySelectorAll('.scan-thumb[data-scanimg]').forEach(function(b){
      b.addEventListener('click', function(){ img.src = b.dataset.scanimg; dlg.showModal(); });
    });
  })();
  </script>
<% } %>

<!-- שורת פעולות: אפשרויות (עריכה) + חזרה לרשימה משמאלו -->
<div class="card no-print" style="display:flex; justify-content:flex-start; gap:var(--space-3)">
  <% if (invoice.status !== 'paid' && typeof can === 'function' && can('edit_invoice')) { %>
    <details class="menu up">
      <summary class="btn btn-secondary">אפשרויות <span class="caret">▾</span></summary>
      <div class="menu-panel" style="min-width:180px">
        <a href="/invoices/<%= invoice.id %>/edit">ערוך חשבונית</a>
      </div>
    </details>
  <% } %>
  <a href="/invoices" class="btn btn-secondary">חזרה לרשימה</a>
  <a href="/invoices/new" class="btn btn-primary">+ חשבונית חדשה</a>
</div>

<!-- מודל תמונת החשבונית -->
<dialog id="imgDlg" class="dlg wide">
  <div class="dlg-head">
    <strong>תמונת חשבונית</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <!-- קלט קובץ נסתר; ההעלאה/החלפה מתבצעת דרך הכפתור העגול (עיבוד לשחור-לבן לפני השמירה) -->
  <form method="post" action="/invoices/<%= invoice.id %>/image" enctype="multipart/form-data" class="bw-form">
    <input id="imgFile" type="file" name="image" accept="image/*,application/pdf" hidden />
  </form>
  <% if (invoice.image_path) { %>
    <% if (imgIsPdf) { %>
      <p><a href="/invoices/<%= invoice.id %>/image" target="_blank" class="btn btn-secondary">פתח קובץ PDF</a></p>
    <% } else { %>
      <a href="/invoices/<%= invoice.id %>/image" target="_blank"><img src="/invoices/<%= invoice.id %>/image" alt="תמונת חשבונית" style="max-width:100%;max-height:56vh;border:1px solid var(--color-line);border-radius:var(--radius-md)" /></a>
    <% } %>
    <!-- כפתור עיגול להעלאה/החלפה (ימין) + כפתור מאוחד לתמונה (שמאלו): החלף / מחק -->
    <div style="display:flex;gap:var(--space-6);align-items:flex-start;margin-top:var(--space-3)">
      <div class="icon-tile">
        <button type="button" class="icon-circle accent" onclick="document.getElementById('imgFile').click()" aria-label="החלף תמונה" title="החלף תמונה">
          <svg viewBox="0 0 24 24"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M5 15v3a2 2 0 002 2h10a2 2 0 002-2v-3"/></svg>
        </button>
        <span class="cap">החלף תמונה</span>
      </div>
      <div class="icon-tile">
        <details class="menu">
          <summary class="btn btn-secondary btn-sm">תמונה <span class="caret">▾</span></summary>
          <div class="menu-panel" style="min-width:170px">
            <button type="button" onclick="document.getElementById('imgFile').click()">החלף תמונה</button>
            <form method="post" action="/invoices/<%= invoice.id %>/image/delete" onsubmit="return confirm('למחוק את תמונת החשבונית?')">
              <button type="submit" class="danger">מחק תמונה</button>
            </form>
          </div>
        </details>
        <span class="cap">פעולות</span>
      </div>
    </div>
    <p class="text-muted" style="font-size:12px;margin-top:8px">התמונה מעובדת אוטומטית לשחור-לבן ברור לפני השמירה.</p>
  <% } else { %>
    <div class="icon-tile" style="margin:var(--space-2) auto 0">
      <button type="button" class="icon-circle accent" onclick="document.getElementById('imgFile').click()" aria-label="העלאת חשבונית" title="העלאת חשבונית">
        <svg viewBox="0 0 24 24"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M5 15v3a2 2 0 002 2h10a2 2 0 002-2v-3"/></svg>
      </button>
      <span class="cap">העלאת חשבונית</span>
    </div>
    <p class="text-muted" style="font-size:12px;margin-top:10px;text-align:center">צלם/י או בחר/י קובץ. התמונה מעובדת אוטומטית לשחור-לבן ברור לפני השמירה.</p>
  <% } %>
</dialog>

<!-- מודל OCR -->
<dialog id="ocrDlg" class="dlg wide">
  <div class="dlg-head">
    <strong>OCR — קריאה מהתמונה</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <% if (!ocrData) { %>
    <p class="text-muted">הרץ OCR כדי לקרוא את השדות מהתמונה. OCR משמש לתמיכה בלבד ואינו דורס נתונים ללא אישורך.</p>
    <form method="post" action="/invoices/<%= invoice.id %>/ocr"><button class="btn btn-primary" type="submit">הרץ OCR</button></form>
  <% } else { %>
    <% if (cmp && cmp.hasMismatch) { %><div class="alert alert-warn">נמצאו אי-התאמות בין הקריאה למה שהוקלד.</div><% } %>
    <p class="text-muted" style="font-size:13px">לחץ על שדה כדי לתקן אותו, ואז "אישור" כדי להחיל על החשבונית.</p>
    <form method="post" action="/invoices/<%= invoice.id %>/ocr/apply">
      <div class="row">
        <div class="field"><label>מספר הקצאה<% if (ex.allocationNumber) { %> · OCR זיהה <span class="mono"><%= ex.allocationNumber %></span><% } %></label><input name="allocation_number" maxlength="9" pattern="\d{9}" value="<%= ex.allocationNumber || invoice.allocation_number || '' %>" /></div>
        <div class="field"><label>תאריך</label><input name="invoice_date" type="date" value="<%= invoice.invoice_date %>" /></div>
      </div>
      <div class="row">
        <div class="field"><label>לפני מע"מ (₪)</label><input name="amount_before_vat" value="<%= fromAgorot(Math.abs(invoice.amount_before_vat)) %>" /></div>
        <div class="field"><label>מע"מ (₪)</label><input name="vat_amount" value="<%= fromAgorot(Math.abs(invoice.vat_amount)) %>" /></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:var(--space-2)">
        <button class="btn btn-primary" type="submit">אישור</button>
        <button class="btn btn-danger" type="submit" formaction="/invoices/<%= invoice.id %>/ocr/delete" formnovalidate onclick="return confirm('למחוק את תוצאת ה-OCR?')">מחק OCR</button>
      </div>
    </form>
    <% if (cmp) { %>
      <details style="margin-top:var(--space-3)">
        <summary class="text-muted">השוואה מלאה + טקסט גולמי</summary>
        <table style="margin-top:8px"><thead><tr><th>שדה</th><th>הוקלד</th><th>OCR</th></tr></thead><tbody>
          <% cmp.rows.forEach(function(r){ %>
            <tr><td><%= r.label %></td>
              <td><%= r.kind === 'money' ? (r.typed == null ? '—' : formatIls(r.typed)) : (r.typed || '—') %></td>
              <td><%= r.kind === 'money' ? (r.ocr == null ? '—' : formatIls(r.ocr)) : (r.ocr || '—') %></td></tr>
          <% }); %>
        </tbody></table>
        <pre style="white-space:pre-wrap;background:var(--color-surface-2);border:1px solid var(--color-line);border-radius:var(--radius-md);padding:.6rem;max-height:200px;overflow:auto;margin-top:8px"><%= ocrData.raw_text %></pre>
      </details>
    <% } %>
  <% } %>
</dialog>

<script>
// עיבוד תמונה בצד הלקוח: גווני-אפור + ניגודיות → שחור-לבן ברור, לפני ההעלאה. PDF עובר כמו שהוא.
function bwProcess(file, cb){
  if(!file || !/^image\//.test(file.type)) { cb(file); return; }
  var url = URL.createObjectURL(file), img = new Image();
  img.onload = function(){
    var maxD = 2000, w = img.naturalWidth, h = img.naturalHeight;
    var s = Math.min(1, maxD / Math.max(w, h)); w = Math.round(w*s); h = Math.round(h*s);
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    var ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0, w, h);
    var d = ctx.getImageData(0, 0, w, h), p = d.data, k = 1.45, b = 128*(1-k);
    for(var i=0;i<p.length;i+=4){
      var g = 0.299*p[i] + 0.587*p[i+1] + 0.114*p[i+2];
      g = g*k + b; g = g<0?0:g>255?255:g;
      p[i] = p[i+1] = p[i+2] = g;
    }
    ctx.putImageData(d, 0, 0); URL.revokeObjectURL(url);
    c.toBlob(function(blob){
      if(!blob){ cb(file); return; }
      cb(new File([blob], 'invoice-bw.jpg', { type:'image/jpeg' }));
    }, 'image/jpeg', 0.9);
  };
  img.onerror = function(){ URL.revokeObjectURL(url); cb(file); };
  img.src = url;
}
document.querySelectorAll('form.bw-form').forEach(function(form){
  var inp = form.querySelector('input[type=file][name=image]');
  if(!inp) return;
  // בחירת קובץ (מהכפתור העגול) → שליחה אוטומטית
  inp.addEventListener('change', function(){
    if(inp.files && inp.files.length){ form.requestSubmit ? form.requestSubmit() : form.submit(); }
  });
  form.addEventListener('submit', function(e){
    if(form.__bwDone) return;
    var f = inp.files && inp.files[0];
    if(!f || !/^image\//.test(f.type)) return; // PDF/ריק → שליחה רגילה
    e.preventDefault();
    bwProcess(f, function(nf){
      try { var dt = new DataTransfer(); dt.items.add(nf); inp.files = dt.files; } catch(_){}
      form.__bwDone = true; form.submit();
    });
  });
});
</script>

<% if (typeof ocrOpen !== 'undefined' && ocrOpen) { %>
  <script>var d=document.getElementById('ocrDlg'); if(d) d.showModal();</script>
<% } %>
