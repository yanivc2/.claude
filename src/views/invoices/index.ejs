<%- include('../partials/header') %>
<% var filterLabel = filter === 'recorded' ? 'נרשמו' : filter === 'on_hold' ? 'מוחזקות' : filter === 'approved_for_payment' ? 'מאושרות לתשלום' : filter === 'unpaid' ? 'לא שולמו' : filter === 'paid' ? 'שולמו' : 'הכל'; %>
<div class="toolbar">
  <h1>חשבוניות</h1>
  <div class="actions no-print">
    <details class="menu">
      <summary class="btn btn-secondary">סינון · <%= filterLabel %> <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/invoices" class="<%= !filter ? 'active' : '' %>">הכל</a>
        <a href="/invoices?status=recorded" class="<%= filter === 'recorded' ? 'active' : '' %>">נרשמו</a>
        <a href="/invoices?status=on_hold" class="<%= filter === 'on_hold' ? 'active' : '' %>">מוחזקות</a>
        <a href="/invoices?status=approved_for_payment" class="<%= filter === 'approved_for_payment' ? 'active' : '' %>">מאושרות לתשלום</a>
        <a href="/invoices?status=unpaid" class="<%= filter === 'unpaid' ? 'active' : '' %>">לא שולמו</a>
        <a href="/invoices?status=paid" class="<%= filter === 'paid' ? 'active' : '' %>">שולמו</a>
      </div>
    </details>
    <details class="menu">
      <summary class="btn btn-primary">+ חשבונית חדשה <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/invoices/new">+ חשבונית חדשה</a>
        <div class="menu-sep"></div>
        <a href="/payments/new?method=transfer">+ תשלום בהעברה</a>
        <a href="/payments/new?method=cash">+ תשלום במזומן</a>
        <a href="/payments/new?method=check">+ צ׳ק</a>
      </div>
    </details>
  </div>
</div>
<p class="muted no-print" style="margin:.2rem 0">לחיצה על שורה פותחת את פרטי החשבונית. חשבונית מוחזקת (חסרה הקצאה) מסומנת באדום.</p>

<details class="card no-print collapse-card">
  <summary>הוצאות מזומן (מסגירות Z)</summary>
  <div style="margin-top:.6rem"><%- include('../partials/_cashExpenses', { rows: closingExpenses, matchable: true, matchInvoices: matchInvoices }) %></div>
</details>

<form method="get" action="/invoices" class="card no-print" style="margin-bottom:1rem">
  <input type="hidden" name="status" value="<%= filter %>" />
  <div class="row">
    <div><label>חיפוש לפי מספר חשבונית / הקצאה / ספק</label><input name="q" value="<%= q %>" inputmode="text" placeholder="אפשר כמה מספרים מופרדים ברווח או פסיק" /></div>
  </div>
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:.7rem 0 .2rem">
    <span class="muted">סינון לפי:</span>
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" class="filt-toggle" data-t="sup" style="width:auto;min-height:0" <%= supplierId ? 'checked' : '' %> /> ספק</label>
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" class="filt-toggle" data-t="store" style="width:auto;min-height:0" <%= storeId ? 'checked' : '' %> /> חנות</label>
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" class="filt-toggle" data-t="date" style="width:auto;min-height:0" <%= (from || to) ? 'checked' : '' %> /> תאריך</label>
  </div>
  <div class="row">
    <div class="filt-field" data-t="sup" style="<%= supplierId ? '' : 'display:none' %>">
      <label>ספק</label>
      <select name="supplier">
        <option value="">כל הספקים</option>
        <% suppliers.forEach(function(s){ %><option value="<%= s.id %>" <%= supplierId === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
      </select>
    </div>
    <div class="filt-field" data-t="store" style="<%= storeId ? '' : 'display:none' %>">
      <label>חנות</label>
      <select name="store">
        <option value="">כל החנויות</option>
        <% stores.forEach(function(st){ %><option value="<%= st.id %>" <%= storeId === st.id ? 'selected' : '' %>><%= st.name %> · <%= st.company_name %></option><% }); %>
      </select>
    </div>
  </div>
  <div class="row filt-field" data-t="date" style="<%= (from || to) ? '' : 'display:none' %>">
    <div><label>מתאריך</label><input type="date" name="from" value="<%= from || '' %>" /></div>
    <div><label>עד תאריך</label><input type="date" name="to" value="<%= to || '' %>" /></div>
  </div>
  <div style="margin-top:.7rem;display:flex;gap:.5rem">
    <button type="submit">סנן</button>
    <a href="/invoices<%= filter ? '?status=' + filter : '' %>" class="btn btn-secondary">נקה</a>
  </div>
</form>

<div class="table-scroll">
<table class="sortable">
  <thead>
    <tr><th class="no-print" data-nosort>✓</th><th>מספר חשבונית</th><th>חנות</th><th>תאריך</th><th class="right">סכום</th><th>ספק</th><th>שולם</th></tr>
  </thead>
  <tbody>
    <% if (invoices.length === 0) { %>
      <tr><td colspan="7" class="muted">אין חשבוניות להצגה.</td></tr>
    <% } %>
    <% invoices.forEach(function(i){ %>
      <%
        // "שולם" cell: a real payment → its method+identifier; a matched Z cash expense →
        // "שולם במזומן"; a cash payment with NO Z match → flagged (light-red row).
        var paid = { label: 'לא שולם', cls: 'b-neutral' };
        if (i.pay_method) {
          paid = { label: paymentIdent({ method: i.pay_method, check_number: i.pay_check_number,
            reference: i.pay_reference, batch_number: i.pay_batch_number, card_last4: i.pay_card_last4,
            payer_name: i.pay_payer_name }), cls: 'b-paid' };
        } else if (i.cash_matches > 0) {
          paid = { label: 'שולם במזומן', cls: 'b-paid' };
        } else if (i.status === 'paid') {
          paid = { label: 'שולם', cls: 'b-paid' };
        }
        // A recorded cash payment counts as handled (per owner decision) — no "unmatched" flag.
        var rowCls = i.status === 'on_hold' ? 'row-hold' : '';
        // Selectable for a combined payment: payable (recorded/approved) and not already paid.
        var selectable = (i.status === 'recorded' || i.status === 'approved_for_payment') && !i.pay_method && !(i.cash_matches > 0);
      %>
      <tr onclick="location='/invoices/<%= i.id %>'" style="cursor:pointer" class="<%= rowCls %>">
        <td class="no-print" onclick="event.stopPropagation()">
          <% if (selectable) { %>
            <input type="checkbox" class="inv-pick" style="width:auto;min-height:0"
              data-id="<%= i.id %>" data-sup="<%= i.supplier_id %>" data-store="<%= i.store_id %>"
              data-supname="<%= i.supplier_name %>" data-amount="<%= i.total_amount %>" />
          <% } %>
        </td>
        <td class="mono"><%= i.invoice_number %></td>
        <td><%= i.store_name %></td>
        <td><%= formatDate(i.invoice_date) %></td>
        <td class="right <%= i.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(i.total_amount) %></td>
        <td><%= i.supplier_name %>
          <% if (i.supplier_status !== 'approved') { %>
            <span class="badge b-<%= i.supplier_status %>">ספק <%= i.supplier_status === 'pending' ? 'ממתין' : 'חסום' %></span>
          <% } %>
        </td>
        <td><span class="badge <%= paid.cls %>"><%= paid.label %></span></td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>

<div id="payBar" class="pay-bar no-print" hidden>
  <span>נבחרו <strong id="payCount">0</strong> חשבוניות · ספק <strong id="paySup"></strong> · נטו לתשלום <strong id="payNet">₪0.00</strong></span>
  <div style="display:flex;gap:.5rem;margin-inline-start:auto">
    <button type="button" id="payClear" class="btn btn-secondary btn-sm">בטל בחירה</button>
    <button type="button" id="payBtn" class="btn btn-primary btn-sm">💳 הנפק תשלום לנבחרים</button>
  </div>
</div>

<script>
  // Multi-select → combined payment. A payment can't span suppliers/stores (one bank account), so
  // once one invoice is picked, checkboxes of any other supplier/store are disabled. "הנפק תשלום"
  // hands the selection to the existing batch-payment screen (/invoices/new?supplier=&store=&pick=).
  (function(){
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.inv-pick'));
    if (!boxes.length) return;
    var bar = document.getElementById('payBar');
    function picked(){ return boxes.filter(function(b){ return b.checked; }); }
    function fmtAg(ag){ var s = ag<0?'-':''; ag=Math.abs(ag); return '₪'+s+(Math.floor(ag/100)).toLocaleString('en-US')+'.'+String(ag%100).padStart(2,'0'); }
    function refresh(){
      var sel = picked();
      var sup = sel.length ? sel[0].dataset.sup : null, store = sel.length ? sel[0].dataset.store : null;
      boxes.forEach(function(b){ b.disabled = sel.length > 0 && (b.dataset.sup !== sup || b.dataset.store !== store); });
      if (sel.length) {
        bar.hidden = false;
        document.getElementById('payCount').textContent = sel.length;
        document.getElementById('paySup').textContent = sel[0].dataset.supname || '';
        // Net = sum of the selected invoices in agorot; credit notes are negative and net out.
        var net = sel.reduce(function(s, b){ return s + (parseInt(b.dataset.amount, 10) || 0); }, 0);
        document.getElementById('payNet').textContent = fmtAg(net);
      } else { bar.hidden = true; }
    }
    boxes.forEach(function(b){ b.addEventListener('change', refresh); });
    document.getElementById('payClear').addEventListener('click', function(){ boxes.forEach(function(b){ b.checked = false; }); refresh(); });
    document.getElementById('payBtn').addEventListener('click', function(){
      var sel = picked(); if (!sel.length) return;
      var ids = sel.map(function(b){ return b.dataset.id; }).join(',');
      location = '/invoices/new?supplier=' + sel[0].dataset.sup + '&store=' + sel[0].dataset.store + '&pick=' + ids;
    });
  })();
</script>

<script>
  // Filter panel: checkboxes reveal the supplier / store / date-range controls (choose one up to all).
  (function(){
    document.querySelectorAll('.filt-toggle').forEach(function(cb){
      cb.addEventListener('change', function(){
        var t = cb.getAttribute('data-t');
        document.querySelectorAll('.filt-field[data-t="' + t + '"]').forEach(function(el){
          el.style.display = cb.checked ? '' : 'none';
          if (!cb.checked) el.querySelectorAll('input,select').forEach(function(i){ i.value=''; });
        });
      });
    });
  })();
</script>
<%- include('../partials/footer') %>
