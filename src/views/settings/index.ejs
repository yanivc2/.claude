<%- include('../partials/header') %>
<div class="toolbar">
  <h1>הגדרות</h1>
  <a href="/settings/guide" class="btn btn-secondary">📖 מדריך למשתמש</a>
</div>
<p class="muted">ניהול מבנה החברות, החנויות, חשבונות הבנק והמשתמשים. פעולות בעלים בלבד.</p>

<% if (currentUser.role === 'owner') { %>
  <%# These five used to live in the ☰ navigation menu, which cost two support round-trips: nobody
      looks for an action inside a navigation menu. They belong on the page the owner opens in
      order to perform them. The dialogs they open are included from THIS file for the same reason
      the previous bug happened — a button and the dialog it opens must ship together. %>
  <div class="card">
    <h2 style="margin:0 0 .2rem">פעולות בעלים</h2>
    <p class="muted" style="margin:0 0 var(--space-3)">פעולות תחזוקה על המערכת כולה.</p>
    <div class="owner-actions">
      <button type="button" class="dial" onclick="apOpen('dlg-db')">
        <span class="dial-ic">🗄️</span>
        <span class="dial-txt"><strong>עדכון מסד נתונים</strong><small>הרץ פעם אחת אחרי כל עדכון גרסה. בטוח, לא מוחק דבר.</small></span>
      </button>
      <form method="post" action="/settings/scan-toggle" style="margin:0">
        <input type="hidden" name="on" value="<%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? '0' : '1' %>" />
        <button type="submit" class="dial" style="width:100%">
          <span class="dial-ic"><%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? '📷' : '🔒' %></span>
          <span class="dial-txt"><strong>צילום חשבוניות — <%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? 'פעיל' : 'נעול' %></strong><small><%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? 'לחץ כדי לנעול את התכונה.' : 'תכונה בתשלום. לחץ כדי להפעיל (חבילת צילום חשבוניות).' %></small></span>
        </button>
      </form>
      <button type="button" class="dial" onclick="apOpen('dlg-backup')">
        <span class="dial-ic">⬇</span>
        <span class="dial-txt"><strong>גיבוי מלא</strong><small>הורדת עותק של כל הנתונים כקובץ JSON.</small></span>
      </button>
      <button type="button" class="dial" onclick="apOpen('dlg-storage')">
        <span class="dial-ic">🖼️</span>
        <span class="dial-txt"><strong>בדיקת אחסון קבצים</strong><small>בודק שהצילומים נשמרים ונקראים כמו שצריך. הרץ אם תמונות לא נפתחות.</small></span>
      </button>
    </div>
    <div class="owner-actions" style="margin-top:var(--space-3)">
      <button type="button" class="dial danger" onclick="apOpen('dlg-restore')">
        <span class="dial-ic">♻</span>
        <span class="dial-txt"><strong>שחזור מגיבוי</strong><small>מחליף את כל הנתונים בתוכן קובץ גיבוי. בלתי הפיך.</small></span>
      </button>
      <button type="button" class="dial danger" onclick="apOpen('dlg-clean')">
        <span class="dial-ic">🧹</span>
        <span class="dial-txt"><strong>התחלה נקייה — חשבוניות/תשלומים/Z</strong><small>מוחק חשבוניות, תשלומים, דוחות Z וטיוטות סריקה. שומר סגירות Z, ספקים, קטלוג ועובדים. בלתי הפיך.</small></span>
      </button>
      <button type="button" class="dial danger" onclick="apOpen('dlg-reset')">
        <span class="dial-ic">⚠</span>
        <span class="dial-txt"><strong>איפוס — התחל מחדש</strong><small>מוחק את נתוני העבודה ומשאיר חברות, חנויות ומשתמשים. בלתי הפיך.</small></span>
      </button>
    </div>
  </div>
  <%- include('../partials/_ownerDialogs') %>
<% } %>
<% function permLabel(key){ var f = permissionCatalog.find(function(p){return p.key===key;}); return f ? f.label : key; } %>
<script>
  window.AP_ROLE_TEMPLATES = <%- JSON.stringify(typeof roleTemplates !== 'undefined' && roleTemplates ? roleTemplates : []) %>;
  // Apply a saved role template to a user form: tick its permission checkboxes and set the label.
  function apApplyTemplate(sel){
    var t = (window.AP_ROLE_TEMPLATES||[]).filter(function(x){ return String(x.id) === String(sel.value); })[0];
    if (!t) return;
    var form = sel.closest('form'); if (!form) return;
    var roleSel = form.querySelector('select[name=role]');
    if (roleSel && roleSel.value === 'owner') { roleSel.value = 'secretary'; roleSel.dispatchEvent(new Event('change')); }
    var box = form.querySelector('.perm-box');
    if (box) { box.querySelectorAll('input[name=permissions]').forEach(function(cb){ cb.checked = (t.permissions||[]).indexOf(cb.value) !== -1; }); }
    var lbl = form.querySelector('input[name=label]');
    if (lbl && !lbl.value) lbl.value = t.name;
  }
  // One-click role preset: tick exactly the preset's permissions within this picker.
  window.AP_PRESETS = <%- JSON.stringify(typeof rolePresets !== 'undefined' && rolePresets ? rolePresets : []) %>;
  function apPreset(btn, key){
    var box = btn.closest('.perm-picker'); if (!box) return;
    var perms = key === '__clear' ? [] : (((window.AP_PRESETS||[]).filter(function(p){ return p.key === key; })[0]) || {}).perms || [];
    box.querySelectorAll('input[name=permissions]').forEach(function(cb){ cb.checked = perms.indexOf(cb.value) !== -1; });
  }
</script>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><%= notice %></div>
<% } %>
<% if (typeof schemaWarning !== 'undefined' && schemaWarning) { %>
  <div class="alert alert-warn"><%= schemaWarning %></div>
<% } %>

<% if (typeof invite !== 'undefined' && invite) { %>
  <div class="card" style="border-color:var(--color-accent)">
    <div class="card-kicker">הזמנה בוואטסאפ</div>
    <strong>פרטי התחברות עבור <%= invite.name %></strong>
    <p class="card-body" style="margin:.3rem 0">נוצרה <strong>סיסמה זמנית</strong>. לחץ "פתח וואטסאפ" — ההודעה כבר מוכנה (קישור לאפליקציה + סיסמה + הסבר להתקנה). אם וואטסאפ לא מילא את הטקסט, לחץ "העתק הודעה" והדבק ידנית.</p>

    <form method="post" action="/settings/users/<%= invite.userId %>/invite" class="stack" style="margin:.4rem 0">
      <div class="row" style="gap:.6rem;align-items:end;flex-wrap:wrap">
        <div><label style="margin:0">שם משתמש (ניתן לשנות)</label><input name="username" class="mono" style="max-width:200px" value="<%= invite.username %>" /></div>
        <div><label style="margin:0">סיסמה זמנית (ניתן לשנות)</label><input id="inv_pw" name="password" class="mono" style="max-width:200px" value="<%= invite.password %>" /></div>
      </div>
      <div class="actions" style="margin-top:.4rem;flex-wrap:wrap">
        <button type="submit" class="btn btn-secondary btn-sm">עדכן והכן הודעה מחדש</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="copyVal('inv_pw', this)">העתק סיסמה</button>
      </div>
      <p class="muted" style="margin:.1rem 0 0;font-size:12px">שינית שם משתמש או סיסמה? לחץ "עדכן והכן הודעה מחדש" כדי לשמור ולעדכן את ההודעה.</p>
    </form>

    <label style="margin:.2rem 0 0">ההודעה המלאה</label>
    <textarea id="inv_msg" class="input" style="width:100%;min-height:150px" readonly onclick="this.select()"><%= invite.message %></textarea>

    <div class="actions" style="margin-top:.6rem;flex-wrap:wrap">
      <button type="button" class="btn btn-primary" onclick="shareInvite()">שלח / שתף בוואטסאפ</button>
      <a class="btn btn-secondary" href="<%= invite.waUrl %>" target="_blank" rel="noopener">פתח וואטסאפ (בחירת איש קשר)</a>
      <button type="button" class="btn btn-secondary" onclick="copyVal('inv_msg', this)">העתק הודעה</button>
      <a class="btn btn-secondary" href="<%= invite.loginUrl %>" target="_blank" rel="noopener">פתח את דף ההתחברות</a>
    </div>
    <script>
      function copyVal(id, btn){
        var el = document.getElementById(id); if (!el) return;
        el.focus(); el.select();
        var done = function(){ var t = btn.textContent; btn.textContent = 'הועתק ✓'; setTimeout(function(){ btn.textContent = t; }, 1500); };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(el.value).then(done, function(){ try{document.execCommand('copy');}catch(e){} done(); }); }
        else { try{document.execCommand('copy');}catch(e){} done(); }
      }
      // On mobile, the native share sheet lets you pick WhatsApp AND a contact, with the message
      // already attached (most reliable). Fall back to the wa.me link elsewhere.
      function shareInvite(){
        var msg = document.getElementById('inv_msg').value;
        if (navigator.share) { navigator.share({ text: msg }).catch(function(){}); }
        else { window.open('<%= invite.waUrl %>', '_blank', 'noopener'); }
      }
    </script>
  </div>
<% } %>

<% if (typeof linkInvite !== 'undefined' && linkInvite) { %>
  <div class="card" style="border-color:var(--color-accent)">
    <div class="card-kicker">קישור הגדרה עצמית</div>
    <strong>קישור עבור <%= linkInvite.name %></strong>
    <p class="card-body" style="margin:.3rem 0">שלח את הקישור — המשתמש יבחר <strong>שם משתמש וסיסמה משלו</strong>. לא נשלחת סיסמה. הקישור אישי ותקף ל-7 ימים.</p>
    <label style="margin:.2rem 0 0">הקישור</label>
    <input id="li_link" class="input mono" style="width:100%" readonly value="<%= linkInvite.link %>" onclick="this.select()" />
    <label style="margin:.4rem 0 0">ההודעה המלאה</label>
    <textarea id="li_msg" class="input" style="width:100%;min-height:130px" readonly onclick="this.select()"><%= linkInvite.message %></textarea>
    <div class="actions" style="margin-top:.6rem;flex-wrap:wrap">
      <button type="button" class="btn btn-primary" onclick="liShare()">שלח / שתף בוואטסאפ</button>
      <a class="btn btn-secondary" href="<%= linkInvite.waUrl %>" target="_blank" rel="noopener">פתח וואטסאפ (בחירת איש קשר)</a>
      <button type="button" class="btn btn-secondary" onclick="liCopy('li_link', this)">העתק קישור</button>
      <button type="button" class="btn btn-secondary" onclick="liCopy('li_msg', this)">העתק הודעה</button>
    </div>
    <script>
      function liCopy(id, btn){
        var el = document.getElementById(id); if (!el) return; el.focus(); el.select();
        var done = function(){ var t = btn.textContent; btn.textContent = 'הועתק ✓'; setTimeout(function(){ btn.textContent = t; }, 1500); };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(el.value).then(done, done); }
        else { try { document.execCommand('copy'); } catch(e){} done(); }
      }
      function liShare(){
        var msg = document.getElementById('li_msg').value;
        if (navigator.share) { navigator.share({ text: msg }).catch(function(){}); }
        else { window.open('<%= linkInvite.waUrl %>', '_blank', 'noopener'); }
      }
    </script>
  </div>
<% } %>

<%# The owner action dialogs (עדכון DB / גיבוי / איפוס / שחזור) now live in
    partials/_ownerDialogs.ejs, included by the header alongside the buttons that open them —
    keeping them here meant every OTHER /settings/* page had the buttons but not the dialogs. %>


<!-- ===== שלב 1: חברה חדשה ===== -->
<details class="section">
  <summary><span class="step">1</span> הקמת חברה חדשה</summary>
  <div class="section-body">
    <form method="post" action="/settings/companies" class="stack" style="max-width:420px">
      <label>שם חברה *</label>
      <input name="name" required />
      <label>ח.פ. (9 ספרות, לא חובה)</label>
      <input name="tax_id" maxlength="9" pattern="\d{9}" />
      <div style="margin-top:.6rem"><button type="submit">הוסף חברה</button></div>
    </form>
  </div>
</details>

<!-- ===== שלב 2: חנות + חשבון בנק ===== -->
<details class="section">
  <summary><span class="step">2</span> הקמת חנות + חשבון בנק</summary>
  <div class="section-body">
    <p class="muted">יש קודם להקים חברה חדשה (שלב 1), ואז לעבור לשלב זה ולשייך את החנות לחברה.</p>
    <form method="post" action="/settings/stores" class="stack" style="max-width:640px">
      <label>חברה *</label>
      <select name="company_id" required>
        <% companies.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
      </select>
      <label>שם חנות *</label>
      <input name="store_name" required />
      <label>כתובת</label>
      <input name="address" />
      <div class="row">
        <div><label>בנק</label><input name="bank_name" value="הפועלים" /></div>
        <div><label>סניף *</label><input name="branch" value="428" required /></div>
        <div><label>מספר חשבון *</label><input name="account_number" required /></div>
      </div>
      <label>שם תצוגה (יחושב אוטומטית אם ריק)</label>
      <input name="display_name" />
      <div style="margin-top:.6rem"><button type="submit">הוסף חנות + חשבון</button></div>
    </form>
  </div>
</details>

<!-- ===== פרטי חברות בע"מ (מתחת להקמת חנות + חשבון בנק) ===== -->
<details class="section">
  <summary>פרטי חברות בע"מ</summary>
  <div class="section-body">
    <% companies.forEach(function(c){ %>
      <div style="border:1px solid var(--line);border-radius:8px;padding:.8rem;margin-bottom:.8rem">
        <div class="toolbar" style="margin-bottom:.4rem">
          <strong><%= c.name %></strong>
          <form method="post" action="/settings/companies/<%= c.id %>" class="actions">
            <input name="name" value="<%= c.name %>" style="width:200px" />
            <input name="tax_id" value="<%= c.tax_id || '' %>" placeholder="ח.פ. (9 ספרות)" style="width:150px" />
            <button class="secondary small" type="submit">עדכן חברה</button>
          </form>
        </div>
        <table>
          <thead><tr><th>חנות</th><th>בנק</th><th>סניף</th><th>חשבון</th><th>שם תצוגה</th><th class="no-print" data-nosort></th></tr></thead>
          <tbody>
            <% if (c.stores.length === 0) { %><tr><td colspan="6" class="muted">אין חנויות.</td></tr><% } %>
            <% c.stores.forEach(function(s){ %>
              <tr>
                <td><%= s.name %></td>
                <td><%= s.bank_name || '—' %></td>
                <td class="mono"><%= s.branch || '—' %></td>
                <td class="mono"><%= s.account_number || '—' %></td>
                <td>
                  <% if (s.account_id) { %>
                    <form method="post" action="/settings/accounts/<%= s.account_id %>" class="actions">
                      <input name="display_name" value="<%= s.display_name %>" style="width:240px" />
                      <button class="secondary small" type="submit">שמור</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
                <td class="no-print">
                  <form method="post" action="/settings/stores/<%= s.id %>/delete" style="display:inline"
                        onsubmit="return confirm('למחוק את החנות <%= s.name %>? החנות וחשבון הבנק שלה יימחקו. פעולה זו חסומה אם קיימים לה נתונים (חשבוניות/דוחות Z/הפקדות/תשלומים).')">
                    <button class="danger small" type="submit">מחק</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </div>
</details>

<!-- ===== הסיסמה שלי (בעלים בלבד — שינוי ישיר) ===== -->
<details class="section">
  <summary>הסיסמה שלי</summary>
  <div class="section-body">
    <form method="post" action="/settings/password" class="stack" style="max-width:420px">
      <label>סיסמה נוכחית</label>
      <input type="password" name="current" required />
      <label>סיסמה חדשה (6+ תווים, אות גדולה, קטנה וספרה)</label>
      <input type="password" name="next" required minlength="6" />
      <label>אישור סיסמה חדשה</label>
      <input type="password" name="confirm" required minlength="6" />
      <div style="margin-top:.6rem"><button type="submit">עדכן סיסמה</button></div>
    </form>
  </div>
</details>

<!-- ===== מטריצת הרשאות חברות (הפרדת חברות, בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section" open>
  <summary>מטריצת הרשאות חברות (הפרדת חברות)</summary>
  <div class="section-body">
    <p class="muted">בעלים ("לי") רואה את כל החברות. לכל משתמש אחר סמן לאילו חברות יש גישה — ההגבלה חלה על כל המסכים.</p>
    <% users.filter(function(u){return u.role !== 'owner';}).forEach(function(u){ %>
      <form id="grant-<%= u.id %>" method="post" action="/settings/users/<%= u.id %>/companies"></form>
    <% }); %>
    <table>
      <thead>
        <tr>
          <th>משתמש</th>
          <% companyList.forEach(function(c){ %><th style="text-align:center"><%= c.name %></th><% }); %>
          <th class="no-print"></th>
        </tr>
      </thead>
      <tbody>
        <% users.filter(function(u){return u.role !== 'owner';}).forEach(function(u){ %>
          <tr>
            <td><strong><%= u.label || u.name %></strong> <span class="muted mono" style="font-size:.8rem"><%= u.username || '' %></span></td>
            <% companyList.forEach(function(c){ %>
              <td style="text-align:center">
                <input form="grant-<%= u.id %>" type="checkbox" name="companies" value="<%= c.id %>" style="width:auto"
                  <%= (grants[u.id] || []).includes(c.id) ? 'checked' : '' %> />
              </td>
            <% }); %>
            <td class="no-print"><button form="grant-<%= u.id %>" class="small" type="submit">שמור</button></td>
          </tr>
        <% }); %>
        <% if (users.filter(function(u){return u.role !== 'owner';}).length === 0) { %>
          <tr><td colspan="<%= companyList.length + 2 %>" class="muted">אין משתמשים שאינם בעלים.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</details>
<% } %>

<!-- ===== מטריצת הרשאות חנויות (הרשאה פר-חנות, בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<%
  var _allStores = [];
  (companies || []).forEach(function(c){ (c.stores || []).forEach(function(s){ _allStores.push(s); }); });
  var _nonOwners = users.filter(function(u){ return u.role !== 'owner'; });
%>
<details class="section">
  <summary>מטריצת הרשאות חנויות (הרשאה פר-חנות)</summary>
  <div class="section-body">
    <p class="muted">אופציונלי, ומדויק יותר מהרשאת חברה: סמן לאילו <strong>חנויות</strong> יש למשתמש גישה.
      אם לא סומנה אף חנות — המשתמש רואה את כל החנויות בחברות המורשות לו (כמו קודם). אם סומנו חנויות —
      הוא מוגבל אליהן בלבד, וזו גם רשימת החנויות שיוכל לבחור כ"חנות פעילה" בבאנר העליון.</p>
    <% if (_allStores.length === 0) { %>
      <p class="muted">לא הוגדרו חנויות עדיין.</p>
    <% } else { %>
      <% _nonOwners.forEach(function(u){ %>
        <form id="sgrant-<%= u.id %>" method="post" action="/settings/users/<%= u.id %>/stores"></form>
      <% }); %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th rowspan="2">משתמש</th>
              <% (companies || []).filter(function(c){ return (c.stores || []).length; }).forEach(function(c){ %>
                <th colspan="<%= c.stores.length %>" style="text-align:center"><%= c.name %></th>
              <% }); %>
              <th class="no-print" rowspan="2"></th>
            </tr>
            <tr>
              <% (companies || []).forEach(function(c){ (c.stores || []).forEach(function(s){ %>
                <th style="text-align:center;font-weight:400;font-size:12px"><%= s.name %></th>
              <% }); }); %>
            </tr>
          </thead>
          <tbody>
            <% _nonOwners.forEach(function(u){ %>
              <tr>
                <td><strong><%= u.label || u.name %></strong> <span class="muted mono" style="font-size:.8rem"><%= u.username || '' %></span></td>
                <% (companies || []).forEach(function(c){ (c.stores || []).forEach(function(s){ %>
                  <td style="text-align:center">
                    <input form="sgrant-<%= u.id %>" type="checkbox" name="stores" value="<%= s.id %>" style="width:auto"
                      <%= (storeGrants[u.id] || []).includes(s.id) ? 'checked' : '' %> />
                  </td>
                <% }); }); %>
                <td class="no-print"><button form="sgrant-<%= u.id %>" class="small" type="submit">שמור</button></td>
              </tr>
            <% }); %>
            <% if (_nonOwners.length === 0) { %>
              <tr><td colspan="<%= _allStores.length + 2 %>" class="muted">אין משתמשים שאינם בעלים.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</details>
<% } %>

<!-- ===== תבניות תפקיד (בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section">
  <summary>תבניות תפקיד</summary>
  <div class="section-body">
    <p class="muted">בנה תפקיד בעל שם עם סט הרשאות קבוע (למשל "מנהל חשבונות"), ואז החל אותו על משתמש <strong>בקליק אחד</strong> בטופס המשתמש למטה — בלי לסמן כל הרשאה ידנית. מחיקת תבנית אינה משפיעה על משתמשים קיימים.</p>
    <table>
      <thead><tr><th>שם התבנית</th><th>הרשאות</th><th class="no-print"></th></tr></thead>
      <tbody>
        <% (typeof roleTemplates !== 'undefined' ? roleTemplates : []).forEach(function(t){ %>
          <tr>
            <td><strong><%= t.name %></strong></td>
            <td class="muted" style="font-size:.85rem"><%= t.permissions.length ? t.permissions.map(permLabel).join(' · ') : 'בסיס בלבד (ללא הרשאות נוספות)' %></td>
            <td class="no-print">
              <form method="post" action="/settings/role-templates/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את התבנית <%= t.name %>? לא משפיע על משתמשים קיימים.')">
                <button class="danger small" type="submit">מחק</button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (!(typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %><tr><td colspan="3" class="muted">אין תבניות עדיין.</td></tr><% } %>
      </tbody>
    </table>
    <h3 style="margin:1rem 0 .3rem">תבנית חדשה</h3>
    <form method="post" action="/settings/role-templates" class="stack" style="max-width:640px">
      <label style="margin:0">שם התבנית *</label>
      <input name="name" placeholder="למשל: מנהל חשבונות" required style="max-width:320px" />
      <label style="margin:.4rem 0 .2rem">הרשאות בתבנית</label>
      <%- include('_permpicker', { selected: [] }) %>
      <div style="margin-top:.5rem"><button type="submit">הוסף תבנית</button></div>
    </form>
  </div>
</details>
<% } %>

<!-- ===== ניהול משתמשים והרשאות (בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section">
  <summary>ניהול משתמשים והרשאות</summary>
  <div class="section-body">
    <p class="muted"><strong>בעלים</strong> — גישה מלאה. אחרת בחר תפקיד <strong>מזכירה</strong> (בסיס) ותן שם-תפקיד חופשי (למשל "מנהל") וסמן בצ׳ק-ליסט אילו הרשאות להוסיף.</p>
    <div class="table-scroll">
    <table>
      <thead><tr><th>שם</th><th>שם משתמש</th><th>תפקיד</th><th>הרשאות</th><th class="no-print">פעולות</th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
          <tr>
            <td><%= u.name %><% if (u.email) { %><br><span class="muted" style="font-size:.8rem"><%= u.email %></span><% } %></td>
            <td class="mono"><%= u.username || '—' %></td>
            <td>
              <span class="badge <%= u.role === 'owner' ? 'b-approved_for_payment' : 'b-recorded' %>"><%= u.role === 'owner' ? 'בעלים' : (u.label || 'מזכירה') %></span>
            </td>
            <td>
              <% if (u.role === 'owner') { %>
                <span class="muted" style="font-size:.85rem">הכל</span>
              <% } else if (u.permissions && u.permissions.length) { %>
                <details class="permcell">
                  <summary>הרשאות (<%= u.permissions.length %>)</summary>
                  <div class="permcell-body muted"><%= u.permissions.map(permLabel).join(' · ') %></div>
                </details>
              <% } else { %>
                <span class="muted" style="font-size:.85rem">בסיס בלבד</span>
              <% } %>
            </td>
            <td class="no-print">
              <button type="button" class="secondary small" onclick="var e=document.getElementById('edit-user-<%= u.id %>'); e.hidden=!e.hidden">ערוך</button>
              <form method="post" action="/settings/users/<%= u.id %>/invite" style="display:inline">
                <button class="secondary small" type="submit">שלח בוואטסאפ</button>
              </form>
              <form method="post" action="/settings/users/<%= u.id %>/invite-link" style="display:inline">
                <button class="secondary small" type="submit" title="המשתמש יבחר שם משתמש וסיסמה בעצמו">קישור הגדרה עצמית</button>
              </form>
              <% if (u.id !== currentUser.id) { %>
                <form method="post" action="/settings/users/<%= u.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את המשתמש <%= u.name %>?')">
                  <button class="danger small" type="submit">מחק</button>
                </form>
              <% } %>
            </td>
          </tr>
          <tr id="edit-user-<%= u.id %>" hidden>
            <td colspan="5">
              <form method="post" action="/settings/users/<%= u.id %>" class="stack" style="max-width:640px">
                <div class="row">
                  <div><label style="margin:0">שם</label><input name="name" value="<%= u.name %>" /></div>
                  <div><label style="margin:0">מייל</label><input name="email" value="<%= u.email || '' %>" placeholder="name@example.com" /></div>
                </div>
                <div class="row">
                  <div><label style="margin:0">תפקיד בסיס</label>
                    <select name="role" onchange="var p=this.closest('form').querySelector('.perm-box'); if(p) p.style.display = this.value==='owner'?'none':'';">
                      <option value="secretary" <%= u.role === 'secretary' ? 'selected' : '' %>>מזכירה (בסיס)</option>
                      <option value="owner" <%= u.role === 'owner' ? 'selected' : '' %>>בעלים (הכל)</option>
                    </select>
                  </div>
                  <div><label style="margin:0">שם תפקיד (תצוגה)</label><input name="label" value="<%= u.label || '' %>" placeholder="למשל: מנהל" /></div>
                </div>
                <div class="row">
                  <div><label style="margin:0">שעות התחברות — מ־ (שעון ישראל)</label><input type="time" name="login_start" value="<%= u.login_start || '' %>" /></div>
                  <div><label style="margin:0">עד</label><input type="time" name="login_end" value="<%= u.login_end || '' %>" /></div>
                </div>
                <p class="muted" style="margin:.1rem 0 .3rem;font-size:12px">השאר ריק = ללא הגבלה. שני השדות מלאים = התחברות מותרת רק בין השעות הללו (בעלים אינו מוגבל).</p>
                <div class="perm-box" style="<%= u.role === 'owner' ? 'display:none' : '' %>">
                  <% if ((typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %>
                    <label style="margin:.4rem 0 .2rem">החל תבנית תפקיד</label>
                    <select onchange="apApplyTemplate(this)" style="max-width:320px">
                      <option value="">— בחר תבנית —</option>
                      <% roleTemplates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
                    </select>
                  <% } %>
                  <label style="margin:.4rem 0 .2rem">הרשאות</label>
                  <%- include('_permpicker', { selected: (u.permissions || []) }) %>
                </div>
                <div style="margin-top:.5rem"><button class="small" type="submit">שמור</button></div>
              </form>
              <form method="post" action="/settings/users/<%= u.id %>/reset-password" class="actions" style="gap:.5rem;margin-top:.5rem" onsubmit="return confirm('לאפס סיסמה למשתמש זה?')">
                <div><label style="margin:0">סיסמה חדשה (איפוס ע"י בעלים)</label><input type="text" name="password" minlength="6" placeholder="6+ תווים, אות גדולה/קטנה וספרה" required /></div>
                <div style="align-self:end"><button class="secondary small" type="submit">אפס סיסמה</button></div>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <h3 style="margin:1rem 0 .3rem">הוספת משתמש</h3>
    <form method="post" action="/settings/users" class="stack" style="max-width:640px">
      <div class="row">
        <div><label style="margin:0">שם *</label><input name="name" required /></div>
        <div><label style="margin:0">שם משתמש (לוגין) *</label><input name="username" required /></div>
      </div>
      <div class="row">
        <div><label style="margin:0">מייל</label><input name="email" placeholder="name@example.com" /></div>
        <div><label style="margin:0">סיסמה ראשונית *</label><input type="text" name="password" minlength="6" required /></div>
      </div>
      <div class="row">
        <div><label style="margin:0">תפקיד בסיס</label>
          <select name="role" onchange="var p=this.closest('form').querySelector('.perm-box'); if(p) p.style.display = this.value==='owner'?'none':'';">
            <option value="secretary">מזכירה (בסיס)</option>
            <option value="owner">בעלים (הכל)</option>
          </select>
        </div>
        <div><label style="margin:0">שם תפקיד (תצוגה)</label><input name="label" placeholder="למשל: מנהל" /></div>
      </div>
      <div class="row">
        <div><label style="margin:0">שעות התחברות — מ־ (שעון ישראל)</label><input type="time" name="login_start" /></div>
        <div><label style="margin:0">עד</label><input type="time" name="login_end" /></div>
      </div>
      <p class="muted" style="margin:.1rem 0 .3rem;font-size:12px">השאר ריק = ללא הגבלה. שני השדות מלאים = התחברות מותרת רק בין השעות הללו (בעלים אינו מוגבל).</p>
      <div class="perm-box">
        <% if ((typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %>
          <label style="margin:.4rem 0 .2rem">החל תבנית תפקיד</label>
          <select onchange="apApplyTemplate(this)" style="max-width:320px">
            <option value="">— בחר תבנית —</option>
            <% roleTemplates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
          </select>
        <% } %>
        <label style="margin:.4rem 0 .2rem">הרשאות</label>
        <%- include('_permpicker', { selected: [] }) %>
      </div>
      <div style="margin-top:.5rem"><button type="submit">הוסף משתמש</button></div>
    </form>
    <p class="muted" style="margin-top:.6rem">משתמשים עם כתובת מייל יכולים לאפס סיסמה בעצמם דרך "שכחתי סיסמה" במסך ההתחברות (דורש <span class="mono">RESEND_API_KEY</span>). בכל מקרה אפשר לאפס ידנית כאן.</p>
  </div>
</details>
<% } %>

<script>
  // Accordion for the settings panels: opening one section closes the others.
  (function(){
    var sections = Array.prototype.slice.call(document.querySelectorAll('details.section'));
    sections.forEach(function(d){
      d.addEventListener('toggle', function(){
        if (!d.open) return;
        sections.forEach(function(o){ if (o !== d && o.open) o.removeAttribute('open'); });
      });
    });
  })();
</script>
<%- include('../partials/footer') %>
