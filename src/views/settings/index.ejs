<%- include('../partials/header') %>
<h1>הגדרות</h1>
<p class="muted">ניהול מבנה החברות, החנויות, חשבונות הבנק והמשתמשים. פעולות בעלים בלבד.</p>
<% function permLabel(key){ var f = permissionCatalog.find(function(p){return p.key===key;}); return f ? f.label : key; } %>
<script>
  window.AP_ROLE_TEMPLATES = <%- JSON.stringify(typeof roleTemplates !== 'undefined' && roleTemplates ? roleTemplates : []) %>;
  // Apply a saved role template to a user form: tick its permission checkboxes and set the label.
  function apApplyTemplate(sel){
    var t = (window.AP_ROLE_TEMPLATES||[]).filter(function(x){ return String(x.id) === String(sel.value); })[0];
    if (!t) return;
    var form = sel.closest('form'); if (!form) return;
    var roleSel = form.querySelector('select[name=role]');
    if (roleSel && roleSel.value === 'owner') { roleSel.value = 'secretary'; roleSel.dispatchEvent(new Event('change')); }
    var box = form.querySelector('.perm-box');
    if (box) { box.querySelectorAll('input[name=permissions]').forEach(function(cb){ cb.checked = (t.permissions||[]).indexOf(cb.value) !== -1; }); }
    var lbl = form.querySelector('input[name=label]');
    if (lbl && !lbl.value) lbl.value = t.name;
  }
</script>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><%= notice %></div>
<% } %>
<% if (typeof schemaWarning !== 'undefined' && schemaWarning) { %>
  <div class="alert alert-warn"><%= schemaWarning %></div>
<% } %>

<% if (typeof invite !== 'undefined' && invite) { %>
  <div class="card" style="border-color:var(--color-accent)">
    <div class="card-kicker">הזמנה בוואטסאפ</div>
    <strong>קישור הגדרת סיסמה עבור <%= invite.name %></strong>
    <p class="card-body" style="margin:.3rem 0">לחץ "פתח וואטסאפ" — ההודעה מוכנה (שם משתמש + קישור), ותוכל לבחור למי לשלוח. הקישור תקף לשבוע.</p>
    <div class="actions">
      <a class="btn btn-primary" href="<%= invite.waUrl %>" target="_blank" rel="noopener">פתח וואטסאפ</a>
      <input class="input" style="max-width:440px" value="<%= invite.link %>" readonly onclick="this.select()" />
    </div>
  </div>
<% } %>

<% if (currentUser.role === 'owner') { %>
<!-- כפתורי פעולה עגולים (בעלים) -->
<div class="owner-dials">
  <button type="button" class="dial" onclick="document.getElementById('dlg-db').showModal()">
    <span class="dial-ic">🗄️</span><span class="dial-lbl">עדכון מסד נתונים</span>
  </button>
  <button type="button" class="dial" onclick="document.getElementById('dlg-backup').showModal()">
    <span class="dial-ic">⬇</span><span class="dial-lbl">גיבוי מלא</span>
  </button>
  <button type="button" class="dial danger" onclick="document.getElementById('dlg-reset').showModal()">
    <span class="dial-ic">⚠</span><span class="dial-lbl">איפוס התוכנה — התחל מחדש</span>
  </button>
  <button type="button" class="dial danger" onclick="document.getElementById('dlg-restore').showModal()">
    <span class="dial-ic">♻</span><span class="dial-lbl">שחזור מגיבוי</span>
  </button>
</div>

<dialog id="dlg-db" class="ndialog">
  <form method="post" action="/settings/db-upgrade" class="stack">
    <h3 style="margin:0">עדכון מסד נתונים</h3>
    <p class="muted" style="margin:.2rem 0">מוסיף עמודות/טבלאות חדשות שנדרשות אחרי עדכון גרסה (בטוח, לא מוחק נתונים). הרץ פעם אחת אחרי כל פריסה חדשה.</p>
    <div class="actions" style="justify-content:flex-end">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button type="submit">עדכן מסד נתונים</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-backup" class="ndialog">
  <div class="stack">
    <h3 style="margin:0">גיבוי מלא</h3>
    <p class="muted" style="margin:.2rem 0">הורדת עותק מלא של כל הנתונים (JSON) — שמור אותו במקום שבשליטתך (Google Drive / דיסק). מומלץ אחת לשבוע. גיבוי אוטומטי שבועי רץ בנפרד (pg_dump) ושומר עותק מלא כארכיון.</p>
    <div class="actions" style="justify-content:flex-end">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">סגור</button>
      <a href="/settings/backup" class="btn btn-primary">⬇ הורד גיבוי (JSON)</a>
    </div>
  </div>
</dialog>

<dialog id="dlg-reset" class="ndialog">
  <form method="post" action="/settings/reset-data" class="stack" onsubmit="return apReset(event)">
    <h3 style="margin:0;color:var(--color-bad)">אזור מסוכן — התחל מחדש</h3>
    <p class="muted" style="margin:.2rem 0">
      מוחק את כל <strong>נתוני העבודה</strong> — חשבוניות, תשלומים, תנועות בנק, דוחות Z, הפקדות, הוצאות, יומן ובקשות (כולל הסריקות).
      <br><strong>נשמרים:</strong> חברות, חנויות, חשבונות בנק, משתמשים והרשאות. פעולה בלתי הפיכה.
    </p>
    <label style="display:flex;align-items:center;gap:8px;font-weight:400;margin:0">
      <input type="checkbox" name="also_suppliers" value="1" style="width:auto;min-height:0" /> לנקות גם את רשימת הספקים
    </label>
    <label class="lbl" style="margin-top:.4rem">סיסמת הבעלים</label>
    <input type="password" name="password" required autocomplete="current-password" placeholder="הסיסמה שלך" style="max-width:260px" />
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button class="danger" type="submit">אפס נתונים והתחל מחדש</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-restore" class="ndialog">
  <form method="post" action="/settings/restore" enctype="multipart/form-data" class="stack" onsubmit="return confirm('לשחזר מהגיבוי? כל הנתונים הנוכחיים יוחלפו בתוכן הקובץ. פעולה בלתי הפיכה.')">
    <h3 style="margin:0;color:var(--color-bad)">שחזור מגיבוי</h3>
    <p class="muted" style="margin:.2rem 0">טוען קובץ גיבוי (JSON) ו<strong>מחליף בו את כל הנתונים הקיימים</strong>. ⚠️ בלתי הפיך — כל הנתונים הנוכחיים יימחקו ויוחלפו.</p>
    <label class="lbl">קובץ גיבוי</label>
    <input type="file" name="backup" accept=".json,application/json" required />
    <label class="lbl" style="margin-top:.4rem">סיסמת הבעלים</label>
    <input type="password" name="password" required autocomplete="current-password" placeholder="הסיסמה שלך" style="max-width:260px" />
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button class="danger" type="submit">שחזר מגיבוי</button>
    </div>
  </form>
</dialog>

<script>
function apReset(e){
  var form = e.target;
  if (form.dataset.go === '1') return true;          // second pass — really submit
  e.preventDefault();
  if (!form.password.value) { form.password.focus(); return false; }
  var wantBackup = confirm('האם תרצה לגבות לפני האיפוס?\n\n"אישור" — יורד קובץ גיבוי ואז מאפס.\n"ביטול" — מאפס בלי גיבוי.');
  if (wantBackup) {
    var a = document.createElement('a'); a.href = '/settings/backup'; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ form.dataset.go = '1'; form.submit(); }, 1800);
  } else {
    form.dataset.go = '1'; form.submit();
  }
  return false;
}
</script>
<% } %>

<!-- ===== שלב 1: חברה חדשה ===== -->
<details class="section">
  <summary><span class="step">1</span> הקמת חברה חדשה</summary>
  <div class="section-body">
    <form method="post" action="/settings/companies" class="stack" style="max-width:420px">
      <label>שם חברה *</label>
      <input name="name" required />
      <label>ח.פ. (9 ספרות, לא חובה)</label>
      <input name="tax_id" maxlength="9" pattern="\d{9}" />
      <div style="margin-top:.6rem"><button type="submit">הוסף חברה</button></div>
    </form>
  </div>
</details>

<!-- ===== שלב 2: חנות + חשבון בנק ===== -->
<details class="section">
  <summary><span class="step">2</span> הקמת חנות + חשבון בנק</summary>
  <div class="section-body">
    <p class="muted">יש קודם להקים חברה חדשה (שלב 1), ואז לעבור לשלב זה ולשייך את החנות לחברה.</p>
    <form method="post" action="/settings/stores" class="stack" style="max-width:640px">
      <label>חברה *</label>
      <select name="company_id" required>
        <% companies.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
      </select>
      <label>שם חנות *</label>
      <input name="store_name" required />
      <label>כתובת</label>
      <input name="address" />
      <div class="row">
        <div><label>בנק</label><input name="bank_name" value="הפועלים" /></div>
        <div><label>סניף *</label><input name="branch" value="428" required /></div>
        <div><label>מספר חשבון *</label><input name="account_number" required /></div>
      </div>
      <label>שם תצוגה (יחושב אוטומטית אם ריק)</label>
      <input name="display_name" />
      <div style="margin-top:.6rem"><button type="submit">הוסף חנות + חשבון</button></div>
    </form>
  </div>
</details>

<!-- ===== פרטי חברות בע"מ (מתחת להקמת חנות + חשבון בנק) ===== -->
<details class="section">
  <summary>פרטי חברות בע"מ</summary>
  <div class="section-body">
    <% companies.forEach(function(c){ %>
      <div style="border:1px solid var(--line);border-radius:8px;padding:.8rem;margin-bottom:.8rem">
        <div class="toolbar" style="margin-bottom:.4rem">
          <strong><%= c.name %></strong>
          <form method="post" action="/settings/companies/<%= c.id %>" class="actions">
            <input name="name" value="<%= c.name %>" style="width:200px" />
            <input name="tax_id" value="<%= c.tax_id || '' %>" placeholder="ח.פ. (9 ספרות)" style="width:150px" />
            <button class="secondary small" type="submit">עדכן חברה</button>
          </form>
        </div>
        <table>
          <thead><tr><th>חנות</th><th>בנק</th><th>סניף</th><th>חשבון</th><th>שם תצוגה</th></tr></thead>
          <tbody>
            <% if (c.stores.length === 0) { %><tr><td colspan="5" class="muted">אין חנויות.</td></tr><% } %>
            <% c.stores.forEach(function(s){ %>
              <tr>
                <td><%= s.name %></td>
                <td><%= s.bank_name || '—' %></td>
                <td class="mono"><%= s.branch || '—' %></td>
                <td class="mono"><%= s.account_number || '—' %></td>
                <td>
                  <% if (s.account_id) { %>
                    <form method="post" action="/settings/accounts/<%= s.account_id %>" class="actions">
                      <input name="display_name" value="<%= s.display_name %>" style="width:240px" />
                      <button class="secondary small" type="submit">שמור</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </div>
</details>

<!-- ===== הסיסמה שלי (בעלים בלבד — שינוי ישיר) ===== -->
<details class="section">
  <summary>הסיסמה שלי</summary>
  <div class="section-body">
    <form method="post" action="/settings/password" class="stack" style="max-width:420px">
      <label>סיסמה נוכחית</label>
      <input type="password" name="current" required />
      <label>סיסמה חדשה (6+ תווים, אות גדולה, קטנה וספרה)</label>
      <input type="password" name="next" required minlength="6" />
      <label>אישור סיסמה חדשה</label>
      <input type="password" name="confirm" required minlength="6" />
      <div style="margin-top:.6rem"><button type="submit">עדכן סיסמה</button></div>
    </form>
  </div>
</details>

<!-- ===== מטריצת הרשאות חברות (הפרדת חברות, בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section" open>
  <summary>מטריצת הרשאות חברות (הפרדת חברות)</summary>
  <div class="section-body">
    <p class="muted">בעלים ("לי") רואה את כל החברות. לכל משתמש אחר סמן לאילו חברות יש גישה — ההגבלה חלה על כל המסכים.</p>
    <% users.filter(function(u){return u.role !== 'owner';}).forEach(function(u){ %>
      <form id="grant-<%= u.id %>" method="post" action="/settings/users/<%= u.id %>/companies"></form>
    <% }); %>
    <table>
      <thead>
        <tr>
          <th>משתמש</th>
          <% companyList.forEach(function(c){ %><th style="text-align:center"><%= c.name %></th><% }); %>
          <th class="no-print"></th>
        </tr>
      </thead>
      <tbody>
        <% users.filter(function(u){return u.role !== 'owner';}).forEach(function(u){ %>
          <tr>
            <td><strong><%= u.label || u.name %></strong> <span class="muted mono" style="font-size:.8rem"><%= u.username || '' %></span></td>
            <% companyList.forEach(function(c){ %>
              <td style="text-align:center">
                <input form="grant-<%= u.id %>" type="checkbox" name="companies" value="<%= c.id %>" style="width:auto"
                  <%= (grants[u.id] || []).includes(c.id) ? 'checked' : '' %> />
              </td>
            <% }); %>
            <td class="no-print"><button form="grant-<%= u.id %>" class="small" type="submit">שמור</button></td>
          </tr>
        <% }); %>
        <% if (users.filter(function(u){return u.role !== 'owner';}).length === 0) { %>
          <tr><td colspan="<%= companyList.length + 2 %>" class="muted">אין משתמשים שאינם בעלים.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</details>
<% } %>

<!-- ===== תבניות תפקיד (בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section">
  <summary>תבניות תפקיד</summary>
  <div class="section-body">
    <p class="muted">בנה תפקיד בעל שם עם סט הרשאות קבוע (למשל "מנהל חשבונות"), ואז החל אותו על משתמש <strong>בקליק אחד</strong> בטופס המשתמש למטה — בלי לסמן כל הרשאה ידנית. מחיקת תבנית אינה משפיעה על משתמשים קיימים.</p>
    <table>
      <thead><tr><th>שם התבנית</th><th>הרשאות</th><th class="no-print"></th></tr></thead>
      <tbody>
        <% (typeof roleTemplates !== 'undefined' ? roleTemplates : []).forEach(function(t){ %>
          <tr>
            <td><strong><%= t.name %></strong></td>
            <td class="muted" style="font-size:.85rem"><%= t.permissions.length ? t.permissions.map(permLabel).join(' · ') : 'בסיס בלבד (ללא הרשאות נוספות)' %></td>
            <td class="no-print">
              <form method="post" action="/settings/role-templates/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את התבנית <%= t.name %>? לא משפיע על משתמשים קיימים.')">
                <button class="danger small" type="submit">מחק</button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (!(typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %><tr><td colspan="3" class="muted">אין תבניות עדיין.</td></tr><% } %>
      </tbody>
    </table>
    <h3 style="margin:1rem 0 .3rem">תבנית חדשה</h3>
    <form method="post" action="/settings/role-templates" class="stack" style="max-width:640px">
      <label style="margin:0">שם התבנית *</label>
      <input name="name" placeholder="למשל: מנהל חשבונות" required style="max-width:320px" />
      <label style="margin:.4rem 0 .2rem">הרשאות בתבנית</label>
      <div class="actions" style="flex-wrap:wrap;gap:.8rem">
        <% permissionCatalog.forEach(function(p){ %>
          <label style="display:flex;align-items:center;gap:.3rem;margin:0;font-weight:400">
            <input type="checkbox" name="permissions" value="<%= p.key %>" style="width:auto" /> <%= p.label %>
          </label>
        <% }); %>
      </div>
      <div style="margin-top:.5rem"><button type="submit">הוסף תבנית</button></div>
    </form>
  </div>
</details>
<% } %>

<!-- ===== ניהול משתמשים והרשאות (בעלים בלבד) ===== -->
<% if (currentUser.role === 'owner') { %>
<details class="section">
  <summary>ניהול משתמשים והרשאות</summary>
  <div class="section-body">
    <p class="muted"><strong>בעלים</strong> — גישה מלאה. אחרת בחר תפקיד <strong>מזכירה</strong> (בסיס) ותן שם-תפקיד חופשי (למשל "מנהל") וסמן בצ׳ק-ליסט אילו הרשאות להוסיף.</p>
    <table>
      <thead><tr><th>שם</th><th>שם משתמש</th><th>תפקיד</th><th>הרשאות</th><th class="no-print">פעולות</th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
          <tr>
            <td><%= u.name %><% if (u.email) { %><br><span class="muted" style="font-size:.8rem"><%= u.email %></span><% } %></td>
            <td class="mono"><%= u.username || '—' %></td>
            <td>
              <span class="badge <%= u.role === 'owner' ? 'b-approved_for_payment' : 'b-recorded' %>"><%= u.role === 'owner' ? 'בעלים' : (u.label || 'מזכירה') %></span>
            </td>
            <td class="muted" style="font-size:.85rem">
              <% if (u.role === 'owner') { %>הכל<% } else if (u.permissions && u.permissions.length) { %><%= u.permissions.map(permLabel).join(' · ') %><% } else { %>בסיס בלבד<% } %>
            </td>
            <td class="no-print">
              <button type="button" class="secondary small" onclick="var e=document.getElementById('edit-user-<%= u.id %>'); e.hidden=!e.hidden">ערוך</button>
              <form method="post" action="/settings/users/<%= u.id %>/invite" style="display:inline">
                <button class="secondary small" type="submit">שלח בוואטסאפ</button>
              </form>
              <% if (u.id !== currentUser.id) { %>
                <form method="post" action="/settings/users/<%= u.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את המשתמש <%= u.name %>?')">
                  <button class="danger small" type="submit">מחק</button>
                </form>
              <% } %>
            </td>
          </tr>
          <tr id="edit-user-<%= u.id %>" hidden>
            <td colspan="5">
              <form method="post" action="/settings/users/<%= u.id %>" class="stack" style="max-width:640px">
                <div class="row">
                  <div><label style="margin:0">שם</label><input name="name" value="<%= u.name %>" /></div>
                  <div><label style="margin:0">מייל</label><input name="email" value="<%= u.email || '' %>" placeholder="name@example.com" /></div>
                </div>
                <div class="row">
                  <div><label style="margin:0">תפקיד בסיס</label>
                    <select name="role" onchange="var p=this.closest('form').querySelector('.perm-box'); if(p) p.style.display = this.value==='owner'?'none':'';">
                      <option value="secretary" <%= u.role === 'secretary' ? 'selected' : '' %>>מזכירה (בסיס)</option>
                      <option value="owner" <%= u.role === 'owner' ? 'selected' : '' %>>בעלים (הכל)</option>
                    </select>
                  </div>
                  <div><label style="margin:0">שם תפקיד (תצוגה)</label><input name="label" value="<%= u.label || '' %>" placeholder="למשל: מנהל" /></div>
                </div>
                <div class="perm-box" style="<%= u.role === 'owner' ? 'display:none' : '' %>">
                  <% if ((typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %>
                    <label style="margin:.4rem 0 .2rem">החל תבנית תפקיד</label>
                    <select onchange="apApplyTemplate(this)" style="max-width:320px">
                      <option value="">— בחר תבנית —</option>
                      <% roleTemplates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
                    </select>
                  <% } %>
                  <label style="margin:.4rem 0 .2rem">הרשאות</label>
                  <div class="actions" style="flex-wrap:wrap;gap:.8rem">
                    <% permissionCatalog.forEach(function(p){ %>
                      <label style="display:flex;align-items:center;gap:.3rem;margin:0;font-weight:400">
                        <input type="checkbox" name="permissions" value="<%= p.key %>" style="width:auto" <%= (u.permissions||[]).includes(p.key) ? 'checked' : '' %> /> <%= p.label %>
                      </label>
                    <% }); %>
                  </div>
                </div>
                <div style="margin-top:.5rem"><button class="small" type="submit">שמור</button></div>
              </form>
              <form method="post" action="/settings/users/<%= u.id %>/reset-password" class="actions" style="gap:.5rem;margin-top:.5rem" onsubmit="return confirm('לאפס סיסמה למשתמש זה?')">
                <div><label style="margin:0">סיסמה חדשה (איפוס ע"י בעלים)</label><input type="text" name="password" minlength="6" placeholder="6+ תווים, אות גדולה/קטנה וספרה" required /></div>
                <div style="align-self:end"><button class="secondary small" type="submit">אפס סיסמה</button></div>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <h3 style="margin:1rem 0 .3rem">הוספת משתמש</h3>
    <form method="post" action="/settings/users" class="stack" style="max-width:640px">
      <div class="row">
        <div><label style="margin:0">שם *</label><input name="name" required /></div>
        <div><label style="margin:0">שם משתמש (לוגין) *</label><input name="username" required /></div>
      </div>
      <div class="row">
        <div><label style="margin:0">מייל</label><input name="email" placeholder="name@example.com" /></div>
        <div><label style="margin:0">סיסמה ראשונית *</label><input type="text" name="password" minlength="6" required /></div>
      </div>
      <div class="row">
        <div><label style="margin:0">תפקיד בסיס</label>
          <select name="role" onchange="var p=this.closest('form').querySelector('.perm-box'); if(p) p.style.display = this.value==='owner'?'none':'';">
            <option value="secretary">מזכירה (בסיס)</option>
            <option value="owner">בעלים (הכל)</option>
          </select>
        </div>
        <div><label style="margin:0">שם תפקיד (תצוגה)</label><input name="label" placeholder="למשל: מנהל" /></div>
      </div>
      <div class="perm-box">
        <% if ((typeof roleTemplates !== 'undefined' ? roleTemplates : []).length) { %>
          <label style="margin:.4rem 0 .2rem">החל תבנית תפקיד</label>
          <select onchange="apApplyTemplate(this)" style="max-width:320px">
            <option value="">— בחר תבנית —</option>
            <% roleTemplates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
          </select>
        <% } %>
        <label style="margin:.4rem 0 .2rem">הרשאות</label>
        <div class="actions" style="flex-wrap:wrap;gap:.8rem">
          <% permissionCatalog.forEach(function(p){ %>
            <label style="display:flex;align-items:center;gap:.3rem;margin:0;font-weight:400">
              <input type="checkbox" name="permissions" value="<%= p.key %>" style="width:auto" /> <%= p.label %>
            </label>
          <% }); %>
        </div>
      </div>
      <div style="margin-top:.5rem"><button type="submit">הוסף משתמש</button></div>
    </form>
    <p class="muted" style="margin-top:.6rem">משתמשים עם כתובת מייל יכולים לאפס סיסמה בעצמם דרך "שכחתי סיסמה" במסך ההתחברות (דורש <span class="mono">RESEND_API_KEY</span>). בכל מקרה אפשר לאפס ידנית כאן.</p>
  </div>
</details>
<% } %>
<%- include('../partials/footer') %>
