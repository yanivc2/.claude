<%- include('../partials/header') %>
<div class="toolbar"><h1>עובדים ומשכורות</h1></div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
  var sRows = (typeof salaryRows !== 'undefined' && salaryRows) ? salaryRows : [];
  var sMethods = (typeof salaryMethods !== 'undefined' && salaryMethods) ? salaryMethods : [];
  var sCash = (typeof cashCandidates !== 'undefined' && cashCandidates) ? cashCandidates : [];
  var sStoreId = (typeof salaryStoreId !== 'undefined') ? salaryStoreId : null;
  var mLabel = function (m) { for (var i = 0; i < sMethods.length; i++) if (sMethods[i].value === m) return sMethods[i].label; return m; };
  // The employee picker offers THIS branch's staff only: an employee linked to other stores is not
  // ours to pay, and an unlinked one is shared with every branch (lib/scope.js#filterByStoreLinks).
  var payable = (totals || []).filter(function (e) {
    if (!sStoreId) return true;
    if (!e.stores || !e.stores.length) return true;
    return e.stores.some(function (st) { return Number(st.id) === Number(sStoreId); });
  });
%>
<div class="card">
  <h2 style="margin:0 0 .5rem">תשלומי שכר</h2>
  <p class="muted" style="margin:0 0 .6rem">
    איך שולם השכר בפועל — לכל עובד, אמצעי, אסמכתה, התאריך שעבורו שולם והסכום.
    <% if (sStoreId) { %>מוצגים תשלומי החנות הפעילה בלבד.<% } else { %>בחר חנות פעילה בבאנר כדי לצמצם לסניף אחד.<% } %>
  </p>

  <form method="post" action="/employees/salary" class="stack">
    <% if (sStoreId) { %><input type="hidden" name="store_id" value="<%= sStoreId %>" /><% } %>
    <div class="table-scroll">
      <table class="no-enhance">
        <thead><tr><th>שם העובד</th><th>שולם ב</th><th>מס׳ אסמכתה</th><th>לתאריך</th><th class="right">סכום (₪)</th><th></th></tr></thead>
        <tbody>
          <tr>
            <td>
              <% if (!sStoreId) { %>
                <select name="store_id" class="js-combo" required style="margin-bottom:.3rem">
                  <option value="">בחר חנות…</option>
                  <% (storeOptions || []).forEach(function(st){ %><option value="<%= st.id %>"><%= st.name %></option><% }); %>
                </select>
              <% } %>
              <select name="employee_id" class="js-combo" required>
                <option value="">בחר עובד…</option>
                <% payable.forEach(function(e){ %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }); %>
              </select>
              <% if (!payable.length) { %><small class="muted">אין עובדים משויכים לחנות זו.</small><% } %>
            </td>
            <td>
              <select name="method" required>
                <% sMethods.forEach(function(m){ %><option value="<%= m.value %>"><%= m.label %></option><% }); %>
              </select>
            </td>
            <td><input name="reference" autocomplete="off" placeholder="מספר צ׳ק / אסמכתה" /></td>
            <%# The global day-first picker makes this typable as 8/9/26 (partials/footer.ejs). %>
            <td><input type="date" name="due_date" required /></td>
            <td><div style="display:flex;align-items:center;gap:.3rem"><input name="amount" inputmode="decimal" placeholder="0.00" required style="max-width:130px" /><span class="muted">₪</span></div></td>
            <td><button type="submit" class="small">הוסף</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </form>

  <% if (sRows.length) { %>
    <div class="table-scroll" style="margin-top:.8rem">
      <table>
        <thead><tr><th>שם העובד</th><th>שולם ב</th><th>מס׳ אסמכתה</th><th>לתאריך</th><th class="right">סכום</th><th>נפרט בקופה</th><th class="no-print" data-nosort></th></tr></thead>
        <tbody>
          <% sRows.forEach(function(r){ %>
            <tr>
              <td><%= r.first_name %> <%= r.last_name %><% if (!sStoreId) { %> <span class="badge b-neutral"><%= r.store_name %></span><% } %></td>
              <td><%= mLabel(r.method) %></td>
              <td class="mono"><%= r.reference || '—' %></td>
              <td class="mono"><%= formatDate(r.due_date) %></td>
              <td class="right"><%= formatIls(r.amount) %></td>
              <td>
                <% if (Number(r.cashed)) { %>
                  <span class="badge b-approved">הותאם להוצאת מזומן</span>
                  <form method="post" action="/employees/salary/<%= r.id %>/uncashed" style="display:inline" onsubmit="return confirm('לבטל את ההתאמה? הצ׳ק שבוטל יישאר במעקב.')">
                    <button class="btn btn-secondary small" type="submit">בטל התאמה</button>
                  </form>
                <% } else if (r.method === 'check') { %>
                  <%# The employee cashed the wage check at the till: matching it to the Z-closing
                      cash expense that paid it out also VOIDS the check, so the same wage is not
                      paid twice (services/salaryPayments.js#markCashed). %>
                  <details>
                    <summary class="muted" style="cursor:pointer;font-size:12px">סמן כנפרט + התאם למזומן</summary>
                    <form method="post" action="/employees/salary/<%= r.id %>/cashed" style="margin-top:.35rem">
                      <select name="cash_expense_id" class="js-combo" required>
                        <option value="">בחר הוצאת מזומן מסגירת Z…</option>
                        <% sCash.forEach(function(c){ %>
                          <option value="<%= c.id %>"><%= formatDate(c.expense_date) %> · <%= c.payer_name || c.purpose || 'הוצאה' %> · <%= formatIls(c.amount) %><%= c.z_number ? ' · Z ' + c.z_number : '' %></option>
                        <% }); %>
                      </select>
                      <% if (!sCash.length) { %><small class="muted">אין הוצאות מזומן פנויות בסגירות ה-Z.</small><% } %>
                      <button type="submit" class="small" style="margin-top:.3rem">התאם ובטל את הצ׳ק</button>
                    </form>
                  </details>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="no-print">
                <form method="post" action="/employees/salary/<%= r.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את רישום התשלום?')">
                  <button class="danger small" type="submit">מחק</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%# Collapsed by default: adding an employee is occasional, recording a wage payment is daily. %>
<details class="card no-print collapse-card">
  <summary>הוספת עובד</summary>
  <form method="post" action="/employees" class="actions" style="gap:.6rem;align-items:flex-end;flex-wrap:wrap;margin-top:.8rem">
    <div><label class="lbl">שם פרטי *</label><input name="first_name" required /></div>
    <div><label class="lbl">שם משפחה *</label><input name="last_name" required /></div>
    <div><label class="lbl">טלפון</label><input name="phone" type="tel" inputmode="tel" autocomplete="off" placeholder="050-0000000" /></div>
    <% if (typeof storeOptions !== 'undefined' && storeOptions && storeOptions.length > 1) { %>
      <div style="flex-basis:100%">
        <label class="lbl">חנויות (ללא סימון = כל החנויות)</label>
        <%- include('../suppliers/_storepick', { stores: storeOptions, selected: [] }) %>
      </div>
    <% } %>
    <div><button type="submit">הוסף עובד</button></div>
  </form>

  <details class="section" style="margin-top:1rem">
    <summary>ייבוא רשימת עובדים מקובץ Excel</summary>
    <div class="section-body">
      <p class="muted" style="margin:.4rem 0">
        העלה קובץ <strong>Excel (.xlsx)</strong> או CSV עם שורת כותרות. עמודות מזוהות: <strong>שם</strong>
        (או "שם פרטי" + "שם משפחה") ו-<strong>טלפון</strong>. עובד שכבר קיים (לפי מספר טלפון) לא ייווסף — כדי
        למנוע כפילויות.
      </p>
      <form method="post" action="/employees/import" enctype="multipart/form-data" class="actions"
            style="gap:.6rem;align-items:flex-end;flex-wrap:wrap">
        <div><label class="lbl">קובץ עובדים</label><input type="file" name="file" accept=".xlsx,.csv,.tsv,text/csv" required /></div>
        <div><button type="submit">ייבא עובדים</button></div>
      </form>
    </div>
  </details>
</details>

<div class="card">
  <h2 style="margin:0 0 .5rem">עובדים — סיכום</h2>
  <div class="table-scroll">
  <table class="sortable">
    <thead><tr><th>שם</th><th>טלפון</th><th>חנויות</th><th class="right">מפרעות</th><th class="right">שכר</th><th class="right">רישומים</th><th>סטטוס</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (!totals || totals.length === 0) { %><tr><td colspan="8" class="muted">אין עובדים. הוסף עובד למעלה.</td></tr><% } %>
      <% (totals || []).forEach(function(e){ %>
        <tr>
          <td><%= e.first_name %> <%= e.last_name %></td>
          <td class="mono"><% if (e.phone) { %><a href="<%= telLink(e.phone) %>"><%= e.phone %></a><% } else { %>—<% } %></td>
          <%# The store marker: which branches this employee belongs to. No chips = every store. %>
          <td>
            <% if (!e.stores || e.stores.length === 0) { %>
              <span class="badge b-neutral">כל החנויות</span>
            <% } else { %>
              <% e.stores.forEach(function(st){ %><span class="badge b-approved"><%= st.name %></span> <% }); %>
            <% } %>
            <% if (storeOptions && storeOptions.length) { %>
              <details style="margin-top:.35rem">
                <summary class="muted" style="cursor:pointer; font-size:12px">שנה / העתק לחנות</summary>
                <form method="post" action="/employees/<%= e.id %>/stores" style="margin-top:.4rem">
                  <%- include('../suppliers/_storepick', { stores: storeOptions, selected: (e.stores || []).map(function(s){ return s.id; }) }) %>
                  <p class="muted" style="font-size:11px; margin:.3rem 0">ללא סימון = משויך לכל החנויות.</p>
                  <button type="submit" class="small">שמור שיוך</button>
                </form>
              </details>
            <% } %>
          </td>
          <td class="right"><%= e.advances ? formatIls(e.advances) : '—' %></td>
          <td class="right"><%= e.salary ? formatIls(e.salary) : '—' %></td>
          <td class="right"><%= e.lines || 0 %></td>
          <td><% if (e.active) { %><span class="badge b-approved">פעיל</span><% } else { %><span class="badge b-neutral">לא פעיל</span><% } %></td>
          <td class="no-print">
            <form method="post" action="/employees/<%= e.id %>/delete" style="display:inline"
                  onsubmit="return confirm('למחוק את <%= e.first_name %> <%= e.last_name %>? אם יש לו רישומים הוא יועבר ללא-פעיל.')">
              <button class="danger small" type="submit">מחק</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h2 style="margin:0 0 .5rem">מעקב מפרעות ושכר</h2>
  <p class="muted" style="margin:0 0 .5rem">כל מפרעה או תשלום שכר שהוזן בדוח Z עבור עובד — מוצג כאן לפי תאריך.</p>
  <div class="table-scroll">
  <table class="sortable">
    <thead><tr><th>תאריך</th><th>עובד</th><th>סוג</th><th>חנות</th><th>Z</th><th class="right">סכום</th></tr></thead>
    <tbody>
      <% if (!ledger || ledger.length === 0) { %><tr><td colspan="6" class="muted">אין רישומים.</td></tr><% } %>
      <% (ledger || []).forEach(function(r){ %>
        <tr>
          <td><%= formatDate(r.expense_date) %></td>
          <td><%= r.first_name %> <%= r.last_name %></td>
          <td><% if (r.kind === 'advance') { %><span class="badge b-on_hold">מפרעה</span><% } else { %><span class="badge b-neutral">שכר</span><% } %></td>
          <td><%= r.store_name %></td>
          <td class="mono"><a href="/reports/zreports/<%= r.z_report_id %>">Z <%= r.z_number %></a></td>
          <td class="right"><strong><%= formatIls(r.amount) %></strong></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
