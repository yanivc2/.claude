<%- include('../partials/header') %>
<h1>ספק חדש</h1>
<div class="card">
  <p class="muted">הספק ייווצר בסטטוס <strong>ממתין</strong>. ניתן להזין חשבוניות מיד, אך תשלום חסום עד אישור בעלים (R1/R6).</p>
  <form class="stack" method="post" action="/suppliers">
    <label>שם ספק *</label>
    <input name="name" required value="<%= values.name || '' %>" />
    <label>ח.פ. / מס' עוסק (לא חובה)</label>
    <input name="tax_id" value="<%= values.tax_id || '' %>" />
    <label>הערות</label>
    <textarea name="notes" rows="2"><%= values.notes || '' %></textarea>
    <div style="margin-top:1rem" class="actions">
      <button type="submit">שמור ספק</button>
      <a href="/suppliers" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
