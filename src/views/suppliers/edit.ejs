<%- include('../partials/header') %>
<%
var PT_PRESETS = ['מיידי', 'שוטף 14', 'שוטף 30', 'שוטף 45'];
var pmVal = supplier.payment_method || '';
var ptStored = supplier.payment_terms || '';
var ptSel = ptStored && PT_PRESETS.indexOf(ptStored) === -1 ? 'other' : ptStored;
var ptCustom = ptSel === 'other' ? ptStored : '';
var sel = (selectedStores || []).map(Number);
%>
<h1>עריכת ספק</h1>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<div class="card">
  <form class="stack" method="post" action="/suppliers/<%= supplier.id %>/edit">
    <label>שם ספק *</label>
    <input name="name" required value="<%= supplier.name || '' %>" />

    <div class="row">
      <div><label>ח.פ / עוסק מורשה</label><input name="tax_id" value="<%= supplier.tax_id || '' %>" /></div>
      <div><label>מייל</label><input name="email" inputmode="email" value="<%= supplier.email || '' %>" /></div>
    </div>

    <h3 style="margin:1rem 0 .2rem">פרטי קשר</h3>
    <div class="row">
      <div><label>טלפון</label><input name="phone" inputmode="tel" value="<%= supplier.phone || '' %>" /></div>
      <div><label>שם סוכן</label><input name="contact_name" value="<%= supplier.contact_name || '' %>" /></div>
    </div>
    <div class="row">
      <div><label>טלפון סוכן</label><input name="contact_phone" inputmode="tel" value="<%= supplier.contact_phone || '' %>" /></div>
      <div></div>
    </div>

    <h3 style="margin:1rem 0 .2rem">תשלום</h3>
    <div class="row">
      <div>
        <label>אמצעי תשלום</label>
        <select name="payment_method">
          <option value="">— ללא —</option>
          <option value="transfer" <%= pmVal === 'transfer' ? 'selected' : '' %>>העברה</option>
          <option value="check" <%= pmVal === 'check' ? 'selected' : '' %>>צק</option>
          <option value="cash" <%= pmVal === 'cash' ? 'selected' : '' %>>מזומן</option>
          <option value="credit" <%= pmVal === 'credit' ? 'selected' : '' %>>אשראי</option>
          <option value="standing_order" <%= pmVal === 'standing_order' ? 'selected' : '' %>>הו"ק</option>
        </select>
      </div>
      <div>
        <label>תנאי תשלום</label>
        <select name="payment_terms" onchange="document.getElementById('ptOther').style.display=this.value==='other'?'block':'none'">
          <option value="">— ללא —</option>
          <option value="מיידי" <%= ptSel === 'מיידי' ? 'selected' : '' %>>תשלום מיידי</option>
          <option value="שוטף 14" <%= ptSel === 'שוטף 14' ? 'selected' : '' %>>שוטף 14</option>
          <option value="שוטף 30" <%= ptSel === 'שוטף 30' ? 'selected' : '' %>>שוטף 30</option>
          <option value="שוטף 45" <%= ptSel === 'שוטף 45' ? 'selected' : '' %>>שוטף 45</option>
          <option value="other" <%= ptSel === 'other' ? 'selected' : '' %>>אחר…</option>
        </select>
      </div>
    </div>
    <div id="ptOther" style="margin-top:.5rem;<%= ptSel === 'other' ? '' : 'display:none' %>">
      <label>תנאי תשלום אחר</label>
      <input name="payment_terms_other" value="<%= ptCustom || '' %>" placeholder="לדוגמה: שוטף 60, 50% מקדמה" />
    </div>

    <h3 style="margin:1rem 0 .2rem">חנויות משויכות</h3>
    <%- include('_storepick', { stores: stores, selected: sel }) %>

    <% if (typeof parentOptions !== 'undefined') { %>
      <label style="margin-top:1rem">חברת-אם (לתשלום מרוכז)</label>
      <select name="parent_supplier_id" class="js-combo">
        <option value="">— ללא (ספק עצמאי) —</option>
        <% parentOptions.forEach(function(p){ %>
          <option value="<%= p.id %>" <%= Number(supplier.parent_supplier_id) === p.id ? 'selected' : '' %>><%= p.name %></option>
        <% }); %>
      </select>
      <p class="muted" style="margin:.2rem 0 0">אם ספק זה הוא חברת-בת (למשל טרה תחת קוקה קולה) — בחר את חברת-האם, וכך אפשר יהיה לשלם את החשבוניות של שתיהן יחד בתשלום אחד.</p>
    <% } %>

    <label style="margin-top:1rem">הערות</label>
    <textarea name="notes" rows="2"><%= supplier.notes || '' %></textarea>
    <div style="margin-top:1rem" class="actions">
      <button type="submit">שמור שינויים</button>
      <a href="/suppliers" class="btn secondary">ביטול</a>
    </div>
  </form>
</div>

<%# "הסקיל של הספק" — what scanning this supplier's invoices has taught the system about how its
    invoice is laid out. It is built automatically from the scans themselves; the only editable
    part is the owner's own notes, because the learned parts are measurements and overwriting a
    measurement by hand would make the whole thing untrustworthy. %>
<% var rd = typeof readiness !== 'undefined' ? readiness : { state: 'new', label: '' }; %>
<div class="card">
  <div class="toolbar" style="align-items:center;margin:0 0 .4rem">
    <h2 style="margin:0">🎓 הסקיל של הספק</h2>
    <span class="badge <%= rd.state === 'ready' ? 'b-approved' : rd.state === 'learning' ? 'b-on_hold' : 'b-neutral' %>">
      <%= rd.state === 'ready' ? 'מוכן' : rd.state === 'learning' ? 'לומד' : 'חדש' %>
    </span>
  </div>
  <p class="muted" style="margin:0 0 .6rem"><%= rd.label %><% if (rd.samples) { %> · נלמד מ-<%= rd.samples %> חשבוניות שצולמו<% } %></p>

  <% if (profileHints && profileHints.length) { %>
    <p class="muted" style="margin:0 0 .3rem">מה שנשלח יחד עם הצילום הבא של הספק הזה:</p>
    <ul style="margin:0 0 .8rem">
      <% profileHints.forEach(function(h){ %><li><%= h %></li><% }); %>
    </ul>
  <% } else { %>
    <p class="muted" style="margin:0 0 .8rem">
      עדיין אין מספיק מידע. צלמו חשבונית של הספק הזה, בחרו אותו במסך הצילום, ואשרו —
      המערכת תלמד את מבנה החשבונית מהצילום עצמו ומכל תיקון שתעשו.
    </p>
  <% } %>

  <form method="post" action="/suppliers/<%= supplier.id %>/scan-hints" class="stack">
    <label class="lbl">הערות שלך לקריאת החשבונית (שורה לכל כלל)</label>
    <textarea name="hints" rows="3" placeholder="לדוגמה: עמודת הקוד היא ברקוד מקוצר — ספרות הסיום של הברקוד המלא"><%= (profile.hints || []).join('\n') %></textarea>
    <p class="muted" style="margin:.2rem 0 0">מה שנלמד אוטומטית לא נמחק בשמירה כאן.</p>
    <div class="actions" style="margin-top:.4rem"><button type="submit">שמור הערות</button></div>
  </form>
</div>
<%- include('../partials/footer') %>
