<%- include('../partials/header') %>
<%# "+ ספק חדש" ו"סינון" — בשורת הכותרת (partials/_suppliersMenu.ejs, בעלים 21/10). %>
<div class="toolbar">
  <h1>ספקים</h1>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>


<%# ספקי פירות וירקות (עסקאות בשיעור אפס, §30(א)(13)) — בעלים 21/10: במקום כרטיס נפרד, עמודת "שיעור 0" בטבלה
    עם ריבוע שמסמן/מבטל בקליק (POST /suppliers/zero-rated, בעלים בלבד). ההצעה עדיין נגזרת מהחשבוניות של הספק
    עצמו (services/suppliers.js#zeroRatedCandidates) ומוצגת כ"מוצע" ליד ריבוע שעוד לא סומן — לעולם לא מסמנת לבד.
    הסימון לא משנה את בדיקת מספר ההקצאה (תמיד לפי המע"מ בחשבונית) — רק מכבה את התזכורת "חשבונית מס גדולה בלי מע"מ". %>
<% var _zc = {}; ((typeof zeroCandidates !== 'undefined' && zeroCandidates) || []).forEach(function(c){ _zc[c.id] = c; });
   var _isOwner = !!(currentUser && currentUser.role === 'owner'); %>

<%# למה רואים ספקים שנראים "של חנות אחרת": ספק בלי שיוך לחנות הוא משותף לכולן ולכן אף פעם לא
    מוסתר (זו הייתה החלטה מכוונת — כלום לא נעלם כשנוסף השיוך). התוצאה היא שעד שמשייכים, בחירת
    סניף לא מצמצמת את רשימת הספקים. החשבוניות כבר יודעות לאן כל ספק מוביל, אז מציעים לפי הן. %>
<% var ss = (typeof storeSuggestions !== 'undefined' && storeSuggestions) ? storeSuggestions : []; %>
<% if (ss.length && currentUser && currentUser.role === 'owner') { %>
  <details class="card no-print collapse-card">
    <summary>שיוך ספקים לחנויות — <%= ss.length %> ספקים ללא שיוך (מופיעים בכל החנויות)</summary>
    <p class="muted" style="margin:.6rem 0">
      ספק <strong>ללא שיוך לחנות משותף לכל החנויות</strong> ולכן מופיע גם כשנבחרה חנות פעילה — הוא
      לא "ספק של חנות אחרת", הוא פשוט עדיין לא שויך. ההצעה למטה נגזרת <strong>מהחשבוניות שהספק
      הגיש בפועל</strong>: לצד כל חנות מופיע כמה חשבוניות הוא הגיש לה. ספק שמוביל לשני סניפים —
      סמן את שניהם, זה בדיוק מה שהשיוך נועד לו. ספק שתשאיר בלי סימון יישאר משותף לכולן.
    </p>
    <form method="post" action="/suppliers/assign-stores">
      <div class="table-scroll">
        <table class="no-enhance">
          <thead><tr><th>ספק</th><th class="right">חשבוניות</th><th>חנויות לפי החשבוניות</th></tr></thead>
          <tbody>
            <% ss.forEach(function(c){ %>
              <tr>
                <td>
                  <input type="hidden" name="offered" value="<%= c.id %>" />
                  <a href="/suppliers/<%= c.id %>/edit"><%= c.name %></a>
                </td>
                <td class="right mono"><%= c.invoices %></td>
                <td>
                  <% c.stores.forEach(function(st){ %>
                    <label style="display:inline-flex;align-items:center;gap:.35rem;margin:0 0 .3rem 1rem;cursor:pointer">
                      <input type="checkbox" name="stores_<%= c.id %>" value="<%= st.id %>" checked style="width:auto;min-height:0" />
                      <span><%= st.name %> <span class="muted">(<%= st.n %>)</span></span>
                    </label>
                  <% }); %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="actions" style="margin-top:.6rem">
        <button type="submit">🏪 שייך לפי החשבוניות</button>
        <span class="muted">ספק שכל תיבותיו ריקות יישאר משותף לכל החנויות.</span>
      </div>
    </form>
  </details>
<% } %>

<%# 🏛️ "תשלומים לרשויות" (בעלים 21/10: "תשלומים שיצאו מהבנק", מעל טבלת הספקים) — חיובי בנק לביטוח לאומי, מס הכנסה,
    מע"מ, רשות המסים וארנונה/עירייה, מזוהים מתיאור החיוב (services/authorityPayments.js), 12 החודשים האחרונים,
    בחשבונות שבסקופ. מקובץ לפי חודש · רשות · חשבון; "פירוט" פותח את החיובים עצמם. סגור כברירת מחדל, בעלים בלבד. %>
<% var _ap = (typeof authorityPayments !== 'undefined' && authorityPayments) ? authorityPayments : [];
   var _apTotal = _ap.reduce(function(t, g){ return t + g.total; }, 0), _apCount = _ap.reduce(function(t, g){ return t + g.count; }, 0); %>
<% if (_isOwner) { %>
  <details class="card no-print collapse-card authority-card">
    <summary>תשלומים לרשויות <span class="muted">— <%= _apCount %> חיובים · <%= formatIls(_apTotal) %> · 12 החודשים האחרונים</span></summary>
    <% if (!_ap.length) { %>
      <p class="muted" style="margin:.6rem 0">לא נמצאו בדף הבנק חיובים לרשויות (ביטוח לאומי, מס הכנסה, מע"מ, רשות המסים, ארנונה) ב-12 החודשים האחרונים.</p>
    <% } else { %>
      <p class="muted" style="margin:.6rem 0">מזוהה מתיאור החיוב בדף הבנק: ביטוח לאומי · מס הכנסה · מע"מ · רשות המסים · ארנונה / עירייה.</p>
      <div class="table-scroll">
        <table class="sortable no-export">
          <thead><tr><th>חודש</th><th>רשות</th><th>חשבון</th><th class="right">חיובים</th><th class="right">סכום</th><th data-nosort data-nofilter>פירוט</th></tr></thead>
          <tbody>
            <% _ap.forEach(function(g){ %>
              <tr>
                <td class="mono"><%= g.month.slice(5, 7) + '/' + g.month.slice(2, 4) %></td>
                <td><%= g.authority %></td>
                <td><%= g.account %></td>
                <td class="right mono"><%= g.count %></td>
                <td class="right mono"><strong><%= formatIls(g.total) %></strong></td>
                <td>
                  <details class="authority-items">
                    <summary>פירוט</summary>
                    <% g.items.forEach(function(it){ %>
                      <div class="muted" style="font-size:12px"><%= formatDate(it.txn_date) %> · <%= formatIls(-Number(it.amount)) %><%= it.raw_reference ? ' · ' + it.raw_reference : '' %> · <%= it.description %></div>
                    <% }); %>
                  </details>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </details>
<% } %>

<form method="post" action="/suppliers/bulk">
  <table>
    <thead>
      <tr>
        <th style="width:2rem"><input type="checkbox" onclick="document.querySelectorAll('input.rowchk').forEach(c=>c.checked=this.checked)" title="בחר הכל" /></th>
        <%# "אפשרויות מסומנים" (בעלים 21/10: "להעביר לטבלה בין שם לריבוע שמסמנים… את הבצע שים תחתיו") — מה שהיה
            הכרטיס "פעולה על הנבחרים" מעל הטבלה, עכשיו בכותרת העמודה שבין "שם" לריבועי הסימון. %>
        <th data-nosort data-nofilter data-noexport class="bulk-col no-print">
          <span class="bulk-title">אפשרויות מסומנים</span>
          <select name="bulk_action" class="bulk-pick" aria-label="פעולה על הספקים המסומנים" title="אישור/חסימה/מחיקה — פעולות בעלים. מחיקה רק לספק ללא חשבוניות.">
            <option value="approve">אשר</option>
            <option value="block">חסום</option>
            <option value="delete">מחק</option>
            <option value="zero_rated">סמן: עסקאות בשיעור אפס</option>
            <option value="zero_rated_off">בטל: עסקאות בשיעור אפס</option>
          </select>
          <button type="submit" class="btn-sm bulk-go" onclick="return confirm('לבצע את הפעולה על הספקים המסומנים?')">בצע</button>
        </th>
        <th>שם</th><th>חנויות</th><th class="hide-sm">ח.פ.</th><th>סטטוס</th><th>טלפון</th><th data-nosort data-nofilter data-noexport class="zero-col" title="עסקאות בשיעור אפס (פירות וירקות טריים)">שיעור 0</th>
      </tr>
    </thead>
    <tbody>
      <% if (suppliers.length === 0) { %>
        <tr><td colspan="8" class="muted">אין ספקים להצגה.</td></tr>
      <% } %>
      <% suppliers.forEach(function(s){ %>
        <tr>
          <td><input type="checkbox" class="rowchk" name="ids" value="<%= s.id %>" /></td>
          <td><a class="btn btn-secondary btn-sm" href="/suppliers/<%= s.id %>/edit">ערוך</a></td>
          <td><%= s.name %></td>
          <td>
            <% if (s.stores && s.stores.length) { %>
              <% s.stores.forEach(function(st){ %><span class="badge b-neutral" style="margin:1px"><%= st.name %></span><% }); %>
            <% } else { %><span class="badge b-neutral" title="ספק ללא שיוך לחנות — משותף לכל החנויות ולכן מופיע גם כשנבחרה חנות פעילה">כל החנויות</span><% } %>
          </td>
          <td class="mono hide-sm"><%= s.tax_id || '—' %></td>
          <td><span class="badge b-<%= s.status %>"><%= s.status === 'pending' ? 'ממתין' : s.status === 'approved' ? 'מאושר' : 'חסום' %></span><% if (Number(s.zero_rated)) { %> <span class="badge b-neutral" title="עסקאות בשיעור אפס (§30(א)(13)) — חשבוניות ללא מע\"מ, ללא חובת מספר הקצאה">מע"מ 0%</span><% } %></td>
          <td onclick="event.stopPropagation()">
            <% if (s.phone || s.email) { %>
              <details class="menu">
                <summary class="btn btn-secondary btn-sm mono" style="white-space:nowrap"><%= s.phone || 'קשר' %> <span class="caret">▾</span></summary>
                <div class="menu-panel" style="min-width:160px">
                  <% if (s.phone) { %>
                    <a href="<%= telLink(s.phone) %>">📞 התקשר</a>
                    <a href="<%= waLink(s.phone) %>" target="_blank" rel="noopener">💬 וואטסאפ</a>
                  <% } %>
                  <% if (s.email) { %>
                    <a href="mailto:<%= s.email %>">✉️ מייל</a>
                  <% } %>
                </div>
              </details>
            <% } else { %>—<% } %>
          </td>
          <td class="zero-cell">
            <% var _c = _zc[s.id]; var _on = Number(s.zero_rated) === 1;
               var _why = _c ? (_c.suggested ? 'כל חשבוניות המס שלו ללא מע"מ' : (_c.invoices ? Math.round(_c.share * 100) + '% מחשבוניותיו ללא מע"מ' : '')) + (_c.nameHint ? ' · השם רומז על תוצרת חקלאית' : '') : ''; %>
            <%# בלי name — כדי שלא ייסע עם "אפשרויות מסומנים";הקליק שולח את הטופס הנפרד zeroToggleForm. %>
            <input type="checkbox" class="zero-toggle" data-id="<%= s.id %>" <%= _on ? 'checked' : '' %> <%= _isOwner ? '' : 'disabled' %>
                   aria-label="עסקאות בשיעור אפס — <%= s.name %>" title="<%= _on ? 'מסומן: עסקאות בשיעור אפס' : 'סמן: עסקאות בשיעור אפס' %><%= _why ? ' · ' + _why : '' %>" />
            <% if (!_on && _c && _c.suggested) { %><span class="zero-hint" title="<%= _why %>">מוצע</span><% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</form>

<% if (_isOwner) { %>
<form method="post" action="/suppliers/zero-rated" id="zeroToggleForm" class="no-print" hidden></form>
<script>
  // "שיעור 0" בקליק אחד (בעלים 21/10): הריבוע שולח את הספק הזה בלבד — מסומן או לא — ל-/suppliers/zero-rated.
  document.querySelectorAll('.zero-toggle').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var f = document.getElementById('zeroToggleForm');
      f.textContent = '';
      var add = function (n, v) { var i = document.createElement('input'); i.type = 'hidden'; i.name = n; i.value = v; f.appendChild(i); };
      add('offered', cb.dataset.id);
      if (cb.checked) add('zero_ids', cb.dataset.id);
      cb.disabled = true;
      // requestSubmit ולא submit: רק הוא מעלה את אירוע ה-submit, שבו partials/footer.ejs שומר את מקום הגלילה.
      if (f.requestSubmit) f.requestSubmit(); else f.submit();
    });
  });
</script>
<% } %>
<%- include('../partials/footer') %>
