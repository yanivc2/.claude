<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · AP Control</title>
  <meta name="theme-color" content="#5980a6" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&family=Barlow+Condensed:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/design-system.css" />
</head>
<body>
  <div style="direction:rtl;min-height:100vh;position:relative;background:var(--color-bg);color:var(--color-text);overflow-x:hidden">
    <!-- blueprint background: fine grid, coarse grid, radial vignette -->
    <div style="position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(color-mix(in srgb,var(--color-accent) 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--color-accent) 8%,transparent) 1px,transparent 1px);background-size:26px 26px"></div>
    <div style="position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(color-mix(in srgb,var(--color-accent) 14%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--color-accent) 14%,transparent) 1px,transparent 1px);background-size:182px 182px"></div>
    <div style="position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(120% 80% at 50% -20%, transparent 60%, color-mix(in srgb,var(--color-accent) 6%,transparent))"></div>
    <!-- fixed inset frame with registration corners -->
    <div style="position:fixed;inset:14px;z-index:9;pointer-events:none;border:1px solid color-mix(in srgb,var(--color-accent) 32%,transparent)">
      <i class="bp-corner" style="left:-5px;top:-5px"></i>
      <i class="bp-corner" style="right:-5px;top:-5px"></i>
      <i class="bp-corner" style="left:-5px;bottom:-5px"></i>
      <i class="bp-corner" style="right:-5px;bottom:-5px"></i>
    </div>

    <div style="position:relative;z-index:1">
      <header style="display:flex;align-items:center;gap:14px;padding:12px 26px;background:color-mix(in srgb,var(--color-bg) 88%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--color-neutral-500);position:sticky;top:0;z-index:20">
        <span style="position:relative;width:30px;height:30px;background:var(--color-accent);display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-size:12px;font-weight:700;color:#fff;letter-spacing:.02em">AP<i class="bp-corner" style="left:-4px;top:-4px"></i><i class="bp-corner" style="right:-4px;top:-4px"></i><i class="bp-corner" style="left:-4px;bottom:-4px"></i><i class="bp-corner" style="right:-4px;bottom:-4px"></i></span>
        <span style="font-family:var(--font-heading);font-weight:700;font-size:19px;letter-spacing:.06em;white-space:nowrap;text-transform:uppercase">Control</span>
        <span style="font-family:var(--font-heading);font-size:10px;letter-spacing:.18em;color:var(--color-accent);border:1px solid var(--color-accent);padding:1px 6px;white-space:nowrap"><%= typeof pageTag !== 'undefined' ? pageTag : 'AP-01' %></span>
        <span style="flex:1"></span>
        <a href="/login" style="font-family:var(--font-heading);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-700);text-decoration:none">← התחברות</a>
      </header>

      <main class="page">