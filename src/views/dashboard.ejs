<%- include('partials/header') %>
<div class="toolbar" style="align-items:center">
  <h1 style="margin:0">לוח בקרה</h1>
  <%# "אפשרויות" יושב בפס החנות הפעילה (partials/header.ejs). בלי פס — כאן. %>
  <% if (!(typeof availableStores !== 'undefined' && availableStores && availableStores.length)) { %><%- include('partials/_quickMenu') %><% } %>
</div>

<% if (typeof voidedInBank !== 'undefined' && voidedInBank && voidedInBank.count) { %>
  <div class="card" style="border:2px solid var(--color-danger, #c0392b); background:rgba(192,57,43,.06)">
    <h2 style="margin:0 0 .3rem; color:var(--color-danger, #c0392b)">🔴 צ׳ק שבוטל נפרע (<%= voidedInBank.count %>)</h2>
    <p class="muted" style="margin:0 0 .4rem">
      הכסף עבר למרות שהצ׳ק סומן כמבוטל — יש לבדוק (ביטול שגוי / stop-payment / הנפקה מחדש).
      ביטול במערכת אינו מבטל בבנק: צ׳ק נשאר בר-פירעון כחצי שנה. ראה <a href="/voided-checks">צ׳קים מבוטלים</a>.
    </p>
    <table>
      <thead><tr><th>צ׳ק / אסמכתא</th><th class="right">סכום</th><th>תאריך בבנק</th><th>תיאור</th></tr></thead>
      <tbody>
        <% voidedInBank.rows.forEach(function(h){ %>
          <tr>
            <td class="mono"><a href="/payments/<%= h.payment.id %>"><%= h.payment.check_number || h.payment.reference || h.payment.batch_number || '—' %></a></td>
            <td class="right neg"><%= formatIls(h.txn.amount) %></td>
            <td><%= formatDate(h.txn.txn_date) %></td>
            <td><%= h.txn.description || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="stat-grid">
  <%# "צ׳קים בחוץ" — במקום "צ׳קים פתוחים" (אותו דבר בספירה ולא בכסף; בעלים, 16/10). החנות היא החנות
      הפעילה בלבד — בורר החנות שהיה בתוך האריח בוטל. %>
  <a class="stat" href="/reports/outstanding">
    <div class="num"><%= formatIls(outstandingDisplay) %></div>
    <div class="label">צ׳קים בחוץ · <%= typeof openChecksCount !== 'undefined' ? openChecksCount : 0 %> צ׳קים<%= storeId ? '' : ' · כל החנויות' %></div>
  </a>
  <a class="stat <%= stats.pendingSuppliers ? 'attn' : '' %>" href="/suppliers?status=pending">
    <div class="num"><%= stats.pendingSuppliers %></div>
    <div class="label">ספקים ממתינים לאישור</div>
  </a>
  <a class="stat <%= stats.onHoldInvoices ? 'attn' : '' %>" href="/invoices?status=on_hold">
    <div class="num"><%= stats.onHoldInvoices %></div>
    <div class="label">חשבוניות מוחזקות</div>
  </a>
  <a class="stat" href="/reconciliation">
    <div class="num" style="font-size:22px"><%= (stats.lastReconciled && stats.lastReconciled.ts) ? formatDate(String(stats.lastReconciled.ts).slice(0,10)) : '—' %></div>
    <div class="label">התאמת בנק אחרונה<%
      // When no single store is active ("all stores"), name which store the latest reconciliation
      // belongs to; with an active store the banner already says which store, so the name is omitted.
      var _actStore = (typeof activeStore !== 'undefined' && activeStore);
      if (!_actStore && stats.lastReconciled && stats.lastReconciled.storeName) { %> · <%= stats.lastReconciled.storeName %><% } %></div>
  </a>
  <%# 🔎 בדיקת חשבונית — במקום אריח "צ׳קים בחוץ" שעבר להתחלה (בעלים, 16/10: "בטל את הרובריקה ושים
      במקום הצ׳קים בחוץ"). רק החנות הפעילה (בלי בורר חנות/חברה). שם ומספר בשדות נפרדים; המספר נפתח
      בנייד במקלדת מספרים (חשבונית / צ׳ק / הקצאה / אסמכתה — גם ברקוד שנסרק). %>
  <div class="stat oc-tile lookup-tile no-print">
    <div class="label" style="margin-bottom:.45rem">🔎 בדיקת חשבונית / אמצעי תשלום</div>
    <form method="get" action="/" class="lookup-form">
      <input name="name" value="<%= typeof name !== 'undefined' ? name : '' %>" placeholder="שם ספק" autocomplete="off" aria-label="חיפוש לפי שם ספק" />
      <input name="q" value="<%= q %>" inputmode="numeric" placeholder="מספר חשבונית / צ׳ק" autocomplete="off" aria-label="חיפוש לפי מספר" />
      <%# בעלים, 18/10: "חפש" משמאל לשדות החיפוש (באותה שורה), ו"לא שולמו בלבד" מתחתיו. %>
      <div class="lookup-go">
        <button type="submit">חפש</button>
        <label class="lookup-unpaid"><input type="checkbox" name="unpaid" value="1" <%= typeof unpaidOnly !== 'undefined' && unpaidOnly ? 'checked' : '' %> /> לא שולמו בלבד</label>
      </div>
    </form>
  </div>
  <a class="stat <%= (typeof zNoDepositCount !== 'undefined' && zNoDepositCount) ? 'attn' : '' %>" href="/reports/zreports" title="דוחות Z שהוזנו ללא הצהרת הפקדה — לחץ להצהיר">
    <div class="num"><%= typeof zNoDepositCount !== 'undefined' ? zNoDepositCount : 0 %></div>
    <div class="label">Z ללא הצהרת הפקדה</div>
  </a>
  <a class="stat <%= (typeof notDepositedCount !== 'undefined' && notDepositedCount) ? 'attn' : '' %>" href="/reports/zreports" title="הפקדות שהוצהרו וטרם הופקדו — לחץ לסמן הפקדה">
    <div class="num"><%= typeof notDepositedCount !== 'undefined' ? notDepositedCount : 0 %></div>
    <div class="label">הצהרות שלא הופקדו</div>
  </a>
</div>

<% if (invoiceResults || checkResults || supplierResults) { %>
<div class="card no-collapse" id="lookup-results">
  <div class="toolbar" style="align-items:center"><h2 style="margin:0">תוצאות חיפוש</h2><a class="btn btn-secondary btn-sm" href="/">נקה</a></div>
  <% if (invoiceResults) { %>
    <h3 style="margin:1rem 0 .3rem">חשבוניות (<%= invoiceResults.length %>)</h3>
    <div class="table-scroll"><table>
      <thead><tr><th>#</th><th>ספק</th><th>חנות</th><th>מס'</th><th>הקצאה</th><th>תאריך</th><th class="right">סכום</th><th>מס' צ׳ק</th><th>פירעון</th></tr></thead>
      <tbody>
        <% if (invoiceResults.length === 0) { %><tr><td colspan="9" class="muted">אין חשבוניות תואמות.</td></tr><% } %>
        <% invoiceResults.forEach(function(r){ %>
          <tr>
            <td><a href="/invoices/<%= r.id %>"><%= r.id %></a></td>
            <td><%= r.supplier_name %></td>
            <td><%= r.store_name %></td>
            <td class="mono"><%= r.invoice_number %></td>
            <td class="mono"><%= r.allocation_number || '—' %></td>
            <td><%= formatDate(r.invoice_date) %></td>
            <td class="right <%= r.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(r.total_amount) %></td>
            <td class="mono"><%= r.check_number || '—' %></td>
            <td>
              <% if (r.payment_status) { %>
                <span class="badge b-<%= r.payment_status %>"><%= r.payment_status === 'issued' ? 'בחוץ' : r.payment_status === 'cleared' ? 'נפרע' : 'מבוטל' %></span>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>

  <% if (checkResults) { %>
    <h3 style="margin:1rem 0 .3rem">תשלומים (<%= checkResults.length %>)</h3>
    <div class="table-scroll"><table>
      <thead><tr><th>אמצעי / מזהה</th><th>ספק</th><th>חשבון</th><th>תאריך</th><th class="right">סכום</th><th>סטטוס</th></tr></thead>
      <tbody>
        <% if (checkResults.length === 0) { %><tr><td colspan="6" class="muted">אין תשלומים תואמים.</td></tr><% } %>
        <% checkResults.forEach(function(c){ %>
          <tr onclick="location='/payments/<%= c.id %>'" style="cursor:pointer">
            <td><%= paymentIdent(c) %></td>
            <td><%= c.supplier_name || '—' %></td>
            <td><%= c.bank_account_name %></td>
            <td><%= formatDate(c.payment_date) %></td>
            <td class="right"><%= formatIls(c.amount) %></td>
            <td><span class="badge b-<%= c.status %>"><%= c.status === 'issued' ? 'בחוץ' : c.status === 'cleared' ? 'נפרע' : 'מבוטל' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>

  <% if (supplierResults) { %>
    <h3 style="margin:1rem 0 .3rem">ספקים (<%= supplierResults.length %>)</h3>
    <div class="table-scroll"><table>
      <thead><tr><th>ספק</th><th>טלפון</th><th>מייל</th><th>איש קשר הנה"ח</th><th>סטטוס</th></tr></thead>
      <tbody>
        <% if (supplierResults.length === 0) { %><tr><td colspan="5" class="muted">אין ספקים תואמים.</td></tr><% } %>
        <% supplierResults.forEach(function(s){ %>
          <tr onclick="location='/suppliers/contacts?q=<%= encodeURIComponent(s.name) %>'" style="cursor:pointer">
            <td><strong><%= s.name %></strong></td>
            <td><%= s.phone || '—' %></td>
            <td><%= s.email || '—' %></td>
            <td><%= s.contact_name || '—' %><%= s.contact_phone ? ' · ' + s.contact_phone : '' %></td>
            <td><span class="badge b-<%= s.status === 'approved' ? 'approved' : s.status === 'blocked' ? 'blocked' : 'on_hold' %>"><%= s.status === 'approved' ? 'מאושר' : s.status === 'blocked' ? 'חסום' : 'ממתין' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>
</div>
<% } %>

<%# 🔴 התראות המזומן יושבות **בלוח הבקרה**, מעל הרשימה שהן מדברות עליה — לא רק בפעמון. רק מה שדורש
    תשומת לב: צ׳ק שכר שנפרע בבנק לפני שהותאם (אותו שכר עלול לצאת פעמיים), וכל עוד לא נקרא ("✓ ראיתי").
    התאמה שבוצעה כבר נסגרה ולכן אינה כאן (בעלים, 16/10) — היא בפעמון ובטלגרם. no-collapse — אזהרה לא
    נסגרת מאחורי אקורדיון. %>
<% var _alerts = (typeof cashAlerts !== 'undefined' && cashAlerts) ? cashAlerts : []; %>
<% var _alertsOld = (typeof cashAlertsUnscoped !== 'undefined' && cashAlertsUnscoped) ? Number(cashAlertsUnscoped) : 0; %>
<% if (_alerts.length || _alertsOld) { %>
  <div class="card no-collapse" style="border-color:var(--color-warn)">
    <h2 style="margin:0 0 .3rem">🔔 התראות מזומן</h2>
    <p class="muted" style="margin:0 0 .5rem; font-size:12px">רק מה שדורש תשומת לב: צ׳ק שכר שנפרע בבנק <strong>לפני</strong> שהותאם — כדי שאותו שכר לא ייצא פעמיים. התאמות שבוצעו מופיעות בפעמון ובטלגרם.</p>
    <div class="table-scroll">
      <table class="no-enhance">
        <tbody>
          <% _alerts.forEach(function(n){ %>
            <tr>
              <td style="width:1%; white-space:nowrap" class="muted"><%= israelStamp(n.created_at) || String(n.created_at || '').slice(0,16) %></td>
              <td>
                <% if (n.kind === 'salary_cleared_unmatched') { %><span class="badge b-blocked">לפני התאמה</span>
                <% } else { %><span class="badge b-paid">הותאם</span><% } %>
                <%= n.link ? '' : '' %><strong><%= n.title %></strong>
                <% if (n.body) { %><div class="muted" style="font-size:12px; white-space:pre-line"><%= n.body %></div><% } %>
              </td>
              <td style="width:1%; white-space:nowrap">
                <% if (n.link) { %><a class="btn btn-secondary small" href="<%= n.link %>">פתח</a><% } %>
                <form method="post" action="/notifications/<%= n.id %>/read" data-keep-scroll style="display:inline;margin:0">
                  <input type="hidden" name="return_to" value="/" />
                  <button type="submit" class="btn btn-secondary small" title="סמן כנקרא — ההתראה יוצאת מהלוח ונשארת ברשימת ההתראות">✓ ראיתי</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%# 🔴 התראות שנרשמו לפני שהיה שיוך לחנות אינן נתלות על חנות שאולי אינה שלהן — אבל גם לא
        נבלעות בשקט, אחרת מסך ריק היה נראה כמו "אין התראות" בזמן שיש. %>
    <% if (_alertsOld) { %>
      <p class="muted" style="margin:.5rem 0 0; font-size:12px">
        ועוד <strong><%= _alertsOld %></strong> התראות מזומן ישנות שלא נקראו — מלפני שהתראות שויכו לחנות, ולכן הן לא מוצגות
        תחת חנות אחת. <a href="/notifications">לקרוא אותן ברשימת ההתראות</a>; אחרי שיסומנו כנקראו השורה הזו תיעלם.
      </p>
    <% } %>
    <p class="muted" style="margin:.5rem 0 0; font-size:12px"><a href="/notifications">כל ההתראות</a></p>
  </div>
<% } %>

<%# מכווץ כברירת מחדל (בקשת הבעלים) — הכותרת עדיין אומרת כמה מחכות לטיפול, כך שמה שדורש פעולה
    לא נעלם. אותו דפוס של דף המרקורים (`details.card.collapse`). %>
<details class="card collapse" id="unmatched-cash">
  <summary>
    <span class="caret">▸</span> <strong>שולם מהפדיון — יש להתאים</strong>
    <% if (unmatchedCash && unmatchedCash.length) { %> <span class="badge b-on_hold" title="יש תשלומי מזומן שדורשים התאמה לחשבונית"><%= unmatchedCash.length %> לטיפול</span><% } else { %> <span class="muted">(0)</span><% } %>
  </summary>
  <div style="margin-top:.8rem">
    <%# טבלה אחת משותפת ללוח הבקרה ולדף המרקורים — partials/_unmatchedCash.ejs. %>
    <%- include('partials/_unmatchedCash', {
          rows: unmatchedCash, settled: (typeof settledCash !== 'undefined' ? settledCash : []),
          matched: (typeof matchedCash !== 'undefined' ? matchedCash : []), pendingSettle: (typeof pendingSettle !== 'undefined' ? pendingSettle : []), contacts: (typeof waContacts !== 'undefined' ? waContacts : []),
          settleOk: (typeof cashSettleReady !== 'undefined') && cashSettleReady, returnTo: '/',
        }) %>
  </div>
</details>

<div class="card">
  <h2 style="margin:0 0 .5rem">היסטוריית הפקדות</h2>
  <%# אותה טבלה בדיוק של דף המרקורים — partials/_deposits.ejs. %>
  <%- include('partials/_deposits', {
        rows: depositsHistory,
        verify: (typeof depVerify !== 'undefined' ? depVerify : new Map()),
        zdiff: (typeof depZDiff !== 'undefined' ? depZDiff : new Map()),
        actions: false,
        grouped: true,
      }) %>
</div>

<div class="card">
  <h2 style="margin:0 0 .5rem">דוחות Z</h2>
  <% if (zStatus && zStatus.ok) { %>
    <p><span class="badge b-approved">תקין</span> — אין פערים ברצף מספרי ה-Z.</p>
  <% } else { %>
    <% (zStatus ? zStatus.gaps : []).forEach(function(g){ %>
      <div style="margin:0 0 .8rem">
        <p style="margin:0 0 .3rem"><span class="badge b-blocked">חסר זד מספר <%= g.from === g.to ? g.from : (g.from + '-' + g.to) %></span> <span class="muted"><%= g.storeName %></span></p>
        <table>
          <thead><tr><th>מיקום</th><th>מספר Z</th><th>תאריך</th><th class="right">סכום</th></tr></thead>
          <tbody>
            <% [['לפני', g.before], ['אחרי', g.after]].forEach(function(pair){ var pos = pair[0], z = pair[1]; %>
              <tr>
                <td><%= pos %></td>
                <% if (z) { %>
                  <td class="mono"><a href="/reports/zreports/<%= z.id %>"><%= z.z_number %></a></td>
                  <td><%= formatDate(z.z_date) %></td>
                  <td class="right"><%= formatIls(z.daily_total) %></td>
                <% } else { %>
                  <td colspan="3" class="muted">—</td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  <% } %>
</div>

<%# 🔴 העברה בבנק ללא תיעוד — בתחתית ומכווץ כברירת מחדל (בעלים, 16/10). הכותרת עדיין אומרת כמה. %>
<% if (typeof untrackedTransfers !== 'undefined' && untrackedTransfers && untrackedTransfers.length) { %>
<details class="card collapse" id="untracked-transfers" style="border-color:var(--color-bad)">
  <summary>
    <span class="caret">▸</span> <strong style="color:var(--color-bad)">🔴 העברה בבנק ללא תיעוד</strong>
    <span class="badge b-blocked"><%= untrackedTransfers.length %></span>
  </summary>
  <div style="margin-top:.8rem">
    <p class="muted" style="margin:0 0 .4rem">העברות שיצאו מהחשבון (בבנק: "העב׳ במקבץ-נט" / "העברה מהבנק") ואין מאחוריהן בקשת העברה מוצהרת. פירוט וטיפול ב<a href="/transfers">העברות בנקאיות</a>.</p>
    <div class="table-scroll"><table>
      <thead><tr><th>תאריך</th><th class="right">סכום</th><th>חנות</th><th>תיאור</th></tr></thead>
      <tbody>
        <% untrackedTransfers.slice(0, 8).forEach(function(t){ %>
          <tr>
            <td class="mono"><%= formatDate(t.txn_date) %></td>
            <td class="right neg"><%= formatIls(t.amount) %></td>
            <td><%= t.store_name %></td>
            <td><%= t.description || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  </div>
</details>
<% } %>
<%- include('partials/footer') %>
