<%- include('partials/header') %>
<h1>לוח בקרה</h1>

<div class="card no-print">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:12px">
    <h2 style="margin:0">פעולות מהירות</h2>
    <details class="menu open-in">
      <summary class="btn btn-primary">אפשרויות <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <a href="/invoices/new">+ חשבונית חדשה</a>
        <a href="/payments/new">+ תשלום חדש</a>
        <a href="/reports/zreports">+ דוח Z חדש</a>
        <a href="/suppliers/new">+ ספק חדש</a>
        <div class="menu-sep"></div>
        <a href="/payments">מרקורים</a>
        <a href="/reports/profitability">רווחיות</a>
      </div>
    </details>
  </div>
</div>

<div class="card">
  <h2>בדיקת חשבונית / אמצעי תשלום</h2>
  <form method="get" action="/" class="actions" style="flex-wrap:wrap; gap:.6rem; align-items:flex-end" id="lookupForm">
    <div>
      <label class="lbl">חנות</label>
      <select name="store" id="lk_store">
        <option value="">כל החנויות</option>
        <% stores.forEach(function(s){ %>
          <option value="<%= s.id %>" data-company="<%= s.company_id %>" <%= storeId === s.id ? 'selected' : '' %>><%= s.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="lbl">חברה</label>
      <select name="company" id="lk_company">
        <option value="">כל החברות</option>
        <% companies.forEach(function(c){ %>
          <option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="lbl">מספר / שם לחיפוש</label>
      <small class="muted" style="display:block;margin:2px 0 4px">חשבונית / צ׳ק / הקצאה / אסמכתה</small>
      <input name="q" value="<%= q %>" inputmode="text" placeholder="אפשר כמה מופרדים ברווח או פסיק — ולחצו Enter" style="max-width:340px" />
    </div>
    <div>
      <label class="lbl">&nbsp;</label>
      <label style="display:flex;align-items:center;gap:6px;font-weight:400;white-space:nowrap;min-height:44px">
        <input type="checkbox" name="unpaid" value="1" <%= typeof unpaidOnly !== 'undefined' && unpaidOnly ? 'checked' : '' %> style="width:auto;min-height:0" /> רק שלא שולמו
      </label>
    </div>
    <div><button type="submit">חפש</button></div>
  </form>
  <script>
    (function(){
      var store = document.getElementById('lk_store');
      var company = document.getElementById('lk_company');
      if (!store || !company) return;
      // בחירת חנות → שיוך מיידי לחברה שלה.
      store.addEventListener('change', function(){
        var opt = store.options[store.selectedIndex];
        var co = opt && opt.getAttribute('data-company');
        if (co) company.value = co;
      });
      // בחירת חברה → הצג רק את חנויותיה; אם יש חנות אחת בחר אותה, אחרת אפס ל"כל החנויות".
      company.addEventListener('change', function(){
        var co = company.value;
        var matches = [];
        for (var i = 0; i < store.options.length; i++) {
          var o = store.options[i];
          if (o.value === '') { o.hidden = false; continue; }
          var oc = o.getAttribute('data-company');
          o.hidden = !!co && oc !== co;
          if (co && oc === co) matches.push(o);
        }
        var cur = store.options[store.selectedIndex];
        if (store.value && cur && cur.getAttribute('data-company') !== co) store.value = '';
        if (co && matches.length === 1) store.value = matches[0].value;
      });
    })();
  </script>

  <% if (invoiceResults) { %>
    <h3 style="margin:1rem 0 .3rem">חשבוניות (<%= invoiceResults.length %>)</h3>
    <table>
      <thead><tr><th>#</th><th>ספק</th><th>חנות</th><th>מס'</th><th>הקצאה</th><th>תאריך</th><th class="right">סכום</th><th>מס' צ׳ק</th><th>פירעון</th></tr></thead>
      <tbody>
        <% if (invoiceResults.length === 0) { %><tr><td colspan="9" class="muted">אין חשבוניות תואמות.</td></tr><% } %>
        <% invoiceResults.forEach(function(r){ %>
          <tr>
            <td><a href="/invoices/<%= r.id %>"><%= r.id %></a></td>
            <td><%= r.supplier_name %></td>
            <td><%= r.store_name %></td>
            <td class="mono"><%= r.invoice_number %></td>
            <td class="mono"><%= r.allocation_number || '—' %></td>
            <td><%= formatDate(r.invoice_date) %></td>
            <td class="right <%= r.total_amount < 0 ? 'neg' : '' %>"><%= formatIls(r.total_amount) %></td>
            <td class="mono"><%= r.check_number || '—' %></td>
            <td>
              <% if (r.payment_status) { %>
                <span class="badge b-<%= r.payment_status %>"><%= r.payment_status === 'issued' ? 'בחוץ' : r.payment_status === 'cleared' ? 'נפרע' : 'מבוטל' %></span>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <% if (checkResults) { %>
    <h3 style="margin:1rem 0 .3rem">תשלומים (<%= checkResults.length %>)</h3>
    <table>
      <thead><tr><th>אמצעי / מזהה</th><th>ספק</th><th>חשבון</th><th>תאריך</th><th class="right">סכום</th><th>סטטוס</th></tr></thead>
      <tbody>
        <% if (checkResults.length === 0) { %><tr><td colspan="6" class="muted">אין תשלומים תואמים.</td></tr><% } %>
        <% checkResults.forEach(function(c){ %>
          <tr onclick="location='/payments/<%= c.id %>'" style="cursor:pointer">
            <td><%= paymentIdent(c) %></td>
            <td><%= c.supplier_name || '—' %></td>
            <td><%= c.bank_account_name %></td>
            <td><%= formatDate(c.payment_date) %></td>
            <td class="right"><%= formatIls(c.amount) %></td>
            <td><span class="badge b-<%= c.status %>"><%= c.status === 'issued' ? 'בחוץ' : c.status === 'cleared' ? 'נפרע' : 'מבוטל' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <% if (supplierResults) { %>
    <h3 style="margin:1rem 0 .3rem">ספקים (<%= supplierResults.length %>)</h3>
    <table>
      <thead><tr><th>ספק</th><th>טלפון</th><th>מייל</th><th>איש קשר הנה"ח</th><th>סטטוס</th></tr></thead>
      <tbody>
        <% if (supplierResults.length === 0) { %><tr><td colspan="5" class="muted">אין ספקים תואמים.</td></tr><% } %>
        <% supplierResults.forEach(function(s){ %>
          <tr onclick="location='/suppliers/contacts?q=<%= encodeURIComponent(s.name) %>'" style="cursor:pointer">
            <td><strong><%= s.name %></strong></td>
            <td><%= s.phone || '—' %></td>
            <td><%= s.email || '—' %></td>
            <td><%= s.contact_name || '—' %><%= s.contact_phone ? ' · ' + s.contact_phone : '' %></td>
            <td><span class="badge b-<%= s.status === 'approved' ? 'approved' : s.status === 'blocked' ? 'blocked' : 'on_hold' %>"><%= s.status === 'approved' ? 'מאושר' : s.status === 'blocked' ? 'חסום' : 'ממתין' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="stat-grid">
  <a class="stat" href="/reports/outstanding">
    <div class="num"><%= typeof openChecksCount !== 'undefined' ? openChecksCount : 0 %></div>
    <div class="label">צ׳קים פתוחים</div>
  </a>
  <a class="stat <%= stats.pendingSuppliers ? 'attn' : '' %>" href="/suppliers?status=pending">
    <div class="num"><%= stats.pendingSuppliers %></div>
    <div class="label">ספקים ממתינים לאישור</div>
  </a>
  <a class="stat <%= stats.onHoldInvoices ? 'attn' : '' %>" href="/invoices?status=on_hold">
    <div class="num"><%= stats.onHoldInvoices %></div>
    <div class="label">חשבוניות מוחזקות</div>
  </a>
  <a class="stat" href="/reconciliation">
    <div class="num" style="font-size:22px"><%= stats.lastReconciledAt ? formatDate(String(stats.lastReconciledAt).slice(0,10)) : '—' %></div>
    <div class="label">התאמת בנק אחרונה</div>
  </a>
  <div class="stat oc-tile" style="position:relative; display:flex; align-items:flex-start; gap:10px">
    <details class="menu up no-print" style="flex:0 0 auto">
      <summary class="icon-circle sm" title="בחירת חנות" aria-label="בחירת חנות" style="list-style:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9M4 9h16M9 20v-6h6v6"/></svg>
      </summary>
      <div class="menu-panel" style="min-width:220px">
        <div class="menu-cap">צ׳קים בחוץ לפי חנות</div>
        <a href="/?<%= ocLinkBase %><%= ocLinkBase ? '&' : '' %>oc_store=" class="<%= !ocStore ? 'active' : '' %>">כל החנויות</a>
        <% ocAccounts.forEach(function(a){ %>
          <a href="/?<%= ocLinkBase %><%= ocLinkBase ? '&' : '' %>oc_store=<%= a.store_id %>" class="<%= ocStore === a.store_id ? 'active' : '' %>"><%= a.store_name %></a>
        <% }); %>
      </div>
    </details>
    <a href="/reports/outstanding" style="flex:1 1 auto; min-width:0; color:inherit; text-decoration:none">
      <div class="num"><%= formatIls(outstandingDisplay) %></div>
      <div class="label">צ׳קים בחוץ<%= ocSelectedName ? ' · ' + ocSelectedName : ' · כל החנויות' %></div>
    </a>
  </div>
</div>

<div class="card">
  <h2 style="margin:0 0 .5rem">תשלום במזומן ללא התאמה</h2>
  <table>
    <thead><tr><th>תאריך</th><th>שם</th><th>עבור</th><th class="right">סכום</th><th>Z</th></tr></thead>
    <tbody>
      <% if (!unmatchedCash || unmatchedCash.length === 0) { %><tr><td colspan="5" class="muted">אין הוצאות מזומן ללא התאמה.</td></tr><% } %>
      <% (unmatchedCash || []).forEach(function(e){ %>
        <tr>
          <td><%= formatDate(e.expense_date) %></td>
          <td><%= e.payer_name || '—' %></td>
          <td><%= e.purpose || '—' %></td>
          <td class="right"><%= formatIls(e.amount) %></td>
          <td><a href="/reports/zreports/<%= e.z_report_id %>">Z <%= e.z_number %></a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2 style="margin:0 0 .5rem">הסטורית הפקדות</h2>
  <table class="sortable">
    <thead><tr><th>מספר שקית</th><th class="right">סכום הפקדה</th><th>תאריך</th><th>הופקד</th><th class="right">יתרה / זכות</th></tr></thead>
    <tbody>
      <% if (!depositsHistory || depositsHistory.length === 0) { %><tr><td colspan="5" class="muted">אין הפקדות.</td></tr><% } %>
      <% (depositsHistory || []).forEach(function(d){ %>
        <tr>
          <td class="mono"><%= d.bag_number || '—' %></td>
          <td class="right"><%= formatIls(d.amount) %></td>
          <td><%= formatDate(d.deposit_date) %></td>
          <td><% if (d.deposited) { %><span class="badge b-approved">הופקד</span><% } else { %><span class="badge b-on_hold">לא הופקד</span><% } %></td>
          <td class="right">
            <% if (d.recon_diff == null) { %><span class="muted">—</span>
            <% } else if (d.recon_diff === 0) { %><span class="badge b-approved">מאוזן</span>
            <% } else if (d.recon_diff > 0) { %><span class="badge b-cleared">יתרה <%= formatIls(d.recon_diff) %></span>
            <% } else { %><span class="badge b-blocked">חוסר <%= formatIls(-d.recon_diff) %></span><% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="muted" style="margin:.4rem 0 0">"יתרה / זכות" מתמלא רק לאחר התאמת בנקים.</p>
</div>

<div class="card">
  <h2 style="margin:0 0 .5rem">דוחות Z</h2>
  <% if (zStatus && zStatus.ok) { %>
    <p><span class="badge b-approved">תקין</span> — אין פערים ברצף מספרי ה-Z.</p>
  <% } else { %>
    <% (zStatus ? zStatus.gaps : []).forEach(function(g){ %>
      <div style="margin:0 0 .8rem">
        <p style="margin:0 0 .3rem"><span class="badge b-blocked">חסר זד מספר <%= g.from === g.to ? g.from : (g.from + '-' + g.to) %></span> <span class="muted"><%= g.storeName %></span></p>
        <table>
          <thead><tr><th>מיקום</th><th>מספר Z</th><th>תאריך</th><th class="right">סכום</th></tr></thead>
          <tbody>
            <% [['לפני', g.before], ['אחרי', g.after]].forEach(function(pair){ var pos = pair[0], z = pair[1]; %>
              <tr>
                <td><%= pos %></td>
                <% if (z) { %>
                  <td class="mono"><a href="/reports/zreports/<%= z.id %>"><%= z.z_number %></a></td>
                  <td><%= formatDate(z.z_date) %></td>
                  <td class="right"><%= formatIls(z.daily_total) %></td>
                <% } else { %>
                  <td colspan="3" class="muted">—</td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  <% } %>
</div>
<%- include('partials/footer') %>
