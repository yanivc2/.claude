<%- include('../partials/header') %>
<div class="toolbar" style="align-items:center">
  <h1 style="margin:0">צילום חשבונית</h1>
  <div class="actions no-print">
    <a href="/scan/pending" class="btn btn-secondary">ממתינות לאישור</a>
  </div>
</div>

<% if (!aiEnabled) { %>
  <div class="alert alert-warn">
    <strong>החילוץ האוטומטי אינו פעיל.</strong>
    לא הוגדר מפתח API לשירות החילוץ, ולכן לא ניתן לשלוח צילומים לעיבוד. פנו לבעלים.
  </div>
<% } else { %>

<div class="card">
  <label class="lbl">חנות *</label>
  <select id="scanStore">
    <option value="">— בחר חנות —</option>
    <% stores.forEach(function(st){ %>
      <option value="<%= st.id %>"><%= st.name %> · <%= st.company_name %></option>
    <% }); %>
  </select>
  <%# Naming the supplier before the shot is what lets its learned profile ("הסקיל") travel with
      the very first extraction. Optional on purpose: an employee who does not know the supplier
      just shoots, and the system matches it from the document as before. %>
  <label class="lbl" style="margin-top:var(--space-3)">ספק (לא חובה — משפר את הזיהוי)</label>
  <select id="scanSupplier">
    <option value="">— לא יודע / לא רלוונטי —</option>
    <% suppliers.forEach(function(sp){ %>
      <option value="<%= sp.id %>"><%= sp.name %><%= sp.ready === 'ready' ? ' ✓' : sp.ready === 'learning' ? ' · לומד' : '' %></option>
    <% }); %>
  </select>
  <p class="muted" id="scanSupplierNote" style="margin:.4rem 0 0">בחירת ספק שולחת יחד עם הצילום את מה שהמערכת כבר למדה על מבנה החשבונית שלו.</p>
  <p class="muted" style="margin:.5rem 0 0">צלמו את כל עמודי החשבונית (עד <%= maxPages %> עמודים) — כולם יישלחו יחד כחשבונית אחת.</p>
</div>

<div class="card">
  <%# The phone's own camera app, not a viewfinder in the page: it brings autofocus, HDR and
      multi-frame denoise that a getUserMedia frame grab does not, and that difference was
      measurable on real invoices. Each returned page is scored for sharpness in scan-capture.js. %>
  <div class="scan-actions">
    <button type="button" class="btn btn-primary btn-block" id="btnCamera">צלם עמוד 📷</button>
    <button type="button" class="btn btn-secondary btn-block" id="btnFiles">בחר קבצים 🗂️ (גלריה / Genius Scan)</button>
  </div>

  <input type="file" id="camInput" accept="image/*" capture="environment" hidden />
  <input type="file" id="fileInput" accept="image/*,image/heic,image/heif,application/pdf" multiple hidden />

  <div id="scanErr" class="alert alert-error" style="display:none;margin-top:var(--space-3)"></div>
  <div id="scanBlurWarn" class="alert alert-warn" style="display:none;margin-top:var(--space-3)"></div>
  <div id="scanThumbs" class="scan-thumbs"></div>
  <p class="muted" id="scanCount" style="margin:.6rem 0 0">עדיין לא נוספו עמודים.</p>

  <div id="scanProgress" class="scan-progress" style="display:none"><div id="scanProgressBar"></div></div>

  <div class="actions" style="margin-top:var(--space-3)">
    <button type="button" class="btn btn-primary" id="btnSend" disabled>שלח לעיבוד ←</button>
  </div>
</div>

<details class="card scan-tips">
  <summary>איך מקבלים את התוצאה הטובה ביותר (ובזול)</summary>
  <ul>
    <li><strong>המערכת בודקת חדות אחרי כל צילום.</strong> מסגרת ירוקה = חד, מסגרת אדומה = מטושטש. אפשר לשלוח גם צילום מטושטש, אבל הקריאה תהיה פחות מדויקת — עדיף ללחוץ "צלם שוב".</li>
    <li><strong>לחצו על עמוד כדי לראות אותו בגדול</strong> ולוודא שהמספרים קריאים לפני השליחה.</li>
    <li><strong>עדיף לצלם מתוך האפליקציה מאשר להעלות PDF.</strong> כל עמוד PDF נקרא גם כטקסט ולא רק כתמונה, ולכן עולה יותר על כל סריקה. קובץ PDF עדיין נתמך במלואו — פשוט יקר יותר.</li>
    <li><strong>צבע לא מייקר כלום.</strong> העלות נקבעת לפי מידות התמונה בלבד, לכן אנחנו שומרים על צבע — הוא עוזר לזהות חותמות, סכומים מודגשים וזיכויים.</li>
    <li>הניחו את החשבונית על משטח בהיר ושטוח, בלי צל של היד, ותנו לטלפון רגע להתמקד לפני הלחיצה.</li>
  </ul>
</details>

<%# Full-size look at a captured page before sending it. A 104px thumbnail cannot answer "did the
    numbers come out readable?", which is exactly the question the sharpness verdict raises. %>
<dialog id="pageDlg" class="dlg wide">
  <div class="dlg-head">
    <strong>עמוד שצולם</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <img id="pageDlgImg" src="" alt="עמוד שצולם" style="max-width:100%;max-height:74vh;border:1px solid var(--color-line);border-radius:var(--radius-md)" />
  <p class="muted" id="pageDlgCap" style="margin:.5rem 0 0"></p>
</dialog>

<script type="application/json" id="scanConfig"><%- JSON.stringify({
  maxPages: maxPages,
  maxEdge: maxEdge,
  jpegQuality: jpegQuality,
  maxUploadBytes: maxUploadMb * 1024 * 1024,
  maxTotalBytes: 18 * 1024 * 1024,
}) %></script>
<%# Versioned so a new deploy is picked up: the service worker caches this cache-first by full URL. %>
<script src="/scan-capture.js?v=<%= encodeURIComponent(typeof buildVersion !== 'undefined' ? buildVersion : 'dev') %>" defer></script>
<% } %>
<%- include('../partials/footer') %>
