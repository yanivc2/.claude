<%- include('../partials/header') %>
<div class="toolbar" style="align-items:center">
  <h1 style="margin:0">צילום חשבונית</h1>
  <div class="actions no-print">
    <a href="/scan/pending" class="btn btn-secondary">ממתינות לאישור</a>
  </div>
</div>

<% if (!aiEnabled) { %>
  <div class="alert alert-warn">
    <strong>החילוץ האוטומטי אינו פעיל.</strong>
    לא הוגדר מפתח API לשירות החילוץ, ולכן לא ניתן לשלוח צילומים לעיבוד. פנו לבעלים.
  </div>
<% } else { %>

<div class="card">
  <label class="lbl">חנות *</label>
  <select id="scanStore">
    <option value="">— בחר חנות —</option>
    <% stores.forEach(function(st){ %>
      <option value="<%= st.id %>"><%= st.name %> · <%= st.company_name %></option>
    <% }); %>
  </select>
  <p class="muted" style="margin:.5rem 0 0">צלמו את כל עמודי החשבונית (עד <%= maxPages %> עמודים) — כולם יישלחו יחד כחשבונית אחת.</p>
</div>

<div class="card">
  <div class="scan-actions">
    <button type="button" class="btn btn-primary btn-block" id="btnCamera">צלם עמוד 📷</button>
    <button type="button" class="btn btn-secondary btn-block" id="btnFiles">בחר קבצים 🗂️ (גלריה / Genius Scan)</button>
  </div>
  <input type="file" id="camInput" accept="image/*" capture="environment" hidden />
  <input type="file" id="fileInput" accept="image/*,application/pdf" multiple hidden />

  <div id="scanErr" class="alert alert-error" style="display:none;margin-top:var(--space-3)"></div>
  <div id="scanThumbs" class="scan-thumbs"></div>
  <p class="muted" id="scanHint" style="margin:.6rem 0 0">עדיין לא נוספו עמודים.</p>

  <div class="actions" style="margin-top:var(--space-3)">
    <button type="button" class="btn btn-primary" id="btnSend" disabled>שלח לעיבוד ←</button>
  </div>
</div>

<script>
(function(){
  var MAX_PAGES = <%= maxPages %>;
  var MAX_EDGE = 2000;          // הצד הארוך אחרי הקטנה
  var JPEG_Q = 0.85;            // איכות — צבע נשמר, אין המרה לשחור-לבן
  var pages = [];               // [{file, url, isPdf}]
  var store = document.getElementById('scanStore');
  var thumbs = document.getElementById('scanThumbs');
  var hint = document.getElementById('scanHint');
  var errBox = document.getElementById('scanErr');
  var btnSend = document.getElementById('btnSend');
  var camInput = document.getElementById('camInput');
  var fileInput = document.getElementById('fileInput');

  // זכירת החנות האחרונה שנבחרה במכשיר הזה
  try {
    var last = localStorage.getItem('scanStoreId');
    if (last) { store.value = last; }
  } catch (e) {}
  store.addEventListener('change', function(){
    try { localStorage.setItem('scanStoreId', store.value); } catch (e) {}
    sync();
  });

  function showError(msg){ errBox.textContent = msg; errBox.style.display = msg ? 'block' : 'none'; }

  function sync(){
    btnSend.disabled = !(pages.length > 0 && store.value);
    hint.textContent = pages.length
      ? ('נוספו ' + pages.length + ' עמודים' + (store.value ? '' : ' — יש לבחור חנות'))
      : 'עדיין לא נוספו עמודים.';
  }

  function render(){
    thumbs.innerHTML = '';
    pages.forEach(function(p, i){
      var card = document.createElement('div');
      card.className = 'scan-thumb';
      var inner = p.isPdf
        ? '<div class="scan-thumb-pdf">📄</div>'
        : '<img src="' + p.url + '" alt="עמוד ' + (i+1) + '" />';
      card.innerHTML = inner + '<span class="scan-thumb-no">' + (i+1) + '</span>'
        + '<button type="button" class="scan-thumb-x" aria-label="הסר עמוד">✕</button>';
      card.querySelector('.scan-thumb-x').addEventListener('click', function(){
        if (pages[i].url && !pages[i].isPdf) URL.revokeObjectURL(pages[i].url);
        pages.splice(i, 1); render(); sync();
      });
      thumbs.appendChild(card);
    });
  }

  /* הקטנה בצבע: מצמצמים את הצד הארוך ל-2000px ומקודדים מחדש ל-JPEG. אין גווני אפור —
     חשבונית צבעונית נקראת טוב יותר ע"י המודל. PDF עובר כמו שהוא. */
  function downscale(file, cb){
    if (!/^image\//.test(file.type)) { cb(file); return; }
    var url = URL.createObjectURL(file), img = new Image();
    img.onload = function(){
      var w = img.naturalWidth, h = img.naturalHeight;
      var s = Math.min(1, MAX_EDGE / Math.max(w, h));
      w = Math.round(w * s); h = Math.round(h * s);
      var c = document.createElement('canvas'); c.width = w; c.height = h;
      c.getContext('2d').drawImage(img, 0, 0, w, h);
      URL.revokeObjectURL(url);
      c.toBlob(function(blob){
        cb(blob ? new File([blob], 'page.jpg', { type: 'image/jpeg' }) : file);
      }, 'image/jpeg', JPEG_Q);
    };
    img.onerror = function(){ URL.revokeObjectURL(url); cb(file); };
    img.src = url;
  }

  function addFiles(list){
    showError('');
    var files = Array.prototype.slice.call(list || []);
    if (!files.length) return;
    if (pages.length + files.length > MAX_PAGES) {
      showError('אפשר לצרף עד ' + MAX_PAGES + ' עמודים לחשבונית.');
      files = files.slice(0, Math.max(0, MAX_PAGES - pages.length));
    }
    var left = files.length;
    if (!left) return;
    files.forEach(function(f){
      downscale(f, function(out){
        var isPdf = /pdf$/i.test(out.type);
        pages.push({ file: out, isPdf: isPdf, url: isPdf ? null : URL.createObjectURL(out) });
        left -= 1;
        if (left === 0) { render(); sync(); }
      });
    });
  }

  document.getElementById('btnCamera').addEventListener('click', function(){ camInput.click(); });
  document.getElementById('btnFiles').addEventListener('click', function(){ fileInput.click(); });
  camInput.addEventListener('change', function(){ addFiles(camInput.files); camInput.value = ''; });
  fileInput.addEventListener('change', function(){ addFiles(fileInput.files); fileInput.value = ''; });

  btnSend.addEventListener('click', function(){
    if (!pages.length || !store.value) return;
    showError('');
    btnSend.disabled = true;
    var label = btnSend.textContent;
    btnSend.textContent = 'מעלה…';
    var fd = new FormData();
    fd.append('store_id', store.value);
    pages.forEach(function(p, i){
      var ext = p.isPdf ? '.pdf' : '.jpg';
      fd.append('images', p.file, 'page-' + (i+1) + ext);
    });
    fetch('/scan/upload', { method: 'POST', body: fd })
      .then(function(r){ return r.json().then(function(j){ return { ok: r.ok, body: j }; }); })
      .then(function(res){
        if (!res.ok || !res.body.id) throw new Error((res.body && res.body.error) || 'ההעלאה נכשלה');
        location.href = '/scan/' + res.body.id;
      })
      .catch(function(e){
        showError(e.message || 'ההעלאה נכשלה — נסו שוב');
        btnSend.textContent = label; btnSend.disabled = false;
      });
  });

  sync();
})();
</script>
<% } %>
<%- include('../partials/footer') %>
