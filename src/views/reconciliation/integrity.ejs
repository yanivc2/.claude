<%- include('../partials/header') %>
<div class="toolbar">
  <h1>🔍 בדיקת שיוך לחשבון</h1>
  <a class="btn btn-secondary" href="/reconciliation<%= account ? '?account=' + account.id : '' %>">← חזרה להתאמת בנק</a>
</div>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (!account || !result) { %>
  <div class="alert alert-warn">לא נבחר חשבון בנק.</div>
<% } else { var r = result; var ok = !r.breaks.length && !r.duplicates.length && !r.foreignChecks.length; %>
  <div class="card no-collapse">
    <p style="margin:0 0 .4rem"><strong><%= account.display_name %></strong> ·
      <%= r.rowsTotal %> תנועות<% if (r.firstDate) { %> מ-<%= formatDate(r.firstDate) %> עד <%= formatDate(r.lastDate) %><% } %>.</p>
    <% if (ok) { %>
      <div class="alert alert-ok" style="margin:0">✓ לא נמצא שום סימן לתנועה של חשבון אחר.
        <% if (r.daysChecked) { %>רצף היתרות נבדק על פני <%= r.daysChecked %> ימים ומתיישב בכל אחד מהם.<% } %></div>
    <% } else { %>
      <%# אומר **איפה** — הבאנר לבדו שלח את הבעלים לחפש בדף שבו רוב הסעיפים ירוקים. %>
      <div class="alert alert-warn" style="margin:0">נמצאו ממצאים שדורשים בדיקה:
        <%= [r.breaks.length ? 'סעיף 1 — ' + r.breaks.length + ' שברים ברצף היתרות' : null,
             r.duplicates.length ? 'סעיף 2 — ' + r.duplicates.length + ' תנועות שקיימות גם בחשבון אחר' : null,
             r.foreignChecks.length ? 'סעיף 3 — ' + r.foreignChecks.length + ' צ׳קים מפנקס של חשבון אחר' : null].filter(Boolean).join(' · ') %>. פירוט למטה.</div>
    <% } %>
    <% if (!r.rowsWithBalance && r.rowsTotal) { %>
      <p class="muted" style="margin:.5rem 0 0">לתנועות בחשבון הזה אין "יתרה לאחר פעולה" (משיכה מהבנק או הזנה ידנית), ולכן רצף היתרות לא נבדק — רק שתי הבדיקות האחרות.</p>
    <% } else if (r.rowsWithBalance < r.rowsTotal) { %>
      <p class="muted" style="margin:.5rem 0 0"><%= r.rowsWithBalance %> מתוך <%= r.rowsTotal %> תנועות נושאות יתרה; ימים בלי יתרה נספרים בסכום אבל אינם נבדקים בעצמם.</p>
    <% } %>
    <% if (r.partialDays && r.partialDays.length) { %>
      <p class="muted" style="margin:.4rem 0 0"><%= r.partialDays.length %> ימים לא נבדקו ברצף היתרות: הקובץ שיובא כולל רק חלק מהתנועות של אותם ימים, ושאר התנועות הגיעו מהמשיכה בלי יתרה — כך שהיתרה שבקובץ היא באמצע היום ולא בסופו, ואין דרך להשוות. כדי שייבדקו: לייבא דף חשבון <strong>מלא</strong> לתקופה (כל התנועות), והיתרות ייכנסו לשורות הקיימות.</p>
    <% } %>
  </div>

  <div class="card no-collapse">
    <h2 style="margin:0 0 .3rem">1. רצף היתרות</h2>
    <p class="muted" style="margin:0 0 .5rem">בחשבון אחד היתרה בסוף כל יום = היתרה של היום הקודם + תנועות היום. שבר ברצף אומר שבאותו יום <strong>נכנסו תנועות שאינן של החשבון</strong> — או ש<strong>חסרות תנועות</strong> (תקופה שלא יובאה). ההפרש מראה בכמה.</p>
    <% if (!r.breaks.length) { %><p style="margin:0">✓ <%= r.daysChecked ? 'הרצף שלם.' : 'אין מספיק יתרות כדי לבדוק.' %></p>
    <% } else { %>
      <div class="table-scroll"><table>
        <thead><tr><th>תאריך</th><th class="right">יתרה צפויה</th><th class="right">יתרה בבנק</th><th class="right">הפרש</th><th>קבצים באותו יום</th><th>מה זה כנראה</th></tr></thead>
        <tbody>
          <% r.breaks.forEach(function(b){ var range = (b.since && b.since !== b.date) ? ('בין ' + formatDate(b.since) + ' ל-' + formatDate(b.date)) : ('ב-' + formatDate(b.date)); %>
            <tr>
              <td><%= formatDate(b.date) %></td>
              <td class="right"><%= formatIls(b.expected) %></td>
              <td class="right"><%= formatIls(b.found) %></td>
              <td class="right" dir="ltr"><strong style="color:var(--color-bad)"><%= b.diff > 0 ? '+' : '' %><%= formatIls(b.diff) %></strong></td>
              <td><%= b.files.join(' · ') || '—' %></td>
              <td style="font-size:13px">
                <%# ההפרש = מה שבבנק פחות מה שחושב. שורה בחלון בסכום ‎-הפרש = כנראה מיותרת אצלנו; אחרת חסרה תנועה. %>
                <% if (b.suspects && b.suspects.length && b.suspects[0].why === 'twice') { %>
                  שורות שנקלטו <strong>פעמיים</strong> (עותק אחד מיותר): <% b.suspects.forEach(function(x, i){ %><%= i ? ' · ' : '' %><%= formatDate(x.date) %> <%= x.description || '' %> <span dir="ltr"><%= formatIls(x.amount) %></span><% }); %>
                <% } else if (b.suspects && b.suspects.length) { %>
                  שורה שכנראה <strong>מיותרת</strong> אצלנו: <% b.suspects.forEach(function(x, i){ %><%= i ? ' · ' : '' %><%= formatDate(x.date) %> <%= x.description || '' %> <span dir="ltr"><%= formatIls(x.amount) %></span><% }); %>
                <% } else { %>
                  חסרה כנראה תנועה של <strong dir="ltr"><%= b.diff > 0 ? '+' : '-' %><%= formatIls(Math.abs(b.diff)) %></strong> (<%= b.diff > 0 ? 'זיכוי' : 'חיוב' %>) <%= range %> — לחפש אותה בדף הבנק.
                <% } %>
                <%# השורות עצמן — כדי שאפשר יהיה להשוות לדף הבנק שורה מול שורה. %>
                <% if (b.around && b.around.length) { %>
                  <details style="margin-top:.35rem">
                    <summary class="muted" style="cursor:pointer">השורות אצלנו סביב השבר (<%= b.around.length %>)</summary>
                    <div class="table-scroll" style="margin-top:.3rem"><table style="font-size:12px">
                      <thead><tr><th>תאריך</th><th>תיאור</th><th>אסמכתא</th><th class="right">סכום</th><th class="right">יתרה</th><th>מקור</th></tr></thead>
                      <tbody>
                        <% b.around.forEach(function(x){ var dup = (b.suspects || []).some(function(s){ return Number(s.id) === Number(x.id); }); %>
                          <tr<%- dup ? ' style="background:color-mix(in srgb, var(--color-bad) 14%, transparent)"' : '' %>>
                            <td><%= formatDate(x.date) %></td><td><%= x.description || '' %></td><td dir="ltr"><%= x.ref || '' %></td>
                            <td class="right" dir="ltr"><%= formatIls(x.amount) %></td><td class="right" dir="ltr"><%= x.balance == null ? '—' : formatIls(x.balance) %></td>
                            <td class="muted"><%= x.source === 'csv' ? ('קובץ' + (x.file ? ' · ' + x.file : '')) : x.source === 'manual' ? 'ידני' : 'משיכה' %><%= x.hasId ? ' · מזהה בנק' : '' %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table></div>
                  </details>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table></div>
    <% } %>
  </div>

  <%# 1א. כפילויות קובץ↔משיכה — הסיבה הנפוצה לשבר ברצף (services/bankDuplicates.js). זוג מוצע לאיחוד
      רק כשהסרת העותק מאזנת את היום בדיוק; השאר מוצגים לבדיקה ולא נוגעים בהם. %>
  <% var dp = (typeof dups !== 'undefined' && dups) ? dups : null; %>
  <% if (dp) { var unver = dp.pairs.filter(function(p){ return !(p.verified && !p.conflict); }); %>
  <div class="card no-collapse">
    <h2 style="margin:0 0 .3rem">1א. אותה תנועה פעמיים בחשבון הזה</h2>
    <p class="muted" style="margin:0 0 .5rem">שורה שיובאה מקובץ אקסל ונמשכה שוב מהבנק — או שהופיעה בשני קבצים בתאריכים שונים (הבנק הזיז את התאריך בין ייצוא לייצוא) — אותו סכום, עד 3 ימים הפרש. <strong>מוצע לאיחוד רק מה שהסרתו מאזנת את רצף היתרות בדיוק</strong>, כלומר החשבון עצמו מוכיח שזו כפילות. באיחוד נשארת השורה עם היתרה (ועם מזהה הבנק, כדי שמשיכה הבאה לא תכפיל שוב), וכל התאמה שהייתה על העותק — תשלום, הפקדה, שכר — עוברת אליה.</p>
    <p class="muted" style="margin:0 0 .5rem;font-size:12px">נבדקו <%= dp.fileRows %> שורות מקובץ מול <%= dp.pulledRows %> שורות שנמשכו מהבנק · נמצאו <%= dp.pairs.length %> זוגות אפשריים.
      <%# פירוט לאבחון: מה יכול למנוע זיווג (שתי שורות עם מזהה בנק לא מזווגות; שורת משיכה עם יתרה לא נחשבת עותק). %>
      (<%= dp.fileWithId %> משורות הקובץ נושאות מזהה בנק · <%= dp.pulledNoId %> משורות המשיכה בלי מזהה · <%= dp.pulledWithBalance %> משורות המשיכה עם יתרה)
      <% if (dp.channels && dp.channels.length) { %><br />ערוצי משיכה: <%= dp.channels.map(function(c){ return c.name + ' ×' + c.n; }).join(' · ') %><% } %></p>
    <% if (!dp.pairs.length && (!dp.fileRows || !dp.pulledRows)) { %>
      <p style="margin:0">✓ אין בחשבון גם שורות מקובץ וגם שורות משיכה — אין כאן כפילויות מהסוג הזה.</p>
    <% } else if (!dp.pairs.length) { %>
      <p style="margin:0">✓ לא נמצאה שורת קובץ שיש לה תאומה מהמשיכה.</p>
    <% } else if (dp.mergeable.length) { %>
      <p style="margin:0 0 .5rem"><strong><%= dp.mergeable.length %></strong> כפילויות מאומתות · שברים ברצף היתרות: <strong><%= dp.breaksBefore %></strong> עכשיו → <strong><%= dp.breaksAfter %></strong> אחרי האיחוד.</p>
      <div class="table-scroll"><table>
        <thead><tr><th>תאריך — נשארת</th><th>תאריך — העותק</th><th class="right">סכום</th><th>תיאור — נשארת</th><th>תיאור — העותק</th><th>מאיפה העותק</th><th>התאמה על העותק</th></tr></thead>
        <tbody>
          <% dp.mergeable.forEach(function(p){ %>
            <tr><td><%= formatDate(p.keep.txn_date) %></td><td><%= formatDate(p.drop.txn_date) %></td><td class="right"><%= formatIls(p.keep.amount) %></td>
              <td><%= p.keep.description || '' %></td><td><%= p.drop.description || '' %></td>
              <td class="muted"><%= p.kind === 'days' ? ('קובץ קודם, תאריך אחר' + (p.drop.file_name ? ' · ' + p.drop.file_name : '')) : 'משיכה מהבנק' %></td>
              <td><%= p.dropMatched ? 'כן — תעבור' : '—' %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
      <% if (currentUser && currentUser.role === 'owner') { %>
        <form method="post" action="/reconciliation/integrity/merge" data-busy="מאחד…" style="margin-top:.6rem"
              onsubmit="return confirm('לאחד <%= dp.mergeable.length %> כפילויות? בכל זוג נשארת השורה עם היתרה, והעותק נמחק (ההתאמות שלו עוברות).');">
          <input type="hidden" name="account_id" value="<%= account.id %>" />
          <button type="submit">🧹 אחד <%= dp.mergeable.length %> כפילויות מאומתות</button>
        </form>
      <% } else { %>
        <p class="muted" style="margin:.5rem 0 0">האיחוד מוחק שורות בנק ולכן נעשה ע"י הבעלים.</p>
      <% } %>
    <% } else { %>
      <p style="margin:0">אין זוג שמאזן יום בדיוק — לא מוצע איחוד אוטומטי.</p>
    <% } %>
    <% if (unver.length) { %>
      <details style="margin-top:.6rem">
        <summary class="muted" style="cursor:pointer"><%= unver.length %> זוגות נוספים לא אומתו — לא יאוחדו</summary>
        <div class="table-scroll" style="margin-top:.4rem"><table>
          <thead><tr><th>תאריך (קובץ)</th><th>תאריך (בנק)</th><th class="right">סכום</th><th>תיאור בקובץ</th><th>למה לא</th></tr></thead>
          <tbody>
            <% unver.forEach(function(p){ %>
              <tr><td><%= formatDate(p.keep.txn_date) %></td><td><%= formatDate(p.drop.txn_date) %></td><td class="right"><%= formatIls(p.keep.amount) %></td>
                <td><%= p.keep.description || '' %></td><td class="muted"><%= p.conflict || p.reason %></td></tr>
            <% }); %>
          </tbody>
        </table></div>
      </details>
    <% } %>
  </div>
  <% } %>

  <%# 1ב. אותה תנועה בשתי משיכות — לאבחון בלבד (bankDuplicates#pullTwinPairs). משיכה שהמזהה של התנועות
      השתנה בה מכניסה אותן שוב; כאן רואים כמה, ואיזה חלק במזהה השתנה — לפני שמוחקים משהו. %>
  <% if (dp) { var _pt = dp.pullTwins || []; %>
  <div class="card no-collapse" id="pull-twins">
    <h2 style="margin:0 0 .3rem">1ב. אותה תנועה בשתי משיכות מהבנק</h2>
    <p class="muted" style="margin:0 0 .5rem">הסוכן מושך 60 יום אחורה, ולכן כל משיכה חוזרת על רוב התנועות של הקודמת ומדלגת עליהן לפי המזהה של הבנק. כאן — תנועות שנקלטו <strong>שוב</strong> במשיכה מאוחרת: אותו תאריך, סכום ואסמכתא כמו שורה מייבוא קודם שכבר כיסה את היום הזה. <strong>לאבחון בלבד — שום דבר לא נמחק.</strong></p>
    <% if (!dp.pullTwinCount) { %>
      <p style="margin:0">✓ לא נמצאה תנועה שנקלטה פעמיים בשתי משיכות.</p>
    <% } else { %>
      <p style="margin:0 0 .5rem"><strong><%= dp.pullTwinCount %></strong> תנועות נקלטו פעמיים. מה השתנה במזהה:
        <% dp.pullTwinByDiff.forEach(function(d, i){ %><%= i ? ' · ' : '' %><strong><%= d.diff.replace('date','תאריך').replace('ref','אסמכתא').replace('acct','חשבון').replace('ns','ערוץ').replace('amount','סכום') %></strong> ×<%= d.n %><% }); %>
      </p>
      <div class="table-scroll"><table style="font-size:12px">
        <thead><tr><th>תאריך</th><th class="right">סכום</th><th>תיאור</th><th>אסמכתא</th><th>עותק ראשון — ייבוא</th><th>עותק שני — ייבוא</th><th>מה השתנה</th><th>מזהה ראשון</th><th>מזהה שני</th></tr></thead>
        <tbody>
          <% _pt.forEach(function(p){ %>
            <tr>
              <td><%= formatDate(p.late.txn_date) %></td>
              <td class="right" dir="ltr"><%= formatIls(p.late.amount) %></td>
              <td><%= p.late.description || '' %></td>
              <td dir="ltr"><%= p.late.raw_reference || '' %></td>
              <td class="muted"><%= p.early.import_id == null ? 'לפני המעקב' : '#' + p.early.import_id + (p.early.imported_at ? ' · ' + (israelStamp(p.early.imported_at) || '') : '') %><%= p.early.matched_payment_id ? ' · מותאם' : '' %></td>
              <td class="muted">#<%= p.late.import_id %><%= p.late.imported_at ? ' · ' + (israelStamp(p.late.imported_at) || '') : '' %><%= p.late.matched_payment_id ? ' · מותאם' : '' %></td>
              <td><%= p.diff.join(', ').replace('date','תאריך').replace('ref','אסמכתא').replace('acct','חשבון').replace('ns','ערוץ').replace('amount','סכום') || 'זהה' %></td>
              <td dir="ltr" class="mono" style="font-size:11px; word-break:break-all"><%= p.early.external_id || '—' %></td>
              <td dir="ltr" class="mono" style="font-size:11px; word-break:break-all"><%= p.late.external_id || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table></div>
      <% if (dp.pullTwinCount > _pt.length) { %><p class="muted" style="margin:.4rem 0 0; font-size:12px">מוצגות <%= _pt.length %> ראשונות.</p><% } %>
    <% } %>
  </div>
  <% } %>

  <div class="card no-collapse">
    <h2 style="margin:0 0 .3rem">2. אותה תנועה גם בחשבון אחר</h2>
    <p class="muted" style="margin:0 0 .5rem">תאריך, סכום, אסמכתה ותיאור זהים בשני חשבונות — סימן שאותו קובץ יובא לשניהם.</p>
    <% if (!r.duplicates.length) { %><p style="margin:0">✓ לא נמצאו.</p>
    <% } else { %>
      <div class="table-scroll"><table>
        <thead><tr><th>תאריך</th><th class="right">סכום</th><th>תיאור</th><th>אסמכתה</th><th>קיימת גם ב</th><th>קובץ</th></tr></thead>
        <tbody>
          <% r.duplicates.forEach(function(d){ %>
            <tr><td><%= formatDate(d.txn.txn_date) %></td><td class="right"><%= formatIls(d.txn.amount) %></td><td><%= d.txn.description || '' %></td>
              <td class="mono"><%= d.txn.raw_reference %></td><td><strong><%= d.otherAccount %></strong></td><td><%= d.txn.file_name || '—' %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
    <% } %>
  </div>

  <div class="card no-collapse">
    <h2 style="margin:0 0 .3rem">3. צ׳ק מפנקס של חשבון אחר</h2>
    <p class="muted" style="margin:0 0 .5rem">חיוב שהאסמכתה שלו היא מספר של צ׳ק שהונפק מחשבון אחר, באותו סכום.</p>
    <% if (!r.foreignChecks.length) { %><p style="margin:0">✓ לא נמצאו.</p>
    <% } else { %>
      <div class="table-scroll"><table>
        <thead><tr><th>תאריך</th><th class="right">סכום</th><th>צ׳ק</th><th>הונפק מ</th><th>קובץ</th></tr></thead>
        <tbody>
          <% r.foreignChecks.forEach(function(f){ %>
            <tr><td><%= formatDate(f.txn.txn_date) %></td><td class="right"><%= formatIls(f.txn.amount) %></td>
              <td class="mono"><a href="/payments/<%= f.paymentId %>"><%= f.checkNumber %></a></td><td><strong><%= f.otherAccount %></strong></td><td><%= f.txn.file_name || '—' %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
    <% } %>
  </div>
<% } %>
<%- include('../partials/footer') %>
