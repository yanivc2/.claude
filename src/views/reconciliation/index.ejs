<%- include('../partials/header') %>
<h1>התאמת בנק</h1>
<p class="muted">
  התאמת תנועות חובה מהבנק לצ׳קים פתוחים (R7): לפי סכום + חלון תאריך + כיוון חובה.
  התאמה חד-משמעית מסומנת אוטומטית; שני צ׳קים באותו סכום+חלון מסומנים להכרעתך.
</p>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><%= notice %></div>
<% } %>

<%# הכרטיס העליון (בעלים 18/10, "סדר יותר נכון ויותר ברור"): שורת החשבון; שורת הפעולות היומיות —
    🔄 סנכרן עכשיו · 📄 ייבוא CSV/Excel · ➕ תנועה ידנית; מתחתיה מצב הסנכרון וקוד ה-SMS; ושורת "כלים"
    קטנה — ניקוי לפי קובץ · בדיקת שיוך. בלי טקסט הסבר. מצב מחשב המשרד, המפתח ו"קליטת דוח פדיון"
    עברו להגדרות ← "סנכרון מהבנק". id="bank-sync" + no-collapse: הסקריפט של _bankSync מרענן בתוכו,
    ושדה הקוד לא יוסתר באקורדיון. %>
<% var _bs = (typeof bankSync !== 'undefined' && bankSync) ? bankSync : null;
   var _canImport = !!(accountId && typeof can === 'function' && can('import_bank')); %>
<div class="card no-collapse recon-head"<%- _bs ? ' id="bank-sync"' : '' %>>
  <%# בעלים, 17/10: "לא יהיה אפשרות לבחור חנות בשום מקום חוץ מהסרגל העליון". חשבון בנק הוא 1:1 עם
      חנות (bank_accounts.store_id UNIQUE), ולכן החנות הפעילה קובעת אותו — כאן רק השם, בלי בורר. %>
  <% var _acct = (accounts || []).find(function(a){ return a.id === accountId; }); %>
  <% if (!accountId) { %>
    <%- include('../partials/_needStore', { what: 'התאמת בנק', verb: 'לראות' }) %>
  <% } else { %>
    <p class="recon-account">חשבון בנק: <strong><%= _acct ? _acct.display_name : '' %></strong></p>
  <% } %>

  <% if (_bs || _canImport) { %>
    <div class="actions recon-actions">
      <% if (_bs) { %><%- include('_bankSync', { bankSync: _bs, part: 'action' }) %><% } %>
      <% if (_canImport) { %>
        <button type="button" class="btn-secondary" onclick="document.getElementById('csvDlg').showModal()">📄 ייבוא CSV / Excel</button>
        <button type="button" class="btn-secondary" onclick="document.getElementById('txnDlg').showModal()">➕ הוספת תנועה ידנית</button>
      <% } %>
    </div>
  <% } %>
  <% if (_bs) { %><%- include('_bankSync', { bankSync: _bs, part: 'body' }) %><% } %>

  <% if (typeof financyReady !== 'undefined' && financyReady && accountId) { %>
    <% if (financyLinked) { %>
      <form method="post" action="/reconciliation/sync" class="actions" style="margin-top:var(--space-3)" data-busy>
        <input type="hidden" name="account_id" value="<%= accountId %>" />
        <button type="submit">🏦 משוך תנועות מהבנק</button>
        <span class="muted" style="font-size:12px">
          משיכה ישירה מהבנק (בנקאות פתוחה, קריאה בלבד) במקום ייבוא קובץ — ואז התאמה אוטומטית לצ׳קים.
        </span>
      </form>
    <% } else { %>
      <p class="muted" style="margin-top:var(--space-3); font-size:12px">
        החשבון הזה עדיין לא מקושר ל-Financy. הגדרות ← "קשר חשבונות בנק" כדי לאפשר משיכה ישירה מהבנק.
      </p>
    <% } %>
  <% } %>

  <% if (accountId) { %>
    <div class="actions recon-tools">
      <span class="muted">כלים:</span>
      <% if (_canImport) { %><button type="button" class="btn-secondary btn-sm" onclick="document.getElementById('purgeDlg').showModal()">🧹 ניקוי לפי קובץ</button><% } %>
      <a class="btn btn-secondary btn-sm" href="/reconciliation/integrity?account=<%= accountId %>">🔍 בדיקת שיוך לחשבון</a>
    </div>
  <% } %>
</div>

<%# אסמכתא שנשמרה בכתיב מדעי אינה רק מכוערת: היא לא שווה למספר הצ׳ק ולא למספר שקית ההפקדה,
    ולכן ההתאמה מולה נכשלת בשקט. לכן ההצעה כאן היא לתקן את הנתון, לא להסתיר אותו בעיצוב. %>
<% var odd = (typeof oddRefs !== 'undefined') ? oddRefs : null; %>
<% if (odd && odd.count && typeof can === 'function' && can('import_bank')) { %>
  <%# 🔴 no-collapse: כל כרטיס עם <h2> הוא אקורדיון, ופתיחת "ייבואים אחרונים" סוגרת את כל השאר —
      כלומר הכרטיס הזה נסגר בדיוק כשהמשתמש מסתכל על הבעיה שהוא מתאר. אזהרה עם פעולה לא נסגרת. %>
  <div class="card no-collapse" style="border-color:var(--color-warn)">
    <h2 style="margin:0 0 .4rem">🔢 מספרי אסמכתא בכתיב מדעי</h2>
    <p style="margin:0 0 .5rem">
      ל-<strong><%= odd.count %></strong> תנועות בחשבון הזה נשמרה האסמכתא כפי שקובץ הבנק כתב אותה
      <% if (odd.sample.length) { %>(<%= odd.sample.join(' · ') %>)<% } %> — ולא בספרות.
      זה גם מה שמונע התאמה לפי מספר צ׳ק או מספר שקית הפקדה.
    </p>
    <form method="post" action="/reconciliation/refs/normalize" class="actions" data-busy>
      <input type="hidden" name="account_id" value="<%= accountId %>" />
      <button type="submit">כתוב אותן בספרות</button>
      <span class="muted" style="font-size:12px">אותו מספר בדיוק, כתיב קריא. סכומים, תאריכים והתאמות קיימות לא משתנים.<br />אחרי זה כדאי ללחוץ "התאמה אוטומטית" — צ׳קים שלא נמצאו לפי מספר עשויים להימצא עכשיו.</span>
    </form>
  </div>
<% } %>

<% var pg = (typeof purge !== 'undefined') ? purge : null; %>
<% if (pg) { %>
  <div class="card" style="border-color:var(--color-bad)">
    <h2 style="margin:0 0 .4rem">🧹 ניקוי לפי קובץ<%= pg.fileName ? ' — ' + pg.fileName : '' %></h2>
    <% if (!pg.ids.length && !pg.matchedCount) { %>
      <div class="alert alert-warn" style="margin:0">
        <strong>לא נמצאה אף תנועה מהקובץ הזה בחשבון הזה.</strong>
        ייתכן שהקובץ הועלה לחשבון אחר — בחר אותו למעלה ונסה שוב, או שהשורות כבר נמחקו.
      </div>
    <% } else { %>
      <p style="margin:0 0 .5rem">
        נמצאו <strong><%= pg.ids.length + pg.matchedCount %></strong> תנועות מתוך <%= pg.fileRows %> שורות בקובץ.
        <strong><%= pg.ids.length %></strong> יימחקו<% if (pg.matchedCount) { %>,
        ו-<strong><%= pg.matchedCount %></strong> <span class="badge b-on_hold">מותאמות לצ׳ק — יידלגו</span>
        (בטל את ההתאמה קודם אם צריך למחוק גם אותן)<% } %>.
      </p>
      <div class="table-scroll">
        <table class="no-enhance">
          <thead><tr><th>תאריך</th><th class="right">סכום</th><th>תיאור</th><th>אסמכתא</th></tr></thead>
          <tbody>
            <% pg.rows.forEach(function(r){ %>
              <tr><td><%= formatDate(r.txn_date) %></td><td class="right <%= r.amount < 0 ? 'neg' : '' %>"><%= formatIls(r.amount) %></td>
                  <td><%= r.description || '' %></td><td class="mono"><%= r.raw_reference || '—' %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (pg.ids.length + pg.matchedCount > pg.rows.length) { %>
        <p class="muted" style="margin:.3rem 0 0">מוצגות <%= pg.rows.length %> הראשונות מתוך <%= pg.ids.length + pg.matchedCount %>.</p>
      <% } %>
      <div class="actions" style="margin-top:.6rem">
        <% if (pg.ids.length) { %>
          <form method="post" action="/reconciliation/txns/delete" style="display:inline"
                onsubmit="return confirm('למחוק <%= pg.ids.length %> תנועות שהגיעו מהקובץ הזה? הפעולה אינה הפיכה.');">
            <input type="hidden" name="account_id" value="<%= accountId %>" />
            <% pg.ids.forEach(function(id){ %><input type="hidden" name="txn_ids" value="<%= id %>" /><% }); %>
            <button type="submit" class="danger">🗑️ מחק <%= pg.ids.length %> תנועות</button>
          </form>
        <% } %>
        <%# פרטי בנק שאינם שייכים לחשבון הזה בכלל: ההתאמה שנעשתה מולם היא **התאמת שווא** — הצ׳ק
            לא נפרע בתנועה הזו — ולכן שחרורה הוא התיקון ולא נזק. הצ׳ק חוזר לרשימת הפתוחים
            וממתין לתנועה האמיתית שלו. אישור מפורש, כי זו פעולה על צ׳קים ולא רק על תנועות. %>
        <% if (pg.matchedCount) { %>
          <form method="post" action="/reconciliation/txns/delete" style="display:inline"
                onsubmit="return confirm('למחוק את כל <%= pg.ids.length + pg.matchedCount %> התנועות מהקובץ הזה, כולל <%= pg.matchedCount %> שכבר הותאמו?\n\nההתאמות ישוחררו והצ׳קים יחזרו לרשימת הצ׳קים הפתוחים — נכון כשהתנועות אינן שייכות לחשבון הזה בכלל.\nהפעולה אינה הפיכה.');">
            <input type="hidden" name="account_id" value="<%= accountId %>" />
            <input type="hidden" name="release" value="1" />
            <% pg.ids.concat(pg.matchedIds || []).forEach(function(id){ %><input type="hidden" name="txn_ids" value="<%= id %>" /><% }); %>
            <button type="submit" class="danger">🗑️ מחק את כל <%= pg.ids.length + pg.matchedCount %> ושחרר <%= pg.matchedCount %> התאמות</button>
          </form>
        <% } %>
        <a class="btn btn-secondary" href="/reconciliation?account=<%= accountId %>">ביטול</a>
      </div>
    <% } %>
  </div>
<% } %>

<%# מה הועלה לחשבון הזה. בלי הרובריקה הזו אין שום דרך לדעת מה נכנס, מתי, ועל ידי מי — ולכן גם
    אין דרך לבטל קובץ שנחת בחשבון של חנות אחרת. %>
<% var imps = (typeof imports !== 'undefined' && imports) ? imports : []; %>
<div class="card">
  <h2 style="margin:0 0 .4rem">ייבואים אחרונים לחשבון זה</h2>
  <%# 🔴 לפני שהבעלים לחץ "עדכן מסד נתונים" הטבלה עוד לא קיימת, וה-catch המגן היה מציג "לא יובאו
      קבצים" — כלומר בדיוק אותו שקר בתצוגה שהרובריקה הזו נועדה לתקן. אומרים מה באמת חסר. %>
  <% if (typeof importsReady !== 'undefined' && !importsReady) { %>
    <div class="alert alert-warn" style="margin:0">
      <strong>נדרש עדכון מסד נתונים.</strong> מעקב הייבוא עדיין לא קיים במסד, ולכן אי אפשר להציג
      מה הועלה. היכנס ל<a href="/settings">הגדרות</a> ולחץ <strong>"עדכן מסד נתונים"</strong>, ואז רענן את הדף.
      <br><span class="muted" style="font-size:12px">התנועות עצמן לא נפגעו — רק רשימת הייבואים אינה זמינה.</span>
    </div>
  <% } else { %>
  <%# תנועות שהועלו לפני שהמעקב קיים אין להן ייבוא מזוהה. לומר את זה — עדיף על "לא יובאו קבצים"
      מול חשבון שמלא בתנועות. %>
  <% var untr = (typeof untracked !== 'undefined') ? untracked : null; %>
  <% if (untr) { %>
    <div class="alert alert-info" style="margin:0 0 .6rem">
      <strong><%= untr.count %> תנועות בחשבון הזה הועלו לפני שמעקב הייבוא נוסף ואינן מותאמות לדבר</strong>
      <% if (untr.from) { %>(<%= formatDate(untr.from) %>–<%= formatDate(untr.to) %>)<% } %>,
      ולכן אי אפשר לשייך אותן לקובץ מסוים. למחיקה שלהן — סמן אותן בטבלת "כל התנועות בחשבון" למטה
      (אפשר לסנן לפי תיאור/אסמכתה/תאריך) ולחץ "מחק נבחרות".
    </div>
  <% } %>
  <% if (!imps.length) { %>
    <p class="muted" style="margin:0"><%= untr ? 'אין ייבואים מלווים במעקב לחשבון הזה — כל קובץ שתעלה מעכשיו יופיע כאן.' : 'עדיין לא יובאו קבצים לחשבון הזה.' %></p>
  <% } else { %>
    <p class="muted" style="margin:0 0 .5rem">
      כל שורה היא העלאה אחת. <strong>"נשמר ומוכן להתאמה"</strong> = השורות קיימות וממתינות ל"התאמה אוטומטית".
      ביטול ייבוא מוחק את התנועות שהגיעו בו בלבד.
    </p>
    <div class="table-scroll">
      <table class="sortable line-grid imports-tbl">
        <thead><tr>
          <th>מתי</th><th>קובץ</th><th>מקור</th><th class="right">נשמרו</th><th class="right">כפילויות</th>
          <th>טווח תאריכים</th><th class="right" title="שורות שנקלטו כחדשות אבל אותה תנועה (תאריך, סכום, אסמכתא) כבר הייתה מייבוא קודם">כבר היו</th>
          <th>מצב</th><th>הועלה ע״י</th><th data-nosort>ביטול</th>
        </tr></thead>
        <tbody>
          <% imps.forEach(function(im){ %>
            <tr>
              <%# `imported_at` נשמר ב-UTC — חיתוך המחרוזת הראה שעה מוקדמת ב-2-3 שעות מהשעה שבה הקובץ באמת הועלה. %>
              <td data-label="מתי" data-sort="<%= im.imported_at %>"><%= israelStamp(im.imported_at) || String(im.imported_at).slice(0,16) %></td>
              <td data-label="קובץ" title="<%= im.file_name || '' %>" style="word-break:break-word; min-width:12ch"><%= im.file_name || '—' %></td>
              <td data-label="מקור" class="muted"><%= im.source === 'csv' ? 'קובץ' : im.source === 'financy' ? 'משיכה מהבנק' : im.source === 'scraper' ? 'סריקה' : im.source %></td>
              <td data-label="נשמרו" class="right"><strong><%= im.inserted %></strong></td>
              <td data-label="כפילויות" class="right muted"><%= im.skipped || '—' %></td>
              <%# טווח התאריכים של השורות שנשארו מהייבוא, וכמה מהן הן עותק של תנועה מייבוא קודם — מה שמבדיל
                  "משיכה שהביאה היסטוריה ישנה" מ"משיכה שהכניסה את אותן תנועות שוב" (bankDuplicates#pullTwinPairs). %>
              <td data-label="טווח תאריכים" class="muted" style="white-space:nowrap"><%= im.range ? formatDate(im.range.from) + '–' + formatDate(im.range.to) : '—' %></td>
              <td data-label="כבר היו" class="right">
                <% if (im.twinsOfEarlier) { %><a href="/reconciliation/integrity?account=<%= accountId %>#pull-twins" class="badge b-blocked" title="פירוט בבדיקת השיוך"><%= im.twinsOfEarlier %></a><% } else { %><span class="muted">—</span><% } %>
              </td>
              <td data-label="מצב">
                <% if (!im.present) { %><span class="badge b-neutral">אין שורות</span>
                <% } else if (im.matched) { %><span class="badge b-paid"><%= im.matched %> הותאמו</span>
                  <% if (im.unmatched) { %> <span class="badge b-on_hold"><%= im.unmatched %> ממתינות</span><% } %>
                <% } else { %><span class="badge b-approved">נשמר ומוכן להתאמה</span><% } %>
              </td>
              <td data-label="הועלה ע״י" class="muted"><%= im.imported_by_name || '—' %></td>
              <td data-label="ביטול">
                <form method="post" action="/reconciliation/imports/<%= im.id %>/delete" style="display:inline"
                      onsubmit="return confirm('לבטל את הייבוא<%= im.file_name ? ' — ' + im.file_name : '' %>?\n<%= im.present %> תנועות יימחקו מהחשבון הזה.<% if (im.matched) { %>\nשים לב: <%= im.matched %> מהן כבר הותאמו (לצ׳קים או להפקדות) — ההתאמות ישוחררו, והצ׳קים וההפקדות יחזרו לממתינים להתאמה.<% } %>');">
                  <%# שורות שכבר הותאמו: השירות מסרב בלי אישור נוסף, ולכן האישור נשלח מראש רק כשהמשתמש
                      רואה במפורש כמה התאמות ישוחררו. %>
                  <% if (im.matched) { %><input type="hidden" name="release" value="1" /><% } %>
                  <button type="submit" class="btn-sm danger"><%= im.matched ? 'בטל ושחרר התאמות' : 'בטל ייבוא' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
  <%# 🔴 מה נמחק מהחשבון — מיומן הפעולות. ביטול ייבוא מוחק גם את השורה שלו מהטבלה למעלה, ולכן בלי זה
      תנועות "חוזרות" כחדשות במשיכה הבאה בלי שום הסבר (בעלים, 16/10). bankTransactions#accountDeletionHistory. %>
  <% var dels = (typeof deletions !== 'undefined' && deletions) ? deletions : []; %>
  <% if (dels.length) { %>
    <details style="margin-top:.7rem" <%= dels.some(function(d){ return d.kind === 'import'; }) ? 'open' : '' %>>
      <summary style="cursor:pointer"><strong>מה נמחק מהחשבון הזה</strong> <span class="muted">(<%= dels.length %>) — ייבואים שבוטלו לא מופיעים בטבלה למעלה</span></summary>
      <div class="table-scroll" style="margin-top:.4rem"><table class="no-enhance" style="font-size:13px">
        <thead><tr><th>מתי</th><th>מה</th><th>ע״י</th><th class="right">תנועות שנמחקו</th><th class="right">התאמות ששוחררו / הועברו</th></tr></thead>
        <tbody>
          <% dels.forEach(function(d){ %>
            <tr>
              <td style="white-space:nowrap"><%= israelStamp(d.at) || String(d.at || '').slice(0, 16) %></td>
              <td>
                <% if (d.kind === 'import') { %>
                  <strong>ביטול ייבוא</strong> — <%= d.what.fileName || (d.what.source === 'csv' ? 'קובץ' : 'סריקה') %><% if (d.what.importedAt) { %> מ-<%= israelStamp(d.what.importedAt) || String(d.what.importedAt).slice(0, 16) %><% } %><% if (d.what.inserted != null) { %> (נשמרו בו <%= d.what.inserted %>)<% } %>
                  <div class="muted" style="font-size:11px">התנועות שלו נמחקו — משיכה מאוחרת יותר מביאה אותן שוב כ"חדשות", וההתאמות שלהן צריכות להיעשות מחדש.</div>
                <% } else if (d.kind === 'rows') { %>מחיקת שורות נבחרות / ניקוי לפי קובץ
                <% } else { %>איחוד כפילויות (בדיקת שיוך · 1א) — ההתאמות עברו לשורה שנשארה<% } %>
              </td>
              <td class="muted"><%= d.by || '—' %></td>
              <td class="right"><%= d.deleted %></td>
              <td class="right"><%= d.released || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table></div>
    </details>
  <% } %>
  <% } %>
</div>

<div class="card">
  <div class="toolbar">
    <h2 style="margin:0">תנועות לא מותאמות (חובה)</h2>
    <%# בעלים 21/10: מתחת לעמודת "התאמה", מודגש — footer.ejs מעביר אותו לשורת הסינון (th[data-filter-slot]). %>
    <form method="post" action="/reconciliation/auto" id="autoMatchForm" class="auto-match-form" data-busy="מתאים…">
      <input type="hidden" name="account_id" value="<%= accountId %>" />
      <button type="submit" class="btn-auto-match">התאמה אוטומטית</button>
    </form>
  </div>
  <%# "תאריך תחילת עבודה": חיובים לא מותאמים עד התאריך מוסתרים (לא נמחקים — הסוכן מושך 60 יום
      אחורה והיה מחזיר אותם, וצ׳ק מיידי שהונפק בתוכנה עדיין מותאם אליהם). בעלים בלבד. %>
  <% var _hu = (typeof hiddenUntil !== 'undefined') ? hiddenUntil : null; var _hc = (typeof hiddenCount !== 'undefined') ? hiddenCount : 0; %>
  <div class="no-print" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin:0 0 .6rem">
    <% if (_hu) { %>
      <span class="muted">מוסתרים חיובים עד <strong><%= formatDate(_hu) %></strong> (לפני תחילת העבודה)<%= _hc ? ' — ' + _hc + ' בחשבון הזה' : '' %>.</span>
    <% } %>
    <% if (currentUser.role === 'owner') { %>
      <form method="post" action="/reconciliation/hide-until" style="display:flex;align-items:center;gap:.4rem;margin:0">
        <input type="hidden" name="account_id" value="<%= accountId %>" />
        <label style="margin:0;font-size:13px">הסתר חיובים לא מותאמים עד (כולל):</label>
        <input type="date" name="until" value="<%= _hu || '' %>" style="max-width:150px" />
        <button type="submit" class="btn-secondary small">שמור</button>
      </form>
      <% if (_hu) { %>
        <form method="post" action="/reconciliation/hide-until" style="margin:0">
          <input type="hidden" name="account_id" value="<%= accountId %>" /><input type="hidden" name="until" value="" />
          <button type="submit" class="btn-secondary small">הצג הכל</button>
        </form>
      <% } %>
    <% } %>
  </div>
  <%# מיון A-Z + שורת סינון לכל עמודה (המשפרים הגלובליים ב-partials/footer.ejs). עמודת ההתאמה
      היא טפסים, לא טקסט — אין מה למיין או לסנן לפיה. %>
  <%# .tbl-center — כל העמודות ממורכזות (בקשת הבעלים). האסמכתא היא קישור ל"בחינת תנועה". %>
  <div class="table-scroll"><%# בלי גלילה פנימית הטבלה מושכת את כל הדף הצידה בטלפון (430px מול 390). %>
  <table class="sortable filterable tbl-center">
    <thead>
      <tr><th>תאריך</th><th>סכום</th><th>תיאור</th><th>אסמכתא</th><th data-nosort data-nofilter data-filter-slot="autoMatchForm">התאמה</th></tr>
    </thead>
    <tbody>
      <% if (classified.length === 0) { %>
        <tr><td colspan="5" class="muted">אין תנועות חובה לא מותאמות.</td></tr>
      <% } %>
      <% classified.forEach(function(c){ %>
        <tr>
          <td><%= formatDate(c.txn.txn_date) %></td>
          <td class="neg"><%= formatIls(c.txn.amount) %></td>
          <td><%= c.txn.description || '' %></td>
          <td class="mono"><a href="/reconciliation/txn/<%= c.txn.id %>" title="בחינת התנועה ומה יש במערכת עם המספר הזה"><%= c.txn.raw_reference || '—' %></a>
            <div><a class="btn btn-secondary small" href="/reconciliation/txn/<%= c.txn.id %>">🔎 בחן</a></div></td>
          <td>
            <% if (c.state === 'deterministic' || c.state === 'single') { %>
              <form method="post" action="/reconciliation/match" class="actions">
                <input type="hidden" name="account_id" value="<%= accountId %>" />
                <input type="hidden" name="txn_id" value="<%= c.txn.id %>" />
                <input type="hidden" name="payment_id" value="<%= c.suggestion.id %>" />
                <span><span class="mono"><%= paymentIdent(c.suggestion) %></span>
                  <% if (c.state === 'deterministic') { %><span class="badge b-approved">מס' צ׳ק תואם</span><% } %>
                </span>
                <button class="ok small" type="submit">אשר פירעון</button>
              </form>
            <% } else if (c.state === 'ambiguous' || c.state === 'mismatch' || c.state === 'suggest') { %>
              <form method="post" action="/reconciliation/match" class="actions">
                <input type="hidden" name="account_id" value="<%= accountId %>" />
                <input type="hidden" name="txn_id" value="<%= c.txn.id %>" />
                <%# mismatch = צ׳ק יחיד באותו סכום, אבל מספרו שונה מהאסמכתה בבנק — לא מתאימים אותו לבד. %>
                <span class="badge b-on_hold"><%= c.state === 'mismatch' ? 'מספר שונה — להכרעה' : c.state === 'suggest' ? 'סכום זהה — להכרעה' : 'להכרעה' %></span>
                <select name="payment_id" style="width:auto">
                  <% c.candidates.forEach(function(p){ %>
                    <option value="<%= p.id %>"><%= paymentIdent(p) %> · <%= p.payment_date %><%= p.hint ? ' — ' + p.hint : '' %></option>
                  <% }); %>
                </select>
                <button class="small" type="submit">התאם נבחר</button>
              </form>
            <% } else { %>
              <span class="muted">אין צ׳ק פתוח תואם</span>
            <% } %>
            <%# חיוב שאין לו צ׳ק הוא לרוב העברה/הוראת קבע/חיוב ישיר שהספק גבה. עד עכשיו השורה
                נגמרה כאן, והחשבונית נשארה "לתשלום" אחרי שכבר שולמה. הכפתור פותח דיאלוג **אחד
                משותף** (ולא דיאלוג לכל שורה) שמקבל את פרטי התנועה דרך data-*. %>
            <% if (payableInvoices && payableInvoices.length) { %>
              <button type="button" class="small secondary js-inv-match"
                      data-txn="<%= c.txn.id %>"
                      data-amount="<%= Math.abs(c.txn.amount) %>"
                      data-amount-label="<%= formatIls(Math.abs(c.txn.amount)) %>"
                      data-date="<%= formatDate(c.txn.txn_date) %>"
                      data-desc="<%= c.txn.description || '' %>">🧾 שייך לחשבוניות</button>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<%# 🔴 דיאלוג אחד לכל השורות. אחד-לכל-שורה היה משכפל את רשימת החשבוניות פי מספר התנועות —
    עשרות עותקים של אותו HTML בדף אחד. פרטי התנועה מוזרקים ב-JS מה-data-* של הכפתור שנלחץ. %>
<% if (payableInvoices && payableInvoices.length) { %>
<dialog id="invDlg">
  <form method="post" action="/reconciliation/match-invoices" id="invForm">
    <input type="hidden" name="account_id" value="<%= accountId %>" />
    <input type="hidden" name="txn_id" id="invTxn" />
    <h3 style="margin:0 0 .3rem">שיוך חיוב לחשבוניות</h3>
    <p class="muted" style="margin:0 0 .6rem; font-size:12px">
      חיוב שיצא מהבנק בלי צ׳ק — העברה, הוראת קבע או חיוב ישיר. ייווצר תשלום בסכום שיצא מהבנק,
      והחשבוניות שתסמן ייסגרו לפיו.
    </p>
    <p style="margin:0 0 .6rem">
      <strong id="invTxnLabel"></strong>
      <span class="muted" id="invTxnMeta" style="font-size:12px"></span>
    </p>

    <label style="display:block; margin-bottom:.6rem">אמצעי התשלום
      <select name="pay_method" style="width:auto">
        <% payMethods.forEach(function(m){ %><option value="<%= m.value %>"><%= m.label %></option><% }); %>
      </select>
    </label>

    <div class="table-scroll" style="max-height:40vh">
      <table class="no-enhance">
        <thead><tr><th></th><th>חשבונית</th><th>ספק</th><th>תאריך</th><th class="right">פתוח</th></tr></thead>
        <tbody>
          <% payableInvoices.forEach(function(iv){ %>
            <tr>
              <td style="width:1%"><input type="checkbox" class="js-inv-pick" name="invoice_ids" value="<%= iv.id %>" data-open="<%= iv.open_amount %>" /></td>
              <td class="mono"><%= iv.invoice_number || iv.id %></td>
              <td><%= iv.supplier_name || '' %></td>
              <td><%= formatDate(iv.invoice_date) %></td>
              <td class="right"><%= formatIls(iv.open_amount) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%# הסכום הרץ מול סכום החיוב. בלעדיו הבחירה היא ניחוש, והשרת רק היה מסרב אחרי הלחיצה. %>
    <p style="margin:.6rem 0 0" id="invSum"></p>
    <div class="actions" style="margin-top:.6rem">
      <button type="submit" id="invGo">שייך</button>
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
    </div>
  </form>
</dialog>
<script>
(function(){
  var dlg = document.getElementById("invDlg");
  if (!dlg) return;
  var form = document.getElementById("invForm");
  var txnInput = document.getElementById("invTxn");
  var label = document.getElementById("invTxnLabel");
  var meta = document.getElementById("invTxnMeta");
  var sum = document.getElementById("invSum");
  var go = document.getElementById("invGo");
  var picks = form.querySelectorAll(".js-inv-pick");
  var target = 0;

  function ils(a){ return (a/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + " \u20AA"; }

  function recalc(){
    var chosen = 0, n = 0;
    picks.forEach(function(cb){ if (cb.checked) { chosen += Number(cb.dataset.open||0); n += 1; } });
    var diff = chosen - target;
    if (!n) {
      sum.textContent = "לא נבחרו חשבוניות.";
      sum.style.color = "";
      go.disabled = true;
      return;
    }
    go.disabled = false;
    // 🔴 חוסר אינו שגיאה — חיוב אחד יכול לכסות חלק מחשבונית (תשלום חלקי, R8). **עודף כן**:
    // אי אפשר לשלם מעבר ליתרה הפתוחה, והשרת יסרב — אז נאמר זאת כאן ולא אחרי הלחיצה.
    if (diff < 0) {
      sum.textContent = "נבחרו " + n + " · פתוח " + ils(chosen) + " מתוך חיוב " + ils(target)
        + " — יישארו " + ils(target - chosen) + " מהחיוב ללא שיוך. בחר עוד חשבוניות.";
      sum.style.color = "var(--color-warn)";
      go.disabled = true;
    } else if (diff > 0) {
      sum.textContent = "נבחרו " + n + " · פתוח " + ils(chosen) + " מול חיוב " + ils(target)
        + " — תשלום חלקי, תישאר יתרה פתוחה של " + ils(diff) + ".";
      sum.style.color = "var(--color-warn)";
    } else {
      sum.textContent = "נבחרו " + n + " · " + ils(chosen) + " — תואם בדיוק לסכום החיוב.";
      sum.style.color = "var(--color-ok)";
    }
  }

  picks.forEach(function(cb){ cb.addEventListener("change", recalc); });

  document.querySelectorAll(".js-inv-match").forEach(function(btn){
    btn.addEventListener("click", function(){
      target = Number(btn.dataset.amount||0);
      txnInput.value = btn.dataset.txn;
      label.textContent = "חיוב " + btn.dataset.amountLabel;
      meta.textContent = " · " + btn.dataset.date + (btn.dataset.desc ? " · " + btn.dataset.desc : "");
      picks.forEach(function(cb){ cb.checked = false; });
      recalc();
      dlg.showModal();
    });
  });
})();
</script>
<% } %>

<div class="card">
  <h2>כל התנועות בחשבון</h2>
  <%# בחירה מרובה + מחיקה. יחד עם הסינון לכל עמודה זה מה שמנקה שורות זרות שהועלו לחשבון הלא
      נכון — כולל כאלה שקדמו למעקב הייבוא ואין להן קובץ לבטל. %>
  <%# 🔴 הטופס עומד בפני עצמו ו**אינו עוטף את הטבלה**: לשורות יש טפסים משלהן (ערוך / מחק / בטל
      התאמה), ו-HTML אינו מרשה טופס בתוך טופס — הדפדפן משטח אותם, שדות ה-account_id שלהם נדבקים
      לטופס החיצוני, וכפתורי השורה מתחילים לשלוח אותו. תיבות הסימון מקושרות דרך `form="bulk-del"`,
      וזה בדיוק מה שהתכונה הזו קיימת בשבילה. %>
  <form method="post" action="/reconciliation/txns/delete" id="bulk-del" class="actions no-print" style="margin:0 0 .4rem"
        onsubmit="var n=document.querySelectorAll('.txn-pick:checked').length; if(!n){alert('לא נבחרו תנועות.');return false;} return confirm('למחוק '+n+' תנועות? תנועה שכבר הותאמה לצ׳ק תדולג.');">
    <input type="hidden" name="account_id" value="<%= accountId %>" />
    <button type="submit" class="btn-sm danger">🗑️ מחק נבחרות</button>
    <span class="muted" style="font-size:12px">סמן שורות (או את הכותרת לבחירת הכל) — שורה שכבר הותאמה לצ׳ק תדולג.</span>
  </form>
  <%# שורות שלא הוסברו עד "תאריך תחילת העבודה" מוסתרות גם כאן (services/bankTransactions.js
      #listTransactions → hidden_before_start). נפרע / שכר / הפקדה — תמיד מוצגים. %>
  <% var _allTx = transactions; var _hidTx = _allTx.filter(function(t){ return t.hidden_before_start; }).length;
     if (_hidTx && !(typeof showAllTxns !== 'undefined' && showAllTxns)) transactions = _allTx.filter(function(t){ return !t.hidden_before_start; }); %>
  <% if (_hidTx) { %>
    <p class="muted no-print" style="margin:0 0 .4rem">
      <% if (typeof showAllTxns !== 'undefined' && showAllTxns) { %>
        מוצגות גם <%= _hidTx %> שורות מלפני תחילת העבודה. <a href="/reconciliation?account=<%= accountId %>" data-keep-scroll>הסתר אותן</a>
      <% } else { %>
        הוסתרו <%= _hidTx %> שורות שלא הוסברו עד <%= formatDate(hiddenUntil) %> (לפני תחילת העבודה). <a href="/reconciliation?account=<%= accountId %>&all=1" data-keep-scroll>הצג אותן</a>
      <% } %>
    </p>
  <% } %>
  <div class="table-scroll"><%# בלי גלילה פנימית הטבלה מושכת את כל הדף הצידה בטלפון (430px מול 390). %>
  <table class="sortable filterable">
    <thead><tr><th data-nosort data-nofilter class="no-print"><input type="checkbox" id="txn-all" style="width:auto;min-height:0" title="בחר הכל" /></th><th>תאריך</th><th class="right">סכום</th><th>תיאור</th><th>אסמכתא</th><th>מקור</th><th>סטטוס</th><th data-nosort data-nofilter class="no-print">פעולות</th></tr></thead>
    <tbody>
      <% if (transactions.length === 0) { %>
        <tr><td colspan="7" class="muted">
          אין תנועות בחשבון.
          <% if (typeof can === 'function' && can('import_bank')) { %>
            <button type="button" class="btn-sm" onclick="document.getElementById('csvDlg').showModal()">📄 ייבוא CSV / Excel</button>
          <% } %>
        </td></tr>
      <% } %>
      <% transactions.forEach(function(t){ %>
        <tr>
          <td class="no-print">
            <% if (!t.matched_payment_id) { %>
              <input type="checkbox" class="txn-pick" name="txn_ids" value="<%= t.id %>" form="bulk-del" style="width:auto;min-height:0" />
            <% } %>
          </td>
          <td data-sort="<%= t.txn_date %>"><%= formatDate(t.txn_date) %></td>
          <td class="right <%= t.amount < 0 ? 'neg' : '' %>"><%= formatIls(t.amount) %></td>
          <td><%= t.description || '' %></td>
          <td class="mono"><%= t.raw_reference || '—' %></td>
          <td class="muted"><%= t.source %></td>
          <td>
            <% if (t.matched_payment_id) { %>
              <span class="badge b-cleared">נפרע · <%= methodLabel(t.matched_method) %> <span class="mono"><%= t.matched_check_number %></span></span>
            <% } else if (t.salary_match) { %>
              <span class="badge b-cleared">נפרע · צ׳ק שכר <span class="mono"><%= t.salary_match.reference %></span> · <%= t.salary_match.name %></span>
            <% } else if (t.deposit_match) { %>
              <span class="badge b-cleared" title="זיכוי שקית הפקדה או תיקון שלה בבנק">הפקדה · שקית <span class="mono"><%= t.deposit_match.bag %></span></span>
            <% } else if (t.amount < 0) { %>
              <span class="badge b-issued">ממתין להתאמה</span>
            <% } else { %>
              <span class="muted">זכות</span>
            <% } %>
          </td>
          <td class="no-print">
            <% if (t.matched_payment_id) { %>
              <form method="post" action="/reconciliation/unmatch" style="display:inline">
                <input type="hidden" name="account_id" value="<%= accountId %>" />
                <input type="hidden" name="txn_id" value="<%= t.id %>" />
                <button class="secondary small" type="submit">בטל התאמה</button>
              </form>
            <% } else { %>
              <button type="button" class="secondary small" onclick="document.getElementById('edit-txn-<%= t.id %>').hidden = !document.getElementById('edit-txn-<%= t.id %>').hidden">ערוך</button>
              <form method="post" action="/reconciliation/txn/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק את התנועה?')">
                <input type="hidden" name="account_id" value="<%= accountId %>" />
                <button class="danger small" type="submit">מחק</button>
              </form>
            <% } %>
          </td>
        </tr>
        <% if (!t.matched_payment_id) { %>
          <tr id="edit-txn-<%= t.id %>" hidden>
            <td colspan="7">
              <form method="post" action="/reconciliation/txn/<%= t.id %>/edit" class="actions" style="flex-wrap:wrap; gap:.5rem">
                <input type="hidden" name="account_id" value="<%= accountId %>" />
                <div><label style="margin:0">תאריך</label><input type="date" name="txn_date" value="<%= t.txn_date %>" required /></div>
                <div><label style="margin:0">סכום (₪, שלילי=חובה)</label><input name="amount" inputmode="decimal" value="<%= (t.amount/100).toFixed(2) %>" required /></div>
                <div><label style="margin:0">תיאור</label><input name="description" value="<%= t.description || '' %>" /></div>
                <div><label style="margin:0">אסמכתא</label><input name="reference" value="<%= t.raw_reference || '' %>" /></div>
                <div style="align-self:end"><button class="ok small" type="submit">שמור</button></div>
              </form>
            </td>
          </tr>
        <% } %>
      <% }); %>
    </tbody>
  </table>
  </div>
  <script>
  (function(){
    // "בחר הכל" מסמן רק שורות שנראות — כלומר אחרי הסינון, וזה כל העניין: מסננים לשורות הזרות
    // ומסמנים אותן יחד. שורה שכבר הותאמה לצ׳ק אין לה תיבה בכלל.
    var all = document.getElementById("txn-all");
    if (!all) return;
    all.addEventListener("change", function(){
      document.querySelectorAll(".txn-pick").forEach(function(cb){
        var tr = cb.closest("tr");
        if (tr && tr.style.display !== "none") cb.checked = all.checked;
      });
    });
  })();
  </script>
</div>

<%# "ניקוי לפי קובץ" — קובץ שהועלה לחשבון הלא נכון לפני שמעקב הייבוא היה קיים. לשורות אין סימון
    קובץ ואי אפשר לברור ביניהן ביד; הקובץ עצמו הוא הסימן המדויק. %>
<dialog id="purgeDlg" class="dlg wide">
  <div class="dlg-head">
    <strong>ניקוי לפי קובץ</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <p class="muted" style="font-size:13px">
    העלית קובץ לחשבון הלא נכון? העלה אותו כאן <strong>שוב</strong> — נמצא את התנועות שהוא הביא
    <strong>לחשבון הזה</strong>, נראה לך בדיוק מה יימחק, ורק אז נמחק. הקובץ עצמו לא נשמר ולא מיובא.
    <br>ההתאמה היא לפי תאריך + סכום + תיאור + אסמכתה — אותה שקילות שהייבוא משתמש בה לזיהוי כפילות.
  </p>
  <form method="post" action="/reconciliation/purge-preview" enctype="multipart/form-data">
    <input type="hidden" name="account_id" value="<%= accountId %>" />
    <div class="row">
      <div><label>קובץ שהועלה בטעות</label><input type="file" name="csv" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" required /></div>
    </div>
    <div class="actions" style="margin-top:.6rem">
      <button type="submit">בדוק מה יימחק</button>
      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">ביטול</button>
    </div>
  </form>
</dialog>

<!-- מודל ייבוא CSV / Excel -->
<dialog id="csvDlg" class="dlg wide">
  <div class="dlg-head">
    <strong>ייבוא CSV / Excel</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <p class="muted" style="font-size:13px">
    תומך בייצוא בנק הפועלים ב-CSV או ב-Excel (<span class="mono">.xlsx</span>) — עמודות
    <span class="mono">תאריך / חובה / זכות / אסמכתא</span> — וגם בפורמט פשוט
    (<span class="mono">date, amount, description, reference</span> — חובה שלילי).
    מזהה אוטומטית קידוד עברי (Windows-1255), מפריד ; או פסיק, ומדלג על שורות כותרת מיותרות.
  </p>
  <form method="post" action="/reconciliation/import-csv" enctype="multipart/form-data"
        onsubmit="if(!document.getElementById('csvFile').files.length){alert('יש לבחור קובץ');return false;}">
    <input type="hidden" name="account_id" value="<%= accountId %>" />
    <input id="csvFile" type="file" name="csv"
           accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" hidden
           onchange="document.getElementById('csvName').textContent = this.files[0] ? this.files[0].name : 'לא נבחר קובץ'" />
    <div style="display:flex; gap:var(--space-8); align-items:flex-start; justify-content:flex-start; margin-top:var(--space-2)">
      <div class="icon-tile">
        <button type="button" class="icon-circle" onclick="document.getElementById('csvFile').click()" aria-label="בחר קובץ" title="בחר קובץ">
          <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        </button>
        <span class="cap">בחר קובץ</span>
      </div>
      <div class="icon-tile">
        <button type="submit" class="icon-circle accent" aria-label="ייבא" title="ייבא">
          <svg viewBox="0 0 24 24"><path d="M12 3v12M12 15l-4-4M12 15l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
        </button>
        <span class="cap">ייבא</span>
      </div>
    </div>
    <p class="muted" id="csvName" style="margin-top:10px; font-size:12px">לא נבחר קובץ</p>
  </form>
</dialog>

<!-- מודל הוספת תנועה ידנית -->
<dialog id="txnDlg" class="dlg">
  <div class="dlg-head">
    <strong>הוספת תנועה ידנית</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <form method="post" action="/reconciliation/add" class="stack">
    <input type="hidden" name="account_id" value="<%= accountId %>" />
    <label>תאריך</label>
    <input type="date" name="txn_date" required />
    <label>סכום (₪, שלילי = חובה)</label>
    <input name="amount" inputmode="decimal" placeholder="-1170.00" required />
    <label>תיאור</label>
    <input name="description" />
    <label>אסמכתא (למשל מס' צ׳ק)</label>
    <input name="reference" />
    <div style="margin-top:.6rem"><button class="btn btn-primary" type="submit">הוסף</button></div>
  </form>
</dialog>
<%- include('../partials/footer') %>
