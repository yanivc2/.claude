      document.querySelectorAll('table.cx-grouped').forEach(function (t, i) {
        ['settled', 'matched'].forEach(function (g) { if (t.classList.contains('show-' + g)) groups.push(i + ':' + g); });
      });
      // מה שהוקלד בשורות הסינון (בעלים 21/10: "הצג אותן" איפס את הסינון) — לפי הטבלה (כותרת הכרטיס + מקומה בו).
