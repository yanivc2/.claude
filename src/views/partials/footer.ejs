      h.setAttribute('tabindex', '0');

      // data-ckey: כותרת שנושאת מספר משתנה (תג ספירה) שומרת מפתח קבוע — אחרת מצב הכיווץ אובד בכל שינוי.
      var key = (h.getAttribute('data-ckey') || h.textContent || '').trim().slice(0, 60);
