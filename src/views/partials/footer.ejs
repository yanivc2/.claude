  <script>
  // Auto-submit a filter/switch form from a control's change handler — WITHOUT a programmatic form
  // submit. Inside an installed iOS PWA a scripted submit (form.submit() or requestSubmit()) whose
  // POST answers with a 302 breaks the navigation out to a Safari sheet ("address is invalid"), so we
  // never let the form navigate itself:
  //   • GET  → build action?params and navigate client-side (stays in the app).
  //   • POST → send it with fetch(), then navigate client-side to return_to (or reload). The server
  //            answers fetch with 204 (see routes/context.js) so there is no redirect to break out on.
  // Falls back to a plain form.submit() if fetch is unavailable.
  window.apAutoSubmit = function (el) {
    var f = el && el.form ? el.form : (el && el.closest ? el.closest('form') : null);
    if (!f) return;
    var method = (f.getAttribute('method') || 'get').toLowerCase();
    var action = f.getAttribute('action') || location.pathname;
    var params = new URLSearchParams(new FormData(f));
    if (method !== 'post') {
      var qs = params.toString();
      location.assign(action + (qs ? ('?' + qs) : ''));
      return;
    }
    var rt = f.querySelector('[name=return_to]');
    var dest = (rt && rt.value) ? rt.value : (location.pathname + location.search);
    if (!window.fetch) { f.submit(); return; }
    fetch(action, { method: 'POST', body: params, credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' } })
      .then(function () { location.assign(dest); })
      .catch(function () { location.assign(dest); });
  };
  </script>
  <script>
  // Close any open floating menu (<details class="menu">) when clicking outside it or pressing Esc.
  (function () {
    var deskMq = window.matchMedia('(min-width: 1000px)');
    // On desktop the .navmenu is a fixed sidebar (always open) — never auto-close it. Other
    // floating menus (store pickers) still close normally.
    function closables() {
      return document.querySelectorAll(deskMq.matches ? 'details.menu[open]:not(.navmenu)' : 'details.menu[open]');
    }
    document.addEventListener('click', function (e) {
      if (document.querySelector('dialog[open]')) return; // a modal is open — leave menus alone
      closables().forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (document.querySelector('dialog[open]')) return; // let the dialog swallow the Escape
      closables().forEach(function (d) { d.removeAttribute('open'); });
    });
  })();
