  // collapsed groups at the bottom ("▸ סומנו כטופלו (30)"). A click opens/closes a group; while any
  // column filter has a value, every group row is shown so the filter finds them.
  (function () {
    document.addEventListener('click', function (e) {
      var b = e.target && e.target.closest ? e.target.closest('.cx-group-toggle') : null;
      if (!b) return;
      var tr = b.closest('tr'), table = b.closest('table'), g = tr.getAttribute('data-group');
