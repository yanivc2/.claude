        if (h && !h.value) { e.preventDefault(); alert('יש לבחור תאריך'); wraps[i].querySelector('input[type="text"]').focus(); return; }
      }
    }, true);
  })();
  </script>

  <script>
  // Searchable combobox: enhance any <select class="js-combo"> into a type-to-filter field. Users
  // key part of a name (or a few letters, in order) and pick from the similar matches. The original
  // <select> stays the submitted control (hidden), so the server contract is unchanged.
  (function () {
    function norm(s){ return (s == null ? '' : String(s)).trim().toLowerCase(); }
    function esc(s){ return String(s).replace(/[&<>]/g, function(c){ return { '&':'&amp;','<':'&lt;','>':'&gt;' }[c]; }); }
    // match = plain substring, OR every whitespace token is a substring, OR chars appear in order.
    function matches(text, q){
      var h = norm(text), n = norm(q);
      if (!n) return true;
      if (h.indexOf(n) !== -1) return true;
      var toks = n.split(/\s+/).filter(Boolean);
      if (toks.length > 1 && toks.every(function(t){ return h.indexOf(t) !== -1; })) return true;
      var i = 0; for (var j = 0; j < h.length && i < n.length; j++) { if (h.charAt(j) === n.charAt(i)) i++; }
      return i === n.length;
    }

    function enhance(sel){
      if (sel.dataset.comboDone) return; sel.dataset.comboDone = '1';
      var opts = Array.prototype.slice.call(sel.options).map(function(o){ return { v: o.value, t: (o.text || '').trim(), disabled: o.disabled }; });
      var wrap = document.createElement('span'); wrap.className = 'combo';
      sel.parentNode.insertBefore(wrap, sel); wrap.appendChild(sel);
      sel.style.display = 'none'; sel.setAttribute('aria-hidden', 'true'); sel.tabIndex = -1;
      var req = sel.required; if (req) { sel.required = false; wrap.dataset.req = '1'; }
      wrap.dataset.label = sel.getAttribute('data-combo-label') || 'ערך';

      var input = document.createElement('input'); input.type = 'text'; input.className = 'combo-input';
      input.autocomplete = 'off'; input.placeholder = sel.getAttribute('data-combo-ph') || 'הקלד לחיפוש…';
      var cur = opts.filter(function(o){ return o.v !== '' && o.v === sel.value; })[0];
      if (cur) input.value = cur.t;
      wrap.insertBefore(input, sel);
      var pop = document.createElement('div'); pop.className = 'combo-pop'; pop.hidden = true; wrap.appendChild(pop);

      var shown = [], activeIdx = -1;
      function setVal(o){ sel.value = o.v; input.value = o.t; sel.dispatchEvent(new Event('change', { bubbles: true })); }
      function paint(){ Array.prototype.forEach.call(pop.children, function(c){ if (c.dataset.i != null) c.classList.toggle('active', +c.dataset.i === activeIdx); });
        var a = pop.querySelector('.combo-opt.active'); if (a) a.scrollIntoView({ block: 'nearest' }); }
      function render(q){
        shown = opts.filter(function(o){ return o.v !== '' && !o.disabled && matches(o.t, q); });
        activeIdx = shown.length ? 0 : -1;
        pop.innerHTML = shown.length
          ? shown.map(function(o, i){ return '<div class="combo-opt" data-i="' + i + '">' + esc(o.t) + '</div>'; }).join('')
          : '<div class="combo-empty">אין תוצאות</div>';
        pop.hidden = false; paint();
      }
      input.addEventListener('focus', function(){ render(input.value === (cur && cur.t) ? '' : input.value); });
      input.addEventListener('input', function(){ sel.value = ''; render(input.value); });
      input.addEventListener('keydown', function(e){
        if (pop.hidden) { if (e.key === 'ArrowDown') { render(''); } return; }
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, shown.length - 1); paint(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); paint(); }
        else if (e.key === 'Enter') { if (activeIdx >= 0 && shown[activeIdx]) { e.preventDefault(); setVal(shown[activeIdx]); pop.hidden = true; } }
        else if (e.key === 'Escape') { pop.hidden = true; }
      });
      pop.addEventListener('mousedown', function(e){ var t = e.target.closest ? e.target.closest('.combo-opt') : null; if (!t) return; e.preventDefault(); setVal(shown[+t.dataset.i]); pop.hidden = true; });
      input.addEventListener('blur', function(){ setTimeout(function(){
        pop.hidden = true;
        if (!sel.value) { var exact = opts.filter(function(o){ return o.v !== '' && norm(o.t) === norm(input.value); })[0]; if (exact) setVal(exact); }
        var c = opts.filter(function(o){ return o.v !== '' && o.v === sel.value; })[0];
        input.value = c ? c.t : (sel.value ? input.value : '');
        cur = c || null;
      }, 150); });
    }
    function enhanceAll(root){ (root || document).querySelectorAll('select.js-combo').forEach(enhance); }
    document.addEventListener('DOMContentLoaded', function(){ enhanceAll(); });
    document.addEventListener('click', function(e){ document.querySelectorAll('.combo-pop').forEach(function(p){ if (!p.parentNode.contains(e.target)) p.hidden = true; }); });
    document.addEventListener('submit', function(e){
      var wraps = e.target.querySelectorAll ? e.target.querySelectorAll('.combo[data-req="1"]') : [];
      for (var i = 0; i < wraps.length; i++) {
        var s = wraps[i].querySelector('select');
        if (s && !s.value) { e.preventDefault(); alert('יש לבחור ' + (wraps[i].dataset.label || 'ערך')); wraps[i].querySelector('.combo-input').focus(); return; }
      }
    }, true);
  })();
  </script>

  <script>
  // Global table tools: for every data table (a <table> with a <thead> and ≥2 body rows), add a
  // compact toolbar with (a) a live per-keystroke search that filters rows across ALL columns, and
  // (b) Excel + CSV export of the currently-visible rows. Columns whose header is .no-print or
  // [data-noexport] (action/checkbox/ייצוא columns) are excluded from the export. Opt out with
  // class "no-enhance" on the table.
  (function () {
    var main = document.querySelector('main') || document.body;
    function norm(s) { return (s == null ? '' : String(s)).replace(/\s+/g, ' ').trim().toLowerCase(); }
    function dataRows(tbody) {
      return Array.prototype.slice.call(tbody.rows).filter(function (r) { return !r.querySelector('td[colspan]'); });
    }
    function exportCols(table) {
      var ths = table.tHead ? table.tHead.rows[0].cells : [];
      var keep = [];
      Array.prototype.forEach.call(ths, function (th, i) {
        var skip = th.classList.contains('no-print') || th.hasAttribute('data-noexport');
        if (!skip) keep.push(i);
      });
      return keep;
    }
    function cellText(cell) {
      // Prefer a link's text; collapse whitespace. Keeps numbers/×/— readable in the export.
      return (cell ? cell.textContent : '').replace(/\s+/g, ' ').trim();
    }
    function buildMatrix(table) {
      var cols = exportCols(table);
      var ths = table.tHead.rows[0].cells;
      var head = cols.map(function (i) { return cellText(ths[i]); });
      var body = dataRows(table.tBodies[0])
        .filter(function (r) { return r.style.display !== 'none'; })
        .map(function (r) { return cols.map(function (i) { return cellText(r.cells[i]); }); });
      return { head: head, body: body };
    }
    function download(name, blob) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click();
      setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
    }
    function esc(s) { return String(s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); }
    function exportExcel(table, base) {
      var m = buildMatrix(table);
      var html = '<html><head><meta charset="utf-8"></head><body><table border="1" dir="rtl"><thead><tr>'
        + m.head.map(function (h) { return '<th>' + esc(h) + '</th>'; }).join('') + '</tr></thead><tbody>'
        + m.body.map(function (row) { return '<tr>' + row.map(function (c) { return '<td>' + esc(c) + '</td>'; }).join('') + '</tr>'; }).join('')
        + '</tbody></table></body></html>';
      download(base + '.xls', new Blob(['﻿' + html], { type: 'application/vnd.ms-excel' }));
    }
    function csvCell(s) { return '"' + String(s).replace(/"/g, '""') + '"'; }
    function exportCsv(table, base) {
      var m = buildMatrix(table);
      var lines = [m.head].concat(m.body).map(function (row) { return row.map(csvCell).join(','); });
      download(base + '.csv', new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
    }
    function exportPdf(table, base) {
      // Open a clean, RTL print view of just this table (visible rows, no action columns) — the user
      // then saves it as PDF from the print dialog. Falls back to printing the page if pop-ups block.
      var m = buildMatrix(table);
      var w = window.open('', '_blank');
      if (!w) { window.print(); return; }
      var doc = '<html dir="rtl"><head><meta charset="utf-8"><title>' + esc(base) + '</title>'
        + '<style>body{font-family:Arial,sans-serif;direction:rtl;margin:24px}h3{margin:0 0 12px}'
        + 'table{border-collapse:collapse;width:100%}th,td{border:1px solid #999;padding:6px 8px;text-align:right;font-size:12px}'
        + 'thead th{background:#eee}</style></head><body><h3>' + esc(base) + '</h3><table><thead><tr>'
        + m.head.map(function (h) { return '<th>' + esc(h) + '</th>'; }).join('') + '</tr></thead><tbody>'
        + m.body.map(function (row) { return '<tr>' + row.map(function (c) { return '<td>' + esc(c) + '</td>'; }).join('') + '</tr>'; }).join('')
        + '</tbody></table></body></html>';
      w.document.write(doc); w.document.close(); w.focus();
      setTimeout(function () { try { w.print(); } catch (e) {} }, 300);
    }
    function baseName(table) {
      var card = table.closest('.card');
      var h = card ? card.querySelector('h1, h2, h3') : null;
      var t = (h ? h.textContent : (document.querySelector('h1') ? document.querySelector('h1').textContent : 'table'));
      return (t || 'table').replace(/\s+/g, ' ').trim().slice(0, 40) || 'table';
    }

    main.querySelectorAll('table').forEach(function (table) {
      if (table.classList.contains('no-enhance')) return;
      if (table.dataset.toolsDone) return;
      if (!table.tHead || !table.tBodies.length) return;
      if (dataRows(table.tBodies[0]).length < 2) return; // nothing worth searching/exporting
      table.dataset.toolsDone = '1';

      var tools = document.createElement('div');
      tools.className = 'tbl-tools no-print';
      var search = document.createElement('input');
      search.type = 'search'; search.className = 'tbl-search';
      search.placeholder = 'חיפוש בטבלה…'; search.autocomplete = 'off';
      var count = document.createElement('span'); count.className = 'tbl-count muted';
      // A single "ייצוא" button that opens a small menu with the three formats (Excel / CSV / PDF),
      // instead of three separate buttons cluttering every table toolbar.
      var exportWrap = document.createElement('div'); exportWrap.className = 'tbl-export';
      var exportBtn = document.createElement('button');
      exportBtn.type = 'button'; exportBtn.className = 'btn btn-secondary btn-sm tbl-export-toggle';
      exportBtn.textContent = '⬇ ייצוא ▾'; exportBtn.setAttribute('aria-haspopup', 'true'); exportBtn.setAttribute('aria-expanded', 'false');
      var menu = document.createElement('div'); menu.className = 'tbl-export-menu'; menu.hidden = true;
      var xls = document.createElement('button'); xls.type = 'button'; xls.className = 'tbl-export-item'; xls.textContent = 'Excel';
      var csv = document.createElement('button'); csv.type = 'button'; csv.className = 'tbl-export-item'; csv.textContent = 'CSV';
      var pdf = document.createElement('button'); pdf.type = 'button'; pdf.className = 'tbl-export-item'; pdf.textContent = 'PDF';
      menu.appendChild(xls); menu.appendChild(csv); menu.appendChild(pdf);
      exportWrap.appendChild(exportBtn); exportWrap.appendChild(menu);
      tools.appendChild(search); tools.appendChild(count);
      var spacer = document.createElement('span'); spacer.style.marginInlineStart = 'auto'; tools.appendChild(spacer);
      tools.appendChild(exportWrap);

      function closeMenu() { menu.hidden = true; exportBtn.setAttribute('aria-expanded', 'false'); }
      exportBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = menu.hidden;
        // close any other open export menu first
        document.querySelectorAll('.tbl-export-menu').forEach(function (m) { if (m !== menu) m.hidden = true; });
        menu.hidden = !open; exportBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      menu.addEventListener('click', function () { closeMenu(); });
      document.addEventListener('click', function (e) { if (!exportWrap.contains(e.target)) closeMenu(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });

      // place the toolbar just before the table (or its scroll wrapper)
      var anchor = table.closest('.table-scroll') || table;
      anchor.parentNode.insertBefore(tools, anchor);

      var rows = dataRows(table.tBodies[0]);
      function filter() {
        var toks = norm(search.value).split(' ').filter(Boolean);
        var shown = 0;
        rows.forEach(function (r) {
          var hay = norm(r.textContent);
          var ok = toks.every(function (t) { return hay.indexOf(t) !== -1; });
          r.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        count.textContent = toks.length ? (shown + ' / ' + rows.length) : '';
      }
      search.addEventListener('input', filter);
      xls.addEventListener('click', function () { exportExcel(table, baseName(table)); });
      csv.addEventListener('click', function () { exportCsv(table, baseName(table)); });
      pdf.addEventListener('click', function () { exportPdf(table, baseName(table)); });
    });
  })();
  </script>

  <script>
  // Global collapsible rubrics + accordion. Two mechanisms, one behaviour ("open one → the others
  // in its group close"):
  //   1) Native <details data-accordion="grp"> (e.g. the Z-closing recents) — opening one closes
  //      its group siblings.
  //   2) Every titled .card in <main> becomes collapsible: its <h2> turns into a click/keyboard
  //      toggle with a chevron, and expanding one card collapses the other cards on the page.
  // Cards start expanded (nothing hidden on load); each card's state is remembered per page in
  // localStorage. Cards holding a required control are skipped so validation never targets a hidden
  // field. Opt out of a specific card with class "no-collapse".
  (function () {
    // (1) native <details data-accordion>
    document.querySelectorAll('details[data-accordion]').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        var g = d.getAttribute('data-accordion');
        document.querySelectorAll('details[data-accordion="' + g + '"]').forEach(function (o) {
          if (o !== d && o.open) o.open = false;
        });
      });
    });

    // (2) collapsible titled cards
    var main = document.querySelector('main.page') || document.querySelector('main');
    if (!main) return;
    var pageKey = 'apCollapse:' + location.pathname;
    function readState() { try { return JSON.parse(localStorage.getItem(pageKey) || '{}'); } catch (e) { return {}; } }
    function saveState(s) { try { localStorage.setItem(pageKey, JSON.stringify(s)); } catch (e) {} }
    var state = readState();
    var cards = [];

    main.querySelectorAll('.card').forEach(function (card) {
      if (card.tagName === 'DETAILS') return;               // already a native collapsible
      if (card.classList.contains('no-collapse')) return;
      if (card.dataset.collapseDone) return;
      if (card.closest('details')) return;                  // nested inside a collapsible
      if (card.parentElement && card.parentElement.closest('.card')) return; // nested card
      var h = null, k = card.firstElementChild;
      while (k) { if (k.tagName === 'H2') { h = k; break; } k = k.nextElementSibling; } // direct-child <h2> only
      if (!h) return;
      if (card.querySelector('[required]')) return;         // don't hide required inputs

      card.dataset.collapseDone = '1';
      var body = document.createElement('div');
      body.className = 'card-cbody';
      var n = h.nextSibling;
      while (n) { var next = n.nextSibling; body.appendChild(n); n = next; }
      card.appendChild(body);
      h.classList.add('card-ctoggle');
      h.setAttribute('role', 'button');
      h.setAttribute('tabindex', '0');

      var key = (h.textContent || '').trim().slice(0, 60);
      function apply(c) { card.classList.toggle('collapsed', c); h.setAttribute('aria-expanded', String(!c)); }
      apply(state[key] === 1);

      function setCollapsed(c, viaUser) {
        apply(c);
        state[key] = c ? 1 : 0; saveState(state);
        if (!c && viaUser) cards.forEach(function (o) { if (o.card !== card) o.setCollapsed(true, false); });
      }
      var rec = { card: card, setCollapsed: setCollapsed };
      cards.push(rec);
      h.addEventListener('click', function () { setCollapsed(!card.classList.contains('collapsed'), true); });
      h.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setCollapsed(!card.classList.contains('collapsed'), true); }
      });
    });
  })();
  </script>

  <!-- מחוות סלולר (רק ב-PWA מותקן, שם אין מחוות דפדפן טבעיות):
       גלילה מטה מלמעלה = רענון · סחיבה שמאלה = חזרה · סחיבה ימינה = הדף הבא -->
  <div id="ptr" aria-hidden="true"><span class="ptr-ico"></span></div>
  <script>
  (function () {
    var standalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches)
      || window.navigator.standalone === true;
    if (!standalone) return; // בדפדפן רגיל מחוות אלה קיימות במקור — לא נכפיל אותן

    var ptr = document.getElementById('ptr');
    var V_THRESH = 80, H_THRESH = 70, MAX_PULL = 130, TIME = 800;
    var sx = 0, sy = 0, st = 0, active = false, hOk = false, topStart = false, mode = '';

    function atTop() { return (window.scrollY || document.documentElement.scrollTop || 0) <= 0; }
    function hScrollable(el) {
      while (el && el.nodeType === 1 && el !== document.body) {
        if (el.scrollWidth - el.clientWidth > 6) {
          var ov = getComputedStyle(el).overflowX;
          if (ov === 'auto' || ov === 'scroll') return true;
        }
        el = el.parentElement;
      }
      return false;
    }
    function blocked(t) {
      return !!(t && t.closest && t.closest('.dp-pop, dialog[open], input[type="range"]'));
    }
    function showPull(dy) {
      var p = Math.min(dy, MAX_PULL);
      ptr.style.transition = 'none';
      ptr.style.opacity = Math.min(p / V_THRESH, 1);
      ptr.style.transform = 'translate(-50%, ' + (Math.min(p, MAX_PULL) - 60) + 'px)';
      ptr.classList.toggle('ready', dy >= V_THRESH);
    }
    function reset() {
      ptr.classList.remove('ready');
      ptr.style.transition = 'transform .2s, opacity .2s';
      ptr.style.opacity = '0';
      ptr.style.transform = 'translate(-50%, -60px)';
    }

    window.addEventListener('touchstart', function (e) {
      if (e.touches.length !== 1) { active = false; return; }
      var t = e.touches[0];
      sx = t.clientX; sy = t.clientY; st = Date.now(); mode = '';
      active = !blocked(e.target);
      hOk = active && !hScrollable(e.target);
      topStart = atTop();
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      if (!active || e.touches.length !== 1) return;
      var t = e.touches[0];
      var dx = t.clientX - sx, dy = t.clientY - sy;
      if (!mode) {
        if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) mode = 'v';
        else if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) mode = 'h';
      }
      if (mode === 'v' && topStart && dy > 0) {
        showPull(dy);
        if (dy > 4 && e.cancelable) e.preventDefault(); // עצור גלישת-יתר בזמן המשיכה
      }
    }, { passive: false });

    window.addEventListener('touchend', function (e) {
      if (!active) return;
      active = false;
      var ct = e.changedTouches[0];
      var dx = ct.clientX - sx, dy = ct.clientY - sy, dt = Date.now() - st;

      if (mode === 'v' && topStart && dy > V_THRESH) {
        ptr.classList.add('spin');
        setTimeout(function () { location.reload(); }, 120);
        return;
      }
      reset();

      if (mode === 'h' && hOk && Math.abs(dx) > H_THRESH && Math.abs(dx) > Math.abs(dy) * 1.5 && dt < TIME) {
        if (dx < 0) history.back();   // סחיבה שמאלה → אחורה
        else history.forward();       // סחיבה ימינה → קדימה
      }
    }, { passive: true });

    window.addEventListener('touchcancel', function () { active = false; reset(); }, { passive: true });
  })();
  </script>
</body>
</html>
