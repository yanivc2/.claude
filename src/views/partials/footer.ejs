    }
    function enhanceAll(root){ (root || document).querySelectorAll('select.js-combo').forEach(enhance); }
    window.apEnhanceCombos = enhanceAll; // so dynamically-added rows (e.g. Z-closing expenses) get the combobox
    document.addEventListener('DOMContentLoaded', function(){ enhanceAll(); });
    // הרשימה כבר אינה ילדה של .combo (היא על <body>), ולכן הבדיקה היא מול הרשימה עצמה
    // ומול השדה שפתח אותה — אחרת כל לחיצה, כולל בחירה מהרשימה, הייתה סוגרת אותה.
    document.addEventListener('click', function(e){
      document.querySelectorAll('.combo-pop').forEach(function(p){
