          (v.filters || []).forEach(function (f) {
            var t = Array.prototype.find.call(document.querySelectorAll('table'), function (x) { return tableKey(x) === f.k; });
            if (!t) return;
            t.querySelectorAll('.filter-row input, .filter-row select').forEach(function (i, n) {
