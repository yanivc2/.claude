  <script>
  // Close any open floating menu (<details class="menu">) when clicking outside it or pressing Esc.
  (function () {
    var deskMq = window.matchMedia('(min-width: 1000px)');
    // On desktop the .navmenu is a fixed sidebar (always open) — never auto-close it. Other
    // floating menus (store pickers) still close normally.
    function closables() {
      return document.querySelectorAll(deskMq.matches ? 'details.menu[open]:not(.navmenu)' : 'details.menu[open]');
    }
    document.addEventListener('click', function (e) {
      if (document.querySelector('dialog[open]')) return; // a modal is open — leave menus alone
      closables().forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (document.querySelector('dialog[open]')) return; // let the dialog swallow the Escape
      closables().forEach(function (d) { d.removeAttribute('open'); });
    });
  })();
  </script>
  <script>
  // Click-to-sort for any <table class="sortable">. A header cell marked
  // data-nosort is skipped. Amounts (₪, thousands, sign) and dates sort numerically.
  (function () {
    function cellValue(td) {
      var t = (td ? td.textContent : '').trim();
      var num = t.replace(/[₪,\s]/g, '').replace(/[−–—]/g, '-');
      if (/^-?\d+(\.\d+)?$/.test(num)) return { n: parseFloat(num), s: t };
      if (/^\d{4}-\d{2}-\d{2}$/.test(t)) return { n: Date.parse(t), s: t };
      return { n: null, s: t };
    }
    function sortTable(table, colIdx, asc) {
      var tbody = table.tBodies[0];
      if (!tbody) return;
      var rows = Array.prototype.slice.call(tbody.rows).filter(function (r) {
        return !r.querySelector('td[colspan]'); // keep "empty" placeholder rows out of sort
      });
      rows.sort(function (a, b) {
        var va = cellValue(a.cells[colIdx]), vb = cellValue(b.cells[colIdx]);
        var cmp;
        if (va.n !== null && vb.n !== null) cmp = va.n - vb.n;
        else cmp = va.s.localeCompare(vb.s, 'he');
        return asc ? cmp : -cmp;
      });
      rows.forEach(function (r) { tbody.appendChild(r); });
    }
    document.querySelectorAll('table.sortable').forEach(function (table) {
      var ths = table.tHead ? table.tHead.rows[0].cells : [];
      Array.prototype.forEach.call(ths, function (th, idx) {
        if (th.hasAttribute('data-nosort')) return;
        th.style.cursor = 'pointer';
        th.title = 'מיון';
        var asc = true;
        th.addEventListener('click', function () {
          Array.prototype.forEach.call(ths, function (h) {
            h.textContent = h.textContent.replace(/[\s▲▼]+$/, '');
          });
          sortTable(table, idx, asc);
          th.textContent = th.textContent.replace(/[\s▲▼]+$/, '') + (asc ? ' ▲' : ' ▼');
          asc = !asc;
        });
      });
    });
  })();
  </script>
  <script>
  // Day-first date picker: replace every <input type="date"> (whose native mobile picker opens
  // to a month/year wheel) with a calendar popover that opens straight to the day grid. The real
  // value is kept ISO (YYYY-MM-DD) in a hidden input under the original name, so forms submit
  // exactly as before; the visible field just shows DD/MM/YYYY.
  (function () {
    var MONTHS = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
    var DOW = ['א','ב','ג','ד','ה','ו','ש'];
    function pad(n){ return (n < 10 ? '0' : '') + n; }
    function toISO(y,m,d){ return y + '-' + pad(m+1) + '-' + pad(d); }
    function fmt(iso){ var p = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || ''); return p ? p[3]+'/'+p[2]+'/'+p[1] : ''; }
    function parse(iso){ var p = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || ''); return p ? {y:+p[1], m:+p[2]-1, d:+p[3]} : null; }
    // Parse a day-first typed date: "6/8/26", "06/08/2026", "6.8.26", "6-8-26" → ISO. A 2-digit year
    // becomes 20YY. Returns null for anything that isn't a real calendar date (rejects 31/2, 45/1…).
    function parseTyped(s){
      var m = /^\s*(\d{1,2})\s*[\/.\-]\s*(\d{1,2})\s*[\/.\-]\s*(\d{2,4})\s*$/.exec(s || '');
      if (!m) return null;
      var d = +m[1], mo = +m[2], y = +m[3];
      if (y < 100) y += 2000;
      if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
      var dt = new Date(y, mo - 1, d);
      if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return null;
      return toISO(y, mo - 1, d);
    }
    function isoOf(dt){ return toISO(dt.getFullYear(), dt.getMonth(), dt.getDate()); }
    function weekBounds(y,m,d){ var dt = new Date(y,m,d); var sun = new Date(y,m,d - dt.getDay()); var sat = new Date(sun); sat.setDate(sun.getDate()+6); return { sun: sun, sat: sat }; }
    function weekLabel(iso){ var p = parse(iso); if (!p) return ''; var w = weekBounds(p.y,p.m,p.d); return fmt(isoOf(w.sun)) + ' – ' + fmt(isoOf(w.sat)); }
    function monthLabel(iso){ var p = parse(iso); return p ? MONTHS[p.m] + ' ' + p.y : ''; }
    function label(iso, mode){ return mode === 'month' ? monthLabel(iso) : mode === 'week' ? weekLabel(iso) : fmt(iso); }

    // mode: 'day' (default) | 'week' (pick a whole Sun–Sat week) | 'month' (pick a whole month)
    function makePicker(hidden, visible, mode, autosubmit) {
      var pop = document.createElement('div'); pop.className = 'dp-pop'; pop.hidden = true;
      var view;
      function commit(iso){ hidden.value = iso; visible.value = label(iso, mode); hidden.dispatchEvent(new Event('change', { bubbles: true }));
        if (autosubmit && hidden.form) { hidden.form.requestSubmit ? hidden.form.requestSubmit() : hidden.form.submit(); } }
      function renderDays() {
        var sel = parse(hidden.value), today = new Date();
        var selWeek = (mode === 'week' && sel) ? weekBounds(sel.y, sel.m, sel.d) : null;
        var startDow = new Date(view.y, view.m, 1).getDay(), days = new Date(view.y, view.m + 1, 0).getDate();
        var h = '<div class="dp-head"><button type="button" class="dp-nav" data-nav="-1">‹</button>'
          + '<span class="dp-title">' + MONTHS[view.m] + ' ' + view.y + '</span>'
          + '<button type="button" class="dp-nav" data-nav="1">›</button></div><div class="dp-grid">';
        DOW.forEach(function(d){ h += '<div class="dp-dow">' + d + '</div>'; });
        for (var i = 0; i < startDow; i++) h += '<span></span>';
        for (var day = 1; day <= days; day++) {
          var cls = 'dp-day', cur = new Date(view.y, view.m, day);
          if (selWeek) { if (cur >= selWeek.sun && cur <= selWeek.sat) cls += ' dp-sel'; }
          else if (sel && sel.y === view.y && sel.m === view.m && sel.d === day) cls += ' dp-sel';
          if (today.getFullYear() === view.y && today.getMonth() === view.m && today.getDate() === day) cls += ' dp-today';
          h += '<button type="button" class="' + cls + '" data-day="' + day + '">' + day + '</button>';
        }
        h += '</div><div class="dp-foot">'
          + (mode === 'week' ? '<button type="button" data-thisweek="1">השבוע</button>'
             : '<button type="button" data-today="1">היום</button><button type="button" data-clear="1">נקה</button>')
          + '</div>';
        pop.innerHTML = h;
      }
      function renderMonths() {
        var sel = parse(hidden.value), today = new Date();
        var h = '<div class="dp-head"><button type="button" class="dp-nav" data-nav="-12">‹</button>'
          + '<span class="dp-title">' + view.y + '</span>'
          + '<button type="button" class="dp-nav" data-nav="12">›</button></div><div class="dp-mgrid">';
        for (var mo = 0; mo < 12; mo++) {
          var cls = 'dp-mo';
          if (sel && sel.y === view.y && sel.m === mo) cls += ' dp-sel';
          if (today.getFullYear() === view.y && today.getMonth() === mo) cls += ' dp-today';
          h += '<button type="button" class="' + cls + '" data-mo="' + mo + '">' + MONTHS[mo] + '</button>';
        }
        pop.innerHTML = h + '</div>';
      }
      function render(){ if (mode === 'month') renderMonths(); else renderDays(); }
      pop.addEventListener('click', function(e){
        e.stopPropagation(); // keep the popover open — the outside-click handler must not fire
        var t = e.target;
        if (t.dataset.nav != null) {
          var d = +t.dataset.nav;
          if (mode === 'month') view.y += d / 12;
          else { view.m += d; while (view.m < 0) { view.m += 12; view.y--; } while (view.m > 11) { view.m -= 12; view.y++; } }
          render();
        } else if (t.dataset.day) {
          var day = +t.dataset.day;
          if (mode === 'week') { var w = weekBounds(view.y, view.m, day); commit(isoOf(w.sun)); }
          else commit(toISO(view.y, view.m, day));
          pop.hidden = true;
        } else if (t.dataset.mo != null && t.dataset.mo !== '') {
          commit(toISO(view.y, +t.dataset.mo, 1)); pop.hidden = true;
        } else if (t.dataset.today) {
          var td = new Date(); commit(toISO(td.getFullYear(), td.getMonth(), td.getDate())); pop.hidden = true;
        } else if (t.dataset.thisweek) {
          var tw = new Date(), wb = weekBounds(tw.getFullYear(), tw.getMonth(), tw.getDate()); commit(isoOf(wb.sun)); pop.hidden = true;
        } else if (t.dataset.clear) {
          hidden.value = ''; visible.value = ''; pop.hidden = true;
        }
      });
      return { el: pop, open: function(){ var s = parse(hidden.value) || (function(){ var t = new Date(); return { y:t.getFullYear(), m:t.getMonth() }; })(); view = { y:s.y, m:s.m }; render(); pop.hidden = false; } };
    }

    function enhance(input) {
      if (input.dataset.dpDone) return; input.dataset.dpDone = '1';
      var name = input.getAttribute('name'), iso = input.value, req = input.required;
      var mode = input.getAttribute('data-dp-mode') || 'day';
      var autosubmit = input.getAttribute('data-dp-submit') === '1';
      var wrap = document.createElement('span'); wrap.className = 'dp-wrap';
      if (req) wrap.dataset.req = '1';
      input.parentNode.insertBefore(wrap, input); wrap.appendChild(input);
      var hidden = document.createElement('input'); hidden.type = 'hidden'; if (name) hidden.name = name; hidden.value = iso || '';
      wrap.appendChild(hidden);
      input.removeAttribute('name'); input.required = false; input.type = 'text'; input.autocomplete = 'off';
      // Typing a day-first date is allowed on pointer-fine (desktop) devices, so the user can key
      // "6/8/26" instead of reaching for the mouse. Touch keeps the readonly picker (no keyboard
      // popping over the calendar), and week/month modes stay picker-only.
      var canType = mode === 'day' && window.matchMedia && window.matchMedia('(pointer: fine)').matches;
      if (!canType) { input.readOnly = true; input.setAttribute('inputmode', 'none'); }
      if (!input.placeholder) input.placeholder = mode === 'month' ? 'בחר חודש' : mode === 'week' ? 'בחר שבוע' : (canType ? 'הקלד או בחר · יום/חודש/שנה' : 'בחר תאריך');
      input.value = iso ? label(iso, mode) : '';
      var dp = makePicker(hidden, input, mode, autosubmit); wrap.appendChild(dp.el);
      function toggle(e){ e.preventDefault(); input.blur();
        document.querySelectorAll('.dp-pop').forEach(function(p){ if (p !== dp.el) p.hidden = true; });
        if (dp.el.hidden) dp.open(); else dp.el.hidden = true; }
      if (canType) {
        // Parse what was typed → commit to the hidden ISO + canonical DD/MM/YYYY display.
        function commitTyped(){
          var v = (input.value || '').trim();
          if (v === '') { hidden.value = ''; hidden.dispatchEvent(new Event('change', { bubbles: true })); return true; }
          var isoT = parseTyped(v);
          if (isoT) { hidden.value = isoT; input.value = label(isoT, mode); hidden.dispatchEvent(new Event('change', { bubbles: true })); return true; }
          return false; // leave the raw text so the user can fix it
        }
        input.addEventListener('focus', function(){
          document.querySelectorAll('.dp-pop').forEach(function(p){ if (p !== dp.el) p.hidden = true; });
          dp.open();
        });
        input.addEventListener('keydown', function(e){ if (e.key === 'Enter') { if (commitTyped()) dp.el.hidden = true; } });
        // Delay so a click on a calendar day (which blurs the input) commits first.
        input.addEventListener('blur', function(){ setTimeout(commitTyped, 150); });
        wrap._dpCommit = commitTyped; // the submit guard commits typed text synchronously before validating
      } else {
        input.addEventListener('mousedown', toggle);
      }
    }
    function enhanceAll(root){ (root || document).querySelectorAll('input[type="date"]').forEach(enhance); }

    document.addEventListener('DOMContentLoaded', function(){ enhanceAll(); });
    document.addEventListener('click', function(e){
      document.querySelectorAll('.dp-pop').forEach(function(p){ if (!p.parentNode.contains(e.target)) p.hidden = true; });
    });
    // Enforce "required" for enhanced date fields (readonly inputs skip native required validation).
    document.addEventListener('submit', function(e){
      // Commit any date typed but not yet blurred (typed → Submit without leaving the field).
      if (e.target.querySelectorAll) e.target.querySelectorAll('.dp-wrap').forEach(function(w){ if (w._dpCommit) w._dpCommit(); });
      var wraps = e.target.querySelectorAll ? e.target.querySelectorAll('.dp-wrap[data-req="1"]') : [];
      for (var i = 0; i < wraps.length; i++) {
        var h = wraps[i].querySelector('input[type="hidden"]');
        if (h && !h.value) { e.preventDefault(); alert('יש לבחור תאריך'); wraps[i].querySelector('input[type="text"]').focus(); return; }
      }
    }, true);
  })();
  </script>

  <script>
  // Searchable combobox: enhance any <select class="js-combo"> into a type-to-filter field. Users
  // key part of a name (or a few letters, in order) and pick from the similar matches. The original
  // <select> stays the submitted control (hidden), so the server contract is unchanged.
  (function () {
    function norm(s){ return (s == null ? '' : String(s)).trim().toLowerCase(); }
    function esc(s){ return String(s).replace(/[&<>]/g, function(c){ return { '&':'&amp;','<':'&lt;','>':'&gt;' }[c]; }); }
    // match = plain substring, OR every whitespace token is a substring, OR chars appear in order.
    function matches(text, q){
      var h = norm(text), n = norm(q);
      if (!n) return true;
      if (h.indexOf(n) !== -1) return true;
      var toks = n.split(/\s+/).filter(Boolean);
      if (toks.length > 1 && toks.every(function(t){ return h.indexOf(t) !== -1; })) return true;
      var i = 0; for (var j = 0; j < h.length && i < n.length; j++) { if (h.charAt(j) === n.charAt(i)) i++; }
      return i === n.length;
    }

    function enhance(sel){
      if (sel.dataset.comboDone) return; sel.dataset.comboDone = '1';
      var opts = Array.prototype.slice.call(sel.options).map(function(o){ return { v: o.value, t: (o.text || '').trim(), disabled: o.disabled }; });
      var wrap = document.createElement('span'); wrap.className = 'combo';
      sel.parentNode.insertBefore(wrap, sel); wrap.appendChild(sel);
      sel.style.display = 'none'; sel.setAttribute('aria-hidden', 'true'); sel.tabIndex = -1;
      var req = sel.required; if (req) { sel.required = false; wrap.dataset.req = '1'; }
      wrap.dataset.label = sel.getAttribute('data-combo-label') || 'ערך';

      var input = document.createElement('input'); input.type = 'text'; input.className = 'combo-input';
      input.autocomplete = 'off'; input.placeholder = sel.getAttribute('data-combo-ph') || 'הקלד לחיפוש…';
      var cur = opts.filter(function(o){ return o.v !== '' && o.v === sel.value; })[0];
      if (cur) input.value = cur.t;
      wrap.insertBefore(input, sel);
      var pop = document.createElement('div'); pop.className = 'combo-pop'; pop.hidden = true; wrap.appendChild(pop);

      var shown = [], activeIdx = -1;
      function setVal(o){ sel.value = o.v; input.value = o.t; sel.dispatchEvent(new Event('change', { bubbles: true })); }
      function paint(){ Array.prototype.forEach.call(pop.children, function(c){ if (c.dataset.i != null) c.classList.toggle('active', +c.dataset.i === activeIdx); });
        var a = pop.querySelector('.combo-opt.active'); if (a) a.scrollIntoView({ block: 'nearest' }); }
      function render(q){
        shown = opts.filter(function(o){ return o.v !== '' && !o.disabled && matches(o.t, q); });
        activeIdx = shown.length ? 0 : -1;
        pop.innerHTML = shown.length
          ? shown.map(function(o, i){ return '<div class="combo-opt" data-i="' + i + '">' + esc(o.t) + '</div>'; }).join('')
          : '<div class="combo-empty">אין תוצאות</div>';
        pop.hidden = false; paint();
      }
      input.addEventListener('focus', function(){ render(input.value === (cur && cur.t) ? '' : input.value); });
      input.addEventListener('input', function(){ sel.value = ''; render(input.value); });
      input.addEventListener('keydown', function(e){
        if (pop.hidden) { if (e.key === 'ArrowDown') { render(''); } return; }
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, shown.length - 1); paint(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); paint(); }
        else if (e.key === 'Enter') { if (activeIdx >= 0 && shown[activeIdx]) { e.preventDefault(); setVal(shown[activeIdx]); pop.hidden = true; } }
        else if (e.key === 'Escape') { pop.hidden = true; }
      });
      pop.addEventListener('mousedown', function(e){ var t = e.target.closest ? e.target.closest('.combo-opt') : null; if (!t) return; e.preventDefault(); setVal(shown[+t.dataset.i]); pop.hidden = true; });
      input.addEventListener('blur', function(){ setTimeout(function(){
        pop.hidden = true;
        if (!sel.value) { var exact = opts.filter(function(o){ return o.v !== '' && norm(o.t) === norm(input.value); })[0]; if (exact) setVal(exact); }
        var c = opts.filter(function(o){ return o.v !== '' && o.v === sel.value; })[0];
        input.value = c ? c.t : (sel.value ? input.value : '');
        cur = c || null;
      }, 150); });
    }
    function enhanceAll(root){ (root || document).querySelectorAll('select.js-combo').forEach(enhance); }
    document.addEventListener('DOMContentLoaded', function(){ enhanceAll(); });
    document.addEventListener('click', function(e){ document.querySelectorAll('.combo-pop').forEach(function(p){ if (!p.parentNode.contains(e.target)) p.hidden = true; }); });
    document.addEventListener('submit', function(e){
      var wraps = e.target.querySelectorAll ? e.target.querySelectorAll('.combo[data-req="1"]') : [];
      for (var i = 0; i < wraps.length; i++) {
        var s = wraps[i].querySelector('select');
        if (s && !s.value) { e.preventDefault(); alert('יש לבחור ' + (wraps[i].dataset.label || 'ערך')); wraps[i].querySelector('.combo-input').focus(); return; }
      }
    }, true);
  })();
  </script>

  <!-- מחוות סלולר (רק ב-PWA מותקן, שם אין מחוות דפדפן טבעיות):
       גלילה מטה מלמעלה = רענון · סחיבה שמאלה = חזרה · סחיבה ימינה = הדף הבא -->
  <div id="ptr" aria-hidden="true"><span class="ptr-ico"></span></div>
  <script>
  (function () {
    var standalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches)
      || window.navigator.standalone === true;
    if (!standalone) return; // בדפדפן רגיל מחוות אלה קיימות במקור — לא נכפיל אותן

    var ptr = document.getElementById('ptr');
    var V_THRESH = 80, H_THRESH = 70, MAX_PULL = 130, TIME = 800;
    var sx = 0, sy = 0, st = 0, active = false, hOk = false, topStart = false, mode = '';

    function atTop() { return (window.scrollY || document.documentElement.scrollTop || 0) <= 0; }
    function hScrollable(el) {
      while (el && el.nodeType === 1 && el !== document.body) {
        if (el.scrollWidth - el.clientWidth > 6) {
          var ov = getComputedStyle(el).overflowX;
          if (ov === 'auto' || ov === 'scroll') return true;
        }
        el = el.parentElement;
      }
      return false;
    }
    function blocked(t) {
      return !!(t && t.closest && t.closest('.dp-pop, dialog[open], input[type="range"]'));
    }
    function showPull(dy) {
      var p = Math.min(dy, MAX_PULL);
      ptr.style.transition = 'none';
      ptr.style.opacity = Math.min(p / V_THRESH, 1);
      ptr.style.transform = 'translate(-50%, ' + (Math.min(p, MAX_PULL) - 60) + 'px)';
      ptr.classList.toggle('ready', dy >= V_THRESH);
    }
    function reset() {
      ptr.classList.remove('ready');
      ptr.style.transition = 'transform .2s, opacity .2s';
      ptr.style.opacity = '0';
      ptr.style.transform = 'translate(-50%, -60px)';
    }

    window.addEventListener('touchstart', function (e) {
      if (e.touches.length !== 1) { active = false; return; }
      var t = e.touches[0];
      sx = t.clientX; sy = t.clientY; st = Date.now(); mode = '';
      active = !blocked(e.target);
      hOk = active && !hScrollable(e.target);
      topStart = atTop();
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      if (!active || e.touches.length !== 1) return;
      var t = e.touches[0];
      var dx = t.clientX - sx, dy = t.clientY - sy;
      if (!mode) {
        if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) mode = 'v';
        else if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) mode = 'h';
      }
      if (mode === 'v' && topStart && dy > 0) {
        showPull(dy);
        if (dy > 4 && e.cancelable) e.preventDefault(); // עצור גלישת-יתר בזמן המשיכה
      }
    }, { passive: false });

    window.addEventListener('touchend', function (e) {
      if (!active) return;
      active = false;
      var ct = e.changedTouches[0];
      var dx = ct.clientX - sx, dy = ct.clientY - sy, dt = Date.now() - st;

      if (mode === 'v' && topStart && dy > V_THRESH) {
        ptr.classList.add('spin');
        setTimeout(function () { location.reload(); }, 120);
        return;
      }
      reset();

      if (mode === 'h' && hOk && Math.abs(dx) > H_THRESH && Math.abs(dx) > Math.abs(dy) * 1.5 && dt < TIME) {
        if (dx < 0) history.back();   // סחיבה שמאלה → אחורה
        else history.forward();       // סחיבה ימינה → קדימה
      }
    }, { passive: true });

    window.addEventListener('touchcancel', function () { active = false; reset(); }, { passive: true });
  })();
  </script>
</body>
</html>
