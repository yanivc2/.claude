  <script>
  // ── ניווט ונוחות בכל דף (בעלים, 16/10) ─────────────────────────────────────────────
  // (1) "→ חזרה" — תמיד אפשר לחזור לדף הקודם בלחיצה. לא history.back(): אחרי פעולה (POST→303) הדפדפן
  //     רושם את אותו דף פעמיים, ו"אחורה" מחזיר לאותו דף לפני הפעולה. כאן נשמרת מחסנית של **דפים שונים**
  //     (בלי פרמטרים חולפים כמו notice/cashErr), כך ש"חזרה" תמיד מוביל לדף אחר באמת.
  // (2) "⬆" — בדף ארוך, כפתור צף שמקפיץ לראש הדף.
  // (3) פס גלילה מצד ימין (מחשב, עכבר): גרירה שלו גוללת הרבה במהירות — ובתנועה איטית, לאט ובשליטה.
  (function () {
    var main = document.querySelector('main.page') || document.querySelector('main');
    if (!main || /^\/(login|forgot|reset)/.test(location.pathname)) return;

    // (1) חזרה
    var TRANSIENT = /^(notice|err|error|cashErr|cashNote|saved|dup|paid|moved|nsup|nstore|noteerr|cb|open)$/;
    function clean(u) {
      var q = new URLSearchParams(u.search);
      Array.from(q.keys()).forEach(function (k) { if (TRANSIENT.test(k)) q.delete(k); });
      var qs = q.toString();
      return u.pathname + (qs ? '?' + qs : '');
    }
    var NAVK = 'apNavStack';
    var cur = clean(location);
    // הודעת תוצאה ("נמחקה: …", שגיאה) מוצגת פעם אחת: אחרי שהדף הציג אותה היא יורדת מהכתובת. אחרת רענון,
    // או חזרה לאפליקציה (ה-PWA משחזר את הכתובת האחרונה), מציגים שוב "נמחקה" ימים אחרי — בעלים, 19/10:
    // "איזה סגירה נמחקה?". רק פרמטרי הודעה — שאר הפרמטרים החולפים משמשים את הדף עצמו.
    try {
      var q0 = new URLSearchParams(location.search), had = false;
      ['notice', 'err', 'error'].forEach(function (k) { if (q0.has(k)) { q0.delete(k); had = true; } });
      if (had && history.replaceState) {
        var qs0 = q0.toString();
        history.replaceState(history.state, '', location.pathname + (qs0 ? '?' + qs0 : '') + location.hash);
      }
    } catch (e) { /* אין history — ההודעה פשוט נשארת בכתובת */ }
    var st = [];
    try { st = JSON.parse(sessionStorage.getItem(NAVK) || '[]'); } catch (e) { st = []; }
    if (st.length && st[st.length - 1] === cur) { /* אותו דף (פעולה/רענון) — לא נוסף */ }
    else if (st.length >= 2 && st[st.length - 2] === cur) st.pop();         // חזרנו לדף הקודם
    else { st.push(cur); if (st.length > 40) st = st.slice(-40); }
    try { sessionStorage.setItem(NAVK, JSON.stringify(st)); } catch (e) {}
    // בעלים 21/10: "איפה נעלם כפתור החזור?" — בדף שנפתח ישר (לשונית חדשה, שחזור PWA) או אחרי "→ חזרה" לדף
    // הראשון במחסנית לא היה לאן לחזור, והכפתור פשוט נעלם. עכשיו הוא תמיד שם; בלי דף קודם — ללוח הבקרה.
    var prev = st.length >= 2 ? st[st.length - 2] : (location.pathname !== '/' ? '/' : null);
    if (prev) {
      var a = document.createElement('a');
      a.href = prev;
      a.className = 'btn btn-secondary btn-sm';
      a.textContent = '→ חזרה';
      a.title = st.length >= 2 ? 'חזרה לדף הקודם' : 'חזרה ללוח הבקרה';
      // בעלים, 18/10: "את כפתור חזור שים הכי ימינה ואחריו את אפשרויות" — ראשון בצד הימני של שורת הכותרת.
      // דף בלי פס חנות — שורה משלו בראש התוכן, צמודה לימין.
      var side = document.querySelector('.store-banner .sb-start');
      if (side) {
        a.className += ' store-banner-back no-print';
        side.insertBefore(a, side.firstChild);
      } else {
        var bar = document.createElement('div');
        bar.className = 'page-back no-print';
        bar.appendChild(a);
        main.insertBefore(bar, main.firstChild);
      }
    }

    // (2) לראש הדף
    var top = document.createElement('button');
    top.type = 'button';
    top.className = 'to-top no-print';
    top.setAttribute('aria-label', 'לראש הדף');
    top.title = 'לראש הדף';
    // בעלים, 17/10: "זה לא מובן שזה חץ למעלה" — חץ מלא (SVG, לא תו שתלוי בגופן) + המילה "למעלה".
    top.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3l-8 8h5v10h6V11h5z"/></svg><span>למעלה</span>';
    top.hidden = true;
    top.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    document.body.appendChild(top);

    // (3) פס גלילה מימין — רק עם עכבר, ורק כשהדף ארוך באמת.
    var fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
    var rail = null, thumb = null;
    if (fine) {
      rail = document.createElement('div');
      rail.className = 'scroll-rail no-print';
      rail.setAttribute('aria-hidden', 'true');
      thumb = document.createElement('div');
      thumb.className = 'scroll-rail-thumb';
      rail.appendChild(thumb);
      document.body.appendChild(rail);
      var drag = null;
      thumb.addEventListener('mousedown', function (e) {
        e.preventDefault();
        drag = { y: e.clientY, top: thumb.offsetTop };
        rail.classList.add('dragging');
        document.body.classList.add('no-select');
      });
      document.addEventListener('mousemove', function (e) {
        if (!drag) return;
        var range = rail.clientHeight - thumb.offsetHeight;
        var t = Math.max(0, Math.min(range, drag.top + (e.clientY - drag.y)));
        var max = document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo(0, range > 0 ? (t / range) * max : 0);
      });
      document.addEventListener('mouseup', function () {
        if (!drag) return;
        drag = null;
        rail.classList.remove('dragging');
        document.body.classList.remove('no-select');
      });
      // לחיצה על הפס עצמו (לא על הידית) — קפיצה למקום הזה.
      rail.addEventListener('mousedown', function (e) {
        if (e.target === thumb) return;
        var r = rail.getBoundingClientRect();
        var range = rail.clientHeight - thumb.offsetHeight;
        var t = Math.max(0, Math.min(range, e.clientY - r.top - thumb.offsetHeight / 2));
        var max = document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo(0, range > 0 ? (t / range) * max : 0);
      });
    }

    function update() {
      var doc = document.documentElement;
      var max = doc.scrollHeight - window.innerHeight;
      top.hidden = window.scrollY < 600;
      // פס שנדבק לתחתית המסך ("הנפק תשלום לנבחרים", שמירת דוח Z) — הכפתור עולה מעליו ולא מכסה אותו.
      var lift = 18;
      document.querySelectorAll('.pay-bar, .zform-save').forEach(function (b) {
        if (b.offsetParent === null) return;
        var r = b.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > window.innerHeight - 4) lift = Math.max(lift, window.innerHeight - r.top + 10);
      });
      top.style.bottom = lift + 'px';
      if (!rail) return;
      var long = doc.scrollHeight > window.innerHeight * 1.8;
      rail.hidden = !long;
      if (!long) return;
      // בדסקטופ — צמוד לתפריט הצד, בלי מרווח (בעלים 21/10: "הסרגל מימין תצמיד אותו, בטל את המרווח ביניהם"),
      // והתוכן נשאר ממורכז ביניהם. בלי תפריט צד (טלפון/מסך צר) — ליד הקצה הימני של התוכן. לא מעל התפריט.
      var mr = main.getBoundingClientRect();
      var side = document.querySelector('header.nav');
      var sr = side && side.getBoundingClientRect();
      var docked = sr && sr.left >= mr.right && sr.height > window.innerHeight / 2;
      var x = docked ? sr.left - 16 : Math.min(window.innerWidth - 16, mr.right + 4);
      rail.style.left = x + 'px';
      var h = rail.clientHeight;
      var th = Math.max(40, h * window.innerHeight / doc.scrollHeight);
      thumb.style.height = th + 'px';
      thumb.style.top = (max > 0 ? (window.scrollY / max) * (h - th) : 0) + 'px';
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    document.addEventListener('toggle', update, true);
    window.addEventListener('load', update);
    update();
  })();
  </script>
</body>
</html>
