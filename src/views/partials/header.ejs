<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <%# viewport-fit=cover: without it env(safe-area-inset-*) is always 0, and the fullscreen
      scanner (/scan) would put its controls under the notch and the home indicator. %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <%# Apply the saved theme (מצב בהיר/כהה) before the stylesheet paints, so there is no flash. %>
  <script>(function(){try{var t=localStorage.getItem('ap-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
  <title><%= title %> · AP Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/nocturne.css?v=<%= encodeURIComponent(typeof buildVersion !== 'undefined' ? buildVersion : 'dev') %>" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#161826" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
</head>
<body>
  <!-- ambient background -->
  <div class="amb amb-glow"></div>
  <div class="amb amb-grid"></div>
  <div class="amb amb-vignette"></div>

  <header class="nav">
    <a href="/" class="nav-brand"><span class="mark">AP</span>Control</a>
    <%# טלפון: שם הדף במרכז שורת הכותרת (בעלים, 17/10) — מתחלף בכל דף. השרת כותב את `title`, והסקריפט
        למטה מחליף בטקסט ה-<h1> של הדף ומסתיר אותו שם, כך שהשם לא מופיע פעמיים. במחשב — מוסתר. %>
    <span class="nav-title"><%= typeof title !== 'undefined' ? title : '' %></span>
    <%# טלפון (בעלים, 18/10): "שים את בורר החנות משמאל, הכי שמאל ללוח הבקרה" — הסקריפט שאחרי .topbar מעביר
        לכאן את .sb-store (הבורר עצמו, לא עותק) ובמחשב מחזיר אותו לשורת הכותרת. %>
    <span class="nav-store"></span>
    <span class="spacer"></span>
    <details class="menu navmenu" id="navmenu">
      <%# טלפון (בעלים, 18/10): "במקום ניווט דפים יהיה רשום AP CONTROL — מימין, איפה ש-AP Control עכשיו".
          הכפתור שפותח את התפריט הוא הלוגו עצמו; הלוגו הנפרד מוסתר בטלפון. במחשב הכפתור מוסתר (הסרגל פתוח). %>
      <summary class="btn btn-secondary btn-sm" aria-label="ניווט דפים" title="ניווט דפים"><span class="nav-brand navmenu-brand"><span class="mark">AP</span>Control</span> <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <% function nav(key){ return typeof canView !== 'function' || canView(key); } %>
        <%# "📖 מדריך למשתמש" — ראשון בתפריט, מעל "לוח בקרה" (בעלים 21/10; עבר מסרגל הכלים של דף ההגדרות).
            הדף יושב תחת /settings ולכן גם הקישור דורש את הרשאת 'settings'. %>
        <% if (typeof can === 'function' && can('settings')) { %><a href="/settings/guide" class="<%= path.startsWith('/settings/guide') ? 'active' : '' %>"><span class="mi-ic">📖</span>מדריך למשתמש</a><% } %>
        <% if (nav('nav_dashboard')) { %><a href="/" class="<%= path === '/' ? 'active' : '' %>"><span class="mi-ic">🏠</span>לוח בקרה</a><% } %>
        <% if (nav('nav_invoices')) { %><a href="/invoices" class="<%= path.startsWith('/invoices') ? 'active' : '' %>"><span class="mi-ic">🧾</span>חשבוניות</a><% } %>
        <% if (nav('nav_tracked_invoices')) { %><a href="/tracked-invoices" class="<%= path.startsWith('/tracked-invoices') ? 'active' : '' %>"><span class="mi-ic">🟠</span>מעוקבות לתשלום</a><% } %>
        <% if (nav('nav_payments')) { %><a href="/payments" class="<%= path.startsWith('/payments') ? 'active' : '' %>"><span class="mi-ic">💳</span>מרקורים</a><% } %>
        <% if (nav('nav_zreports')) { %><a href="/reports/zreports" class="<%= path.startsWith('/reports/zreports') ? 'active' : '' %>"><span class="mi-ic">📊</span>דוחות Z</a><% } %>
        <% if (nav('nav_zclosing')) { %><a href="/zclosing" class="<%= path.startsWith('/zclosing') ? 'active' : '' %>"><span class="mi-ic">🔒</span>סגירת Z</a><% } %>
        <% if (nav('nav_outstanding')) { %><a href="/reports/outstanding" class="<%= path === '/reports/outstanding' ? 'active' : '' %>"><span class="mi-ic">📤</span>צ׳קים בחוץ</a><% } %>
        <% if (nav('nav_reconciliation')) { %><a href="/reconciliation" class="<%= path.startsWith('/reconciliation') ? 'active' : '' %>"><span class="mi-ic">🏦</span>התאמת בנק</a><% } %>
        <% if (nav('nav_transfers')) { %><a href="/transfers" class="<%= path.startsWith('/transfers') ? 'active' : '' %>"><span class="mi-ic">🏦</span>העברות בנקאיות</a><% } %>
        <% if (nav('nav_voided_checks')) { %><a href="/voided-checks" class="<%= path.startsWith('/voided-checks') ? 'active' : '' %>"><span class="mi-ic">🚫</span>צ׳קים מבוטלים</a><% } %>
        <% if (nav('nav_audit')) { %><a href="/audit" class="<%= path === '/audit' ? 'active' : '' %>"><span class="mi-ic">📅</span>יומן</a><% } %>
        <% if (nav('nav_suppliers')) { %><a href="/suppliers" class="<%= path.startsWith('/suppliers') ? 'active' : '' %>"><span class="mi-ic">🏢</span>ספקים</a><% } %>
        <% if (nav('nav_employees')) { %><a href="/employees" class="<%= path.startsWith('/employees') ? 'active' : '' %>"><span class="mi-ic">👥</span>עובדים ומשכורות</a><% } %>
        <% if (nav('nav_profitability')) { %><a href="/reports/profitability" class="<%= path === '/reports/profitability' ? 'active' : '' %>"><span class="mi-ic">💰</span>רווחיות</a><% } %>
        <% if (currentUser.role === 'owner') { %>
          <a href="/approvals" class="<%= path.startsWith('/approvals') ? 'active' : '' %>"><span class="mi-ic">✅</span>אישורים<% if (typeof pendingApprovals !== 'undefined' && pendingApprovals > 0) { %> <span class="tag tag-accent"><%= pendingApprovals %></span><% } %></a>
          <a href="/notifications" class="<%= path.startsWith('/notifications') ? 'active' : '' %>"><span class="mi-ic">🔔</span>התראות<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> <span class="tag tag-accent"><%= unreadNotifications %></span><% } %></a>
        <% } %>
        <% if (nav('nav_scan')) { %><a href="/scan" class="<%= path.startsWith('/scan') ? 'active' : '' %>"><span class="mi-ic"><%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? '📷' : '🔒' %></span>צילום חשבוניות<% if (!(typeof scanEnabled !== 'undefined' && scanEnabled)) { %> <span class="tag" style="font-size:10px">נעול</span><% } %></a><% } %>
        <% if (typeof can === 'function' && can('settings')) { %>
          <a href="/settings" class="<%= path.startsWith('/settings') && !path.startsWith('/settings/guide') ? 'active' : '' %>"><span class="mi-ic">⚙️</span>הגדרות</a>
        <% } %>
        <div class="menu-sep"></div>
        <button type="button" id="themeToggle" onclick="apToggleTheme()"><span class="mi-ic" id="themeIco">🌙</span><span id="themeTxt">מצב בהיר</span></button>
        <form method="post" action="/logout" style="margin:0">
          <button type="submit"><span class="mi-ic">🚪</span>התנתק</button>
        </form>
      </div>
    </details>
  </header>
  <script>
    /* Desktop only: show the nav as a static bar under the logo (force <details> open);
       mobile keeps the ☰ dropdown untouched. */
    (function(){
      var d = document.getElementById('navmenu'); if (!d) return;
      var mq = window.matchMedia('(min-width: 1000px)');
      function sync(){ if (mq.matches) d.setAttribute('open',''); else d.removeAttribute('open'); }
      (mq.addEventListener ? mq.addEventListener('change', sync) : mq.addListener(sync));
      sync();
      // שם הדף בשורת הכותרת: כותרת ה-h1 הראשונה של הדף עולה לשם — לכותרת הטלפון (.nav-title) ולמרכז שורת
      // הכותרת במחשב (.topbar-title) — ומוסתרת בדף (CSS), כך שהשם לא מופיע פעמיים.
      document.addEventListener('DOMContentLoaded', function () {
        var h = document.querySelector('main.page h1');
        if (!h) return;
        var name = h.textContent.replace(/\s+/g, ' ').trim();
        document.querySelectorAll('.nav-title, .topbar-title').forEach(function (t) { t.textContent = name; t.title = name; });
        h.classList.add('h1-in-header');
      });
      /* --nav-w: the widest menu item (icon + label), measured — the CSS centers the whole group on
         it, so the icons stand in one straight column and the longest label still fits. Count tags
         (אישורים, התראות, "נעול") sit at the far end of their row and are left out of the measure. */
      function measure(){
        var panel = d.querySelector('.menu-panel'); if (!panel || !panel.offsetWidth) return;
        var max = 0, r = document.createRange();
        var tags = panel.querySelectorAll('.tag, .badge');
        tags.forEach(function(t){ t.style.display = 'none'; });
        panel.querySelectorAll(':scope > a, :scope > button, :scope > form > button').forEach(function(el){
          r.selectNodeContents(el); var w = r.getBoundingClientRect().width; if (w > max) max = w;
        });
        tags.forEach(function(t){ t.style.display = ''; });
        if (max) panel.style.setProperty('--nav-w', Math.ceil(max) + 'px');
      }
      d.addEventListener('toggle', measure);
      window.addEventListener('resize', measure);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
      measure();
    })();

    /* Theme toggle (מצב בהיר/כהה). Persists to localStorage; the <head> script applies it on load.
       Default (no data-theme) is the dark Nocturne ground; toggling adds/removes data-theme=light. */
    function apCurrentTheme(){ return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; }
    function apSyncThemeLabel(){
      var light = apCurrentTheme() === 'light';
      var ico = document.getElementById('themeIco'), txt = document.getElementById('themeTxt');
      if (ico) ico.textContent = light ? '☀️' : '🌙';
      if (txt) txt.textContent = light ? 'מצב כהה' : 'מצב בהיר';
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', light ? '#f4f5fa' : '#161826');
    }
    function apToggleTheme(){
      var next = apCurrentTheme() === 'light' ? 'dark' : 'light';
      if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('ap-theme', next); } catch (e) {}
      apSyncThemeLabel();
    }
    apSyncThemeLabel();
  </script>

  <%# ── שורת הכותרת (בעלים, 17/10 + 18/10, אחרי הדמיה): פס החנות הוא שורת הכותרת של אזור התוכן.
      מחשב: קבועה למעלה. מימין "→ חזרה" (הכי ימני, footer.ejs) ואחריו "אפשרויות" — הקצה הימני של הקבוצה
      מעל המסגרת הימנית של אריח "צ׳קים בחוץ"; במרכז שם הדף (ה-h1, מתחלף בכל דף); משמאל "AP Control" והבורר
      צמוד אליו. בלי 🏪 ובלי "החלף" — הבורר מחליף לבד (apAutoSubmit). טלפון: הפס מתחת לכותרת, ושם הדף
      במרכז הכותרת עצמה (.nav-title). מחוץ ל-<main> בכוונה: ל-main יש אנימציית transform, ו-position:fixed
      בתוכו נמדד מול main. %>
  <% if (typeof availableStores !== 'undefined' && availableStores && availableStores.length) { %>
  <div class="topbar">
    <div class="topbar-inner">
      <div class="store-banner<%= (typeof activeStore !== 'undefined' && activeStore) ? '' : ' is-all' %>">
        <%# topMenu: שם partial בתיקייה הזו שהדף מבקש לשים כאן (למשל '_newInvoiceMenu' בדף החשבוניות). %>
        <div class="sb-side sb-start"><% if (typeof quickMenu !== 'undefined' && quickMenu) { %><%- include('_quickMenu') %><% } %><% if (typeof topMenu !== 'undefined' && topMenu) { %><%- include(topMenu) %><% } %></div>
        <div class="sb-center"><span class="topbar-title"><%= typeof title !== 'undefined' ? title : '' %></span></div>
        <div class="sb-side sb-end">
        <span class="sb-store">
        <%# בעלים, 17/10: "אני לא צריך שיהיה רשום פעמיים — לקצר אבל להבליט". כשיש בורר, שם החנות מופיע
            רק בתוכו (מודגש). בלי בורר (חנות אחת) — השם לבדו, מודגש. %>
        <% if (availableStores.length <= 1) { %>
        <strong class="store-banner-name">
          <% if (typeof activeStore !== 'undefined' && activeStore) { %>
            <%= activeStore.name %>
          <% } else if (typeof canAllStores !== 'undefined' && canAllStores) { %>
            כל החנויות
          <% } else { %>
            לא נבחרה חנות
          <% } %>
        </strong>
        <% } %>
        <% if (availableStores.length > 1) { %>
          <%# בלי כפתור "החלף" (בעלים, 18/10: "זה מתחלף אוטומטית"): onchange שולח דרך apAutoSubmit (fetch —
              POST מקורי שנענה בהפניה הוא מה ששבר את ה-PWA המותקן). <noscript> שומר החלפה גם בלי JS. %>
          <form method="post" action="/context/store" class="store-banner-switch"
                onsubmit="if (window.apAutoSubmit) { apAutoSubmit(this); return false; } return true;">
            <input type="hidden" name="return_to" value="<%= path %>">
            <% var _dupNames = {}; availableStores.forEach(function(s){ _dupNames[s.name] = (_dupNames[s.name] || 0) + 1; });
               var _todo = (typeof storeTodo !== 'undefined' && storeTodo) || {};
               var _anyTodo = availableStores.some(function(s){ return _todo[s.id] > 0; }); %>
            <select name="store_id" class="store-banner-pick" onchange="apAutoSubmit(this)" aria-label="חנות פעילה — בחר חנות">
              <% if (typeof canAllStores !== 'undefined' && canAllStores) { %><option value="">— כל החנויות —</option><% } else if (!(typeof activeStore !== 'undefined' && activeStore)) { %><option value="" disabled selected>— בחר חנות —</option><% } %>
              <% availableStores.forEach(function(s){ %>
                <%# רק שם החנות; שם החברה נוסף רק כששתי חנויות נושאות אותו שם (אחרת אי אפשר להבדיל ביניהן). %>
                <%# "(N)" = הפקדות שהוצהרו ולא הופקדו באותה חנות (בעלים 20/10). קצר בכוונה: הבורר הסגור מציג את
                    הטקסט של החנות הנבחרת, וברוחב טלפון אין לו יותר מ-108px. ההסבר — בשורה האחרונה של הרשימה הפתוחה. %>
                <option value="<%= s.id %>"<%= (typeof activeStore !== 'undefined' && activeStore && Number(activeStore.id) === Number(s.id)) ? ' selected' : '' %>><%= s.name %><%= _dupNames[s.name] > 1 ? ' · ' + s.company_name : '' %><%= _todo[s.id] > 0 ? ' (' + _todo[s.id] + ')' : '' %></option>
              <% }); %>
              <% if (_anyTodo) { %><option value="" disabled>(N) = הפקדות שלא הופקדו</option><% } %>
            </select>
            <noscript><button type="submit" class="btn btn-secondary btn-sm">החלף</button></noscript>
          </form>
        <% } else { %>
          <span class="tag tag-outline store-banner-lock">נעול לחנות זו</span>
        <% } %>
        </span>
          <a href="/" class="nav-brand topbar-brand"><span class="mark">AP</span>Control</a>
        </div>
      </div>
    </div>
  </div>
  <script>
    // בורר החנות: במחשב — בשורת הכותרת, צמוד ל-"AP Control"; בטלפון — הכי שמאלי בשורת הניווט, מול שם
    // הדף. אותו אלמנט עובר בין שני המקומות (בלי עותק — "בורר יחיד"), מיד בטעינה ובכל מעבר רוחב.
    (function () {
      var store = document.querySelector('.topbar .sb-store');
      var home = document.querySelector('.topbar .sb-end');
      var slot = document.querySelector('.nav .nav-store');
      if (!store || !home || !slot) return;
      var mq = window.matchMedia('(max-width: 999.98px)');
      function put() {
        if (mq.matches) { if (store.parentNode !== slot) slot.appendChild(store); }
        else if (store.parentNode !== home) home.insertBefore(store, home.firstChild);
      }
      put();
      (mq.addEventListener ? mq.addEventListener('change', put) : mq.addListener(put));
    })();
  </script>
  <% } %>
  <main class="page fade-up">
    <% if (typeof scopeCompanies !== 'undefined' && scopeCompanies) { %>
      <div class="scope-strip">
        <span class="tag tag-outline">חברות מורשות</span>
        <% if (scopeCompanies.length === 0) { %>
          <span>אין גישה לאף חברה — פנה לבעלים</span>
        <% } else { %>
          <span><%= scopeCompanies.map(function(c){return c.name;}).join(' · ') %></span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div>
    <% } %>
