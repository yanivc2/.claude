<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <%# viewport-fit=cover: without it env(safe-area-inset-*) is always 0, and the fullscreen
      scanner (/scan) would put its controls under the notch and the home indicator. %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <%# Apply the saved theme (מצב בהיר/כהה) before the stylesheet paints, so there is no flash. %>
  <script>(function(){try{var t=localStorage.getItem('ap-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
  <title><%= title %> · AP Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/nocturne.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#161826" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
</head>
<body>
  <!-- ambient background -->
  <div class="amb amb-glow"></div>
  <div class="amb amb-grid"></div>
  <div class="amb amb-vignette"></div>

  <header class="nav">
    <a href="/" class="nav-brand"><span class="mark">AP</span>Control</a>
    <span class="spacer"></span>
    <details class="menu navmenu" id="navmenu">
      <summary class="btn btn-secondary btn-sm">☰ ניווט דפים <span class="caret">▾</span></summary>
      <div class="menu-panel">
        <% function nav(key){ return typeof canView !== 'function' || canView(key); } %>
        <% if (nav('nav_dashboard')) { %><a href="/" class="<%= path === '/' ? 'active' : '' %>"><span class="mi-ic">🏠</span>לוח בקרה</a><% } %>
        <% if (nav('nav_invoices')) { %><a href="/invoices" class="<%= path.startsWith('/invoices') ? 'active' : '' %>"><span class="mi-ic">🧾</span>חשבוניות</a><% } %>
        <% if (nav('nav_scan')) { %><a href="/scan" class="<%= path.startsWith('/scan') ? 'active' : '' %>"><span class="mi-ic"><%= (typeof scanEnabled !== 'undefined' && scanEnabled) ? '📷' : '🔒' %></span>צילום חשבוניות<% if (!(typeof scanEnabled !== 'undefined' && scanEnabled)) { %> <span class="tag" style="font-size:10px">נעול</span><% } %></a><% } %>
        <% if (nav('nav_payments')) { %><a href="/payments" class="<%= path.startsWith('/payments') ? 'active' : '' %>"><span class="mi-ic">💳</span>מרקורים</a><% } %>
        <% if (nav('nav_zreports')) { %><a href="/reports/zreports" class="<%= path.startsWith('/reports/zreports') ? 'active' : '' %>"><span class="mi-ic">📊</span>דוחות Z</a><% } %>
        <% if (nav('nav_zclosing')) { %><a href="/zclosing" class="<%= path.startsWith('/zclosing') ? 'active' : '' %>"><span class="mi-ic">🔒</span>סגירת Z</a><% } %>
        <% if (nav('nav_outstanding')) { %><a href="/reports/outstanding" class="<%= path === '/reports/outstanding' ? 'active' : '' %>"><span class="mi-ic">📤</span>צ׳קים בחוץ</a><% } %>
        <% if (nav('nav_reconciliation')) { %><a href="/reconciliation" class="<%= path.startsWith('/reconciliation') ? 'active' : '' %>"><span class="mi-ic">🏦</span>התאמת בנק</a><% } %>
        <% if (nav('nav_suppliers')) { %><a href="/suppliers" class="<%= path.startsWith('/suppliers') ? 'active' : '' %>"><span class="mi-ic">🏢</span>ספקים</a><% } %>
        <% if (nav('nav_profitability')) { %><a href="/reports/profitability" class="<%= path === '/reports/profitability' ? 'active' : '' %>"><span class="mi-ic">💰</span>רווחיות</a><% } %>
        <% if (currentUser.role === 'owner') { %>
          <a href="/approvals" class="<%= path.startsWith('/approvals') ? 'active' : '' %>"><span class="mi-ic">✅</span>אישורים<% if (typeof pendingApprovals !== 'undefined' && pendingApprovals > 0) { %> <span class="tag tag-accent"><%= pendingApprovals %></span><% } %></a>
        <% } %>
        <% if (nav('nav_employees')) { %><a href="/employees" class="<%= path.startsWith('/employees') ? 'active' : '' %>"><span class="mi-ic">👥</span>עובדים ומשכורות</a><% } %>
        <% if (nav('nav_audit')) { %><a href="/audit" class="<%= path === '/audit' ? 'active' : '' %>"><span class="mi-ic">📅</span>יומן</a><% } %>
        <% if (typeof can === 'function' && can('settings')) { %>
          <a href="/settings" class="<%= path.startsWith('/settings') ? 'active' : '' %>"><span class="mi-ic">⚙️</span>הגדרות</a>
        <% } %>
        <div class="menu-sep"></div>
        <button type="button" id="themeToggle" onclick="apToggleTheme()"><span class="mi-ic" id="themeIco">🌙</span><span id="themeTxt">מצב בהיר</span></button>
        <form method="post" action="/logout" style="margin:0">
          <button type="submit"><span class="mi-ic">🚪</span>התנתק</button>
        </form>
      </div>
    </details>
  </header>
  <script>
    /* Desktop only: show the nav as a static bar under the logo (force <details> open);
       mobile keeps the ☰ dropdown untouched. */
    (function(){
      var d = document.getElementById('navmenu'); if (!d) return;
      var mq = window.matchMedia('(min-width: 1000px)');
      function sync(){ if (mq.matches) d.setAttribute('open',''); else d.removeAttribute('open'); }
      (mq.addEventListener ? mq.addEventListener('change', sync) : mq.addListener(sync));
      sync();
    })();

    /* Theme toggle (מצב בהיר/כהה). Persists to localStorage; the <head> script applies it on load.
       Default (no data-theme) is the dark Nocturne ground; toggling adds/removes data-theme=light. */
    function apCurrentTheme(){ return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; }
    function apSyncThemeLabel(){
      var light = apCurrentTheme() === 'light';
      var ico = document.getElementById('themeIco'), txt = document.getElementById('themeTxt');
      if (ico) ico.textContent = light ? '☀️' : '🌙';
      if (txt) txt.textContent = light ? 'מצב כהה' : 'מצב בהיר';
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', light ? '#f4f5fa' : '#161826');
    }
    function apToggleTheme(){
      var next = apCurrentTheme() === 'light' ? 'dark' : 'light';
      if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('ap-theme', next); } catch (e) {}
      apSyncThemeLabel();
    }
    apSyncThemeLabel();
  </script>

  <main class="page fade-up">
    <%# Active-store context banner — always visible so the user knows which store they're on. %>
    <% if (typeof availableStores !== 'undefined' && availableStores && availableStores.length) { %>
      <div class="store-banner<%= (typeof activeStore !== 'undefined' && activeStore) ? '' : ' is-all' %>">
        <span class="store-banner-ico" aria-hidden="true">🏪</span>
        <span class="store-banner-label">חנות פעילה</span>
        <strong class="store-banner-name">
          <% if (typeof activeStore !== 'undefined' && activeStore) { %>
            <%= activeStore.name %><% if (activeStore.company_name) { %> <span class="store-banner-co">· <%= activeStore.company_name %></span><% } %>
          <% } else { %>
            כל החנויות
          <% } %>
        </strong>
        <% if (availableStores.length > 1) { %>
          <form method="post" action="/context/store" class="store-banner-switch">
            <input type="hidden" name="return_to" value="<%= path %>">
            <select name="store_id" onchange="apAutoSubmit(this)" aria-label="בחר חנות פעילה">
              <option value="">— כל החנויות —</option>
              <% availableStores.forEach(function(s){ %>
                <option value="<%= s.id %>"<%= (typeof activeStore !== 'undefined' && activeStore && Number(activeStore.id) === Number(s.id)) ? ' selected' : '' %>><%= s.name %> · <%= s.company_name %></option>
              <% }); %>
            </select>
            <button type="submit" class="btn btn-secondary btn-sm">החלף</button>
          </form>
        <% } else { %>
          <span class="tag tag-outline store-banner-lock">נעול לחנות זו</span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof scopeCompanies !== 'undefined' && scopeCompanies) { %>
      <div class="scope-strip">
        <span class="tag tag-outline">חברות מורשות</span>
        <% if (scopeCompanies.length === 0) { %>
          <span>אין גישה לאף חברה — פנה לבעלים</span>
        <% } else { %>
          <span><%= scopeCompanies.map(function(c){return c.name;}).join(' · ') %></span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><strong>שגיאה:</strong> <%= error %></div>
    <% } %>
