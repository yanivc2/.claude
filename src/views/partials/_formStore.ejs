<%#
  The store of an ENTRY form = the active store, never a picker (owner rule 2026-10-04: a picker per
  form is how one branch's data got typed into another) — and no visible field either (owner 18/10 for
  the Z closing, 20/10 for every other entry form: the store is already in the top bar). Renders two
  hidden fields only: `store_id` (what the routes already read and validate with assertStoreAllowed)
  and `ctx_store` (lib/storeContext.js refuses the post if the active store changed since render).
  Callers render partials/_needStore instead of the form when there is no active store.
%>
<% var _fs = (typeof activeStore !== 'undefined' && activeStore) ? activeStore : null; %>
<% if (_fs) { %>
  <input type="hidden" name="store_id" value="<%= _fs.id %>" />
  <input type="hidden" name="ctx_store" value="<%= _fs.id %>" />
<% } %>
