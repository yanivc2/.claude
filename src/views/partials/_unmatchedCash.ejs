<%
  // ── טבלת "תשלום במזומן ללא התאמה" — פרשל אחד, שני דפים ─────────────────────────
  // 🔴 לוח הבקרה ודף המרקורים הציגו שתי טבלאות שונות לאותו דבר, וזה בדיוק מה שמבלבל:
  // אותה שורת כסף נראתה אחרת בכל דף. כאן היא נראית אותו דבר בשניהם, על אותם כפתורים.
  //
  // locals: `rows` (הוצאות ללא התאמה, עם `candidates`/`petty`), `settled` (שסומנו כטופלו),
  //         `settleOk` (האם עמודות ה"טופל" קיימות במסד), `returnTo` (לאן לחזור אחרי POST).
  var _rows = (typeof rows !== 'undefined' && rows) ? rows : [];
  var _settled = (typeof settled !== 'undefined' && settled) ? settled : [];
  var _settleOk = (typeof settleOk !== 'undefined') ? settleOk : true;
  var _returnTo = (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/';
  var _isOwner = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'owner');
  // "נשמר בסגירת Z על ידי X" — מי עמד בקופה. זה מה שהופך שורה למאותרת מול אדם.
  function _by(e) {
    var n = ((e.by_first || '') + ' ' + (e.by_last || '')).trim();
    var src = e.source === 'zclosing' ? ('סגירת Z' + (n ? ' · ' + n : '')) : 'דוח Z';
    // שם החנות נדרש כשהטבלה חוצה חנויות (דף המרקורים ב"כל החנויות"); בלעדיו אי אפשר לדעת
    // לאיזו קופה שייכת השורה. כשיש חנות פעילה אחת הוא פשוט חוזר על מה שכבר ידוע.
    return (e.store_name ? e.store_name + ' · ' : '') + src;
  }
%>
  <% if (typeof cashErr !== 'undefined' && cashErr) { %>
    <div class="alert alert-warn" style="margin:0 0 .6rem"><%= cashErr %></div>
  <% } %>
  <% if (typeof cashNote !== 'undefined' && cashNote) { %>
    <div class="alert alert-ok" style="margin:0 0 .6rem"><%= cashNote %></div>
  <% } %>
  <%# הכפתור מופיע רק כשהעמודה קיימת במסד; אחרת אומרים במפורש מה חסר, ולא מציגים כפתור שייכשל. %>
  <% if (!_settleOk && rows && rows.length) { %>
    <p class="muted" style="margin:0 0 .6rem; font-size:12px">
      כדי לסמן הוצאה כטופלה (פריטה שנאספה) — הגדרות ← "עדכן מסד נתונים".
    </p>
  <% } %>
  <%# בנייד כל שורה הופכת לכרטיס מתויג (`.line-grid`) — 6 עמודות ב-300px ברחו הצידה והכפתורים נחתכו. %>
  <div class="table-scroll">
  <table class="line-grid cx-table">
    <thead><tr><th>Z</th><th>תאריך</th><th>שם</th><th>עבור</th><th class="right">סכום</th><th class="no-print" data-nosort data-noexport>פעולה</th></tr></thead>
    <tbody>
      <% if (!rows || rows.length === 0) { %><tr><td colspan="6" class="muted">אין הוצאות מזומן ללא התאמה.</td></tr><% } %>
      <% (rows || []).forEach(function(e){ %>
        <tr>
          <td data-label="Z">
            <a href="<%= e.source === 'zclosing' ? '/zclosing/' + e.ref_id : '/reports/zreports/' + e.ref_id %>">Z <%= e.z_number %></a>
            <%# מי עמד בקופה. בלי זה שורת כסף אינה מאותרת מול אדם, ואי אפשר לשאול אף אחד עליה. %>
            <div class="muted" style="font-size:11px"><%= _by(e) %></div>
          </td>
          <%# תאריך ההוצאה + שעת השמירה בפועל (UTC במסד → israelStamp), כמו בטבלת הוצאות המזומן. %>
          <td data-label="תאריך" data-sort="<%= e.created_at || e.expense_date || '' %>">
            <%= formatDate(e.expense_date) %>
            <% if (e.created_at && israelStamp(e.created_at)) { %>
              <div class="muted" style="font-size:11px" title="שעת השמירה במערכת">נשמר <%= israelStamp(e.created_at) %></div>
            <% } %>
          </td>
          <td data-label="שם">
            <%= e.payer_name || '—' %>
            <%# שכר/מפרעה מטופלים בדף עובדים, ולכן השורה אומרת את הסוג ואת שם העובד — אחרת
                "תשלום מזומן ללא התאמה" מציג סכום בלי לומר מה צריך לעשות איתו. %>
            <% var _emp = ((e.emp_first || '') + ' ' + (e.emp_last || '')).trim(); %>
            <%# רק כשהשם המלא מוסיף מידע: "אורית" מול "אורית כהן" הוא אותו אדם, ו-"אורית · אורית כהן" הוא רעש. %>
            <% var _p = (e.payer_name || '').trim(); %>
            <% if (_emp && _p && !_emp.includes(_p) && !_p.includes(_emp)) { %><span class="muted" style="font-size:12px">· <%= _emp %></span>
            <% } else if (_emp && !_p) { %><%= _emp %><% } %>
          </td>
          <td data-label="עבור">
            <%# הסוג פעם אחת: התג ("שכר"/"מפרעה") ולא גם "שכר במזומן" לידו (בעלים, 16/10). %>
            <% if (e.description_type === 'salary' || e.description_type === 'advance') { %>
              <a href="/employees"><span class="badge b-on_hold"><%= e.description_type === 'salary' ? 'שכר' : 'מפרעה' %></span></a>
              <%= e.purpose || '' %>
            <% } else { %><%= e.purpose || '—' %><% } %>
          </td>
          <td data-label="סכום" class="right"><%= formatIls(e.amount) %></td>
          <td data-label="פעולה" class="no-print">
            <div class="cx-acts">
            <%# 💬 וואטסאפ — לכל שורה: "נסעו במונית ולא הביאו חשבונית — אסביר שבפעם הבאה זה לא ישולם". %>
            <button type="button" class="btn btn-secondary small cx-wa" title="שלח הודעת וואטסאפ על ההוצאה הזו" aria-label="וואטסאפ"
                    data-amount="<%= formatIls(e.amount) %>" data-date="<%= formatDate(e.expense_date) %>" data-z="<%= e.z_number || '' %>"
                    data-what="<%= [e.payer_name, e.purpose].filter(Boolean).join(' · ') %>">💬</button>
            <%# הכפתור נגזר מהסוג שנקלט, כי לכל סוג יש דרך יציאה אחרת:
                פריטה  → נאספת חזרה לקופה, לעולם לא תקבל חשבונית → "טופל".
                שכר/מפרעה → הצ׳ק שהוזן בדף עובדים ומשכורות → התאמה שגם מבטלת את הצ׳ק.
                כל השאר → חשבונית. %>
            <% if (e.petty) { %>
              <% if (_settleOk) { %>
                <form method="post" action="/cash-expenses/<%= e.source %>/<%= e.id %>/settle" style="display:inline" data-keep-scroll>
                  <input type="hidden" name="return_to" value="<%= _returnTo %>" />
                  <button type="submit" class="btn btn-secondary small" title="פריטה שנאספה — סמן כטופל">✓ טופל</button>
                </form>
              <% } %>
            <% } else { var _isSal = (e.description_type === 'salary' || e.description_type === 'advance'); %>
              <%# כיתוב קצר אחד לכל הסוגים — "התאם לצ׳ק שכר" הרחיב את עמודת הפעולה עד שה"טופל" שלידו נחתך מחוץ
                  למסך (בעלים, 16/10). השורה כבר נושאת תג "שכר"/"מפרעה", והחלון אומר במפורש למה מתאימים. %>
              <button type="button" class="btn btn-secondary small" title="<%= _isSal ? 'התאם לצ׳ק שכר' : 'התאם לחשבונית' %>"
                      onclick="document.getElementById('cxm-<%= e.source %>-<%= e.id %>').showModal()">🔗 התאם</button>
              <dialog id="cxm-<%= e.source %>-<%= e.id %>" style="max-width:560px; width:92vw">
                <h3 tabindex="-1" autofocus style="margin:0 0 .2rem"><%= _isSal ? 'התאמה לצ׳ק שכר' : 'התאמה לחשבונית' %></h3>
                <p class="muted" style="margin:0 0 .6rem; font-size:12px">
                  <%= e.payer_name || '' %><%= e.purpose ? ' · ' + e.purpose : '' %> · <strong><%= formatIls(e.amount) %></strong>
                  · <%= formatDate(e.expense_date) %>
                  <br /><%= _isSal ? 'הצ׳ק שיותאם יבוטל, אחרת ייפרע בבנק וישולם אותו שכר פעמיים.' : 'אפשר לבחור כמה חשבוניות — גם של ספקים שונים. ★ = אותו סכום, ≈ = הספק שבשם.' %>
                </p>
                <% if (!e.candidates || !e.candidates.length) { %>
                  <p class="muted" style="margin:0 0 .6rem">
                    <%= _isSal ? 'אין צ׳קי שכר פתוחים להתאמה. הזן אותם בדף עובדים ומשכורות.' : 'אין חשבוניות פתוחות לתשלום.' %>
                  </p>
                  <div class="actions"><a class="btn btn-secondary" href="<%= _isSal ? '/employees' : '/invoices' %>">פתח את הדף</a>
                    <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">סגור</button></div>
                <% } else if (_isSal) { var _same = e.candidates.filter(function(c){ return c.sameAmount; }); %>
                  <%# 🔴 מועמד בסכום זהה נבחר מראש. בלי זה הבורר נפתח ריק ("הקלד לחיפוש"), וכל הערך
                      של "אותו סכום קודם" מתבטל — המשתמש עדיין צריך לחפש ידנית את מה שכבר נמצא לו. %>
                  <p class="muted" style="margin:0 0 .5rem; font-size:12px">
                    <% if (_same.length === 1) { %>נמצאה התאמה אחת בדיוק באותו סכום — כבר נבחרה. לחץ "התאם" לאישור.
                    <% } else if (_same.length > 1) { %>נמצאו <%= _same.length %> באותו סכום (★) — הראשונה נבחרה.
                    <% } else { %>אין צ׳ק בסכום זהה — בחר מהרשימה.<% } %>
                  </p>
                  <form method="post" action="/cash-expenses/<%= e.source %>/<%= e.id %>/match-salary" data-keep-scroll>
                    <select name="salary_payment_id" class="js-combo" required style="width:100%">
                      <option value=""></option>
                      <% e.candidates.forEach(function(c, ci){ %>
                        <option value="<%= c.id %>" <%= (ci === 0 && c.sameAmount) ? 'selected' : '' %>>
                          <%= c.sameAmount ? '★ ' : '' %><%= formatIls(c.amount) %>
                          · <%= ((c.first_name || '') + ' ' + (c.last_name || '')).trim() %>
                          · <%= formatDate(c.due_date) %>
                        </option>
                      <% }); %>
                    </select>
                    <div class="actions" style="margin-top:.7rem">
                      <button type="submit">התאם</button>
                      <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">ביטול</button>
                    </div>
                  </form>
                <% } else {
                     // חשבוניות: אפשר לבחור **כמה** (גם של ספקים שונים — "משלמת טרה וקולה יחד"), והסכום שנבחר
                     // מוצג מול סכום ההוצאה. בחירה מראש: חשבונית אחת בסכום זהה, ואם אין — צירוף יחיד.
                     var _same = e.candidates.filter(function(c){ return c.sameAmount; });
                     var _combos = e.combos || [];
                     var _pre = _same.length ? String(_same[0].id) : (_combos.length === 1 ? _combos[0].ids.join(',') : '');
                     var _checks = e.supplierCheck || []; %>
                  <p class="muted" style="margin:0 0 .5rem; font-size:12px">
                    <% if (_same.length === 1) { %>נמצאה חשבונית אחת בדיוק באותו סכום — כבר נבחרה. לחץ "התאם" לאישור.
                    <% } else if (_same.length > 1) { %>נמצאו <%= _same.length %> באותו סכום (★) — הראשונה נבחרה.
                    <% } else if (_combos.length) { %>אין חשבונית בודדת באותו סכום — אבל יש <strong>צירוף</strong> של חשבוניות מאותם ימים שסכומו שווה בדיוק:
                    <% } else { %>אין חשבונית באותו סכום. הרשימה מתחילה בספק שמופיע בשם ובחשבוניות מיום ה-Z; אפשר לבחור כמה.<% } %>
                  </p>
                  <% _combos.forEach(function(cb){ %>
                    <button type="button" class="btn btn-secondary small cxm-combo" data-ids="<%= cb.ids.join(',') %>" style="display:block;width:100%;text-align:start;margin:0 0 .35rem;white-space:normal">
                      ★ <% cb.items.forEach(function(c, ci){ %><%= ci ? ' + ' : '' %><bdi><%= c.supplier_name || '' %> #<%= c.invoice_number || c.id %> (<%= formatIls(c.total_amount) %>)</bdi><% }); %> = <%= formatIls(e.amount) %>
                    </button>
                  <% }); %>
                  <% _checks.forEach(function(ck){ %>
                    <% if (ck.status === 'missing') { %>
                      <p style="margin:.2rem 0 .4rem; font-size:12px; color:var(--color-bad)">⚠️ לא נמצאה חשבונית של <strong><%= ck.supplier %></strong> סביב <%= formatDate(e.expense_date) %> — כנראה לא הוזנה. ביום הזנת ה-Z צריכה להיות מוזנת חשבונית מתאימה.</p>
                    <% } else if (ck.status === 'notOpen') { %>
                      <p style="margin:.2rem 0 .4rem; font-size:12px">ℹ️ יש חשבונית של <strong><%= ck.supplier %></strong> מאותם ימים, אבל היא <strong>לא פתוחה לתשלום</strong> ולכן אינה ברשימה:
                        <% ck.invoices.forEach(function(iv, ii){ %><%= ii ? ' · ' : '' %><a href="/invoices/<%= iv.id %>">#<%= iv.invoice_number || iv.id %></a> <%= formatIls(iv.total_amount) %> (<%= iv.status === 'paid' ? 'כבר שולמה' : iv.status === 'on_hold' ? 'מוחזקת' : iv.status %>)<% }); %>
                      </p>
                    <% } %>
                  <% }); %>
                  <form method="post" action="/cash-expenses/<%= e.source %>/<%= e.id %>/match-invoice" data-keep-scroll
                        onsubmit="if(!this.querySelector('.cx-inv-ids').value){ alert('בחר לפחות חשבונית אחת'); return false; }">
                    <div class="cx-inv-box cxm-box" data-multi="1" data-target="<%= Number(e.amount) %>">
                      <input type="hidden" name="invoice_ids" class="cx-inv-ids" value="<%= _pre %>" />
                      <div class="cx-inv-chips"></div>
                      <select class="cx-inv" aria-label="הוסף חשבונית" style="width:100%">
                        <option value="">➕ הוסף חשבונית</option>
                        <% e.candidates.forEach(function(c){ %>
                          <option value="<%= c.id %>" data-amount="<%= Number(c.total_amount) %>"><%= c.sameAmount ? '★ ' : c.nameMatch ? '≈ ' : '' %><%= c.supplier_name || '' %> #<%= c.invoice_number || c.id %> · <%= formatIls(c.total_amount) %> · <%= formatDate(c.invoice_date) %></option>
                        <% }); %>
                      </select>
                    </div>
                    <p class="cxm-sum muted" style="margin:.4rem 0 0; font-size:12px"></p>
                    <div class="actions" style="margin-top:.7rem">
                      <button type="submit">התאם</button>
                      <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">ביטול</button>
                    </div>
                  </form>
                <% } %>
              </dialog>
              <%# "טופל" להוצאה שאינה פריטה: הבעלים — מיד. כל אחד אחר (בעלים, 16/10) — הפעולה מתבצעת,
                  ננעלת (רק הבעלים מבטל), ונשלחת לבעלים בקשת אישור: פוש + התראה עם "אשר / דחה".
                  השרת אוכף את זה (setCashExpenseSettled), לא רק הכפתור. %>
              <% if (_settleOk) { %>
                <form method="post" action="/cash-expenses/<%= e.source %>/<%= e.id %>/settle" style="display:inline" data-keep-scroll data-busy="מסמן…">
                  <input type="hidden" name="return_to" value="<%= _returnTo %>" />
                  <button type="submit" class="btn btn-secondary small" title="<%= _isOwner ? 'סמן כטופל בלי התאמה' : 'יסומן כטופל ויישלח לאישור הבעלים' %>">✓ טופל</button>
                </form>
              <% } %>
            <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <%# סימון שאי אפשר לבטל הוא מחיקה. השורות שסומנו נשארות כאן, מתחת, ונשלפות חזרה בלחיצה. %>
  <% var _settled = (typeof settled !== 'undefined' && settled) ? settled : []; %>
  <% if (_settled.length) { %>
    <details style="margin-top:.6rem">
      <summary class="muted" style="font-size:12px; cursor:pointer">סומנו כטופלו (<%= _settled.length %>)</summary>
      <div class="table-scroll" style="margin-top:.4rem">
        <table class="no-enhance">
          <thead><tr><th>Z</th><th>תאריך</th><th>שם</th><th>עבור</th><th class="right">סכום</th><th>סומן</th><th class="no-print"></th></tr></thead>
          <tbody>
            <% _settled.forEach(function(e){ %>
              <tr>
                <td class="mono">
                  <a href="<%= e.source === 'zclosing' ? '/zclosing/' + e.ref_id : '/reports/zreports/' + e.ref_id %>">Z <%= e.z_number %></a>
                  <div class="muted" style="font-size:11px"><%= _by(e) %></div>
                </td>
                <td>
                  <%= formatDate(e.expense_date) %>
                  <% if (e.created_at && israelStamp(e.created_at)) { %>
                    <div class="muted" style="font-size:11px">נשמר <%= israelStamp(e.created_at) %></div>
                  <% } %>
                </td>
                <td><%= e.payer_name || '—' %></td>
                <td><%= e.purpose || '—' %></td>
                <td class="right"><%= formatIls(e.amount) %></td>
                <%# מי סימן ומתי — סימון ידני הוא החלטה של אדם, ולכן הוא נושא שם. %>
                <% var _pend = ((typeof pendingSettle !== 'undefined' && pendingSettle) || []).indexOf(e.source + '|' + e.id) >= 0; %>
                <td class="muted" style="font-size:12px">
                  <%= israelStamp(e.settled_at) %>
                  <% if (e.settled_by_name) { %><div><%= e.settled_by_name %></div><% } %>
                  <% if (_pend) { %><span class="badge b-on_hold" title="ממתין לאישור הבעלים — נעול">⏳ ממתין לאישור</span><% } %>
                </td>
                <td class="no-print">
                  <%# נעול עד אישור: מי שאינו הבעלים לא מבטל סימון של הוצאה שאינה פריטה (גם השרת אוכף). %>
                  <% if (_isOwner || e.description_type === 'petty') { %>
                  <form method="post" action="/cash-expenses/<%= e.source %>/<%= e.id %>/settle" style="display:inline" data-keep-scroll>
                    <input type="hidden" name="undo" value="1" />
                    <input type="hidden" name="return_to" value="<%= _returnTo %>" />
                    <button type="submit" class="btn btn-secondary small" title="החזר לרשימת ההוצאות ללא התאמה">↩ בטל סימון</button>
                  </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </details>
  <% } %>
<%# ── הותאמו לאחרונה — "הותאם ל" (בעלים, 16/10): שורה שהותאמה יורדת מהרשימה; כאן רואים למה היא
    הותאמה. מספר החשבונית מוביל לחשבונית, מספר ה-Z ל-Z. ────────────────────────────────────── %>
<% var _matched = (typeof matched !== 'undefined' && matched) ? matched : []; %>
<% if (_matched.length) { %>
  <details style="margin-top:.6rem">
    <summary class="muted" style="font-size:12px; cursor:pointer">הותאמו לאחרונה (<%= _matched.length %>)</summary>
    <div class="table-scroll" style="margin-top:.4rem">
      <table class="no-enhance">
        <thead><tr><th>Z</th><th>תאריך</th><th>שם</th><th class="right">סכום</th><th>הותאם ל</th></tr></thead>
        <tbody>
          <% _matched.forEach(function(e){ %>
            <tr>
              <td class="mono"><a href="<%= e.source === 'zclosing' ? '/zclosing/' + e.ref_id : '/reports/zreports/' + e.ref_id %>">Z <%= e.z_number %></a>
                <div class="muted" style="font-size:11px"><%= e.store_name ? e.store_name + ' · ' : '' %><%= e.source === 'zclosing' ? 'סגירת Z' : 'דוח Z' %></div></td>
              <td><%= formatDate(e.expense_date) %></td>
              <td><%= [e.payer_name, e.purpose].filter(Boolean).join(' · ') || '—' %></td>
              <td class="right"><%= formatIls(e.amount) %></td>
              <td><% e.matchedTo.forEach(function(m, mi){ %><%= mi ? ' · ' : '' %><a href="<%= m.href %>"><bdi><%= m.label %></bdi></a><% }); %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </details>
<% } %>

<%# ── 💬 וואטסאפ — חלון אחד לכל השורות. איש קשר מהרשימה (עובדים עם טלפון), מספר שמוקלד, או בלי —
    ואז וואטסאפ עצמו פותח בורר אנשי קשר. ההודעה מוכנה וניתנת לעריכה. ───────────────────────────── %>
<% var _contacts = (typeof contacts !== 'undefined' && contacts) ? contacts : []; %>
<dialog id="cx-wa-dlg" style="max-width:480px; width:92vw">
  <h3 tabindex="-1" autofocus style="margin:0 0 .5rem">💬 הודעת וואטסאפ על הוצאה</h3>
  <label class="lbl">למי</label>
  <select id="cx-wa-to" style="width:100%">
    <option value="">בחירה בוואטסאפ (בורר אנשי הקשר של הטלפון)</option>
    <% _contacts.forEach(function(c){ %><option value="<%= c.phone %>"><%= c.name %></option><% }); %>
    <option value="__other">מספר אחר…</option>
  </select>
  <input id="cx-wa-num" type="tel" inputmode="tel" placeholder="050-0000000" style="width:100%; margin-top:.4rem" hidden />
  <label class="lbl" style="margin-top:.6rem">הודעה</label>
  <textarea id="cx-wa-msg" rows="6" style="width:100%"></textarea>
  <div class="actions" style="margin-top:.7rem">
    <button type="button" id="cx-wa-send">פתח בוואטסאפ</button>
    <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">ביטול</button>
  </div>
</dialog>
<script>
(function(){
  var dlg = document.getElementById('cx-wa-dlg');
  if (!dlg) return;
  var to = document.getElementById('cx-wa-to'), num = document.getElementById('cx-wa-num'), msg = document.getElementById('cx-wa-msg');
  function phone(raw){ var d = String(raw || '').replace(/\D/g, ''); if (/^972\d{8,9}$/.test(d)) return d; if (/^0\d{8,9}$/.test(d)) return '972' + d.slice(1); return ''; }
  to.addEventListener('change', function(){ num.hidden = to.value !== '__other'; if (!num.hidden) num.focus(); });
  document.addEventListener('click', function(e){
    var b = e.target && e.target.closest ? e.target.closest('.cx-wa') : null;
    if (!b) return;
    var what = b.getAttribute('data-what');
    msg.value = 'שלום, לגבי הוצאה במזומן מהקופה: ' + b.getAttribute('data-amount')
      + (what ? ' — ' + what : '') + ' (' + b.getAttribute('data-date') + (b.getAttribute('data-z') ? ', Z ' + b.getAttribute('data-z') : '') + ').\n'
      + 'לא הגיעה אליי חשבונית או קבלה על ההוצאה הזו. מהפעם הבאה הוצאה בלי חשבונית לא תשולם.';
    dlg.showModal();
  });
  document.getElementById('cx-wa-send').addEventListener('click', function(){
    var p = to.value === '__other' ? phone(num.value) : to.value;
    if (to.value === '__other' && !p) { alert('מספר טלפון לא תקין'); return; }
    window.open('https://wa.me/' + (p || '') + '?text=' + encodeURIComponent(msg.value), '_blank');
    dlg.close();
  });
})();
</script>

<%# בורר כמה חשבוניות (אותו קובץ של טופסי ה-Z) + סכום שנבחר מול סכום ההוצאה + כפתורי צירוף. %>
<script src="/cx-inv-picker.js?v=<%= encodeURIComponent(typeof buildVersion !== 'undefined' ? buildVersion : 'dev') %>" defer></script>
<script>
(function(){
  function fmt(a){ return '₪' + (a/100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function sum(box){
    var ids = String((box.querySelector('.cx-inv-ids') || {}).value || '').split(',').filter(Boolean);
    var total = 0;
    ids.forEach(function(id){ var o = box.querySelector('select.cx-inv option[value="' + id + '"]'); if (o) total += Number(o.getAttribute('data-amount')) || 0; });
    var target = Number(box.getAttribute('data-target')) || 0;
    var out = box.parentNode.querySelector('.cxm-sum');
    if (!out) return;
    if (!ids.length) { out.textContent = 'לא נבחרה חשבונית.'; out.style.color = ''; return; }
    var d = total - target;
    out.textContent = 'נבחרו ' + ids.length + ' · ' + fmt(total) + ' מתוך ' + fmt(target) + (d === 0 ? ' — תואם בדיוק ✓' : ' — הפרש ' + fmt(Math.abs(d)));
    out.style.color = d === 0 ? 'var(--color-ok)' : 'var(--color-warn)';
  }
  document.addEventListener('input', function(e){ var b = e.target && e.target.closest && e.target.closest('.cxm-box'); if (b) sum(b); }, true);
  document.addEventListener('click', function(e){
    var btn = e.target && e.target.closest ? e.target.closest('.cxm-combo') : null;
    if (!btn) return;
    var box = btn.closest('dialog').querySelector('.cxm-box');
    box.querySelector('.cx-inv-ids').value = btn.getAttribute('data-ids');
    if (window.cxInvRender) window.cxInvRender(box.parentNode);
    sum(box);
  });
  function init(){ document.querySelectorAll('.cxm-box').forEach(sum); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
