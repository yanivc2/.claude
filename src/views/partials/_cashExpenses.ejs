<%
  // "הוצאות מזומן" rubric — rows from recentClosingExpenses(). Columns: סוג · תאריך · שם · פרטים · סכום.
  // Required local: `rows`. Optional: `matchable` (+ `matchInvoices`) adds a "התאמה" column that lets
  // the user link an unmatched cash expense to an invoice → the invoice reads "שולם במזומן".
  var _cxKindLabel = { manual: 'ידני', petty: 'פריטה', salary: 'שכר', advance: 'מפרעה', invoice: 'חשבונית' };
  var _matchable = (typeof matchable !== 'undefined' && matchable);
  var _matchInvoices = (typeof matchInvoices !== 'undefined' && matchInvoices) ? matchInvoices : [];
  // `hideStore` — הקורא כבר מקבץ לפי חנות (רובריקת "הוצאות מזומן מהקופה"), ואז שם החנות בכל
  // שורה הוא רעש שחוזר על עצמו מול הכותרת שמעליו. מספר ה-Z נשאר: הוא מזהה את השורה.
  var _hideStore = (typeof hideStore !== 'undefined' && hideStore);
  // "✓ טופל" (בעלים, 16/10): הבעלים — מיד; מזכירה — מתבצע, ננעל, ונשלח לאישור הבעלים (פוש + התראה).
  var _settleOk = (typeof settleOk !== 'undefined') && settleOk;
  var _pending = (typeof pendingSettle !== 'undefined' && pendingSettle) ? pendingSettle : [];
  var _returnTo = (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/invoices';
  var _owner = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'owner');
%>
<div class="table-scroll">
  <%# בדף החשבוניות (matchable): מה שכבר הותאם או סומן "טופל" יורד לשתי קבוצות מכווצות בתחתית הטבלה —
      "▸ סומנו כטופלו (N)" / "▸ הותאמו (N)", כמו בלוח הבקרה — ונפתח בלחיצה (בעלים, 16/10). זו **אותה טבלה**,
      ולכן "חיפוש בטבלה" מוצא גם אותן: בזמן חיפוש הקבוצות נפתחות לשורות שתואמות. בלי מיון לפי עמודה
      כאן — מיון היה מערבב את הקבוצות. %>
  <%
    var _grouped = _matchable && rows && rows.length;
    var _ordered = rows || [];
    if (_grouped) {
      var _gSettled = rows.filter(function(r){ return !r.invoice_id && r.settled_at; });
      var _gMatched = rows.filter(function(r){ return r.invoice_id; });
      _ordered = rows.filter(function(r){ return !r.invoice_id && !r.settled_at; });
      if (_gSettled.length) _ordered = _ordered.concat([{ __group: 'settled', n: _gSettled.length }], _gSettled);
      if (_gMatched.length) _ordered = _ordered.concat([{ __group: 'matched', n: _gMatched.length }], _gMatched);
    }
  %>
  <table class="<%= _grouped ? 'cx-grouped' : 'sortable' %>">
    <thead><tr><th>סוג</th><th>תאריך</th><th>שם</th><th>פרטים</th><th class="right">סכום</th><% if (_matchable) { %><th class="no-print" data-nosort>התאמה לחשבונית</th><% } %></tr></thead>
    <tbody>
      <% if (!rows || rows.length === 0) { %>
        <tr><td colspan="<%= _matchable ? 6 : 5 %>" class="muted">אין הוצאות מזומן עדיין.</td></tr>
      <% } %>
      <% _ordered.forEach(function(e){ %>
        <% if (e.__group) { %>
          <tr class="cx-group-row" data-group="<%= e.__group %>"><td colspan="<%= _matchable ? 6 : 5 %>">
            <button type="button" class="cx-group-toggle" aria-expanded="false"><span class="caret">▸</span> <%= e.__group === 'settled' ? 'סומנו כטופלו' : 'הותאמו' %> (<%= e.n %>)</button>
          </td></tr>
          <% return; } %>
        <%
          // GET /zclosing/:id is requireOwner. In the recents rubric (not the matchable/invoices
          // one) the whole row leads to editing that Z — but only for the owner, who alone may open
          // it; everyone else gets a plain, non-clickable row (no dead link, no 403).
          var _canOpenClosing = (typeof currentUser !== 'undefined' && currentUser
            && currentUser.role === 'owner' && e.closing_id);
          // שורה שהוזנה בטופס דוח ה-Z מובילה לדוח שלה; שורה של סגירה מובילה לסגירה (בעלים בלבד,
          // כי GET /zclosing/:id הוא requireOwner). כך כל שורה ניתנת לאימות מול המקור שלה.
          var _rowHref = _matchable ? null
            : (_canOpenClosing ? ('/zclosing/' + e.closing_id)
              : (e.z_report_id ? ('/reports/zreports/' + e.z_report_id) : null));
        %>
        <% var _gcls = _grouped ? (e.invoice_id ? 'cx-done cx-g-matched' : (e.settled_at ? 'cx-done cx-g-settled' : '')) : ''; %>
        <tr<% if (_rowHref || _gcls) { %> class="<%= _rowHref ? 'cx-recent-row ' : '' %><%= _gcls %>"<% } %><% if (_rowHref) { %> data-href="<%= _rowHref %>" title="פתח את סגירת ה-Z לעריכה"<% } %>>
          <td>
            <% var _st = _hideStore ? '' : (e.store_name || ''); %>
            <% if (_st || e.z_number) { %>
              <div class="muted" style="font-size:12px"><%= _st %><%= (_st && e.z_number) ? ' · ' : '' %><%= e.z_number ? 'Z ' + e.z_number : '' %></div>
            <% } %>
            <%= _cxKindLabel[e.description_type] || 'ידני' %>
            <% if (e.source) { %>
              <span class="muted" style="font-size:11px">· <%= e.source === 'closing' ? 'סגירת Z' : 'דוח Z' %></span>
            <% } %>
          </td>
          <%# תאריך ההוצאה + שעת השמירה בפועל. `created_at` נשמר ב-UTC, ולכן הוא עובר דרך
              israelStamp — הצגתו כמות שהיא הייתה מזיזה כל פעולה ב-2-3 שעות אחורה. %>
          <td class="mono" data-sort="<%= e.created_at || e.expense_date || '' %>">
            <%= formatDate(e.expense_date) %>
            <% if (e.created_at && israelStamp(e.created_at)) { %>
              <div class="muted" style="font-size:11px" title="שעת השמירה במערכת">נשמר <%= israelStamp(e.created_at) %></div>
            <% } %>
          </td>
          <td><%= e.payer_name || '—' %></td>
          <td>
            <% if (e.description_type === 'invoice' && e.invoice_id) { %>
              <a href="/invoices/<%= e.invoice_id %>">חשבונית #<%= e.invoice_number %><%= e.invoice_supplier ? ' · ' + e.invoice_supplier : '' %></a>
              <%# שורה ששילמה כמה חשבוניות (invoice_ids) — הקישור לראשונה, והמספר אומר שיש עוד. %>
              <% var _more = String(e.invoice_ids || '').split(',').filter(Boolean).length - 1; %>
              <% if (_more > 0) { %><span class="muted" style="font-size:12px">+ עוד <%= _more %></span><% } %>
            <% } else if ((e.description_type === 'salary' || e.description_type === 'advance') && (e.emp_first || e.emp_last)) { %>
              <%= ((e.emp_first || '') + ' ' + (e.emp_last || '')).trim() %>
            <% } else { %>
              <%= e.purpose || '—' %>
            <% } %>
          </td>
          <td class="right"><%= formatIls(e.amount) %></td>
          <% if (_matchable) { %>
            <td class="no-print">
              <% var _isPending = _pending.indexOf('zclosing|' + e.id) >= 0; %>
              <% if (!e.invoice_id && e.settled_at) { %>
                <%# סומן "טופל". ממתין לאישור → נעול: רק הבעלים מבטל (וגם השרת אוכף). %>
                <span class="badge b-paid">טופל ✓</span>
                <% if (_isPending) { %><span class="badge b-on_hold" title="המזכירה סימנה — ממתין לאישור הבעלים">⏳ ממתין לאישור</span><% } %>
                <% if (_owner) { %>
                  <form method="post" action="/cash-expenses/zclosing/<%= e.id %>/settle" style="display:inline" data-keep-scroll>
                    <input type="hidden" name="undo" value="1" /><input type="hidden" name="return_to" value="<%= _returnTo %>" />
                    <button type="submit" class="btn btn-secondary small" title="בטל את סימון הטופל">↩</button>
                  </form>
                <% } %>
              <% } else if (e.invoice_id) { %>
                <span class="badge b-paid">מותאם ✓</span>
                <form method="post" action="/invoices/unmatch-cash" style="display:inline">
                  <input type="hidden" name="expense_id" value="<%= e.id %>" />
                  <button type="submit" class="btn btn-secondary small" title="בטל התאמה">✕</button>
                </form>
              <% } else if (e.description_type === 'salary' || e.description_type === 'advance') { %>
                <% if (_settleOk) { %>
                  <form method="post" action="/cash-expenses/zclosing/<%= e.id %>/settle" style="display:inline" data-keep-scroll data-busy="מסמן…">
                    <input type="hidden" name="return_to" value="<%= _returnTo %>" />
                    <button type="submit" class="btn btn-secondary small" title="<%= _owner ? 'סמן כטופל' : 'יסומן כטופל ויישלח לאישור הבעלים' %>">✓ טופל</button>
                  </form>
                <% } else { %><span class="muted" style="font-size:12px">—</span><% } %>
              <% } else { %>
                <% if (_settleOk) { %>
                  <form method="post" action="/cash-expenses/zclosing/<%= e.id %>/settle" style="display:inline;margin:0 0 4px" data-keep-scroll data-busy="מסמן…">
                    <input type="hidden" name="return_to" value="<%= _returnTo %>" />
                    <button type="submit" class="btn btn-secondary small" title="<%= _owner ? 'סמן כטופל' : 'יסומן כטופל ויישלח לאישור הבעלים' %>">✓ טופל</button>
                  </form>
                <% } %>
                <form method="post" action="/invoices/match-cash" style="display:flex;gap:4px;align-items:center;margin:0">
                  <input type="hidden" name="expense_id" value="<%= e.id %>" />
                  <select name="invoice_id" class="js-combo" data-combo-ph="בחר חשבונית" required style="min-width:150px">
                    <option value=""></option>
                    <% _matchInvoices.forEach(function(iv){ %>
                      <option value="<%= iv.id %>">#<%= iv.invoice_number %> · <%= iv.supplier_name %> · <%= formatIls(iv.total_amount) %></option>
                    <% }); %>
                  </select>
                  <button type="submit" class="btn btn-secondary small">התאם</button>
                </form>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<script>
// Clickable recents row → open its Z for editing. Delegated on document (guarded so multiple
// includes don't double-bind). Clicks on inner links/buttons/form controls keep their own action.
(function(){
  if (window.__cxRowLinkInit) return; window.__cxRowLinkInit = true;
  document.addEventListener('click', function(e){
    var row = e.target.closest('tr.cx-recent-row');
    if (!row) return;
    if (e.target.closest('a, button, input, select, textarea, label, form')) return;
    var href = row.getAttribute('data-href');
    if (href) window.location.href = href;
  });
})();
</script>
<% if (_grouped) { %>
<script>
(function(){
  // פתיחה/סגירה של קבוצה, ופתיחה אוטומטית בזמן "חיפוש בטבלה" (החיפוש מסנן גם את השורות שבקבוצות).
  if (window.__cxGroupInit) return; window.__cxGroupInit = true;
  document.addEventListener('click', function(e){
    var b = e.target && e.target.closest ? e.target.closest('.cx-group-toggle') : null;
    if (!b) return;
    var tr = b.closest('tr'), table = b.closest('table'), g = tr.getAttribute('data-group');
    var open = !table.classList.contains('show-' + g);
    table.classList.toggle('show-' + g, open);
    b.setAttribute('aria-expanded', String(open));
    b.querySelector('.caret').textContent = open ? '▾' : '▸';
  });
  document.addEventListener('input', function(e){
    var t = e.target;
    if (!t || !t.classList || !t.classList.contains('tbl-search')) return;
    var tools = t.closest('.tbl-tools'), next = tools && tools.nextElementSibling;
    var table = next && (next.matches('table') ? next : next.querySelector('table'));
    if (table && table.classList.contains('cx-grouped')) table.classList.toggle('cx-searching', !!t.value.trim());
  });
})();
</script>
<% } %>
