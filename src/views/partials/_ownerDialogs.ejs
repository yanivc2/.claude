<%# Owner action dialogs (עדכון DB / גיבוי / איפוס / שחזור).
    These live in the header partial, right next to the buttons that open them, on purpose: the
    buttons render on EVERY /settings/* page, and when the markup lived only in settings/index.ejs
    a click from /settings/guide called showModal() on null and did nothing at all — a dead button
    with no error the owner could see. Buttons and dialogs must ship together. %>
<dialog id="dlg-db" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/db-upgrade" class="stack">
    <h3 style="margin:0">עדכון מסד נתונים</h3>
    <p class="muted" style="margin:.2rem 0">מוסיף עמודות/טבלאות חדשות שנדרשות אחרי עדכון גרסה (בטוח, לא מוחק נתונים). הרץ פעם אחת אחרי כל פריסה חדשה.</p>
    <div class="actions" style="justify-content:flex-end">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button type="submit">עדכן מסד נתונים</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-catalog" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/catalog-import" enctype="multipart/form-data" class="stack">
    <h3 style="margin:0">טעינת קטלוג-על</h3>
    <p class="muted" style="margin:.2rem 0">
      קובץ <strong>XLSX או CSV</strong> עם כותרות בעברית: <strong>ברקוד, שם</strong> (חובה), ואם יש גם מקט, יצרן, יח' אריזה, כמות, יחידת מידה ומחיר מדף.
      קובץ שמאחד כמה רשתות יכול להחזיק עמודת מחיר לכל רשת — כולן נקראות והמחיר שנשמר הוא החציון.
      עמודות אחרות פשוט לא נקראות — <strong>אין צורך למחוק אותן</strong>.
      הטעינה מוסיפה ומעדכנת בלבד ואף פעם לא מוחקת.
    </p>
    <p class="muted" style="margin:.2rem 0">
      ⚠ <strong>אל תשמרו את הקובץ מחדש כ-CSV מתוך אקסל.</strong> אקסל מוריד אפסים מובילים
      מהברקודים (‎012345… הופך ל-‎12345…). המערכת מתקנת את זה לפי ספרת הביקורת ומדווחת כמה תוקנו,
      אבל <strong>XLSX מקורי עדיף</strong> — הוא לא עובר את ההמרה הזו כלל.
      קובץ גדול נקרא בדפדפן ונשלח במנות, כך שאין מגבלת גודל מעשית.
    </p>
    <label class="lbl">קובץ הקטלוג</label>
    <input type="file" name="catalog" accept=".xlsx,.csv,.tsv,.txt,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
    <label class="lbl" style="margin-top:.4rem">שם המקור (לתיעוד)</label>
    <input type="text" name="source_name" placeholder="למשל: קטלוג ספקים 2026" maxlength="60" />
    <%# Progress + result, driven by /catalog-upload.js. Hidden (and inert) when the script is
        absent, in which case the form just posts to /settings/catalog-import as before. %>
    <div id="catalog-progress" hidden style="margin-top:.6rem">
      <div class="scan-progress"><div id="catalog-bar"></div></div>
      <p class="muted" id="catalog-status" style="margin:.4rem 0 0"></p>
    </div>
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">סגור</button>
      <button type="submit">טען קטלוג</button>
    </div>
  </form>
</dialog>
<script type="module" src="/catalog-upload.js?v=1"></script>

<dialog id="dlg-storage" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/storage-test" class="stack">
    <h3 style="margin:0">בדיקת אחסון קבצים</h3>
    <p class="muted" style="margin:.2rem 0">
      כותב קובץ זעיר לאחסון, קורא אותו בחזרה, ומוחק אותו — ומדווח על כל שלב בנפרד.
      הרץ את זה אם צילומים של חשבוניות לא נפתחים: הבדיקה אומרת אם הבעיה בכתיבה, בקריאה, או בהרשאות,
      במקום להשאיר את זה לניחוש. הבדיקה לא נוגעת בשום קובץ קיים.
    </p>
    <div class="actions" style="justify-content:flex-end">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button type="submit">הרץ בדיקה</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-backup" class="ndialog" onclick="event.stopPropagation()">
  <div class="stack">
    <h3 style="margin:0">גיבוי מלא</h3>
    <p class="muted" style="margin:.2rem 0">הורדת עותק מלא של כל הנתונים (JSON) — שמור אותו במקום שבשליטתך (Google Drive / דיסק). מומלץ אחת לשבוע. גיבוי אוטומטי שבועי רץ בנפרד (pg_dump) ושומר עותק מלא כארכיון.</p>
    <div class="actions" style="justify-content:flex-end">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">סגור</button>
      <a href="/settings/backup" class="btn btn-primary">⬇ הורד גיבוי (JSON)</a>
    </div>
  </div>
</dialog>

<dialog id="dlg-clean" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/clean-start" class="stack" onsubmit="return confirm('להתחיל נקי? כל החשבוניות, התשלומים, דוחות ה-Z והטיוטות יימחקו לצמיתות. סגירות ה-Z, הספקים, הקטלוג והעובדים יישמרו. פעולה בלתי הפיכה.')">
    <h3 style="margin:0;color:var(--color-bad)">התחלה נקייה — חשבוניות / תשלומים / Z</h3>
    <p class="muted" style="margin:.2rem 0">
      מוחק לצמיתות את כל <strong>החשבוניות</strong>, כל <strong>התשלומים</strong> (צ׳קים, העברות וכל השאר), כל <strong>דוחות ה-Z</strong> ואת <strong>טיוטות הסריקה</strong> (כולל צילומי החשבוניות).
      <br><strong>נשמרים:</strong> סגירות ה-Z (איזון קופות), ספקים, קטלוג המוצרים, עובדים, תנועות בנק, הפקדות, חברות/חנויות/משתמשים. הפקדות ומחירים רק מנותקים מהחשבוניות/ה-Z שנמחקו.
      <br>⚠️ פעולה בלתי הפיכה. אם תרצה גיבוי — סגור והורד "גיבוי מלא" קודם.
    </p>
    <label class="lbl" style="margin-top:.2rem">סיסמת הבעלים</label>
    <input type="password" name="password" required autocomplete="current-password" placeholder="הסיסמה שלך" style="max-width:260px" />
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button class="danger" type="submit">מחק והתחל נקי</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-reset" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/reset-data" class="stack" onsubmit="return apReset(event)">
    <h3 style="margin:0;color:var(--color-bad)">אזור מסוכן — התחל מחדש</h3>
    <p class="muted" style="margin:.2rem 0">
      מוחק את כל <strong>נתוני העבודה</strong> — חשבוניות, תשלומים, תנועות בנק, דוחות Z, הפקדות, הוצאות, יומן ובקשות (כולל הסריקות).
      <br><strong>נשמרים:</strong> חברות, חנויות, חשבונות בנק, משתמשים והרשאות. פעולה בלתי הפיכה.
    </p>
    <label style="display:flex;align-items:center;gap:8px;font-weight:400;margin:0">
      <input type="checkbox" name="also_suppliers" value="1" style="width:auto;min-height:0" /> לנקות גם את רשימת הספקים
    </label>
    <label class="lbl" style="margin-top:.4rem">סיסמת הבעלים</label>
    <input type="password" name="password" required autocomplete="current-password" placeholder="הסיסמה שלך" style="max-width:260px" />
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button class="danger" type="submit">אפס נתונים והתחל מחדש</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-restore" class="ndialog" onclick="event.stopPropagation()">
  <form method="post" action="/settings/restore" enctype="multipart/form-data" class="stack" onsubmit="return confirm('לשחזר מהגיבוי? כל הנתונים הנוכחיים יוחלפו בתוכן הקובץ. פעולה בלתי הפיכה.')">
    <h3 style="margin:0;color:var(--color-bad)">שחזור מגיבוי</h3>
    <p class="muted" style="margin:.2rem 0">טוען קובץ גיבוי (JSON) ו<strong>מחליף בו את כל הנתונים הקיימים</strong>. ⚠️ בלתי הפיך — כל הנתונים הנוכחיים יימחקו ויוחלפו.</p>
    <label class="lbl">קובץ גיבוי</label>
    <input type="file" name="backup" accept=".json,application/json" required />
    <label class="lbl" style="margin-top:.4rem">סיסמת הבעלים</label>
    <input type="password" name="password" required autocomplete="current-password" placeholder="הסיסמה שלך" style="max-width:260px" />
    <div class="actions" style="justify-content:flex-end;margin-top:.4rem">
      <button type="button" class="secondary" onclick="this.closest('dialog').close()">ביטול</button>
      <button class="danger" type="submit">שחזר מגיבוי</button>
    </div>
  </form>
</dialog>

<script>
/* Open an owner dialog. Never fail silently: if the element is missing (or <dialog> is
   unsupported), say so and fall back to the settings page rather than doing nothing. */
function apOpen(id){
  var d = document.getElementById(id);
  if (d && typeof d.showModal === 'function') { d.showModal(); return; }
  if (d) { d.setAttribute('open',''); return; }
  location.href = '/settings';
}
function apReset(e){
  var form = e.target;
  if (form.dataset.go === '1') return true;          // second pass — really submit
  e.preventDefault();
  if (!form.password.value) { form.password.focus(); return false; }
  var wantBackup = confirm('האם תרצה לגבות לפני האיפוס?\n\n"אישור" — יורד קובץ גיבוי ואז מאפס.\n"ביטול" — מאפס בלי גיבוי.');
  if (wantBackup) {
    var a = document.createElement('a'); a.href = '/settings/backup'; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ form.dataset.go = '1'; form.submit(); }, 1800);
  } else {
    form.dataset.go = '1'; form.submit();
  }
  return false;
}
</script>
