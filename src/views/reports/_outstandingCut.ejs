<%#
  צ׳קים בחוץ (בעלים 21/10). part 'forms' = טופסי הבחירה של "שבועי"/"חודשי" — בראש הדף, מוסתרים עד שלוחצים על
  הכפתור בשורת הכותרת (partials/_outstandingMenu.ejs → ocShowCut, reports/outstanding.ejs); part 'bar' = הסרגל
  שבתחתית: ייצוא והדפסה. "תאריכים" ירד ("הצג הכל · שבועי · חודשי"). locals: csvLink (+ months, weeks, cut,
  selMonths, selWeeks, detailAccountId של הדף).
%>
<% var _part = (typeof part !== 'undefined' && part) ? part : 'bar'; %>
<% if (_part === 'forms') { %>
<% if (months && months.length) { %>
<div class="card no-print oc-forms-card" style="<%= cut === 'weeks' || cut === 'months' ? '' : 'display:none' %>">
  <form method="get" action="/reports/outstanding" id="oc-weeks" class="oc-cut" style="<%= cut === 'weeks' ? '' : 'display:none' %>">
    <% if (detailAccountId) { %><input type="hidden" name="account" value="<%= detailAccountId %>" /><% } %>
    <input type="hidden" name="cut" value="weeks" />
    <p class="muted" style="margin:0 0 .5rem">סמן אילו שבועות להציג (א׳–ש׳; רק שבועות שיש בהם צ׳קים פתוחים):</p>
    <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:.6rem">
      <% (weeks || []).forEach(function(w){ %>
        <label style="display:flex;align-items:center;gap:5px;margin:0"><input type="checkbox" name="weeks" value="<%= w.value %>" style="width:auto;min-height:0" <%= (selWeeks || []).includes(w.value) ? 'checked' : '' %> /> <%= w.label %></label>
      <% }); %>
    </div>
    <button type="submit">הצג נבחרים</button>
  </form>

  <form method="get" action="/reports/outstanding" id="oc-months" class="oc-cut" style="<%= cut === 'months' ? '' : 'display:none' %>">
    <% if (detailAccountId) { %><input type="hidden" name="account" value="<%= detailAccountId %>" /><% } %>
    <input type="hidden" name="cut" value="months" />
    <p class="muted" style="margin:0 0 .5rem">סמן אילו חודשים להציג (רק חודשים שיש בהם צ׳קים פתוחים):</p>
    <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:.6rem">
      <% months.forEach(function(mo){ %>
        <label style="display:flex;align-items:center;gap:5px;margin:0"><input type="checkbox" name="months" value="<%= mo.value %>" style="width:auto;min-height:0" <%= (selMonths || []).includes(mo.value) ? 'checked' : '' %> /> <%= mo.label %></label>
      <% }); %>
    </div>
    <button type="submit">הצג נבחרים</button>
  </form>

</div>
<% } %>
<% } else { %>
<div class="card no-print oc-bar-card">
  <div class="oc-bar">
    <div class="oc-out">
      <a class="btn btn-secondary" href="<%= csvLink %>">📄 ייצוא CSV</a>
      <button type="button" class="btn btn-secondary" onclick="window.print()">🖨️ הדפסה / PDF</button>
    </div>
  </div>
</div>
<% } %>
