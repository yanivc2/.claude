<%
  // Shared Z form — used by the "add" page (zreports.ejs) and the "edit" page (zreport.ejs).
  // Locals: action, submitLabel, storeOptions, invoiceOptions, ccBrands, and optionally
  // zr (existing z_reports row), dep (linked deposit row), expenses (existing lines).
  function sh(a){ return a ? (a/100).toFixed(2) : ''; }
  var z  = (typeof zr !== 'undefined' && zr) ? zr : {};
  var dp = (typeof dep !== 'undefined' && dep) ? dep : null;
  var exRows = (typeof expenses !== 'undefined' && expenses) ? expenses : [];
  function cxEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function cxInvOptsFor(sel){
    var h = '<option value="">— ללא חשבונית —</option>';
    (typeof invoiceOptions !== 'undefined' ? invoiceOptions : []).forEach(function(iv){
      h += '<option value="' + iv.id + '"' + (Number(sel) === iv.id ? ' selected' : '') + '>#' + iv.id + ' · ' + cxEsc(iv.supplier_name) + ' · ' + cxEsc(iv.invoice_number) + ' · ' + formatIls(iv.total_amount) + '</option>';
    });
    return h;
  }
  function cxEmpOptsFor(sel){
    var h = '<option value="">— בחר עובד —</option>';
    (typeof employeeOptions !== 'undefined' ? employeeOptions : []).forEach(function(emp){
      h += '<option value="' + emp.id + '"' + (Number(sel) === emp.id ? ' selected' : '') + '>' + cxEsc(emp.first_name + ' ' + emp.last_name) + '</option>';
    });
    return h;
  }
  function cxKindOptsFor(sel){
    var opts = [['manual','ידני'],['salary','שכר'],['advance','מפרעה'],['invoice','חשבונית']];
    var s = sel || 'manual';
    return opts.map(function(o){ return '<option value="'+o[0]+'"'+(s===o[0]?' selected':'')+'>'+o[1]+'</option>'; }).join('');
  }
  // "שם" on a cash expense is an EMPLOYEE, chosen from the list — never free text (a typed name
  // matched nothing and made the row unattributable). Same rule as the Z-closing form. A saved
  // name that is no longer an employee is re-added as an option so an old row never loses it.
  function cxPayerOptsFor(sel, extra){
    var h = '<option value="">— בחר עובד —</option>';
    var found = false;
    (typeof employeeOptions !== 'undefined' ? employeeOptions : []).forEach(function(emp){
      var full = emp.first_name + ' ' + emp.last_name;
      if (full === sel) found = true;
      h += '<option value="' + cxEsc(full) + '" data-emp="' + emp.id + '"' + (full === sel ? ' selected' : '') + '>' + cxEsc(full) + '</option>';
    });
    if (extra && sel && !found) h += '<option value="' + cxEsc(sel) + '" selected>' + cxEsc(sel) + ' (לא ברשימת העובדים)</option>';
    return h;
  }
  function cxPayerField(sel){
    if (!(typeof employeeOptions !== 'undefined' ? employeeOptions : []).length) {
      return '<input name="payer_name" value="' + cxEsc(sel) + '" autocomplete="off">';
    }
    return '<select name="payer_name" class="cx-payer js-combo">' + cxPayerOptsFor(sel, true) + '</select>';
  }
%>
<form method="post" action="<%= action %>" class="stack" data-zform>
  <label>חנות</label>
  <select name="store_id" required>
    <% storeOptions.forEach(function(st){ %>
      <option value="<%= st.id %>" <%= z.store_id === st.id ? 'selected' : '' %>><%= st.name %> · <%= st.company_name %></option>
    <% }); %>
  </select>
  <div class="row">
    <div><label>מספר Z</label><input name="z_number" required value="<%= z.z_number || '' %>" /></div>
    <div><label>תאריך</label><input type="date" name="z_date" required value="<%= z.z_date || '' %>" /></div>
  </div>
  <label>סה"כ (יומי Z) ₪</label>
  <input name="daily_total" inputmode="decimal" required placeholder="0.00" value="<%= sh(z.daily_total) %>" />

  <h3 style="margin:1rem 0 .2rem">דוח מגירה</h3>
  <div class="row">
    <div><label>מזומן</label><input name="drawer_cash" class="dr" inputmode="decimal" value="<%= sh(z.drawer_cash) %>" /></div>
    <div><label>צ'ק</label><input name="drawer_check" class="dr" inputmode="decimal" value="<%= sh(z.drawer_check) %>" /><small class="muted">תשלום חוב באמצעות צ'ק</small></div>
  </div>
  <div class="row">
    <div><label>אשראי מגירה</label><input name="drawer_credit" id="drawer_credit" class="dr" inputmode="decimal" value="<%= sh(z.drawer_credit) %>" /></div>
    <div><label>הקפה</label><input name="drawer_hakafa" class="dr" inputmode="decimal" value="<%= sh(z.drawer_hakafa) %>" /></div>
  </div>
  <div class="row">
    <div><label>תווי קניה</label><input name="drawer_vouchers" class="dr" inputmode="decimal" value="<%= sh(z.drawer_vouchers) %>" /><small class="muted">זיכוי קניות עובדים מההקפה שלהם באמצעות תווי קניה</small></div>
    <div><label>סה"כ מגירה *</label><input id="drawer_total" readonly value="₪0.00" /><small class="muted">חובה — סכום רכיבי המגירה</small></div>
  </div>
  <div class="row">
    <div></div>
    <div><label>סה"כ הוצאות במזומן</label><input id="drawer_expenses_total" readonly value="₪0.00" /><small class="muted">מתוך פירוט "הוצאות במזומן" למטה</small></div>
  </div>
  <div class="toolbar" style="margin:1.1rem 0 .2rem">
    <div style="display:flex;align-items:center;gap:.6rem">
      <h3 style="margin:0">הוצאות במזומן (לא חובה)</h3>
      <button type="button" class="round-btn" title="פירוט הוצאות" onclick="var p=document.getElementById('cx-panel');p.hidden=!p.hidden;">🧾</button>
    </div>
  </div>
  <div id="cx-panel" <%= exRows.length ? '' : 'hidden' %>>
    <p class="muted" style="margin:0 0 .4rem">הוצאות ששולמו מקופת המזומן. בחר <strong>סוג</strong>: ידני · שכר · מפרעה · חשבונית. שכר/מפרעה משויכים לעובד; סוג 'חשבונית' משויך לחשבונית. שורה חדשה נוספת אוטומטית.</p>
    <div id="cx-body" class="cx-list">
      <% exRows.forEach(function(e){ %>
        <div class="cx-row">
          <div class="cx-field"><label>סוג</label><select name="expense_kind" class="cx-kind"><%- cxKindOptsFor(e.description_type) %></select></div>
          <div class="cx-field"><label>תאריך</label><input type="date" name="expense_date" value="<%= e.expense_date || '' %>" /></div>
          <div class="cx-field"><label>שם</label><%- cxPayerField(e.payer_name || '') %></div>
          <div class="cx-field cx-details"><label>פרטים</label>
            <input name="purpose" class="cx-purpose" value="<%= e.purpose || '' %>" placeholder="עבור" autocomplete="off" />
            <select name="expense_employee_id" class="cx-emp"><%- cxEmpOptsFor(e.employee_id) %></select>
            <select name="expense_invoice_id" class="cx-inv"><%- cxInvOptsFor(e.invoice_id) %></select>
          </div>
          <div class="cx-field cx-amt-field"><label>סכום (₪)</label><input name="amount" class="cx-amt" inputmode="decimal" value="<%= e.amount ? (e.amount/100).toFixed(2) : '' %>" placeholder="0.00" /></div>
          <button type="button" class="btn btn-secondary small cx-del" onclick="cxDel(this)">✕ הסר</button>
        </div>
      <% }); %>
      <div class="cx-row">
        <div class="cx-field"><label>סוג</label><select name="expense_kind" class="cx-kind"><%- cxKindOptsFor(null) %></select></div>
        <div class="cx-field"><label>תאריך</label><input type="date" name="expense_date" /></div>
        <div class="cx-field"><label>שם</label><%- cxPayerField('') %></div>
        <div class="cx-field cx-details"><label>פרטים</label>
          <input name="purpose" class="cx-purpose" placeholder="עבור" autocomplete="off" />
          <select name="expense_employee_id" class="cx-emp"><%- cxEmpOptsFor(null) %></select>
          <select name="expense_invoice_id" class="cx-inv"><%- cxInvOptsFor(null) %></select>
        </div>
        <div class="cx-field cx-amt-field"><label>סכום (₪)</label><input name="amount" class="cx-amt" inputmode="decimal" placeholder="0.00" /></div>
        <button type="button" class="btn btn-secondary small cx-del" onclick="cxDel(this)">✕ הסר</button>
      </div>
    </div>
  </div>

  <div style="display:flex;align-items:center;gap:.6rem;margin:.9rem 0 .4rem">
    <span style="font-weight:600">הכנסות מאשראי</span>
    <button type="button" class="round-btn" title="דוח כרטיסי אשראי" onclick="var p=document.getElementById('cc-panel');p.hidden=!p.hidden;">💳</button>
  </div>

  <div id="cc-panel" hidden>
    <p class="muted" style="margin:0 0 .4rem">דוח כרטיסי אשראי — הסה"כ חייב להיות שווה ל"אשראי מגירה" כדי לשמור.</p>
    <table style="max-width:420px">
      <thead><tr><th>חברה</th><th class="right">סה"כ (₪)</th></tr></thead>
      <tbody>
        <% ccBrands.forEach(function(b){ %>
          <tr><td><%= b.label %></td><td><input name="cc_<%= b.key %>" class="cc" inputmode="decimal" value="<%= sh(z['cc_' + b.key]) %>" /></td></tr>
        <% }); %>
      </tbody>
      <tfoot><tr><th>סה"כ</th><th class="right" id="cc_total_disp">₪0.00</th></tr></tfoot>
    </table>
    <p class="muted" id="cc_match_msg" style="margin:.3rem 0 0"></p>
  </div>

  <h3 style="margin:1.1rem 0 .2rem">הצהרה על הפקדה (לא חובה)</h3>
  <p class="muted" style="margin:0 0 .4rem">אם הפקדת מזומן לבנק — הזן פרטי הפקדה. החנות והתאריך נלקחים מדוח ה-Z שלמעלה.</p>
  <div class="zdep-grid">
    <div><label>מספר שקית הפקדה</label><input name="dep_bag" value="<%= dp ? (dp.bag_number || '') : '' %>" /></div>
    <div><label>סכום הפקדה (₪)</label><input name="dep_amount" inputmode="decimal" placeholder="0.00" value="<%= dp ? sh(dp.amount) : '' %>" /></div>
    <div><label>חוסר / יתרה</label><input id="dep_recon" readonly value="—" /><small class="muted">הפקדה − (מזומן מגירה + הוצאות במזומן)</small></div>
  </div>
  <label style="display:flex;align-items:center;gap:8px;margin-top:.6rem">
    <input type="checkbox" name="dep_deposited" value="1" style="width:auto;min-height:0" <%= dp && dp.deposited ? 'checked' : '' %> /> הופקד לבנק
  </label>

  <%# שמירה דביקה. הכפתור היה בתחתית טופס ארוך (מגירה · אשראי · הוצאות · הפקדה), חלקו בתוך
      אקורדיונים מקופלים — מי שמילא את החלק העליון לא ראה אותו בלי לגלול עד הסוף, ולא היה ברור
      שיש בכלל מה ללחוץ. עכשיו הוא צמוד לתחתית המסך כל עוד הטופס פתוח. %>
  <div class="zform-save">
    <button type="submit"><%= submitLabel %></button>
    <span class="muted" id="zform_save_hint">הנתונים נשמרים רק בלחיצה על הכפתור.</span>
  </div>
</form>

<script>
(function(){
  var form = document.querySelector('form[data-zform]');
  if (!form) return;
  function num(el){ if(!el) return 0; var v = parseFloat(el.value); return isNaN(v) ? 0 : v; }
  function fmt(n){ return '₪' + n.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2}); }
  function drawerSum(){ var s=0; form.querySelectorAll('input.dr').forEach(function(i){ s+=num(i); }); return s; }
  function ccSum(){ var s=0; form.querySelectorAll('input.cc').forEach(function(i){ s+=num(i); }); return s; }
  function cxSum(){ var s=0; form.querySelectorAll('.cx-amt').forEach(function(i){ s+=num(i); }); return s; }
  var creditEl = form.querySelector('#drawer_credit');
  var depAmtEl = form.querySelector('input[name="dep_amount"]');
  var depReconEl = form.querySelector('#dep_recon');
  // חוסר/יתרה = סכום הפקדה − (מזומן מדוח מגירה + סה"כ הוצאות במזומן). הפקדה קטנה → חוסר (− אדום).
  // 🔴 מזומן בלבד, לא סה"כ המגירה: להפקדת מזומן אין קשר לאשראי/צ׳קים/הקפה/תווי קניה, והשוואה
  // מול הסה"כ הראתה "חוסר" בגובה הכנסות האשראי בכל יום. חייב להישאר זהה ל-routes/reports.js#base.
  function drawerCash(){ return num(form.querySelector('input[name="drawer_cash"]')); }
  function recalcDepRecon(){
    if (!depReconEl) return;
    if (!depAmtEl || depAmtEl.value.trim() === '') { depReconEl.value = '—'; depReconEl.style.color = ''; return; }
    var diff = num(depAmtEl) - (drawerCash() + cxSum());
    if (Math.round(diff*100) === 0) { depReconEl.value = 'תואם'; depReconEl.style.color = 'var(--ok)'; }
    else if (diff > 0) { depReconEl.value = 'יתרה ' + fmt(diff); depReconEl.style.color = 'var(--ok)'; }
    else { depReconEl.value = 'חוסר ' + fmt(-diff); depReconEl.style.color = 'var(--bad)'; }
  }
  function recalcDrawer(){ form.querySelector('#drawer_total').value = fmt(drawerSum()); }
  function ccMatches(){ return Math.round(ccSum()*100) === Math.round(num(creditEl)*100); }
  function recalcCc(){
    form.querySelector('#cc_total_disp').textContent = fmt(ccSum());
    var msg = form.querySelector('#cc_match_msg');
    if (ccMatches()) { msg.textContent = 'תואם לאשראי מגירה ✓'; msg.style.color = 'var(--ok)'; }
    else { msg.textContent = 'אין התאמה בהכנסות מאשראי — אשראי מגירה ' + fmt(num(creditEl)); msg.style.color = 'var(--bad)'; }
  }
  form.querySelectorAll('input.dr').forEach(function(i){ i.addEventListener('input', function(){ recalcDrawer(); recalcCc(); recalcDepRecon(); }); });
  form.querySelectorAll('input.cc').forEach(function(i){ i.addEventListener('input', recalcCc); });
  if (depAmtEl) depAmtEl.addEventListener('input', recalcDepRecon);
  recalcDrawer(); recalcCc();
  // Show the credit-card panel up-front when there's credit to reconcile (or a mismatch).
  if (num(creditEl) > 0 || ccSum() > 0) document.getElementById('cc-panel').hidden = false;

  // Cash-expenses table: live total + auto-add a fresh row when the last one is filled.
  var body = document.getElementById('cx-body');
  function recalcCx(){
    var t=0; body.querySelectorAll('.cx-amt').forEach(function(i){ t+=num(i); });
    var el = document.getElementById('drawer_expenses_total'); if (el) el.value = fmt(t);
    recalcDepRecon();
  }
  recalcCx();
  window.cxDel = function(btn){
    var rows = body.querySelectorAll('.cx-row');
    if (rows.length > 1) btn.closest('.cx-row').remove();
    else btn.closest('.cx-row').querySelectorAll('input,select').forEach(function(i){ i.value=''; });
    recalcCx();
  };
  var CX_INV_OPTS = <%- JSON.stringify(cxInvOptsFor(null)) %>;
  var CX_EMP_OPTS = <%- JSON.stringify(cxEmpOptsFor(null)) %>;
  var CX_KIND_OPTS = <%- JSON.stringify(cxKindOptsFor(null)) %>;
  var CX_PAYER_FIELD = <%- JSON.stringify(cxPayerField('')) %>;
  // "שם" IS the employee picker now, so the שכר/מפרעה employee select would be the same person
  // chosen twice. It stays in the DOM (a hidden select still posts) and is driven from the name —
  // the server contract (payer_name + expense_employee_id) is unchanged.
  function syncPayerEmployee(row){
    var payer = row.querySelector('.cx-payer'), emp = row.querySelector('.cx-emp');
    if (!payer || !emp) return;
    var opt = payer.options[payer.selectedIndex];
    emp.value = (opt && opt.getAttribute('data-emp')) || '';
  }
  // Show only the detail control that matches the row's kind (purpose / invoice).
  function applyKind(row){
    var kind = (row.querySelector('.cx-kind') || {}).value || 'manual';
    var p = row.querySelector('.cx-purpose'), emp = row.querySelector('.cx-emp'), inv = row.querySelector('.cx-inv');
    if (p) p.hidden = (kind !== 'manual');
    if (emp) emp.hidden = true;
    if (inv) inv.hidden = (kind !== 'invoice');
    syncPayerEmployee(row);
  }
  function addRow(){
    var row = document.createElement('div');
    row.className = 'cx-row';
    row.innerHTML = '<div class="cx-field"><label>סוג</label><select name="expense_kind" class="cx-kind">' + CX_KIND_OPTS + '</select></div>'
      + '<div class="cx-field"><label>תאריך</label><input type="date" name="expense_date"></div>'
      + '<div class="cx-field"><label>שם</label>' + CX_PAYER_FIELD + '</div>'
      + '<div class="cx-field cx-details"><label>פרטים</label><input name="purpose" class="cx-purpose" placeholder="עבור" autocomplete="off">'
      +   '<select name="expense_employee_id" class="cx-emp">' + CX_EMP_OPTS + '</select>'
      +   '<select name="expense_invoice_id" class="cx-inv">' + CX_INV_OPTS + '</select></div>'
      + '<div class="cx-field cx-amt-field"><label>סכום (₪)</label><input name="amount" class="cx-amt" inputmode="decimal" placeholder="0.00"></div>'
      + '<button type="button" class="btn btn-secondary small cx-del" onclick="cxDel(this)">✕ הסר</button>';
    body.appendChild(row);
    applyKind(row);
    if (window.apEnhanceDates) window.apEnhanceDates(row);
    if (window.apEnhanceCombos) window.apEnhanceCombos(row); // …and its searchable name picker
  }
  // A combobox pick fires `change`, not `input`, so the "spawn the next blank row" rule needs both.
  function maybeAddRow(target){
    var rows = body.querySelectorAll('.cx-row');
    var last = rows[rows.length - 1];
    if (!last.contains(target)) return;
    var filled = Array.prototype.some.call(last.querySelectorAll('input, .cx-payer'), function(i){
      return i.classList.contains('combo-input') ? false : String(i.value || '').trim() !== '';
    });
    if (filled) addRow();
  }
  // Initialize kind-toggle for the server-rendered rows, and react to kind changes.
  body.querySelectorAll('.cx-row').forEach(applyKind);
  body.addEventListener('change', function(e){
    if (!e.target || !e.target.classList) return;
    if (e.target.classList.contains('cx-kind')) applyKind(e.target.closest('.cx-row'));
    if (e.target.classList.contains('cx-payer')) { syncPayerEmployee(e.target.closest('.cx-row')); maybeAddRow(e.target); }
  });
  body.addEventListener('input', function(e){ recalcCx(); maybeAddRow(e.target); });

  form.addEventListener('submit', function(e){
    if (drawerSum() <= 0){ e.preventDefault(); alert('סה"כ מגירה חובה — הזן לפחות רכיב מגירה אחד.'); return; }
    if (!ccMatches()){
      e.preventDefault();
      document.getElementById('cc-panel').hidden = false;
      recalcCc();
      alert('אין התאמה בהכנסות מאשראי');
    }
  });
})();
</script>
