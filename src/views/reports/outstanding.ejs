<%- include('../partials/header') %>
<div class="toolbar">
  <h1>צ׳קים בחוץ</h1>
</div>
<p class="muted">סכום הצ׳קים שהונפקו וטרם נפרעו, פר חשבון בנק = ההתחייבות החיה (§7).<% if (accounts.length !== 1) { %> לחץ על שורה לפירוט.<% } %></p>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
// "הכל" resets the cut (preserving the selected account).
function ocAllLink(){ return '/reports/outstanding' + (detailAccountId ? '?account=' + detailAccountId : ''); }
// The current cut as a '&'-prefixed querystring fragment, so account/export/print links keep it.
function cutQS(){
  var p = [];
  if (cut === 'date') { p.push('cut=date'); if (from) p.push('from=' + encodeURIComponent(from)); if (to) p.push('to=' + encodeURIComponent(to)); }
  else if (cut === 'months') { p.push('cut=months'); (selMonths || []).forEach(function(m){ p.push('months=' + encodeURIComponent(m)); }); }
  else if (cut === 'weeks') { p.push('cut=weeks'); (selWeeks || []).forEach(function(w){ p.push('weeks=' + encodeURIComponent(w)); }); }
  else if (month) { p.push('month=' + encodeURIComponent(month)); }
  return p.length ? '&' + p.join('&') : '';
}
%>
<%# החתכים לפי תאריך פירעון — בסרגל שבתחתית הדף, יחד עם ייצוא והדפסה (reports/_outstandingCut.ejs, בעלים 21/10). %>
<script>
  function ocShowCut(m){
    document.querySelectorAll('.oc-cut').forEach(function(f){ f.style.display = 'none'; });
    var el = document.getElementById('oc-' + m); if (el) el.style.display = '';
  }
</script>

<%# טבלת החשבונות — רק כשיש כמה חשבונות בתצוגה (כל החנויות). חשבון אחד נפתח ישר לרשימת הצ׳קים
    (routes/reports.js, בעלים 21/10: "לוותר על הדבר הזה ומייד להציג את רשימת הצ׳קים"). %>
<% if (accounts.length !== 1) { %>
<div class="card">
  <% if (month) { %><p class="muted" style="margin:0 0 .6rem">מציג צ׳קים שתאריך פירעונם ב־<strong><%= (months.find(function(x){return x.value===month;})||{}).label || month %></strong>.</p><% } %>
  <table>
    <thead>
      <tr><th>חברה</th><th>חנות / חשבון</th><th class="right">צ׳קים פתוחים</th><th class="right">סכום בחוץ</th><th class="no-print">ייצוא</th></tr>
    </thead>
    <tbody>
      <% accounts.forEach(function(a){ %>
        <tr onclick="location='/reports/outstanding?account=<%= a.id %><%= cutQS() %>'" style="cursor:pointer"
            class="<%= detailAccountId === a.id ? 'b-approved' : '' %>">
          <td><%= a.company_name %></td>
          <td><%= a.display_name %></td>
          <td class="right"><%= a.outstanding_count %></td>
          <td class="right"><strong><%= formatIls(a.outstanding) %></strong></td>
          <td class="no-print" onclick="event.stopPropagation()">
            <details class="menu open-in">
              <summary class="btn btn-secondary btn-sm">ייצוא <span class="caret">▾</span></summary>
              <div class="menu-panel" style="min-width:150px">
                <a href="/reports/outstanding-detail.csv?account=<%= a.id %><%= cutQS() %>">📄 ייצוא CSV</a>
                <a href="/reports/outstanding?account=<%= a.id %><%= cutQS() %>&print=1">🖨️ הדפסה</a>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">סה"כ כל החשבונות</th>
        <th class="right"><%= a_total_count(accounts) %></th>
        <th class="right"><%= formatIls(totalOutstanding) %></th>
        <th class="no-print"></th>
      </tr>
    </tfoot>
  </table>
</div>
<% } %>

<% if (detailAccountId) { %>
  <% var _bm = (typeof bankMatches !== 'undefined' && bankMatches) ? bankMatches : new Map();
     var _withCand = 0, _unique = 0;
     detail.forEach(function(r){ var m = _bm.get(Number(r.paymentId)); if (m && m.candidates.length) { _withCand += 1; if (m.unique) _unique += 1; } }); %>
  <div class="card">
    <%# בעלים 18/10: בלי "— החשבון הנבחר"; משמאל לכותרת — חתך התאריכים במקום "ייצוא CSV מפורט". הקובץ
        המפורט עדיין זמין מ"ייצוא ▾ ← 📄 ייצוא CSV" בשורת החשבון (אותה כתובת בדיוק). %>
    <div class="toolbar oc-detail-head">
      <h2 style="margin:0">פירוט צ׳קים שלא נפרעו</h2>
    </div>
    <%# בלי טבלת החשבונות (חשבון אחד) — הסיכום שלה עובר לכאן, כדי שהסכום בחוץ לא ייעלם. %>
    <% var _acc = accounts.find(function(a){ return a.id === detailAccountId; }); %>
    <% if (_acc && accounts.length === 1) { %><p class="muted oc-total" style="margin:0 0 .6rem"><%= _acc.display_name %> · <%= _acc.outstanding_count %> צ׳קים פתוחים · <strong><%= formatIls(_acc.outstanding) %></strong> בחוץ</p><% } %>
    <%# "התאמה לפי סכום": חיוב בבנק באותו סכום שעוד לא הותאם (services/reports.js#outstandingBankCandidates).
        הצעה בלבד — סכום זהה לבדו אינו הוכחה, ולכן ההתאמה בלחיצה. %>
    <div class="alert <%= _withCand ? 'alert-warn' : 'alert-ok' %> no-print" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
      <% if (_withCand) { %>
        <span>🔎 נמצאו חיובים בבנק <strong>באותו סכום</strong> ל-<strong><%= _withCand %></strong> מתוך <%= detail.length %> צ׳קים פתוחים<%= _unique ? ' — ' + _unique + ' מהם חד-משמעיים' : '' %>. ייתכן שהם כבר נפרעו.</span>
        <% if (_unique) { %>
          <form method="post" action="/reports/outstanding/match-unique" style="margin:0"
                onsubmit="return confirm('להתאים <%= _unique %> צ׳קים לחיובים בבנק לפי סכום ולסמן אותם כנפרעו?')">
            <input type="hidden" name="account" value="<%= detailAccountId %>" />
            <button type="submit" class="ok small">🔗 התאם את כל החד-משמעיים (<%= _unique %>)</button>
          </form>
        <% } %>
      <% } else { %>
        <span>🔎 לא נמצא חיוב בבנק באותו סכום לאף צ׳ק פתוח בחשבון הזה (בדף הבנק שיובא עד היום).</span>
      <% } %>
    </div>
    <%# גלילה בתוך הטבלה: 11 עמודות — בלי העטיפה הדף כולו נמתח ל-922px בטלפון ונגרר הצידה. %>
    <div class="table-scroll">
    <table class="sortable">
      <thead>
        <tr>
          <th>ספק</th><th>מס' חשבונית</th><th>תאריך חשבונית</th><th class="right">סכום חשבונית</th>
          <th>מס' זיכוי</th><th class="right">סכום זיכוי</th><th class="right">סכום</th><th>תאריך פירעון</th>
          <th class="no-print">התאמה בבנק לפי סכום</th>
          <%# "סמן כנפרע" (הצ׳ק) ו"ערוך חשבונית" (החשבונית) בעמודות נפרדות — בעלים, 16/10: "תפריד, זה לא יפה". %>
          <th class="no-print" data-nosort>פירעון</th>
          <% if (currentUser.role === 'owner') { %><th class="no-print" data-nosort>חשבונית</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (detail.length === 0) { %><tr><td colspan="<%= currentUser.role === 'owner' ? 11 : 10 %>" class="muted">אין צ׳קים פתוחים.</td></tr><% } %>
        <% detail.forEach(function(r){ %>
          <tr>
            <td><%= r.supplierName %><% if (r.isAdvance) { %> <span class="muted" style="font-size:11px">· על החשבון</span><% } %></td>
            <td class="mono"><a href="/payments/<%= r.paymentId %>"><%= r.invoiceNumbers || r.ident || ('תשלום #' + r.paymentId) %></a></td>
            <td><%= r.invoiceDate ? formatDate(r.invoiceDate) : '' %></td>
            <td class="right"><%= formatIls(r.invoiceAmount) %></td>
            <td class="mono"><%= r.creditNumbers || '—' %></td>
            <td class="right"><%= r.creditAmount ? '−' + formatIls(r.creditAmount) : '—' %></td>
            <td class="right"><strong><%= formatIls(r.amount) %></strong></td>
            <td data-sort="<%= r.dueDate %>"><%= formatDate(r.dueDate) %></td>
            <% var m = _bm.get(Number(r.paymentId)); %>
            <td class="no-print">
              <% if (!m || !m.candidates.length) { %><span class="muted">—</span>
              <% } else { %>
                <form method="post" action="/reports/outstanding/match" style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;margin:0">
                  <input type="hidden" name="account" value="<%= detailAccountId %>" />
                  <input type="hidden" name="payment_id" value="<%= r.paymentId %>" />
                  <% if (m.candidates.length === 1) { var t = m.candidates[0]; %>
                    <input type="hidden" name="txn_id" value="<%= t.id %>" />
                    <span style="font-size:12px" title="<%= t.description || '' %>">חיוב <%= formatDate(t.txn_date) %><%= t.raw_reference ? ' · אסמכתה ' + t.raw_reference : '' %><% if (t.numberDiffers) { %> <span class="badge b-on_hold" title="מספר הצ׳ק בבנק שונה מהמספר כאן — אולי צ׳ק אחר באותו סכום. התאם רק אחרי בדיקה.">מספר שונה — לבדוק</span><% } else if (!m.unique) { %> <span class="badge b-on_hold">גם לצ׳ק אחר</span><% } %></span>
                  <% } else { %>
                    <select name="txn_id" style="max-width:190px;font-size:12px">
                      <% m.candidates.forEach(function(t){ %><option value="<%= t.id %>"><%= formatDate(t.txn_date) %><%= t.raw_reference ? ' · ' + t.raw_reference : '' %></option><% }); %>
                    </select>
                  <% } %>
                  <button type="submit" class="small" onclick="return confirm('להתאים את הצ׳ק לחיוב הזה בבנק ולסמן אותו כנפרע?')">🔗 התאם</button>
                </form>
              <% } %>
            </td>
            <td class="no-print">
              <form method="post" action="/payments/<%= r.paymentId %>/clear" style="display:inline;margin:0">
                <button class="ok small" type="submit">✓ סמן כנפרע</button>
              </form>
            </td>
            <% if (currentUser.role === 'owner') { %>
              <td class="no-print">
                <div style="display:flex;flex-wrap:wrap;gap:4px">
                  <% r.invoiceIds.forEach(function(iid){ %>
                    <a class="btn secondary small" href="/invoices/<%= iid %>/edit">✏️ ערוך</a>
                  <% }); %>
                </div>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <% if (currentUser.role !== 'owner') { %><p class="muted no-print">עריכת חשבוניות זמינה לבעלים בלבד.</p><% } %>
  </div>
<% } %>
<%# הסרגל שבתחתית: מימין החתכים, משמאל ייצוא והדפסה. כשרשימת צ׳קים מוצגת — הייצוא הוא הקובץ המפורט שלה
    (עם החתך); אחרת — סיכום החשבונות. %>
<%- include('_outstandingCut', {
  allLink: ocAllLink(),
  csvLink: detailAccountId ? '/reports/outstanding-detail.csv?account=' + detailAccountId + cutQS() : '/reports/outstanding.csv',
}) %>

<script>
  // "הדפסה" מהתפריט בשורה פותח את פירוט החשבון ומריץ הדפסה אוטומטית.
  if (new URLSearchParams(location.search).get('print') === '1') {
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 350); });
  }
</script>
<%
function a_total_count(list){ return list.reduce(function(s,a){ return s + a.outstanding_count; }, 0); }
%>
<%- include('../partials/footer') %>
