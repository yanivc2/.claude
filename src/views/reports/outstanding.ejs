<%- include('../partials/header') %>
<div class="toolbar">
  <h1>צ׳קים בחוץ</h1>
</div>
<p class="muted">סכום הצ׳קים שהונפקו וטרם נפרעו, פר חשבון בנק = ההתחייבות החיה (§7). לחץ על שורה לפירוט.</p>

<%
// "הכל" resets the cut (preserving the selected account).
function ocAllLink(){ return '/reports/outstanding' + (detailAccountId ? '?account=' + detailAccountId : ''); }
// The current cut as a '&'-prefixed querystring fragment, so account/export/print links keep it.
function cutQS(){
  var p = [];
  if (cut === 'date') { p.push('cut=date'); if (from) p.push('from=' + encodeURIComponent(from)); if (to) p.push('to=' + encodeURIComponent(to)); }
  else if (cut === 'months') { p.push('cut=months'); (selMonths || []).forEach(function(m){ p.push('months=' + encodeURIComponent(m)); }); }
  else if (month) { p.push('month=' + encodeURIComponent(month)); }
  return p.length ? '&' + p.join('&') : '';
}
%>
<% if (months && months.length) { %>
<div class="card no-print">
  <label class="lbl" style="margin:0 0 .5rem">חתך לפי תאריך פירעון</label>
  <div class="actions" style="flex-wrap:wrap;gap:.4rem;margin-bottom:.6rem">
    <a class="chip <%= cut === 'all' ? 'active' : '' %>" href="<%= ocAllLink() %>">הכל</a>
    <button type="button" class="chip <%= cut === 'date' ? 'active' : '' %>" onclick="ocShowCut('date')">חתך תאריכים</button>
    <button type="button" class="chip <%= cut === 'months' ? 'active' : '' %>" onclick="ocShowCut('months')">חתך חודשים</button>
  </div>

  <form method="get" action="/reports/outstanding" id="oc-date" class="oc-cut no-enhance" style="<%= cut === 'date' ? '' : 'display:none' %>">
    <% if (detailAccountId) { %><input type="hidden" name="account" value="<%= detailAccountId %>" /><% } %>
    <input type="hidden" name="cut" value="date" />
    <div class="row">
      <div><label>מתאריך</label><input type="date" name="from" value="<%= from || '' %>" /></div>
      <div><label>עד תאריך</label><input type="date" name="to" value="<%= to || '' %>" /></div>
    </div>
    <div style="margin-top:.5rem"><button type="submit">הצג</button></div>
  </form>

  <form method="get" action="/reports/outstanding" id="oc-months" class="oc-cut" style="<%= cut === 'months' ? '' : 'display:none' %>">
    <% if (detailAccountId) { %><input type="hidden" name="account" value="<%= detailAccountId %>" /><% } %>
    <input type="hidden" name="cut" value="months" />
    <p class="muted" style="margin:0 0 .5rem">סמן אילו חודשים להציג (רק חודשים שיש בהם צ׳קים פתוחים):</p>
    <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:.6rem">
      <% months.forEach(function(mo){ %>
        <label style="display:flex;align-items:center;gap:5px;margin:0"><input type="checkbox" name="months" value="<%= mo.value %>" style="width:auto;min-height:0" <%= (selMonths || []).includes(mo.value) ? 'checked' : '' %> /> <%= mo.label %></label>
      <% }); %>
    </div>
    <button type="submit">הצג נבחרים</button>
  </form>
</div>
<script>
  function ocShowCut(m){
    document.querySelectorAll('.oc-cut').forEach(function(f){ f.style.display = 'none'; });
    var el = document.getElementById('oc-' + m); if (el) el.style.display = '';
  }
</script>
<% } %>

<div class="card">
  <% if (month) { %><p class="muted" style="margin:0 0 .6rem">מציג צ׳קים שתאריך פירעונם ב־<strong><%= (months.find(function(x){return x.value===month;})||{}).label || month %></strong>.</p><% } %>
  <table>
    <thead>
      <tr><th>חברה</th><th>חנות / חשבון</th><th class="right">צ׳קים פתוחים</th><th class="right">סכום בחוץ</th><th class="no-print">ייצוא</th></tr>
    </thead>
    <tbody>
      <% accounts.forEach(function(a){ %>
        <tr onclick="location='/reports/outstanding?account=<%= a.id %><%= cutQS() %>'" style="cursor:pointer"
            class="<%= detailAccountId === a.id ? 'b-approved' : '' %>">
          <td><%= a.company_name %></td>
          <td><%= a.display_name %></td>
          <td class="right"><%= a.outstanding_count %></td>
          <td class="right"><strong><%= formatIls(a.outstanding) %></strong></td>
          <td class="no-print" onclick="event.stopPropagation()">
            <details class="menu open-in">
              <summary class="btn btn-secondary btn-sm">ייצוא <span class="caret">▾</span></summary>
              <div class="menu-panel" style="min-width:150px">
                <a href="/reports/outstanding-detail.csv?account=<%= a.id %><%= cutQS() %>">📄 ייצוא CSV</a>
                <a href="/reports/outstanding?account=<%= a.id %><%= cutQS() %>&print=1">🖨️ הדפסה</a>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">סה"כ כל החשבונות</th>
        <th class="right"><%= a_total_count(accounts) %></th>
        <th class="right"><%= formatIls(totalOutstanding) %></th>
        <th class="no-print"></th>
      </tr>
    </tfoot>
  </table>
</div>

<% if (detailAccountId) { %>
  <div class="card">
    <div class="toolbar">
      <h2 style="margin:0">פירוט צ׳קים שלא נפרעו — החשבון הנבחר</h2>
      <a class="btn secondary no-print" href="/reports/outstanding-detail.csv?account=<%= detailAccountId %><%= cutQS() %>">ייצוא CSV מפורט</a>
    </div>
    <table class="sortable">
      <thead>
        <tr>
          <th>ספק</th><th>מס' חשבונית</th><th>תאריך חשבונית</th><th class="right">סכום חשבונית</th>
          <th>מס' זיכוי</th><th class="right">סכום זיכוי</th><th>תאריך פירעון</th><th class="right">סכום</th>
          <th class="no-print" data-nosort>פעולות</th>
        </tr>
      </thead>
      <tbody>
        <% if (detail.length === 0) { %><tr><td colspan="9" class="muted">אין צ׳קים פתוחים.</td></tr><% } %>
        <% detail.forEach(function(r){ %>
          <tr>
            <td><%= r.supplierName %></td>
            <td class="mono"><a href="/payments/<%= r.paymentId %>"><%= r.invoiceNumbers || r.ident %></a></td>
            <td><%= r.invoiceDate %></td>
            <td class="right"><%= formatIls(r.invoiceAmount) %></td>
            <td class="mono"><%= r.creditNumbers || '—' %></td>
            <td class="right"><%= r.creditAmount ? '−' + formatIls(r.creditAmount) : '—' %></td>
            <td><%= r.dueDate %></td>
            <td class="right"><strong><%= formatIls(r.amount) %></strong></td>
            <td class="no-print">
              <form method="post" action="/payments/<%= r.paymentId %>/clear" style="display:inline">
                <button class="ok small" type="submit">סמן כנפרע</button>
              </form>
              <% if (currentUser.role === 'owner') { %>
                <% r.invoiceIds.forEach(function(iid){ %>
                  <a class="btn secondary small" href="/invoices/<%= iid %>/edit">ערוך חשבונית</a>
                <% }); %>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% if (currentUser.role !== 'owner') { %><p class="muted no-print">עריכת חשבוניות זמינה לבעלים בלבד.</p><% } %>
  </div>
<% } %>
<!-- פעולות ייצוא/הדפסה — למטה -->
<div class="card no-print" style="display:flex; justify-content:flex-start; gap:var(--space-3)">
  <a class="btn btn-secondary" href="/reports/outstanding.csv">📄 ייצוא CSV</a>
  <button type="button" class="btn btn-secondary" onclick="window.print()">🖨️ הדפסה / PDF</button>
</div>

<script>
  // "הדפסה" מהתפריט בשורה פותח את פירוט החשבון ומריץ הדפסה אוטומטית.
  if (new URLSearchParams(location.search).get('print') === '1') {
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 350); });
  }
</script>
<%
function a_total_count(list){ return list.reduce(function(s,a){ return s + a.outstanding_count; }, 0); }
%>
<%- include('../partials/footer') %>
