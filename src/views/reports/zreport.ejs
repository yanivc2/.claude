<%- include('../partials/header') %>
<div class="toolbar">
  <h1>דוח Z <span class="mono"><%= zr.z_number %></span> · <%= store.store_name %></h1>
  <a href="/reports/profitability?zstore=<%= zr.store_id %>" class="btn secondary">חזרה</a>
</div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><%= notice %></div>
<% } %>

<div class="card">
  <div class="row">
    <div><span class="muted">חנות / חברה</span><br><%= store.store_name %> · <%= store.company_name %></div>
    <div><span class="muted">תאריך</span><br><%= zr.z_date %></div>
    <div><span class="muted">יומי Z</span><br><strong><%= formatIls(zr.daily_total) %></strong></div>
  </div>
</div>

<div class="row">
  <div style="flex:1; min-width:280px">
    <div class="card">
      <h2>דוח מגירה</h2>
      <table>
        <tbody>
          <tr><td>מזומן</td><td class="right"><%= formatIls(zr.drawer_cash) %></td></tr>
          <tr><td title="תשלום חוב באמצעות צ'ק">צ'ק</td><td class="right"><%= formatIls(zr.drawer_check) %></td></tr>
          <tr><td>אשראי מגירה</td><td class="right"><%= formatIls(zr.drawer_credit) %></td></tr>
          <tr><td>הקפה</td><td class="right"><%= formatIls(zr.drawer_hakafa) %></td></tr>
          <tr><td title="זיכוי קניות עובדים מההקפה שלהם באמצעות תווי קניה">תווי קניה</td><td class="right"><%= formatIls(zr.drawer_vouchers) %></td></tr>
        </tbody>
        <tfoot>
          <tr><th>סה"כ מגירה</th><th class="right"><%= formatIls(zr.drawer_total) %></th></tr>
          <tr><td>מגירה Z</td><td class="right"><%= formatIls(zr.drawer_z) %></td></tr>
        </tfoot>
      </table>
      <div style="margin-top:.6rem">
        <span class="muted">התאמת מגירה (מזומן + צ'ק + אשראי = מגירה Z):</span>
        <% if (drawerRecon.diff === 0) { %>
          <strong style="color:var(--ok)">✓ תואם</strong>
        <% } else { %>
          <strong style="color:var(--bad)"><%= drawerRecon.diff < 0 ? 'חוסר' : 'יתרה' %> <%= formatIls(drawerRecon.diff) %></strong>
        <% } %>
      </div>
    </div>
  </div>

  <div style="flex:2; min-width:360px">
    <div class="card">
      <div class="toolbar">
        <h2 style="margin:0">דוח הוצאות</h2>
        <strong>סה"כ הוצאות: <%= formatIls(expensesTotal) %></strong>
      </div>
      <table>
        <thead><tr><th>תאריך</th><th>משלם</th><th>תיאור</th><th>עובד</th><th class="right">סכום</th><th>פתק</th><th></th></tr></thead>
        <tbody>
          <% if (expenses.length === 0) { %><tr><td colspan="7" class="muted">אין הוצאות.</td></tr><% } %>
          <% expenses.forEach(function(e){ var t = expenseTypes.find(function(x){return x.value===e.description_type;}); %>
            <tr>
              <td><%= e.expense_date || '—' %></td>
              <td><%= e.payer_name || '—' %></td>
              <td><%= t ? t.label : (e.description_type || '—') %></td>
              <td><%= e.employee_name || '—' %></td>
              <td class="right"><%= formatIls(e.amount) %></td>
              <td><% if (e.image_path) { %><a href="/reports/zexpenses/<%= e.id %>/image" target="_blank">צפה</a><% } else { %>—<% } %></td>
              <td>
                <form method="post" action="/reports/zexpenses/<%= e.id %>/delete" onsubmit="return confirm('למחוק הוצאה?')" style="display:inline">
                  <button class="danger small" type="submit">מחק</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <h3 style="margin-top:1rem">הוספת הוצאה</h3>
      <form method="post" action="/reports/zreports/<%= zr.id %>/expenses" enctype="multipart/form-data" class="stack">
        <div class="row">
          <div><label>תאריך הוצאה</label><input type="date" name="expense_date" /></div>
          <div><label>שם משלם</label><input name="payer_name" /></div>
        </div>
        <div class="row">
          <div>
            <label>תיאור הוצאה</label>
            <select name="description_type" id="exp_type" onchange="toggleEmp()">
              <% expenseTypes.forEach(function(t){ %><option value="<%= t.value %>" data-emp="<%= t.needsEmployee %>"><%= t.label %></option><% }); %>
            </select>
          </div>
          <div id="emp_wrap"><label>שם העובד</label><input name="employee_name" /></div>
          <div><label>סכום (₪)</label><input name="amount" inputmode="decimal" required /></div>
        </div>
        <label>תמונת פתק (לא חובה)</label>
        <input type="file" name="image" accept="image/*,application/pdf" />
        <div style="margin-top:.6rem"><button type="submit">הוסף הוצאה</button></div>
      </form>
    </div>
  </div>
</div>

<div class="row">
  <div style="flex:1; min-width:300px">
    <div class="card">
      <h2>דוח הפקדות</h2>
      <form method="post" action="/reports/zreports/<%= zr.id %>/deposit" class="stack">
        <table>
          <thead><tr><th>שטר</th><th>כמות</th><th class="right">סכום</th></tr></thead>
          <tbody>
            <% denoms.forEach(function(d){ var c = depositCounts[d.value] || 0; %>
              <tr>
                <td>₪<%= d.value %></td>
                <td><input name="count_<%= d.key %>" class="dep" data-val="<%= d.value %>" inputmode="numeric" value="<%= c || '' %>" style="width:90px" /></td>
                <td class="right dep-line"><%= formatIls(Math.round(d.value*100)*c) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot><tr><th>סכום ההפקדה</th><th></th><th class="right" id="dep_total"><%= formatIls(zr.deposit_amount || 0) %></th></tr></tfoot>
        </table>
        <label>מספר שקית</label>
        <input name="deposit_bag" value="<%= zr.deposit_bag || '' %>" />
        <div style="margin-top:.6rem"><button type="submit">שמור הפקדה</button></div>
      </form>
    </div>
  </div>

  <div style="flex:1; min-width:300px">
    <div class="card">
      <h2>התאמת מזומן</h2>
      <p class="muted">מזומן מגירה = הפקדה + הוצאות</p>
      <table>
        <tbody>
          <tr><td>מזומן מגירה</td><td class="right"><%= formatIls(cashRecon.cash) %></td></tr>
          <tr><td>הפקדה</td><td class="right"><%= formatIls(cashRecon.deposit) %></td></tr>
          <tr><td>הוצאות</td><td class="right"><%= formatIls(cashRecon.expenses) %></td></tr>
        </tbody>
        <tfoot>
          <tr>
            <th><%= cashRecon.diff === 0 ? 'התאמה' : (cashRecon.diff < 0 ? 'חוסר' : 'יתרה') %></th>
            <th class="right" style="color:<%= cashRecon.diff === 0 ? 'var(--ok)' : (cashRecon.diff < 0 ? 'var(--bad)' : 'var(--ok)') %>">
              <%= cashRecon.diff === 0 ? '✓' : formatIls(cashRecon.diff) %>
            </th>
          </tr>
        </tfoot>
      </table>
      <% if (cashRecon.diff !== 0) { %>
        <p class="muted">פער בין מזומן המגירה לסכום ההפקדה + ההוצאות. (התאמות מגירה/אשראי מלאות + התראות — בשלב הבא.)</p>
      <% } %>
    </div>
  </div>
</div>

<script>
// Deposit calculator: live line totals + deposit sum.
(function(){
  var depForm = document.querySelector('form[action="/reports/zreports/<%= zr.id %>/deposit"]');
  if (!depForm) return;
  function fmt(agorot){ return '₪' + (agorot/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function recalc(){
    var total = 0;
    depForm.querySelectorAll('input.dep').forEach(function(inp){
      var val = parseFloat(inp.dataset.val); var c = parseInt(inp.value,10)||0;
      var line = Math.round(val*100)*c; total += line;
      inp.closest('tr').querySelector('.dep-line').textContent = fmt(line);
    });
    document.getElementById('dep_total').textContent = fmt(total);
  }
  depForm.querySelectorAll('input.dep').forEach(function(i){ i.addEventListener('input', recalc); });
})();
function toggleEmp(){
  var sel = document.getElementById('exp_type');
  var needs = sel.options[sel.selectedIndex].getAttribute('data-emp') === 'true';
  document.getElementById('emp_wrap').style.display = needs ? '' : 'none';
}
toggleEmp();
</script>
<%- include('../partials/footer') %>
