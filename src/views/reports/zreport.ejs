<%- include('../partials/header') %>
<div class="toolbar">
  <h1>עריכת דוח Z <span class="mono"><%= zr.z_number %></span> · <%= store.store_name %></h1>
  <%# "← חזרה לדוחות Z" — בשורת הכותרת, משמאל ל"→ חזרה" (בעלים 21/10; partials/_zreportBack.ejs דרך topMenu). %>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card">
  <p class="muted" style="margin:0">
    נוצר: <strong><%= israelStamp(zr.created_at) || formatDateTime(zr.created_at) %></strong>
    <% if (zr.updated_at) { %> · עודכן לאחרונה: <strong><%= israelStamp(zr.updated_at) || formatDateTime(zr.updated_at) %></strong><% } else { %> · טרם נערך<% } %>
  </p>
</div>

<%# בדיקת שטרות — מעל עריכת הדוח, מצומצמת כברירת מחדל (בקשת הבעלים). <details> ולא .card עם h2:
    האקורדיון הגלובלי של footer.ejs מדלג על <details>, כך שהמצב הוא של הדפדפן ותמיד מתחיל סגור. %>
<details class="card collapse no-print" id="bill-check"<%= openBills ? ' open' : '' %>>
  <summary><span class="caret">▸</span> <strong>בדיקת שטרות מול סגירת Z</strong><% if (!closing) { %> <span class="muted">(אין סגירה תואמת)</span><% } %></summary>
  <% if (!closing) { %>
    <p class="muted">לא נמצאה סגירת Z תואמת (אותה חנות + אותו מספר Z). כשתיווצר סגירה מתאימה — הספירה תופיע כאן להשוואה.</p>
  <% } else { %>
    <p class="muted">ספירת סוגר הקופה: <strong><%= closing.employee_first %> <%= closing.employee_last %></strong><%= closing.ended_at ? ' · ' + closing.ended_at : '' %>. הזן את ספירתך וסמן ✓ לכל שטר שנבדק.</p>
    <form method="post" action="/reports/zreports/<%= zr.id %>/verify-bills" id="mb-form">
      <div class="table-scroll">
        <table>
          <thead><tr><th>שטר / מטבע</th><th class="right">ספירת סוגר</th><th>ספירת מנהל</th><th>✓</th><th class="right">חוסר / עודף</th></tr></thead>
          <tbody>
            <% closingDenoms.forEach(function(d){
                 var closer = (closerBreakdown && closerBreakdown[d.key]) ? Number(closerBreakdown[d.key]) : 0;
                 var mb = (managerBreakdown && managerBreakdown[d.key]) || {};
            %>
              <tr>
                <td>₪<%= d.value %> <span class="muted" style="font-size:12px"><%= d.kind %></span></td>
                <td class="right"><%= closer %></td>
                <td><input name="mgr_count_<%= d.key %>" class="mb-cnt" data-val="<%= d.value %>" data-closer="<%= closer %>" inputmode="numeric" value="<%= mb.count || '' %>" style="max-width:110px" /></td>
                <td><input type="checkbox" name="mgr_ok_<%= d.key %>" value="1" style="width:auto;min-height:0" <%= mb.ok ? 'checked' : '' %> /></td>
                <td class="right mb-diff">—</td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr><th>סה"כ</th><th class="right" id="mb-closer-total">₪0.00</th><th class="right" colspan="2" id="mb-mgr-total">₪0.00</th><th class="right" id="mb-diff-total">—</th></tr>
          </tfoot>
        </table>
      </div>
      <div style="margin-top:.6rem"><button type="submit">שמור בדיקת שטרות</button></div>
    </form>
    <script>
    (function(){
      var form = document.getElementById('mb-form'); if (!form) return;
      function fmt(a){ return '₪' + a.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2}); }
      function recalc(){
        var closerTotal = 0, mgrTotal = 0;
        form.querySelectorAll('.mb-cnt').forEach(function(inp){
          var val = parseFloat(inp.dataset.val); var closer = parseInt(inp.dataset.closer,10) || 0; var mgr = parseInt(inp.value,10) || 0;
          closerTotal += val*closer; mgrTotal += val*mgr;
          var cell = inp.closest('tr').querySelector('.mb-diff'); var d = (mgr-closer)*val;
          if (closer === 0 && mgr === 0) { cell.textContent = '—'; cell.style.color = ''; }
          else if (mgr === closer) { cell.textContent = '✓'; cell.style.color = 'var(--color-ok)'; }
          else if (d > 0) { cell.textContent = 'עודף ' + fmt(d); cell.style.color = 'var(--color-ok)'; }
          else { cell.textContent = 'חוסר ' + fmt(-d); cell.style.color = 'var(--color-bad)'; }
        });
        document.getElementById('mb-closer-total').textContent = fmt(closerTotal);
        document.getElementById('mb-mgr-total').textContent = fmt(mgrTotal);
        var dt = mgrTotal - closerTotal; var el = document.getElementById('mb-diff-total');
        if (Math.round(dt*100) === 0) { el.textContent = 'תואם'; el.style.color = 'var(--color-ok)'; }
        else if (dt > 0) { el.textContent = 'עודף ' + fmt(dt); el.style.color = 'var(--color-ok)'; }
        else { el.textContent = 'חוסר ' + fmt(-dt); el.style.color = 'var(--color-bad)'; }
      }
      form.querySelectorAll('.mb-cnt').forEach(function(i){ i.addEventListener('input', recalc); });
      recalc();
    })();
    </script>
  <% } %>
</details>

<div class="card no-print">
  <%# תמונת פתק ה-Z: שני כפתורים ליד הכותרת במקום כרטיס נפרד בתחתית (בקשת הבעלים). קלט קובץ אחד —
      📷 מוסיף לו capture (מצלמה בנייד), 📄 מסיר אותו (בחירת קובץ); בחירה שולחת מיד. %>
  <div class="toolbar" style="margin-bottom:.6rem">
    <h2 style="margin:0">עריכת דוח</h2>
    <div class="zimg-actions" style="display:flex;gap:.4rem;align-items:center">
      <% if (zr.image_path) { %><a href="/reports/zreports/<%= zr.id %>/image" target="_blank" class="btn btn-secondary btn-sm" title="צפה בתמונת הדוח" aria-label="צפה בתמונת הדוח">🖼️</a><% } %>
      <button type="button" class="btn btn-secondary btn-sm" data-zimg="file" title="העלה קובץ של פתק ה-Z (תמונה או PDF)" aria-label="העלה קובץ של פתק ה-Z">📄</button>
      <button type="button" class="btn btn-secondary btn-sm" data-zimg="camera" title="צלם את פתק ה-Z" aria-label="צלם את פתק ה-Z">📷</button>
    </div>
  </div>
  <form method="post" action="/reports/zreports/<%= zr.id %>/image" enctype="multipart/form-data" id="zimg-form" data-busy="מעלה…" hidden>
    <input type="file" name="image" id="zimg-input" accept="image/*,application/pdf" />
  </form>
  <script>
  (function(){
    var form = document.getElementById('zimg-form'), input = document.getElementById('zimg-input');
    if (!form || !input) return;
    document.querySelectorAll('[data-zimg]').forEach(function(btn){
      btn.addEventListener('click', function(){
        if (btn.dataset.zimg === 'camera') { input.setAttribute('capture', 'environment'); input.accept = 'image/*'; }
        else { input.removeAttribute('capture'); input.accept = 'image/*,application/pdf'; }
        input.click();
      });
    });
    function send(){ if (form.requestSubmit) form.requestSubmit(); else form.submit(); }
    // צילום מהמצלמה בנייד שוקל 3-8MB, ו-Vercel דוחה גוף בקשה מעל ~4.5MB עוד לפני השרת (CLAUDE.md) —
    // לכן תמונה גדולה מוקטנת בדפדפן ל-2000px לפני השליחה. PDF נשלח כמו שהוא.
    function shrink(file, cb){
      if (!/^image\//.test(file.type) || file.size < 1500000) return cb(null);
      var url = URL.createObjectURL(file), img = new Image();
      img.onload = function(){
        var s = Math.min(1, 2000 / Math.max(img.naturalWidth, img.naturalHeight));
        var c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * s); c.height = Math.round(img.naturalHeight * s);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url);
        c.toBlob(function(b){ cb(b ? new File([b], 'z-slip.jpg', { type: 'image/jpeg' }) : null); }, 'image/jpeg', 0.88);
      };
      img.onerror = function(){ URL.revokeObjectURL(url); cb(null); };
      img.src = url;
    }
    input.addEventListener('change', function(){
      if (!input.files || !input.files.length) return;
      document.querySelectorAll('[data-zimg]').forEach(function(b){ b.disabled = true; });
      document.querySelector('[data-zimg="camera"]').textContent = '⏳';
      shrink(input.files[0], function(small){
        if (small) { try { var dt = new DataTransfer(); dt.items.add(small); input.files = dt.files; } catch (_) {} }
        send();
      });
    });
  })();
  </script>
  <%- include('_zform', { action: '/reports/zreports/' + zr.id, submitLabel: 'שמור שינויים', storeOptions: storeOptions, invoiceOptions: invoiceOptions, ccBrands: ccBrands, zr: zr, dep: dep, expenses: expenses }) %>
</div>
<%- include('../partials/footer') %>
