<%- include('../partials/header') %>
<%
// Plain-text summary of the report, for sharing via WhatsApp / email.
var _lines = ['דוח רווחיות', 'תקופה: ' + from + ' — ' + to, ''];
stores.forEach(function (s) {
  _lines.push(s.store_name + ': מכירות ' + formatIls(s.sales) + ' · קניות ' + formatIls(s.purchases) + ' · רווח ' + formatIls(s.grossProfit));
});
_lines.push('', 'סה"כ: מכירות ' + formatIls(totals.sales) + ' · קניות ' + formatIls(totals.purchases) + ' · רווח ' + formatIls(totals.grossProfit));
var reportText = _lines.join('\n');
var mailSubject = 'דוח רווחיות ' + from + ' — ' + to;
%>
<div class="toolbar"><h1>רווחיות</h1></div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-info"><%= notice %></div>
<% } %>

<!-- בחירת טווח גלויה: חודשי / שבועי / טווח תאריכים (עם כפתור "הצג" מפורש — עובד תמיד) -->
<div class="card no-print">
  <div class="actions" style="gap:.4rem;flex-wrap:wrap">
    <a class="chip <%= preset==='month' ? 'active' : '' %>" href="/reports/profitability?preset=month&from=<%= from %>">חודשי</a>
    <a class="chip <%= preset==='week' ? 'active' : '' %>" href="/reports/profitability?preset=week&from=<%= from %>">שבועי</a>
    <a class="chip <%= !preset ? 'active' : '' %>" href="/reports/profitability?from=<%= from %>&to=<%= to %>">טווח תאריכים</a>
  </div>
  <div style="margin-top:.7rem">
    <% if (preset === 'month') { %>
      <form method="get" action="/reports/profitability" class="actions" style="gap:.6rem;align-items:flex-end;flex-wrap:wrap">
        <input type="hidden" name="preset" value="month" />
        <div><label class="lbl">חודש</label><input type="month" name="from" value="<%= from.slice(0,7) %>" onchange="this.form.submit()" /></div>
        <div><button type="submit">הצג</button></div>
      </form>
    <% } else if (preset === 'week') { %>
      <form method="get" action="/reports/profitability" class="actions" style="gap:.6rem;align-items:flex-end;flex-wrap:wrap">
        <input type="hidden" name="preset" value="week" />
        <div><label class="lbl">בחר יום בשבוע</label><input type="date" name="from" value="<%= from %>" /></div>
        <div><button type="submit">הצג שבוע</button></div>
      </form>
    <% } else { %>
      <form method="get" action="/reports/profitability" class="actions" style="gap:.6rem;align-items:flex-end;flex-wrap:wrap">
        <div><label class="lbl">מתאריך</label><input type="date" name="from" value="<%= from %>" /></div>
        <div><label class="lbl">עד תאריך</label><input type="date" name="to" value="<%= to %>" /></div>
        <div><button type="submit">הצג טווח</button></div>
      </form>
    <% } %>
  </div>
</div>

<div>
    <div class="card">
      <p class="muted">תקופה: <%= from %> — <%= to %>. מכירות מחושבות מ<strong>יומי Z</strong>.</p>
      <table>
        <thead>
          <tr><th>חברה</th><th>חנות</th><th class="right">קניות</th><th class="right">מכירות (Z)</th><th class="right">רווח גולמי</th><th class="right">רווח מלמעלה<br><small class="muted">% מהמכירות</small></th><th class="right">רווח מלמטה<br><small class="muted">% מהעלות</small></th></tr>
        </thead>
        <tbody>
          <% stores.forEach(function(s){ %>
            <tr>
              <td><%= s.company_name %></td>
              <td><%= s.store_name %></td>
              <td class="right"><%= formatIls(s.purchases) %></td>
              <td class="right"><%= formatIls(s.sales) %></td>
              <td class="right <%= s.grossProfit < 0 ? 'neg' : '' %>"><strong><%= formatIls(s.grossProfit) %></strong></td>
              <td class="right"><%= s.marginPct === null ? '—' : s.marginPct.toFixed(1) + '%' %></td>
              <td class="right"><%= s.markupPct === null ? '—' : s.markupPct.toFixed(1) + '%' %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="2">סה"כ</th>
            <th class="right"><%= formatIls(totals.purchases) %></th>
            <th class="right"><%= formatIls(totals.sales) %></th>
            <th class="right <%= totals.grossProfit < 0 ? 'neg' : '' %>"><%= formatIls(totals.grossProfit) %></th>
            <th class="right"><%= totals.marginPct === null ? '—' : totals.marginPct.toFixed(1) + '%' %></th>
            <th class="right"><%= totals.markupPct === null ? '—' : totals.markupPct.toFixed(1) + '%' %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

<!-- כפתורים עגולים למטה: הדפסה · ייצוא (בחירת הטווח גלויה למעלה) -->
<div class="card no-print" style="display:flex; gap:var(--space-8); justify-content:flex-start; align-items:flex-start">
  <div class="icon-tile">
    <button type="button" class="icon-circle" onclick="window.print()" aria-label="הדפסה" title="הדפסה / PDF">
      <svg viewBox="0 0 24 24"><path d="M6 9V3h12v6M6 18H4a1 1 0 01-1-1v-5a2 2 0 012-2h14a2 2 0 012 2v5a1 1 0 01-1 1h-2"/><path d="M7 14h10v7H7z"/></svg>
    </button>
    <span class="cap">הדפסה</span>
  </div>
  <div class="icon-tile">
    <button type="button" class="icon-circle" onclick="document.getElementById('exportDlg').showModal()" aria-label="ייצוא" title="ייצוא">
      <svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M12 11v6M9.5 14.5 12 17l2.5-2.5"/></svg>
    </button>
    <span class="cap">ייצוא</span>
  </div>
</div>

<!-- מודל ייצוא: CSV · וואטסאפ · מייל -->
<dialog id="exportDlg" class="dlg">
  <div class="dlg-head">
    <strong>ייצוא</strong>
    <button type="button" class="dlg-close" onclick="this.closest('dialog').close()">✕</button>
  </div>
  <div style="display:flex;flex-direction:column;gap:.5rem">
    <a class="btn btn-secondary btn-block" href="/reports/profitability.csv?from=<%= from %>&to=<%= to %>">📄 ייצוא CSV</a>
    <a class="btn btn-secondary btn-block" href="https://wa.me/?text=<%= encodeURIComponent(reportText) %>" target="_blank" rel="noopener">💬 וואטסאפ (בחירת איש קשר)</a>
    <a class="btn btn-secondary btn-block" href="mailto:?subject=<%= encodeURIComponent(mailSubject) %>&body=<%= encodeURIComponent(reportText) %>">✉️ מייל</a>
  </div>
</dialog>

<%- include('../partials/footer') %>
