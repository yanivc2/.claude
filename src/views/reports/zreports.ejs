<%- include('../partials/header') %>
<div class="toolbar"><h1>דוחות Z</h1></div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card no-print">
  <h2>הוספת דוח Z</h2>
  <form method="post" action="/reports/zreports" class="stack">
    <label>חנות</label>
    <select name="store_id" required>
      <% storeOptions.forEach(function(st){ %>
        <option value="<%= st.id %>"><%= st.name %> · <%= st.company_name %></option>
      <% }); %>
    </select>
    <div class="row">
      <div><label>מספר Z</label><input name="z_number" required /></div>
      <div><label>תאריך</label><input type="date" name="z_date" required /></div>
    </div>
    <label>סה"כ (יומי Z) ₪</label>
    <input name="daily_total" inputmode="decimal" required placeholder="0.00" />

    <h3 style="margin:1rem 0 .2rem">דוח מגירה</h3>
    <div class="row">
      <div><label>מזומן</label><input name="drawer_cash" class="dr" inputmode="decimal" /></div>
      <div><label>צ'ק</label><input name="drawer_check" class="dr" inputmode="decimal" /><small class="muted">תשלום חוב באמצעות צ'ק</small></div>
    </div>
    <div class="row">
      <div><label>אשראי מגירה</label><input name="drawer_credit" class="dr" inputmode="decimal" /></div>
      <div><label>הקפה</label><input name="drawer_hakafa" class="dr" inputmode="decimal" /></div>
    </div>
    <div class="row">
      <div><label>תווי קניה</label><input name="drawer_vouchers" class="dr" inputmode="decimal" /><small class="muted">זיכוי קניות עובדים מההקפה שלהם באמצעות תווי קניה</small></div>
      <div><label>סה"כ מגירה *</label><input id="drawer_total" readonly value="₪0.00" /><small class="muted">חובה — סכום רכיבי המגירה</small></div>
    </div>
    <div style="margin-top:.6rem"><button type="submit">הוסף דוח Z</button></div>
  </form>
</div>

<div class="card">
  <div class="toolbar">
    <h2 style="margin:0">רשומות Z אחרונות</h2>
    <form method="get" action="/reports/zreports" class="no-print">
      <select name="zstore" onchange="this.form.submit()">
        <option value="">כל החנויות</option>
        <% storeOptions.forEach(function(st){ %>
          <option value="<%= st.id %>" <%= zStoreId === st.id ? 'selected' : '' %>><%= st.name %></option>
        <% }); %>
      </select>
    </form>
  </div>
  <% if (missingZ && missingZ.length) { %>
    <div class="alert alert-warn">מספרי Z חסרים ברצף: <strong><%= missingZ.join(', ') %></strong> — בדוק אם הוזנו ביום אחר.</div>
  <% } %>
  <% if (unmatchedCount > 0) { %>
    <div class="alert alert-warn">⚠ <strong><%= unmatchedCount %></strong> דוחות Z לא תואמים — ראה סימון בטבלה.</div>
  <% } %>
  <table class="sortable">
    <thead><tr><th>Z</th><th>תאריך</th><th>חנות</th><th class="right">יומי Z</th><th class="right">מגירה</th><th>סטטוס</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (zReports.length === 0) { %><tr><td colspan="7" class="muted">אין דוחות Z.</td></tr><% } %>
      <% zReports.forEach(function(z){ %>
        <tr>
          <td class="mono"><a href="/reports/zreports/<%= z.id %>"><%= z.z_number %></a></td>
          <td><%= formatDate(z.z_date) %></td>
          <td><%= z.store_name %></td>
          <td class="right"><%= formatIls(z.daily_total) %></td>
          <td class="right"><%= formatIls(z.drawer_total) %></td>
          <td>
            <% if (z.matched) { %>
              <span class="badge b-approved">תואם</span>
            <% } else { %>
              <span class="badge b-blocked" title="<%= z.issues.map(function(i){return i.label;}).join(', ') %>">לא תואם</span>
            <% } %>
          </td>
          <td class="no-print">
            <form method="post" action="/reports/zreports/<%= z.id %>/delete" onsubmit="return confirm('למחוק דוח Z זה?')" style="display:inline">
              <button class="danger small" type="submit">מחק</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
(function(){
  var form = document.querySelector('form[action="/reports/zreports"]');
  if (!form) return;
  function drawerSum(){
    var sum = 0;
    form.querySelectorAll('input.dr').forEach(function(i){ var v = parseFloat(i.value); if(!isNaN(v)) sum += v; });
    return sum;
  }
  function recalc(){
    form.querySelector('#drawer_total').value = '₪' + drawerSum().toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2});
  }
  form.querySelectorAll('input.dr').forEach(function(i){ i.addEventListener('input', recalc); });
  form.addEventListener('submit', function(e){
    if (drawerSum() <= 0){
      e.preventDefault();
      alert('סה"כ מגירה חובה — הזן לפחות רכיב מגירה אחד.');
    }
  });
})();
</script>
<%- include('../partials/footer') %>
