<%- include('../partials/header') %>
<div class="toolbar"><h1>דוחות Z</h1></div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card no-print">
  <h2>הוספת דוח Z</h2>
  <form method="post" action="/reports/zreports" class="stack">
    <label>חנות</label>
    <select name="store_id" required>
      <% storeOptions.forEach(function(st){ %>
        <option value="<%= st.id %>"><%= st.name %> · <%= st.company_name %></option>
      <% }); %>
    </select>
    <div class="row">
      <div><label>מספר Z</label><input name="z_number" required /></div>
      <div><label>תאריך</label><input type="date" name="z_date" required /></div>
    </div>
    <label>סה"כ (יומי Z) ₪</label>
    <input name="daily_total" inputmode="decimal" required placeholder="0.00" />

    <h3 style="margin:1rem 0 .2rem">דוח מגירה</h3>
    <div class="row">
      <div><label>מזומן</label><input name="drawer_cash" class="dr" inputmode="decimal" /></div>
      <div><label>צ'ק</label><input name="drawer_check" class="dr" inputmode="decimal" /><small class="muted">תשלום חוב באמצעות צ'ק</small></div>
    </div>
    <div class="row">
      <div><label>אשראי מגירה</label><input name="drawer_credit" class="dr" inputmode="decimal" /></div>
      <div><label>הקפה</label><input name="drawer_hakafa" class="dr" inputmode="decimal" /></div>
    </div>
    <div class="row">
      <div><label>תווי קניה</label><input name="drawer_vouchers" class="dr" inputmode="decimal" /><small class="muted">זיכוי קניות עובדים מההקפה שלהם באמצעות תווי קניה</small></div>
      <div><label>סה"כ מגירה *</label><input id="drawer_total" readonly value="₪0.00" /><small class="muted">חובה — סכום רכיבי המגירה</small></div>
    </div>
    <div class="toolbar" style="margin:1.1rem 0 .2rem">
      <div style="display:flex;align-items:center;gap:.6rem">
        <h3 style="margin:0">הוצאות במזומן (לא חובה)</h3>
        <button type="button" class="round-btn" title="פירוט הוצאות" onclick="var p=document.getElementById('cx-panel');p.hidden=!p.hidden;">🧾</button>
      </div>
      <strong>סה"כ הוצאות: <span id="cx-total">₪0.00</span></strong>
    </div>
    <%
      // Options for the per-row invoice picker, built once and reused by the auto-add JS.
      function cxEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
      var cxInvOpts = '<option value="">— ללא חשבונית —</option>';
      (typeof invoiceOptions !== 'undefined' ? invoiceOptions : []).forEach(function(iv){
        cxInvOpts += '<option value="' + iv.id + '">#' + iv.id + ' · ' + cxEsc(iv.supplier_name) + ' · ' + cxEsc(iv.invoice_number) + ' · ' + formatIls(iv.total_amount) + '</option>';
      });
    %>
    <div id="cx-panel" hidden>
      <p class="muted" style="margin:0 0 .4rem">הוצאות ששולמו מקופת המזומן. שורה חדשה נוספת אוטומטית. ניתן לשייך הוצאה לחשבונית.</p>
      <table>
        <thead><tr><th>תאריך</th><th>שם</th><th>עבור</th><th class="right">סכום (₪)</th><th>חשבונית</th><th></th></tr></thead>
        <tbody id="cx-body">
          <tr>
            <td><input type="date" name="expense_date" /></td>
            <td><input name="payer_name" /></td>
            <td><input name="purpose" /></td>
            <td><input name="amount" class="cx-amt" inputmode="decimal" /></td>
            <td><select name="expense_invoice_id" class="cx-inv" style="max-width:220px"><%- cxInvOpts %></select></td>
            <td><button type="button" class="danger small" onclick="cxDel(this)">✕</button></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="margin:1.1rem 0 .2rem">הצהרה על הפקדה (לא חובה)</h3>
    <p class="muted" style="margin:0 0 .4rem">אם הפקדת מזומן לבנק — הזן פרטי הפקדה. החנות והתאריך נלקחים מדוח ה-Z שלמעלה.</p>
    <div class="row">
      <div><label>מספר שקית הפקדה</label><input name="dep_bag" /></div>
      <div><label>סכום הפקדה (₪)</label><input name="dep_amount" inputmode="decimal" placeholder="0.00" /></div>
    </div>
    <label style="display:flex;align-items:center;gap:8px;margin-top:.6rem">
      <input type="checkbox" name="dep_deposited" value="1" style="width:auto;min-height:0" /> הופקד לבנק
    </label>
    <div style="margin-top:.8rem"><button type="submit">הוסף דוח Z</button></div>
  </form>
</div>

<div class="card">
  <h2>הפקדות אחרונות</h2>
  <table class="sortable">
    <thead><tr><th>תאריך</th><th>חנות</th><th>מס' שקית</th><th class="right">סכום</th><th>סטטוס</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (!deposits || deposits.length === 0) { %><tr><td colspan="6" class="muted">אין הפקדות.</td></tr><% } %>
      <% (deposits || []).forEach(function(d){ %>
        <tr>
          <td><%= formatDate(d.deposit_date) %></td>
          <td><%= d.store_name %></td>
          <td class="mono"><%= d.bag_number || '—' %></td>
          <td class="right"><%= formatIls(d.amount) %></td>
          <td>
            <% if (d.deposited) { %><span class="badge b-approved">הופקד</span><% } else { %><span class="badge b-on_hold">לא הופקד</span><% } %>
          </td>
          <td class="no-print">
            <% if (!d.deposited) { %>
              <form method="post" action="/reports/deposits/<%= d.id %>/deposited" style="display:inline"><input type="hidden" name="value" value="1" /><button class="ok small" type="submit">סמן כהופקד</button></form>
            <% } else { %>
              <form method="post" action="/reports/deposits/<%= d.id %>/deposited" style="display:inline"><input type="hidden" name="value" value="0" /><button class="secondary small" type="submit">בטל</button></form>
            <% } %>
            <form method="post" action="/reports/deposits/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('למחוק הפקדה?')"><button class="danger small" type="submit">מחק</button></form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <div class="toolbar">
    <h2 style="margin:0">רשומות Z אחרונות</h2>
    <form method="get" action="/reports/zreports" class="no-print">
      <select name="zstore" onchange="this.form.submit()">
        <option value="">כל החנויות</option>
        <% storeOptions.forEach(function(st){ %>
          <option value="<%= st.id %>" <%= zStoreId === st.id ? 'selected' : '' %>><%= st.name %></option>
        <% }); %>
      </select>
    </form>
  </div>
  <% if (missingZ && missingZ.length) { %>
    <div class="alert alert-warn">מספרי Z חסרים ברצף: <strong><%= missingZ.join(', ') %></strong> — בדוק אם הוזנו ביום אחר.</div>
  <% } %>
  <% if (unmatchedCount > 0) { %>
    <div class="alert alert-warn">⚠ <strong><%= unmatchedCount %></strong> דוחות Z לא תואמים — ראה סימון בטבלה.</div>
  <% } %>
  <table class="sortable">
    <thead><tr><th>Z</th><th>תאריך</th><th>חנות</th><th class="right">יומי Z</th><th class="right">מגירה</th><th>סטטוס</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (zReports.length === 0) { %><tr><td colspan="7" class="muted">אין דוחות Z.</td></tr><% } %>
      <% zReports.forEach(function(z){ %>
        <tr>
          <td class="mono"><a href="/reports/zreports/<%= z.id %>"><%= z.z_number %></a></td>
          <td><%= formatDate(z.z_date) %></td>
          <td><%= z.store_name %></td>
          <td class="right"><%= formatIls(z.daily_total) %></td>
          <td class="right"><%= formatIls(z.drawer_total) %></td>
          <td>
            <% if (z.matched) { %>
              <span class="badge b-approved">תואם</span>
            <% } else { %>
              <span class="badge b-blocked" title="<%= z.issues.map(function(i){return i.label;}).join(', ') %>">לא תואם</span>
            <% } %>
          </td>
          <td class="no-print">
            <form method="post" action="/reports/zreports/<%= z.id %>/delete" onsubmit="return confirm('למחוק דוח Z זה?')" style="display:inline">
              <button class="danger small" type="submit">מחק</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
(function(){
  var form = document.querySelector('form[action="/reports/zreports"]');
  if (!form) return;
  function drawerSum(){
    var sum = 0;
    form.querySelectorAll('input.dr').forEach(function(i){ var v = parseFloat(i.value); if(!isNaN(v)) sum += v; });
    return sum;
  }
  function recalc(){
    form.querySelector('#drawer_total').value = '₪' + drawerSum().toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2});
  }
  form.querySelectorAll('input.dr').forEach(function(i){ i.addEventListener('input', recalc); });
  form.addEventListener('submit', function(e){
    if (drawerSum() <= 0){
      e.preventDefault();
      alert('סה"כ מגירה חובה — הזן לפחות רכיב מגירה אחד.');
    }
  });
})();
// Cash-expenses table on the create form: live total + auto-add a fresh row when the last is filled.
(function(){
  var body = document.getElementById('cx-body');
  if (!body) return;
  function recalc(){
    var t = 0;
    body.querySelectorAll('.cx-amt').forEach(function(i){ var v = parseFloat(i.value); if(!isNaN(v)) t += v; });
    var el = document.getElementById('cx-total'); if (el) el.textContent = '₪' + t.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  }
  window.cxDel = function(btn){
    var rows = body.querySelectorAll('tr');
    if (rows.length > 1) btn.closest('tr').remove();
    else btn.closest('tr').querySelectorAll('input').forEach(function(i){ i.value=''; });
    recalc();
  };
  var CX_INV_OPTS = <%- JSON.stringify(cxInvOpts) %>;
  function addRow(){
    var tr = document.createElement('tr');
    tr.innerHTML = '<td><input type="date" name="expense_date"></td>'
      + '<td><input name="payer_name"></td>'
      + '<td><input name="purpose"></td>'
      + '<td><input name="amount" class="cx-amt" inputmode="decimal"></td>'
      + '<td><select name="expense_invoice_id" class="cx-inv" style="max-width:220px">' + CX_INV_OPTS + '</select></td>'
      + '<td><button type="button" class="danger small" onclick="cxDel(this)">✕</button></td>';
    body.appendChild(tr);
  }
  body.addEventListener('input', function(e){
    recalc();
    var rows = body.querySelectorAll('tr');
    var last = rows[rows.length - 1];
    if (last.contains(e.target)) {
      var filled = Array.prototype.some.call(last.querySelectorAll('input'), function(i){ return i.value.trim() !== ''; });
      if (filled) addRow();
    }
  });
})();
</script>
<%- include('../partials/footer') %>
