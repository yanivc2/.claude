<%- include('../partials/header') %>
<div class="toolbar"><h1>דוחות Z</h1></div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%# כל הרובריקות בדף מתחילות מצומצמות (בקשת הבעלים). הערך "v2" מחליף את מפתח השמירה של הדף, כך
    שמצב פתוח/סגור שנשמר לפני הכלל הזה לא גובר עליו (partials/footer.ejs#pageKey). %>
<span data-collapse-default="v2" hidden></span>
<%# טופס ההוספה הוא <details> ולא .card עם h2: לכרטיס עם שדה חובה המקפל הגלובלי לא נוגע (שדה חובה
    מוסתר חוסם שליחה). כפתור השליחה בתוך ה-details, כך שאי אפשר לשלוח כשהוא סגור. נפתח לבד אחרי שגיאה. %>
<details class="card collapse no-print" id="zr-add"<%= (typeof error !== 'undefined' && error) ? ' open' : '' %>>
  <summary><span class="caret">▸</span> <strong>הוספת דוח Z</strong></summary>
  <% if (!(typeof activeStore !== 'undefined' && activeStore)) { %>
    <%- include('../partials/_needStore', { what: 'דוח Z' }) %>
  <% } else { %>
  <%- include('_zform', { action: '/reports/zreports', submitLabel: 'הוסף דוח Z', storeOptions: storeOptions, invoiceOptions: invoiceOptions, ccBrands: ccBrands, zr: null, dep: null, expenses: [] }) %>
  <% } %>
</details>

<div class="card">
  <h2>הצהרות הפקדה</h2>
  <div class="table-scroll">
  <table class="sortable">
    <thead><tr><th>תאריך</th><th>חנות</th><th data-lookup="/reports/deposits-lookup?bag=">מס' שקית</th><th class="right" data-lookup="/reports/deposits-lookup?amount=">סכום</th><th>סטטוס</th><th class="right">חוסר / יתרה</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (!deposits || deposits.length === 0) { %><tr><td colspan="7" class="muted">אין הפקדות.</td></tr><% } %>
      <%# סה"כ "חוסר / יתרה" מול הבנק — על השורות שהדף טען; השורות עצמן ב-_depositRows (משותף לחיפוש). %>
      <% var _dv = (typeof depVerify !== 'undefined' && depVerify) ? depVerify : new Map(); var _bdSum = 0, _bdN = 0;
         (deposits || []).forEach(function(d){ var v = _dv.get(Number(d.id)) || null; if (v) { _bdSum += v.bankDiff; _bdN += 1; } }); %>
      <%- include('_depositRows', { deposits: deposits, depVerify: _dv }) %>
    </tbody>
    <tfoot><tr>
      <th colspan="5">סה"כ <span class="muted" style="font-weight:400">(<%= _bdN %> שקיות שאותרו בבנק)</span></th>
      <th class="right">
        <% if (!_bdN) { %><span class="muted">—</span>
        <% } else if (_bdSum === 0) { %><span class="badge b-approved">תואם</span>
        <% } else if (_bdSum > 0) { %><strong style="color:var(--color-ok)">יתרה <%= formatIls(_bdSum) %></strong>
        <% } else { %><strong style="color:var(--color-bad)">חוסר <%= formatIls(-_bdSum) %></strong><% } %>
      </th>
      <th class="no-print"></th>
    </tr></tfoot>
  </table>
  </div>
</div>

<%# ===== רובריקה: דוחות Z ללא הצהרת הפקדה — הצהר על הפקדה ===== %>
<div class="card">
  <h2 style="margin:0 0 .5rem">דוחות Z ללא הצהרת הפקדה<% if (zNoDeposit && zNoDeposit.length) { %> <span class="badge b-on_hold"><%= zNoDeposit.length %></span><% } %></h2>
  <% if (!zNoDeposit || zNoDeposit.length === 0) { %>
    <p class="muted" style="margin:0">כל דוחות ה-Z כוללים הצהרת הפקדה. ✓</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="no-enhance">
        <thead><tr><th>Z</th><th>חנות</th><th>תאריך</th><th class="no-print" data-nosort>הצהרת הפקדה</th></tr></thead>
        <tbody>
          <% zNoDeposit.forEach(function(z){ %>
            <tr>
              <td class="mono">Z <%= z.z_number %></td>
              <td><%= z.store_name %></td>
              <td><%= formatDate(z.z_date) %></td>
              <td class="no-print">
                <form method="post" action="/reports/deposit-declare" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:0">
                  <input type="hidden" name="z_report_id" value="<%= z.id %>" />
                  <input name="bag_number" id="declbag-<%= z.id %>" placeholder="מספר שקית" style="max-width:130px" />
                  <button type="button" class="btn btn-secondary small" data-bag-scan="declbag-<%= z.id %>">📷 סרוק</button>
                  <input name="amount" inputmode="decimal" placeholder="סכום ₪" style="max-width:110px" />
                  <button type="submit" class="btn btn-primary small">הצהר</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%# ===== רובריקה: הפקדה שהוצהרה ולא הופקדה — סמן הפקדה / סרוק שקית ===== %>
<div class="card">
  <h2 style="margin:0 0 .5rem">הפקדה שהוצהרה ולא הופקדה<% if (notDeposited && notDeposited.length) { %> <span class="badge b-on_hold"><%= notDeposited.length %></span><% } %></h2>
  <% if (!notDeposited || notDeposited.length === 0) { %>
    <p class="muted" style="margin:0">אין הפקדות שהוצהרו וטרם הופקדו. ✓</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="no-enhance">
        <thead><tr><th>שקית</th><th>Z</th><th>חנות</th><th>תאריך</th><th class="right">סכום</th><th class="no-print" data-nosort>הופקד?</th></tr></thead>
        <tbody>
          <% notDeposited.forEach(function(d){ %>
            <tr>
              <td class="mono"><%= d.bag_number || '—' %></td>
              <td class="mono"><%= d.z_number ? 'Z ' + d.z_number : '—' %></td>
              <td><%= d.store_name %></td>
              <td><%= formatDate(d.deposit_date) %></td>
              <td class="right"><%= formatIls(d.amount) %></td>
              <td class="no-print">
                <form method="post" action="/reports/deposits/<%= d.id %>/deposited" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:0">
                  <input type="hidden" name="value" value="1" />
                  <input name="bag_number" id="depbag-<%= d.id %>" placeholder="שקית (אופציונלי)" value="<%= d.bag_number || '' %>" style="max-width:130px" />
                  <button type="button" class="btn btn-secondary small" data-bag-scan="depbag-<%= d.id %>">📷 סרוק</button>
                  <button type="submit" class="btn ok small">✓ הופקד</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot><tr>
          <th colspan="4">סה"כ <span class="muted" style="font-weight:400">(<%= notDeposited.length %> שקיות)</span></th>
          <th class="right"><%= formatIls(notDeposited.reduce(function(n, d){ return n + (Number(d.amount) || 0); }, 0)) %></th>
          <th class="no-print"></th>
        </tr></tfoot>
      </table>
    </div>
  <% } %>
</div>

<%# האזהרות מחוץ לרובריקה: היא מצומצמת כברירת מחדל, ואזהרה בתוכה הייתה נעלמת יחד איתה. %>
<% if (missingZ && missingZ.length) { %>
  <div class="alert alert-warn">מספרי Z חסרים ברצף: <strong><%= missingZ.join(', ') %></strong> — בדוק אם הוזנו ביום אחר.</div>
<% } %>
<%# "רשומות Z אחרונות" — הרובריקה האחרונה בדף (בעלים 21/10: "תעביר לסוף"); אזהרת הרצף נוסעת איתה.
    <h2> ישיר (לא בתוך .toolbar) — זה מה שהופך את הכרטיס למתקפל (partials/footer.ejs). %>
<div class="card">
  <h2 data-ckey="רשומות Z אחרונות">רשומות Z אחרונות<% if (unmatchedCount > 0) { %> <span class="badge b-on_hold"><%= unmatchedCount %> לא תואמים</span><% } %></h2>
  <%# בלי בורר חנות (בעלים, 17/10) — החנות הפעילה בסרגל העליון קובעת. %>
  <div style="overflow-x:auto">
  <%# "ייצוא" בתא השמאלי של שורת הסה"כ, מתחת לוואטסאפ/מחק (בעלים 21/10: "העבר את ייצוא לשמאל — ראה תמונה"). %>
  <table class="sortable" data-export-into="zrExportSlot">
    <thead><tr><th data-lookup="/reports/zreports-lookup?z=">Z</th><th>תאריך</th><th>חנות</th><th class="right">יומי Z</th><th class="right">מזומן מגירה</th><th class="right">סכום הפקדה</th><th data-lookup="/reports/zreports-lookup?bag=">שקית הפקדה</th><th>סטטוס</th><th class="right">חוסר / יתרה</th><th class="no-print" data-nosort></th></tr></thead>
    <tbody>
      <% if (zReports.length === 0) { %><tr><td colspan="10" class="muted">אין דוחות Z.</td></tr><% } %>
      <%- include('_zreportRows', { zReports: zReports }) %>
    </tbody>
    <%# סה"כ — "מזומן מגירה" על כל הדוחות; "סכום הפקדה" ו"חוסר / יתרה" רק על דוחות עם הפקדה ("—" לא נספר כאפס)
        (בעלים 22/10: "סכם גם את מזומן מגירה, סכום הפקדה"). ב-tfoot ולא ב-tbody: משפרי הטבלה ממיינים ומסננים את שורות ה-tbody. %>
    <% var _zdN = 0, _zdSum = 0, _zCash = 0, _zDep = 0;
       zReports.forEach(function(z){
         _zCash += Number(z.drawer_cash) || 0;
         if (z.hasDeposit) { _zdN += 1; _zdSum += Number(z.depDiff) || 0; _zDep += Number(z.depositTotal) || 0; }
       }); %>
    <tfoot><tr>
      <th colspan="4">סה"כ <span class="muted" style="font-weight:400">(<%= zReports.length %> דוחות · <%= _zdN %> עם הפקדה)</span></th>
      <th class="right"><%= formatIls(_zCash) %></th>
      <th class="right"><%= _zdN ? formatIls(_zDep) : '—' %></th>
      <th colspan="2"></th>
      <th class="right">
        <% if (!_zdN) { %><span class="muted">—</span>
        <% } else if (_zdSum === 0) { %><span style="color:var(--color-ok)">תואם</span>
        <% } else if (_zdSum > 0) { %><strong style="color:var(--color-ok)">יתרה <%= formatIls(_zdSum) %></strong>
        <% } else { %><strong style="color:var(--color-bad)">חוסר <%= formatIls(-_zdSum) %></strong><% } %>
      </th>
      <th class="no-print zr-export-slot" id="zrExportSlot"></th>
    </tr></tfoot>
  </table>
  </div>
</div>

<script src="/bag-scan.js?v=<%= encodeURIComponent(typeof buildVersion !== 'undefined' ? buildVersion : 'dev') %>"></script>
<%- include('../partials/footer') %>
