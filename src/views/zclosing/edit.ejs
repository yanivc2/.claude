<%- include('../partials/header') %>
<%
  function sh(a){ return a ? (a/100).toFixed(2) : ''; }
  function cxEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function cxInvOptsFor(sel){
    var h = '<option value="">— ללא חשבונית —</option>';
    (typeof invoiceOptions !== 'undefined' ? invoiceOptions : []).forEach(function(iv){
      h += '<option value="' + iv.id + '"' + (Number(sel) === iv.id ? ' selected' : '') + '>#' + iv.id + ' · ' + cxEsc(iv.supplier_name) + ' · ' + cxEsc(iv.invoice_number) + ' · ' + formatIls(iv.total_amount) + '</option>';
    });
    return h;
  }
  function cxEmpOptsFor(sel){
    var h = '<option value="">— בחר עובד —</option>';
    (typeof employeeOptions !== 'undefined' ? employeeOptions : []).forEach(function(emp){
      h += '<option value="' + emp.id + '"' + (Number(sel) === emp.id ? ' selected' : '') + '>' + cxEsc(emp.first_name + ' ' + emp.last_name) + '</option>';
    });
    return h;
  }
  function cxKindOptsFor(sel){
    var opts = [['manual','ידני'],['salary','שכר'],['advance','מפרעה'],['invoice','חשבונית']];
    var s = sel || 'manual';
    return opts.map(function(o){ return '<option value="'+o[0]+'"'+(s===o[0]?' selected':'')+'>'+o[1]+'</option>'; }).join('');
  }
  var stOpts = storeOptions || [];
  var empOpts = employeeOptions || [];
  var exRows = expenses || [];
%>
<div class="toolbar">
  <h1>עריכת סגירת Z</h1>
  <a href="/zclosing" class="btn btn-secondary no-print">חזרה</a>
</div>

<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card no-print">
  <p class="muted" style="margin:0 0 .6rem">נשמר: <strong><%= closing.ended_at || '—' %></strong> · שעון ישראל</p>
  <form method="post" action="/zclosing/<%= closing.id %>" class="stack" id="zclose-form">
    <% if (empOpts.length) { %>
      <input type="hidden" name="employee_first" value="<%= closing.employee_first || '' %>" />
      <input type="hidden" name="employee_last" value="<%= closing.employee_last || '' %>" />
      <div>
        <label>עובד (מבצע הספירה)</label>
        <select name="employee_id" required>
          <option value="">בחר עובד…</option>
          <% empOpts.forEach(function(emp){ %><option value="<%= emp.id %>" <%= closing.employee_id === emp.id ? 'selected' : '' %>><%= emp.first_name %> <%= emp.last_name %></option><% }); %>
        </select>
        <% if (!closing.employee_id) { %><small class="muted">סגירה זו נשמרה עם שם חופשי (<%= closing.employee_first %> <%= closing.employee_last %>) — בחר עובד לעדכון.</small><% } %>
      </div>
    <% } else { %>
      <div class="row">
        <div><label>שם פרטי</label><input name="employee_first" required autocomplete="off" value="<%= closing.employee_first || '' %>" /></div>
        <div><label>שם משפחה</label><input name="employee_last" required autocomplete="off" value="<%= closing.employee_last || '' %>" /></div>
      </div>
    <% } %>
    <div class="row">
      <div>
        <label>חנות</label>
        <% if (stOpts.length === 1) { %>
          <input type="hidden" name="store_id" value="<%= stOpts[0].id %>" />
          <input value="<%= stOpts[0].name %> · <%= stOpts[0].company_name %>" readonly />
        <% } else { %>
          <select name="store_id" required>
            <option value="">בחר חנות…</option>
            <% stOpts.forEach(function(st){ %>
              <option value="<%= st.id %>" <%= closing.store_id === st.id ? 'selected' : '' %>><%= st.name %> · <%= st.company_name %></option>
            <% }); %>
          </select>
        <% } %>
      </div>
      <div><label>מספר Z</label><input name="z_number" required autocomplete="off" value="<%= closing.z_number || '' %>" /></div>
      <div><label>סה"כ מזומן מגירה (₪)</label><input name="drawer_cash" id="drawer-cash-in" inputmode="decimal" placeholder="0.00" required value="<%= sh(closing.drawer_cash) %>" /></div>
    </div>

    <details class="card collapse-card" style="background:var(--color-surface-2);margin:1rem 0 0">
      <summary>איזון קופות (ספירת מזומן בכל קופה לפני ה-Z)</summary>
      <p class="muted" style="margin:.5rem 0 .6rem">ספור את המזומן בכל קופה. אפשר להוסיף קופה נוספת. הספירה נשמרת עם הסגירה ואינה משפיעה על טבלת המגירה למטה.</p>
      <div id="reg-list"></div>
      <button type="button" class="btn btn-secondary small" onclick="regAdd()">➕ הוסף קופה</button>
    </details>

    <h3 style="margin:1.1rem 0 .2rem">ספירת מזומן</h3>
    <div class="table-scroll">
      <table>
        <thead><tr><th>שטר / מטבע</th><th>כמות</th><th class="right">סכום</th></tr></thead>
        <tbody>
          <% denoms.forEach(function(d){ %>
            <tr>
              <td>₪<%= d.value %> <span class="muted" style="font-size:12px"><%= d.kind %></span></td>
              <td><input name="count_<%= d.key %>" class="cc-cnt" data-val="<%= d.value %>" inputmode="numeric" placeholder="0" style="max-width:130px" value="<%= breakdown[d.key] || '' %>" /></td>
              <td class="right cc-line">₪0.00</td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot><tr><th>סה"כ מזומן</th><th></th><th class="right" id="cc-cash">₪0.00</th></tr></tfoot>
      </table>
    </div>

    <h3 style="margin:1.1rem 0 .2rem">הוצאות מזומן</h3>
    <p class="muted" style="margin:0 0 .4rem">בחר <strong>סוג</strong>: ידני · שכר · מפרעה · חשבונית. שכר/מפרעה משויכים לעובד; סוג 'חשבונית' משויך לחשבונית. שורה חדשה נוספת אוטומטית.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>סוג</th><th>תאריך</th><th>שם</th><th>פרטים</th><th class="right">סכום (₪)</th><th></th></tr></thead>
        <tbody id="cx-body">
          <% exRows.forEach(function(e){ %>
            <tr>
              <td><select name="expense_kind" class="cx-kind"><%- cxKindOptsFor(e.description_type) %></select></td>
              <td><input type="date" name="expense_date" value="<%= e.expense_date || '' %>" /></td>
              <td><input name="payer_name" value="<%= e.payer_name || '' %>" /></td>
              <td>
                <input name="purpose" class="cx-purpose" value="<%= e.purpose || '' %>" placeholder="עבור" />
                <select name="expense_employee_id" class="cx-emp"><%- cxEmpOptsFor(e.employee_id) %></select>
                <select name="expense_invoice_id" class="cx-inv" style="max-width:240px"><%- cxInvOptsFor(e.invoice_id) %></select>
              </td>
              <td><input name="amount" class="cx-amt" inputmode="decimal" value="<%= sh(e.amount) %>" /></td>
              <td><button type="button" class="danger small" onclick="cxDel(this)">✕</button></td>
            </tr>
          <% }); %>
          <tr>
            <td><select name="expense_kind" class="cx-kind"><%- cxKindOptsFor(null) %></select></td>
            <td><input type="date" name="expense_date" /></td>
            <td><input name="payer_name" /></td>
            <td>
              <input name="purpose" class="cx-purpose" placeholder="עבור" />
              <select name="expense_employee_id" class="cx-emp"><%- cxEmpOptsFor(null) %></select>
              <select name="expense_invoice_id" class="cx-inv" style="max-width:240px"><%- cxInvOptsFor(null) %></select>
            </td>
            <td><input name="amount" class="cx-amt" inputmode="decimal" /></td>
            <td><button type="button" class="danger small" onclick="cxDel(this)">✕</button></td>
          </tr>
        </tbody>
        <tfoot><tr><th colspan="4">סה"כ הוצאות</th><th class="right" id="exp-total">₪0.00</th><th></th></tr></tfoot>
      </table>
    </div>

    <div class="card" style="background:var(--color-surface-2);margin-top:1rem">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <strong>סה"כ כסף + הוצאות</strong>
        <strong id="grand-total" style="font-size:1.15rem">₪0.00</strong>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.5rem">
        <span>סה"כ מזומן מגירה (שהוזן)</span>
        <span id="drawer-disp">₪0.00</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.5rem;border-top:1px solid var(--color-line);padding-top:.5rem">
        <strong>חוסר / יתרה</strong>
        <strong id="closing-diff">—</strong>
      </div>
    </div>

    <div style="margin-top:.8rem;display:flex;gap:.6rem;flex-wrap:wrap">
      <button type="submit">💾 שמור שינויים</button>
      <button type="submit" class="danger" formaction="/zclosing/<%= closing.id %>/delete" formnovalidate onclick="return confirm('למחוק את הסגירה?')">מחק סגירה</button>
    </div>
  </form>
</div>

<script>
(function(){
  var form = document.getElementById('zclose-form');
  if (!form) return;
  function fmt(a){ return '₪' + a.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2}); }
  function cashSum(){
    var total = 0;
    form.querySelectorAll('.cc-cnt').forEach(function(inp){
      var val = parseFloat(inp.dataset.val); var c = parseInt(inp.value, 10) || 0;
      var line = val * c; total += line;
      var cell = inp.closest('tr').querySelector('.cc-line'); if (cell) cell.textContent = fmt(line);
    });
    return total;
  }
  function expSum(){ var s = 0; form.querySelectorAll('.cx-amt').forEach(function(i){ var v = parseFloat(i.value); if (!isNaN(v)) s += v; }); return s; }
  function recalc(){
    var cash = cashSum(); var exp = expSum(); var grand = cash + exp;
    document.getElementById('cc-cash').textContent = fmt(cash);
    document.getElementById('exp-total').textContent = fmt(exp);
    document.getElementById('grand-total').textContent = fmt(grand);
    var drawerEl = document.getElementById('drawer-cash-in');
    var drawer = drawerEl ? (parseFloat(drawerEl.value) || 0) : 0;
    document.getElementById('drawer-disp').textContent = fmt(drawer);
    var diff = grand - drawer;
    var el = document.getElementById('closing-diff');
    if (drawerEl && drawerEl.value.trim() === '') { el.textContent = '—'; el.style.color = ''; }
    else if (Math.round(diff*100) === 0) { el.textContent = 'תואם'; el.style.color = 'var(--ok)'; }
    else if (diff > 0) { el.textContent = 'יתרה ' + fmt(diff); el.style.color = 'var(--ok)'; }
    else { el.textContent = 'חוסר ' + fmt(-diff); el.style.color = 'var(--bad)'; }
  }
  form.querySelectorAll('.cc-cnt').forEach(function(i){ i.addEventListener('input', recalc); });
  var drawerIn = document.getElementById('drawer-cash-in'); if (drawerIn) drawerIn.addEventListener('input', recalc);

  var body = document.getElementById('cx-body');
  var CX_INV_OPTS = <%- JSON.stringify(cxInvOptsFor(null)) %>;
  var CX_EMP_OPTS = <%- JSON.stringify(cxEmpOptsFor(null)) %>;
  var CX_KIND_OPTS = <%- JSON.stringify(cxKindOptsFor(null)) %>;
  function applyKind(row){
    var kind = (row.querySelector('.cx-kind') || {}).value || 'manual';
    var p = row.querySelector('.cx-purpose'), emp = row.querySelector('.cx-emp'), inv = row.querySelector('.cx-inv');
    if (p) p.hidden = (kind !== 'manual');
    if (emp) emp.hidden = !(kind === 'salary' || kind === 'advance');
    if (inv) inv.hidden = (kind !== 'invoice');
  }
  window.cxDel = function(btn){
    var rows = body.querySelectorAll('tr');
    if (rows.length > 1) btn.closest('tr').remove();
    else btn.closest('tr').querySelectorAll('input,select').forEach(function(i){ i.value=''; });
    recalc();
  };
  function addRow(){
    var tr = document.createElement('tr');
    tr.innerHTML = '<td><select name="expense_kind" class="cx-kind">' + CX_KIND_OPTS + '</select></td>'
      + '<td><input type="date" name="expense_date"></td>'
      + '<td><input name="payer_name"></td>'
      + '<td><input name="purpose" class="cx-purpose" placeholder="עבור">'
      +   '<select name="expense_employee_id" class="cx-emp">' + CX_EMP_OPTS + '</select>'
      +   '<select name="expense_invoice_id" class="cx-inv" style="max-width:240px">' + CX_INV_OPTS + '</select></td>'
      + '<td><input name="amount" class="cx-amt" inputmode="decimal"></td>'
      + '<td><button type="button" class="danger small" onclick="cxDel(this)">✕</button></td>';
    body.appendChild(tr);
    applyKind(tr);
  }
  body.querySelectorAll('tr').forEach(applyKind);
  body.addEventListener('change', function(e){
    if (e.target && e.target.classList.contains('cx-kind')) applyKind(e.target.closest('tr'));
  });
  body.addEventListener('input', function(e){
    recalc();
    var rows = body.querySelectorAll('tr');
    var last = rows[rows.length - 1];
    if (last.contains(e.target)) {
      var filled = Array.prototype.some.call(last.querySelectorAll('input'), function(i){ return i.value.trim() !== ''; });
      if (filled) addRow();
    }
  });
  recalc();
})();
</script>

<script>
// "איזון קופות" — repeatable per-register cash count, prefilled from the saved closing.
(function(){
  var list = document.getElementById('reg-list');
  if (!list) return;
  var DENOMS = <%- JSON.stringify((denoms || []).map(function(d){ return { key: d.key, value: d.value, kind: d.kind }; })) %>;
  var STORES = <%- JSON.stringify((stOpts || []).map(function(s){ return { id: s.id, label: s.name + ' · ' + s.company_name }; })) %>;
  var SAVED = [];
  try { SAVED = JSON.parse(<%- JSON.stringify(closing.registers || '[]') %>) || []; } catch (e) { SAVED = []; }
  function fmt(a){ return '₪' + a.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2}); }
  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function storeOptsHtml(sel){ return STORES.map(function(s){ return '<option value="'+s.id+'"'+(Number(sel)===s.id?' selected':'')+'>'+esc(s.label)+'</option>'; }).join(''); }
  function denomRows(bd){
    bd = bd || {};
    return DENOMS.map(function(d){
      var c = bd[d.key] || '';
      return '<tr><td>₪'+d.value+' <span class="muted" style="font-size:12px">'+d.kind+'</span></td>'
        + '<td><input name="reg_count_'+d.key+'[]" class="rc-cnt" data-val="'+d.value+'" inputmode="numeric" placeholder="0" style="max-width:120px" value="'+c+'"></td>'
        + '<td class="right rc-line">₪0.00</td></tr>';
    }).join('');
  }
  window.regDel = function(btn){ var b = btn.closest('.reg-block'); if (b) b.remove(); };
  function recalcBlock(block){
    var t = 0;
    block.querySelectorAll('.rc-cnt').forEach(function(i){
      var v = parseFloat(i.dataset.val); var c = parseInt(i.value, 10) || 0; var line = v * c; t += line;
      var cell = i.closest('tr').querySelector('.rc-line'); if (cell) cell.textContent = fmt(line);
    });
    var tot = block.querySelector('.rc-total'); if (tot) tot.textContent = fmt(t);
  }
  window.regAdd = function(preset){
    preset = preset || {};
    var n = list.querySelectorAll('.reg-block').length + 1;
    var div = document.createElement('div');
    div.className = 'reg-block';
    div.style.cssText = 'background:var(--color-surface);border:1px solid var(--color-line);border-radius:var(--radius-md);margin:.5rem 0;padding:.7rem';
    var regNum = String(preset.register || Math.min(n, 3));
    div.innerHTML =
      '<div class="row">'
      + '<div><label>שם פרטי</label><input name="reg_first[]" autocomplete="off" value="'+esc(preset.first)+'"></div>'
      + '<div><label>שם משפחה</label><input name="reg_last[]" autocomplete="off" value="'+esc(preset.last)+'"></div>'
      + '<div><label>קופה</label><select name="reg_number[]"><option value="1">קופה 1</option><option value="2">קופה 2</option><option value="3">קופה 3</option></select></div>'
      + '<div><label>חנות</label><select name="reg_store[]">' + storeOptsHtml(preset.storeId) + '</select></div>'
      + '</div>'
      + '<div class="table-scroll" style="margin-top:.4rem"><table><thead><tr><th>שטר / מטבע</th><th>כמות</th><th class="right">סכום</th></tr></thead>'
      + '<tbody>' + denomRows(preset.breakdown) + '</tbody>'
      + '<tfoot><tr><th>סה"כ קופה ' + n + '</th><th></th><th class="right rc-total">₪0.00</th></tr></tfoot></table></div>'
      + '<div style="margin-top:.4rem"><button type="button" class="danger small" onclick="regDel(this)">הסר קופה</button></div>';
    var sel = div.querySelector('select[name="reg_number[]"]'); if (sel) sel.value = regNum;
    list.appendChild(div);
    div.addEventListener('input', function(e){ if (e.target.classList && e.target.classList.contains('rc-cnt')) recalcBlock(div); });
    recalcBlock(div);
  };
  if (SAVED.length) SAVED.forEach(function(r){ regAdd(r); });
  else regAdd();
})();
</script>
<%- include('../partials/footer') %>
