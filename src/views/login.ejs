<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>התחברות · AP Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/nocturne.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#161826" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
</head>
<body>
  <div class="amb amb-glow"></div>
  <div class="amb amb-grid"></div>
  <div class="amb amb-vignette"></div>

  <main class="page" style="max-width:400px; margin-top:12vh">
    <div class="card fade-up">
      <div class="nav-brand" style="margin-bottom:var(--space-4)"><span class="mark">AP</span>Control</div>
      <p class="text-muted" style="margin-top:0">התחברות למערכת</p>
      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="alert alert-ok"><%= notice %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="post" action="/login" class="stack">
        <label>שם משתמש</label>
        <input name="username" autocomplete="username" autofocus required />
        <label>סיסמה</label>
        <input name="password" type="password" autocomplete="current-password" required />
        <div style="margin-top:var(--space-4)"><button type="submit" class="btn btn-primary btn-block">התחבר</button></div>
      </form>
      <p class="text-muted" style="margin:var(--space-3) 0 0"><a href="/forgot">שכחתי סיסמה</a></p>
    </div>
    <p class="text-muted" style="text-align:center; font-size:12px; margin-top:var(--space-4)">
      <a href="/privacy">הודעת פרטיות</a> · <a href="/accessibility">הצהרת נגישות</a>
      <% if (typeof buildVersion !== 'undefined' && buildVersion) { %> · <span title="גרסת בנייה">v<%= buildVersion %></span><% } %>
    </p>
  </main>
</body>
</html>
