<%- include('../partials/header') %>
<div class="toolbar"><h1>שינוי סיסמה</h1></div>

<% if (notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (typeof forced !== 'undefined' && forced) { %>
  <div class="alert alert-warn"><strong>החלפת סיסמה נדרשת.</strong> קיבלת סיסמה זמנית — יש לבחור סיסמה קבועה משלך כדי להמשיך.</div>
<% } %>

<div class="card" style="max-width:420px">
  <p class="muted">מחובר כ־<strong><%= currentUser.name %></strong> (<%= currentUser.role === 'owner' ? 'בעלים' : 'מזכירה' %>).</p>
  <form method="post" action="/account/password" class="stack">
    <label><%= (typeof forced !== 'undefined' && forced) ? 'הסיסמה הזמנית' : 'סיסמה נוכחית' %></label>
    <input name="current" type="password" autocomplete="current-password" required />
    <label>סיסמה חדשה</label>
    <input name="next" type="password" autocomplete="new-password" required minlength="8" />
    <label>אישור סיסמה חדשה</label>
    <input name="confirm" type="password" autocomplete="new-password" required minlength="8" />
    <p class="muted" style="margin:.2rem 0 0"><%= typeof policyText !== 'undefined' ? policyText : '' %></p>
    <div style="margin-top:1rem"><button type="submit">עדכן סיסמה</button></div>
  </form>
</div>
<%- include('../partials/footer') %>
