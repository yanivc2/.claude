# AP Control — local configuration (stage 1)
# Copy to .env and adjust. Never commit .env.

# HTTP port for the local web app (secretary connects from a browser on the office LAN)
PORT=3000

# SQLite database file path (relative to project root). Kept out of git; back it up daily (§12).
DB_PATH=./data/ap-control.sqlite

# Stage 1b — invoice images. Directory is gitignored; back it up together with the DB (§12).
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Stage 2 (bank scraper) — NOT used in stage 1. Kept here for reference only.
# Never hard-code bank credentials in source. Use OS keychain or an encrypted, gitignored file.
# BANK_HAPOALIM_USER_CODE=
# BANK_HAPOALIM_PASSWORD=
