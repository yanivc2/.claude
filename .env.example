# AP Control — local configuration (stage 1)
# Copy to .env and adjust. Never commit .env.

# HTTP port for the local web app (secretary connects from a browser on the office LAN)
PORT=3000

# SQLite database file path (relative to project root). Kept out of git; back it up daily (§12).
DB_PATH=./data/ap-control.sqlite

# Stage 1b — invoice images. Directory is gitignored; back it up together with the DB (§12).
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Stage 2 — bank reconciliation (R7).
# Match window: a bank debit matches an open check within this many days of payment_date.
RECONCILE_WINDOW_DAYS=60

# Bank scraper (israeli-bank-scrapers, optional dependency — install when ready for stage 2).
# Never hard-code bank credentials in source. Use OS keychain or an encrypted, gitignored file.
# Run:  npm install israeli-bank-scrapers  &&  npm run scrape
# BANK_HAPOALIM_USER_CODE=
# BANK_HAPOALIM_PASSWORD=

# Stage 3 — OCR (local, optional). Install:  npm install tesseract.js
# Languages for tesseract; OCR_LANG_PATH points to a local traineddata folder for offline use.
OCR_LANGS=heb+eng
# OCR_LANG_PATH=./tessdata

# צילום חשבוניות — AI extraction via the Claude API (vision + structured outputs).
# Without ANTHROPIC_API_KEY the /scan pages show a friendly "not configured" notice.
# Get a key at console.anthropic.com (billing must be enabled). Cost at 300-1,000
# invoices/month is roughly $20-60/month with the default model.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Model + tuning (defaults are fine; EXTRACT_EFFORT=low speeds up extraction at some accuracy cost).
# EXTRACT_MODEL=claude-opus-5
# EXTRACT_EFFORT=medium
# EXTRACT_MAX_TOKENS=16000
# Max pages (photos/files) per scanned invoice upload.
# MAX_SCAN_IMAGES=8

# Stage 4 — check printing (Standard 501 / MICR). GATED: leave false until the bank has
# approved self-printing AND an approved E-13B MICR font is installed (🔴 §11.5, §10.3).
# While false, the check prints as a watermarked DRAFT with a MICR placeholder only.
CHECK_PRINTING_APPROVED=false

# Stage 2d — Z-close alerts via a DEDICATED Telegram bot (separate from any other bot you run).
# Create the bot with @BotFather (/newbot) and paste its token below. With no token the app
# runs normally and simply sends no alerts. Never commit the real token — keep it in .env only.
# TELEGRAM_BOT_TOKEN=123456789:AA...token
# Chat id to send alerts to (default is the owner's id; override here if needed).
# TELEGRAM_CHAT_ID=5717967564

# Stage: cloud file storage. With a Vercel Blob token, uploaded invoice/expense images are
# stored in Vercel Blob (the serverless filesystem is ephemeral). Without it, files are saved
# to UPLOADS_DIR on local disk (the office/local mode). Get the token from the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Files are stored as PRIVATE blobs by default (served only via the app's authenticated routes).
# Set BLOB_ACCESS=public only if your Blob store requires public access.
# BLOB_ACCESS=private

# Stage: authentication (real login — required once the app is exposed to the internet).
# SESSION_SECRET signs the login cookie; set a long random value in any deployment (without it,
# a random per-process secret is used and everyone is logged out on restart).
# SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_TTL_HOURS=12
# Seed credentials — used only when a user row is first created (or has no password yet).
# Change the passwords after first login. Defaults: owner/owner1234, secretary/secretary1234.
# OWNER_USERNAME=owner
# OWNER_PASSWORD=
# SECRETARY_USERNAME=secretary
# SECRETARY_PASSWORD=

# Email (password reset via "שכחתי סיסמה"). Uses Resend's HTTP API. Without RESEND_API_KEY the
# reset flow is disabled and the login page tells users to ask the owner. MAIL_FROM must be a
# verified sender/domain in Resend (the shared onboarding@resend.dev works for testing).
# APP_URL is the public base URL used to build reset links (e.g. https://ap-control.vercel.app).
# RESEND_API_KEY=re_...
# MAIL_FROM=AP Control <onboarding@resend.dev>
# APP_URL=https://ap-control.vercel.app
